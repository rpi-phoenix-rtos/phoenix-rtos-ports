+
+/*
+ * A polling GLocalFileMonitor, for systems whose kernel has no file change
+ * notification at all (no inotify, kqueue or FEN), such as Phoenix-RTOS.
+ * Without any backend g_file_monitor_directory() fails with "Unable to find
+ * default local file monitor type", and file managers, desktops and panels
+ * never see a file appear.
+ *
+ * It is registered at a lower priority than the notification backends, so a
+ * system that has one keeps using it.
+ *
+ * A file is watched by stat()ing it on every tick.
+ *
+ * A directory is watched in tiers, because on such systems every call is a
+ * message to a filesystem server and lstat() of a path is the expensive one
+ * (on Phoenix-RTOS libc it costs two messages per path component):
+ *
+ *  - every tick the directory itself is stat()ed. POSIX requires link(),
+ *    unlink() and rename() to update its st_mtime and st_ctime, so while
+ *    they, its inode, size and link count stay as they were, no entry was
+ *    added, removed or renamed, and nothing more is done;
+ *  - when they move, the entries are read (one readdir per entry) and compared
+ *    by name and d_ino, which finds created, deleted, renamed and replaced
+ *    entries; only the new ones are lstat()ed;
+ *  - every sweep the entries are read and every one is lstat()ed as well,
+ *    which finds content (size, mtime) and attribute (mode, owner, ctime)
+ *    changes: those do not touch the directory. A sweep comes every
+ *    SWEEP_TICKS ticks while the directory changes; each sweep that finds
+ *    nothing doubles the period, up to SWEEP_TICKS_MAX ticks.
+ *
+ * Timestamps have a granularity (one second on Phoenix-RTOS, whose stat()
+ * leaves tv_nsec 0; two seconds on FAT), so an entry added in the same granule
+ * as the last read leaves them unchanged. A listing is therefore trusted to
+ * stand for the directory only if it was read at least RACY_WINDOW after this
+ * monitor first saw the directory's current stamps: by then the filesystem's
+ * clock has left the granule they name, so any later change must move them.
+ * Until then the entries are read on every tick. The window is measured on the
+ * monotonic clock instead of comparing the mtime with the time of day, which
+ * on an NFS root would compare the clocks of two machines.
+ *
+ * A filesystem that does not update a directory's stamps is detected rather
+ * than assumed (statfs() cannot tell the filesystems apart): a sweep that
+ * finds names added or removed under stamps that did not move, outside the
+ * window, makes this monitor read the entries on every tick from then on.
+ * Only that first change is reported late, by up to one sweep period.
+ *
+ * A large directory is polled less often so that the cost of one monitor stays
+ * bounded: the tick is stretched beyond ENTRIES_PER_TICK entries and the sweep
+ * beyond ENTRIES_PER_SWEEP.
+ *
+ * The polling runs on GLib's worker thread, as the notification backends do,
+ * so that synchronous stat() calls (network round trips on an NFS root) never
+ * stall the application's main loop. Events reach the monitor's own context
+ * through g_file_monitor_source_handle_event(), which is thread-safe.
+ *
+ * The tick is GIO_POLL_INTERVAL_MS milliseconds (100 to 60000, default
+ * DEFAULT_INTERVAL_MS).
+ */
+
+#include "config.h"
+
+#include <sys/types.h>
+#include <sys/stat.h>
+#include <dirent.h>
+#include <errno.h>
+#include <string.h>
+
+#include <glib-object.h>
+#include <gio/gfilemonitor.h>
+#include <gio/glocalfilemonitor.h>
+#include <gio/giomodule.h>
+#include "glib-private.h"
+
+#define DEFAULT_INTERVAL_MS 1000
+#define MIN_INTERVAL_MS     100
+#define MAX_INTERVAL_MS     60000
+
+/* A sweep (lstat of every entry) every SWEEP_TICKS ticks while the directory
+ * changes, backing off to every SWEEP_TICKS_MAX ticks while it does not. */
+#define SWEEP_TICKS     4
+#define SWEEP_TICKS_MAX 32
+
+/* How long after the directory's stamps last moved a listing may still miss a
+ * change made in the same timestamp granule (1 s; 2 s on FAT). */
+#define RACY_WINDOW (2 * G_TIME_SPAN_SECOND)
+
+/* Beyond these the tick and the sweep are stretched in proportion. */
+#define ENTRIES_PER_TICK  256
+#define ENTRIES_PER_SWEEP 64
+
+/* The stretched tick is never longer than this (unless the base tick is). */
+#define MAX_SCALED_INTERVAL (30 * G_TIME_SPAN_SECOND)
+
+#define G_TYPE_POLL_LOCAL_FILE_MONITOR (g_poll_local_file_monitor_get_type ())
+#define G_POLL_LOCAL_FILE_MONITOR(o)   (G_TYPE_CHECK_INSTANCE_CAST ((o), G_TYPE_POLL_LOCAL_FILE_MONITOR, GPollLocalFileMonitor))
+
+typedef struct
+{
+  GLocalFileMonitor parent_instance;
+
+  GSource *poller; /* (owned) (nullable): NULL once cancelled */
+} GPollLocalFileMonitor;
+
+typedef GLocalFileMonitorClass GPollLocalFileMonitorClass;
+
+GType g_poll_local_file_monitor_get_type (void);
+
+G_DEFINE_TYPE_WITH_CODE (GPollLocalFileMonitor, g_poll_local_file_monitor, G_TYPE_LOCAL_FILE_MONITOR,
+                         g_io_extension_point_implement (G_LOCAL_FILE_MONITOR_EXTENSION_POINT_NAME,
+                                                         g_define_type_id, "poll", 10))
+
+/* What a poll compares. */
+typedef struct
+{
+  guint64 ino;
+  gint64  size;
+  gint64  mtime;      /* ns */
+  gint64  ctime;      /* ns */
+  guint32 mode;
+  guint32 uid;
+  guint32 gid;
+  guint32 nlink;
+} PollStat;
+
+/* A directory entry. */
+typedef struct
+{
+  guint64  d_ino;     /* as readdir() reported it; 0 when unknown */
+  gboolean have_stat;
+  PollStat st;
+} PollEntry;
+
+/* The poller: a GSource on the worker context, woken by its ready time. It
+ * holds everything a tick needs, so it outlives the monitor safely: cancel
+ * only destroys it, and GLib finalizes it once a running tick returns. */
+typedef struct
+{
+  GSource             source;
+
+  GFileMonitorSource *fms;          /* (owned) where the events go */
+  gchar              *path;         /* the directory, or the file */
+  gchar              *child;        /* file mode: the basename the events name (NULL for hard-link mode) */
+  gboolean            is_directory;
+  gboolean            exists;
+  PollStat            self;         /* file mode: the file */
+  GHashTable         *entries;      /* directory mode: name -> PollEntry */
+
+  /* directory mode: when the entries must be read */
+  PollStat            dir_st;       /* the directory, as last stat()ed */
+  gboolean            have_dir_st;
+  gint64              dir_st_since; /* when dir_st was first seen (monotonic) */
+  gboolean            trusted;      /* entries were read RACY_WINDOW after dir_st_since */
+  gboolean            stamps_unreliable; /* this filesystem does not update dir_st */
+  guint               sweep_period; /* SWEEP_TICKS..SWEEP_TICKS_MAX */
+  guint               sweep_in;     /* ticks until the next sweep */
+  guint               events;       /* emitted so far */
+} PollSource;
+
+static gint64
+poll_base_interval (void)
+{
+  static gsize initialized;
+  static gint64 interval;
+
+  if (g_once_init_enter (&initialized))
+    {
+      const gchar *env = g_getenv ("GIO_POLL_INTERVAL_MS");
+      guint64 ms = DEFAULT_INTERVAL_MS;
+
+      if (env != NULL && !g_ascii_string_to_unsigned (env, 10, MIN_INTERVAL_MS, MAX_INTERVAL_MS, &ms, NULL))
+        {
+          g_warning ("GIO_POLL_INTERVAL_MS=%s is not a number of milliseconds in %u..%u; using %u",
+                     env, MIN_INTERVAL_MS, MAX_INTERVAL_MS, DEFAULT_INTERVAL_MS);
+          ms = DEFAULT_INTERVAL_MS;
+        }
+
+      interval = (gint64) ms * G_TIME_SPAN_MILLISECOND;
+      g_once_init_leave (&initialized, 1);
+    }
+
+  return interval;
+}
+
+static guint
+poll_entry_count (PollSource *ps)
+{
+  return ps->entries != NULL ? g_hash_table_size (ps->entries) : 0;
+}
+
+static gint64
+poll_interval (PollSource *ps)
+{
+  gint64 interval = poll_base_interval ();
+  guint n = poll_entry_count (ps);
+
+  if (n > ENTRIES_PER_TICK)
+    interval = MIN (interval * n / ENTRIES_PER_TICK, MAX (interval, MAX_SCALED_INTERVAL));
+
+  return interval;
+}
+
+/* The ticks from one sweep to the next. */
+static guint
+poll_sweep_ticks (PollSource *ps)
+{
+  return ps->sweep_period * MAX (1, poll_entry_count (ps) / ENTRIES_PER_SWEEP);
+}
+
+static gboolean
+poll_stat (const gchar *path,
+           gboolean     follow,
+           PollStat    *out)
+{
+  struct stat st;
+
+  if ((follow ? stat (path, &st) : lstat (path, &st)) != 0)
+    return FALSE;
+
+  memset (out, 0, sizeof *out);
+  out->ino = st.st_ino;
+  out->size = st.st_size;
+#if defined (HAVE_STRUCT_STAT_ST_MTIM_TV_NSEC)
+  out->mtime = (gint64) st.st_mtim.tv_sec * 1000000000 + st.st_mtim.tv_nsec;
+  out->ctime = (gint64) st.st_ctim.tv_sec * 1000000000 + st.st_ctim.tv_nsec;
+#else
+  out->mtime = (gint64) st.st_mtime * 1000000000;
+  out->ctime = (gint64) st.st_ctime * 1000000000;
+#endif
+  out->mode = st.st_mode;
+  out->uid = st.st_uid;
+  out->gid = st.st_gid;
+  out->nlink = st.st_nlink;
+
+  return TRUE;
+}
+
+/* The event that turns @old into @new, or NO_EVENT. The content of a
+ * directory entry is not compared: a parent's monitor does not report changes
+ * inside a subdirectory (inotify does not either). */
+#define NO_EVENT (-1)
+
+static gint
+poll_stat_compare (const PollStat *old,
+                   const PollStat *new,
+                   gboolean        dir_contents)
+{
+  if (old->ino != new->ino || (old->mode & S_IFMT) != (new->mode & S_IFMT))
+    return G_FILE_MONITOR_EVENT_CREATED; /* replaced, e.g. renamed over */
+
+  if ((dir_contents || !S_ISDIR (new->mode)) && (old->size != new->size || old->mtime != new->mtime))
+    return G_FILE_MONITOR_EVENT_CHANGED;
+
+  if (old->mode != new->mode || old->uid != new->uid || old->gid != new->gid)
+    return G_FILE_MONITOR_EVENT_ATTRIBUTE_CHANGED;
+
+  if (!S_ISDIR (new->mode) && (old->nlink != new->nlink || old->ctime != new->ctime))
+    return G_FILE_MONITOR_EVENT_ATTRIBUTE_CHANGED;
+
+  return NO_EVENT;
+}
+
+/* Whether a directory that was @old and is now @new may have had entries
+ * added, removed or renamed since. */
+static gboolean
+poll_dir_stamps_moved (const PollStat *old,
+                       const PollStat *new)
+{
+  return old->ino != new->ino || old->mode != new->mode || old->size != new->size ||
+         old->nlink != new->nlink || old->mtime != new->mtime || old->ctime != new->ctime;
+}
+
+static void
+poll_emit (PollSource        *ps,
+           GFileMonitorEvent  event,
+           const gchar       *child,
+           const gchar       *rename_to)
+{
+  ps->events++;
+  g_file_monitor_source_handle_event (ps->fms, event, child, rename_to, NULL, g_get_monotonic_time ());
+}
+
+static gboolean
+poll_entry_stat (GString     *path,
+                 gsize        dirlen,
+                 const gchar *name,
+                 PollEntry   *entry)
+{
+  g_string_truncate (path, dirlen);
+  g_string_append (path, name);
+  entry->have_stat = poll_stat (path->str, FALSE, &entry->st);
+
+  return entry->have_stat;
+}
+
+/* Whether a failed stat()/opendir() means that the path is not there, as
+ * opposed to a transient failure (EIO, EMFILE, a timed-out NFS call) that must
+ * not be reported as a deletion. */
+static gboolean
+poll_errno_is_absent (int errsv)
+{
+  return errsv == ENOENT || errsv == ENOTDIR;
+}
+
+/* The directory's entries, name -> PollEntry (not yet stat()ed), or NULL with
+ * errno set if it cannot be read. */
+static GHashTable *
+poll_read_dir (const gchar *path)
+{
+  GHashTable *entries;
+  struct dirent *de;
+  DIR *dir;
+  int errsv;
+
+  dir = opendir (path);
+  if (dir == NULL)
+    return NULL;
+
+  entries = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  for (;;)
+    {
+      PollEntry *entry;
+
+      errno = 0;
+      de = readdir (dir);
+      if (de == NULL)
+        break;
+
+      if (de->d_name[0] == '.' && (de->d_name[1] == '\0' || (de->d_name[1] == '.' && de->d_name[2] == '\0')))
+        continue;
+
+      entry = g_new0 (PollEntry, 1);
+      entry->d_ino = de->d_ino;
+      g_hash_table_insert (entries, g_strdup (de->d_name), entry);
+    }
+  errsv = errno;
+  closedir (dir);
+
+  if (errsv != 0)
+    {
+      /* A partial list would read as deletions. */
+      g_hash_table_unref (entries);
+      errno = errsv;
+      return NULL;
+    }
+
+  return entries;
+}
+
+/* lstat() every entry: the initial snapshot. */
+static void
+poll_stat_all (PollSource *ps)
+{
+  GHashTableIter iter;
+  gpointer name, entry;
+  GString *path;
+  gsize dirlen;
+
+  path = g_string_new (ps->path);
+  if (path->len == 0 || path->str[path->len - 1] != '/')
+    g_string_append_c (path, '/');
+  dirlen = path->len;
+
+  g_hash_table_iter_init (&iter, ps->entries);
+  while (g_hash_table_iter_next (&iter, &name, &entry))
+    poll_entry_stat (path, dirlen, name, entry);
+
+  g_string_free (path, TRUE);
+}
+
+/* The directory is gone (or is no longer a directory): report it and its
+ * entries once. */
+static void
+poll_directory_gone (PollSource *ps)
+{
+  GHashTableIter iter;
+  gpointer key;
+
+  ps->have_dir_st = FALSE;
+  ps->trusted = FALSE;
+
+  if (!ps->exists)
+    return;
+
+  g_hash_table_iter_init (&iter, ps->entries);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    poll_emit (ps, G_FILE_MONITOR_EVENT_DELETED, key, NULL);
+  poll_emit (ps, G_FILE_MONITOR_EVENT_DELETED, NULL, NULL);
+  g_hash_table_remove_all (ps->entries);
+  ps->exists = FALSE;
+}
+
+static void
+poll_directory (PollSource *ps)
+{
+  GHashTable *entries;
+  GHashTableIter iter;
+  gpointer key, value;
+  GPtrArray *gone;
+  GString *path;
+  PollStat st;
+  gboolean sweep, moved, verify;
+  guint events = ps->events;
+  guint names = 0; /* entries created, deleted or renamed this tick */
+  gint64 now;
+  gsize dirlen;
+  guint i;
+
+  if (ps->sweep_in > 0)
+    ps->sweep_in--;
+  sweep = ps->sweep_in == 0;
+
+  /* The directory itself: has an entry been added, removed or renamed? */
+  now = g_get_monotonic_time ();
+  if (!poll_stat (ps->path, TRUE, &st))
+    {
+      if (poll_errno_is_absent (errno))
+        poll_directory_gone (ps);
+      return; /* else try again on the next tick */
+    }
+  if (!S_ISDIR (st.mode))
+    {
+      poll_directory_gone (ps);
+      return;
+    }
+
+  moved = !ps->have_dir_st || poll_dir_stamps_moved (&ps->dir_st, &st);
+  if (moved)
+    {
+      ps->dir_st = st;
+      ps->have_dir_st = TRUE;
+      ps->dir_st_since = now;
+    }
+
+  if (!moved && ps->trusted && !ps->stamps_unreliable && !sweep)
+    return;
+
+  /* A sweep's read that the stamps said was not needed checks them. */
+  verify = !moved && ps->trusted && !ps->stamps_unreliable;
+
+  entries = poll_read_dir (ps->path);
+  if (entries == NULL)
+    {
+      if (poll_errno_is_absent (errno))
+        poll_directory_gone (ps);
+      else
+        ps->have_dir_st = FALSE; /* read it again on the next tick */
+      return;
+    }
+
+  if (!ps->exists)
+    {
+      poll_emit (ps, G_FILE_MONITOR_EVENT_CREATED, NULL, NULL);
+      ps->exists = TRUE;
+    }
+
+  path = g_string_new (ps->path);
+  if (path->len == 0 || path->str[path->len - 1] != '/')
+    g_string_append_c (path, '/');
+  dirlen = path->len;
+
+  /* The names that are no longer there (keys of ps->entries). */
+  gone = g_ptr_array_new ();
+  g_hash_table_iter_init (&iter, ps->entries);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    if (!g_hash_table_contains (entries, key))
+      g_ptr_array_add (gone, key);
+
+  g_hash_table_iter_init (&iter, entries);
+  while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+      const gchar *name = key;
+      PollEntry *entry = value;
+      PollEntry *old = g_hash_table_lookup (ps->entries, name);
+      const gchar *from = NULL;
+
+      if (old != NULL && old->d_ino == entry->d_ino)
+        {
+          /* The same file: compare its attributes only on a sweep. */
+          entry->have_stat = old->have_stat;
+          entry->st = old->st;
+
+          if (sweep)
+            {
+              PollStat est = entry->st;
+              gboolean had_stat = entry->have_stat;
+
+              if (poll_entry_stat (path, dirlen, name, entry) && had_stat)
+                {
+                  gint event = poll_stat_compare (&est, &entry->st, FALSE);
+
+                  if (event != NO_EVENT)
+                    poll_emit (ps, (GFileMonitorEvent) event, name, NULL);
+                }
+            }
+          continue;
+        }
+
+      /* A new name, or a name that now holds another file: renamed from a
+       * name that went away in the same tick, if its d_ino matches. */
+      poll_entry_stat (path, dirlen, name, entry);
+      names++;
+
+      for (i = 0; entry->d_ino != 0 && i < gone->len; i++)
+        {
+          PollEntry *g = gone->pdata[i] != NULL ? g_hash_table_lookup (ps->entries, gone->pdata[i]) : NULL;
+
+          if (g != NULL && g->d_ino == entry->d_ino)
+            {
+              from = gone->pdata[i];
+              gone->pdata[i] = NULL;
+              break;
+            }
+        }
+
+      if (from != NULL)
+        poll_emit (ps, G_FILE_MONITOR_EVENT_RENAMED, from, name);
+      else
+        poll_emit (ps, G_FILE_MONITOR_EVENT_CREATED, name, NULL);
+    }
+
+  for (i = 0; i < gone->len; i++)
+    if (gone->pdata[i] != NULL)
+      {
+        poll_emit (ps, G_FILE_MONITOR_EVENT_DELETED, gone->pdata[i], NULL);
+        names++;
+      }
+
+  g_ptr_array_unref (gone);
+  g_string_free (path, TRUE);
+
+  g_hash_table_unref (ps->entries);
+  ps->entries = entries;
+
+  /* The stat() above came before the read, so if the stamps were already
+   * RACY_WINDOW old then, the filesystem's clock had left their granule before
+   * the first entry was read: a later change cannot leave them as they are. */
+  ps->trusted = now - ps->dir_st_since >= RACY_WINDOW;
+
+  /* Names changed under stamps that, outside the window, did not move -- and
+   * still have not (they would have if the change came after the stat()). */
+  if (verify && names > 0 && poll_stat (ps->path, TRUE, &st) && !poll_dir_stamps_moved (&ps->dir_st, &st))
+    {
+      g_debug ("GPollLocalFileMonitor: %s: entries changed but the directory's mtime and ctime did not; "
+               "reading it on every tick", ps->path);
+      ps->stamps_unreliable = TRUE;
+    }
+
+  /* Sweep often while the directory changes, less and less while it does not. */
+  if (ps->events != events)
+    ps->sweep_period = SWEEP_TICKS;
+  else if (sweep)
+    ps->sweep_period = MIN (ps->sweep_period * 2, SWEEP_TICKS_MAX);
+
+  if (sweep)
+    ps->sweep_in = poll_sweep_ticks (ps);
+  else
+    ps->sweep_in = MIN (ps->sweep_in, poll_sweep_ticks (ps));
+}
+
+/* A file, or a dangling symlink. FALSE with errno set if neither. */
+static gboolean
+poll_file_stat (const gchar *path,
+                PollStat    *out)
+{
+  return poll_stat (path, TRUE, out) || poll_stat (path, FALSE, out);
+}
+
+static void
+poll_file (PollSource *ps)
+{
+  PollStat st;
+  gboolean exists = poll_file_stat (ps->path, &st);
+
+  if (!exists && !poll_errno_is_absent (errno))
+    return; /* try again on the next tick */
+
+  if (exists && !ps->exists)
+    poll_emit (ps, G_FILE_MONITOR_EVENT_CREATED, ps->child, NULL);
+  else if (!exists && ps->exists)
+    poll_emit (ps, G_FILE_MONITOR_EVENT_DELETED, ps->child, NULL);
+  else if (exists)
+    {
+      gint event = poll_stat_compare (&ps->self, &st, TRUE);
+
+      if (event != NO_EVENT)
+        poll_emit (ps, (GFileMonitorEvent) event, ps->child, NULL);
+    }
+
+  ps->exists = exists;
+  if (exists)
+    ps->self = st;
+}
+
+static gboolean
+poll_source_dispatch (GSource     *source,
+                      GSourceFunc  callback,
+                      gpointer     user_data)
+{
+  PollSource *ps = (PollSource *) source;
+
+  /* The monitor is gone (cancel destroys this source too; this is a guard). */
+  if (g_source_is_destroyed ((GSource *) ps->fms))
+    return G_SOURCE_REMOVE;
+
+  if (ps->is_directory)
+    poll_directory (ps);
+  else
+    poll_file (ps);
+
+  g_source_set_ready_time (source, g_get_monotonic_time () + poll_interval (ps));
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+poll_source_finalize (GSource *source)
+{
+  PollSource *ps = (PollSource *) source;
+
+  g_clear_pointer (&ps->entries, g_hash_table_unref);
+  g_free (ps->child);
+  g_free (ps->path);
+  g_source_unref ((GSource *) ps->fms);
+}
+
+static GSourceFuncs poll_source_funcs = {
+  NULL, NULL,
+  poll_source_dispatch,
+  poll_source_finalize,
+  NULL, NULL
+};
+
+static gboolean
+g_poll_local_file_monitor_is_supported (void)
+{
+  return TRUE;
+}
+
+static void
+g_poll_local_file_monitor_start (GLocalFileMonitor  *local_monitor,
+                                 const gchar        *dirname,
+                                 const gchar        *basename,
+                                 const gchar        *filename,
+                                 GFileMonitorSource *source)
+{
+  GPollLocalFileMonitor *monitor = G_POLL_LOCAL_FILE_MONITOR (local_monitor);
+  PollSource *ps;
+
+  g_assert (monitor->poller == NULL);
+
+  ps = (PollSource *) g_source_new (&poll_source_funcs, sizeof (PollSource));
+  g_source_set_static_name ((GSource *) ps, "GPollLocalFileMonitor");
+  ps->fms = (GFileMonitorSource *) g_source_ref ((GSource *) source);
+
+  if (filename != NULL)
+    ps->path = g_strdup (filename); /* G_FILE_MONITOR_WATCH_HARD_LINKS: events name the file itself */
+  else if (basename != NULL)
+    {
+      ps->path = g_build_filename (dirname, basename, NULL);
+      ps->child = g_strdup (basename);
+    }
+  else
+    {
+      ps->path = g_strdup (dirname);
+      ps->is_directory = TRUE;
+    }
+
+  /* The initial snapshot, taken now so that a change right after
+   * g_file_monitor_*() returns is reported. */
+  if (ps->is_directory)
+    {
+      ps->have_dir_st = poll_stat (ps->path, TRUE, &ps->dir_st);
+      ps->dir_st_since = g_get_monotonic_time ();
+      ps->entries = poll_read_dir (ps->path);
+      ps->exists = ps->entries != NULL;
+      if (ps->entries == NULL)
+        ps->entries = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+      else
+        poll_stat_all (ps);
+      ps->sweep_period = SWEEP_TICKS;
+      ps->sweep_in = poll_sweep_ticks (ps);
+    }
+  else
+    ps->exists = poll_file_stat (ps->path, &ps->self);
+
+  g_source_set_ready_time ((GSource *) ps, g_get_monotonic_time () + poll_interval (ps));
+  g_source_attach ((GSource *) ps, GLIB_PRIVATE_CALL (g_get_worker_context) ());
+  monitor->poller = (GSource *) ps;
+}
+
+static gboolean
+g_poll_local_file_monitor_cancel (GFileMonitor *file_monitor)
+{
+  GPollLocalFileMonitor *monitor = G_POLL_LOCAL_FILE_MONITOR (file_monitor);
+
+  if (monitor->poller != NULL)
+    {
+      g_source_destroy (monitor->poller);
+      g_clear_pointer (&monitor->poller, g_source_unref);
+    }
+
+  return TRUE;
+}
+
+static void
+g_poll_local_file_monitor_finalize (GObject *object)
+{
+  g_assert (G_POLL_LOCAL_FILE_MONITOR (object)->poller == NULL);
+
+  G_OBJECT_CLASS (g_poll_local_file_monitor_parent_class)->finalize (object);
+}
+
+static void
+g_poll_local_file_monitor_init (GPollLocalFileMonitor *monitor)
+{
+}
+
+static void
+g_poll_local_file_monitor_class_init (GPollLocalFileMonitorClass *klass)
+{
+  GObjectClass *gobject_class = G_OBJECT_CLASS (klass);
+  GFileMonitorClass *file_monitor_class = G_FILE_MONITOR_CLASS (klass);
+  GLocalFileMonitorClass *local_file_monitor_class = G_LOCAL_FILE_MONITOR_CLASS (klass);
+
+  local_file_monitor_class->is_supported = g_poll_local_file_monitor_is_supported;
+  local_file_monitor_class->start = g_poll_local_file_monitor_start;
+  /* The directory's own disappearance is reported by the poll (DELETED for
+   * the directory), so GLocalFileMonitor need not watch the mount table. */
+  local_file_monitor_class->mount_notify = TRUE;
+  file_monitor_class->cancel = g_poll_local_file_monitor_cancel;
+
+  gobject_class->finalize = g_poll_local_file_monitor_finalize;
+}
