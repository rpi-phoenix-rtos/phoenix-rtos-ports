+/*
+** The main loop healthcheck (see luaV_respondtoheartbeat below) relies on
+** the interpreter returning to the top of the 'for (;;)' loop after every
+** instruction. The computed-goto jump table dispatches directly from one
+** instruction to the next and never returns to the loop top, which would
+** make the heartbeat fire only once per luaV_execute entry. Force the plain
+** switch dispatch whenever healthchecking is enabled.
+*/
+#if defined(LUA_HEALTHCHECK_EVAL)
+#undef LUA_USE_JUMPTABLE
+#define LUA_USE_JUMPTABLE	0
+#endif
+
 
 
 /* limit for table tag-method chains (to avoid infinite loops) */
@@ -1148,6 +1161,16 @@
 #define vmbreak		break
 
 
+#ifdef LUA_HEALTHCHECK_EVAL
+static void luaV_respondtoheartbeat (lua_State *L) {
+  pthread_mutex_lock(&L->mutex);
+  L->alive = LUA_HEALTHCHECK_MAGIC;
+  L->react = 0;
+  pthread_mutex_unlock(&L->mutex);
+}
+#endif
+
+
 void luaV_execute (lua_State *L, CallInfo *ci) {
   LClosure *cl;
   TValue *k;
@@ -1169,6 +1192,11 @@
   /* main loop of interpreter */
   for (;;) {
     Instruction i;  /* instruction being executed */
+#ifdef LUA_HEALTHCHECK_EVAL
+    if (L->react) {
+      luaV_respondtoheartbeat(L);
+    }
+#endif
     vmfetch();
