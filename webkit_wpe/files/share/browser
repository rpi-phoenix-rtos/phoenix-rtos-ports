#!/bin/bash
#
# browser -- the web browser of the Phoenix-RTOS desktop (WPE WebKit: /usr/bin/wpe-browser).
#
#     /bin/bash /bin/browser [URL|FILE|WORDS]
#
# (the XFCE menu entry "Web Browser" runs the same; Phoenix execs no #! scripts, so psh and the
# .desktop entry name bash). In a window of the running Wayland session with the desktop
# defaults:
#   - no argument: the start page /usr/share/wpe-browser/start.html;
#   - an address without a scheme gets https:// (http:// for localhost and IP addresses); plain
#     words are a DuckDuckGo search;
#   - cookies (no third-party ones), local storage and HSTS in $HOME/.local/share/wpe-browser,
#     the HTTP disk cache in $HOME/.cache/wpe-browser ($HOME is /root on the Pi: the persistent
#     NFS or SD root, never the RAM /tmp);
#   - Skia's CPU raster, a 1280x960 window;
#   - frames to labwc as dma-bufs (wpe-browser --dmabuf): the web process renders into GPU
#     textures that labwc composites directly. Shared memory (BROWSER_DMABUF=0) adds a GPU
#     readback in the web process and two more copies of every frame (wl_shm, labwc's upload)
#     to each frame's round trip (a headless or non-linux-dmabuf display falls back to it).
# Keys: Ctrl+L the address, Alt+Left / Alt+Right back / forward, F5 reload, Esc stop,
# Alt+Home the start page, F11 fullscreen, Ctrl+Q quit. The toolbar (back, forward,
# reload/stop, home, the address) stays at the top of the window; WPE_BROWSER_TOOLBAR=auto shows
# it only with Ctrl+L or when the pointer touches the top edge.
#
# Environment: BROWSER_SIZE (WxH, default 1280x960), BROWSER_DMABUF=0 (shared-memory frames
# instead of dma-bufs), BROWSER_GPU=1 (Skia's GPU raster on the V3D instead of the CPU),
# BROWSER_FRAME_AHEAD=1 (the web process renders the next frame while labwc shows this one),
# BROWSER_WEBGL=1 (WebGL, in a build with the port's USE flag webgl) -- the last three off until
# their Pi gates pass -- and wpe-browser's own WPE_BROWSER_* test knobs (passed through). Outside
# the session (WAYLAND_DISPLAY unset) the first $XDG_RUNTIME_DIR/wayland-N socket (default
# /tmp/xdg) is used.
#
# Copyright 2026 Phoenix Systems
#
# This file is part of Phoenix-RTOS.
#
# %LICENSE%

export HOME=${HOME:-/root}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/xdg}
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
	for s in "${XDG_RUNTIME_DIR}"/wayland-[0-9]; do
		[ -e "${s}" ] && export WAYLAND_DISPLAY="${s##*/}" && break
	done
fi
args=(--size="${BROWSER_SIZE:-1280x960}")
[ "${BROWSER_GPU:-0}" = 1 ] || args+=(--cpu-rendering)
[ "${BROWSER_DMABUF:-1}" = 0 ] || args+=(--dmabuf)
[ "${BROWSER_FRAME_AHEAD:-0}" != 1 ] || args+=(--frame-ahead)
[ "${BROWSER_WEBGL:-0}" != 1 ] || args+=(--webgl)
exec /usr/bin/wpe-browser "${args[@]}" "$@"
