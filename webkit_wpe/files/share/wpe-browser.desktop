[Desktop Entry]
Type=Application
Name=Web Browser
GenericName=Web Browser
Comment=Browse the web (WPE WebKit)
Exec=/bin/bash /bin/browser %u
Icon=web-browser
Terminal=false
StartupNotify=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;internet;www;http;
