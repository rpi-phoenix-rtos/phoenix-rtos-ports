# CMake toolchain for aarch64-phoenix; @VAR@ placeholders are filled in by build.sh.
list(APPEND CMAKE_MODULE_PATH "@HERE@/cmake")
set(CMAKE_SYSTEM_NAME Phoenix)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER "@TC@-gcc")
set(CMAKE_CXX_COMPILER "@TC@-g++")
set(CMAKE_AR "@TC@-gcc-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "@TC@-gcc-ranlib" CACHE FILEPATH "")
set(CMAKE_NM "@TC@-gcc-nm" CACHE FILEPATH "")
set(CMAKE_STRIP "@TC@-strip" CACHE FILEPATH "")
set(CMAKE_OBJCOPY "@TC@-objcopy" CACHE FILEPATH "")
set(CMAKE_SYSROOT "@SYSROOT@")
set(CMAKE_C_FLAGS_INIT "@TFLAGS@")
set(CMAKE_CXX_FLAGS_INIT "@TFLAGS@")
set(CMAKE_FIND_ROOT_PATH "@ICU@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# The Phoenix gcc rejects -pthread; pthreads live in libphoenix (libc.a).
set(THREADS_PREFER_PTHREAD_FLAG OFF)
set(CMAKE_THREAD_LIBS_INIT "")
set(CMAKE_HAVE_THREADS_LIBRARY 1)
set(CMAKE_USE_PTHREADS_INIT 1)
set(Threads_FOUND TRUE)
