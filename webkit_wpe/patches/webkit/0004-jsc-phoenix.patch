Subject: JSC: Phoenix: Structure heap size, no concurrent GC by default, LLInt ELF glue

Anonymous mmap is populated at once on Phoenix (vm/map.c), so the Structure heap 'reservation' is
resident: 32 MiB instead of 4 GiB. Concurrent GC defaults off (no ucontext in signal handlers yet,
track B4; JSC_useConcurrentGC=true re-enables it). The asm LLInt uses the ELF GOT globaladdr form and
opcode debug labels as on Linux. No mincore() (all pages resident, as QNX) and no
dl_iterate_phdr() (bytecode-cache version falls back). ARM64Assembler::cacheFlush gets a Phoenix
case (unused with ENABLE_JIT=OFF; see the UCI note for a future JIT).

diff --git a/Source/JavaScriptCore/assembler/ARM64Assembler.h b/Source/JavaScriptCore/assembler/ARM64Assembler.h
index 6cf574e1..081edf7d 100644
--- a/Source/JavaScriptCore/assembler/ARM64Assembler.h
+++ b/Source/JavaScriptCore/assembler/ARM64Assembler.h
@@ -4043,6 +4043,11 @@ public:
         linuxPageFlush(current, end);
 #elif OS(WINDOWS)
         FlushInstructionCache(GetCurrentProcess(), code, size);
+#elif OS(PHOENIX)
+        // Built with ENABLE_JIT=OFF, so no code is ever written. For a JIT (browser B9) note that
+        // the Phoenix kernel runs EL0 with SCTLR_EL1.UCI=0 (hal/aarch64/_init.S), so the DC CVAU /
+        // IC IVAU that __builtin___clear_cache emits trap; it needs UCI=1 or a kernel cache call.
+        __builtin___clear_cache(static_cast<char*>(code), static_cast<char*>(code) + size);
 #else
 #error "The cacheFlush support is missing on this platform."
 #endif
diff --git a/Source/JavaScriptCore/heap/BlockDirectory.cpp b/Source/JavaScriptCore/heap/BlockDirectory.cpp
index c069adcb..e594ecad 100644
--- a/Source/JavaScriptCore/heap/BlockDirectory.cpp
+++ b/Source/JavaScriptCore/heap/BlockDirectory.cpp
@@ -68,8 +68,9 @@ void BlockDirectory::updatePercentageOfPagedOutPages(SimpleStats& stats)
 {
     // FIXME: We should figure out a solution for Windows and PlayStation.
     // QNX doesn't have mincore(), though the information can be had. But since all mapped
-    // pages are resident, does it matter?
-#if OS(UNIX) && !PLATFORM(PLAYSTATION) && !OS(QNX) && !OS(HAIKU)
+    // pages are resident, does it matter? Neither does Phoenix-RTOS (no swap; anonymous memory
+    // is resident from mmap).
+#if OS(UNIX) && !PLATFORM(PLAYSTATION) && !OS(QNX) && !OS(HAIKU) && !OS(PHOENIX)
     size_t pageSize = WTF::pageSize();
     ASSERT(!(MarkedBlock::blockSize % pageSize));
     auto numberOfPagesInMarkedBlock = MarkedBlock::blockSize / pageSize;
diff --git a/Source/JavaScriptCore/heap/StructureAlignedMemoryAllocator.cpp b/Source/JavaScriptCore/heap/StructureAlignedMemoryAllocator.cpp
index 1494c4a2..ac0de46d 100644
--- a/Source/JavaScriptCore/heap/StructureAlignedMemoryAllocator.cpp
+++ b/Source/JavaScriptCore/heap/StructureAlignedMemoryAllocator.cpp
@@ -263,6 +263,12 @@ size_t StructureMemoryManager::computePreferredStructureHeapReservationSize()
         size_t baseSize { 0 };
 #if PLATFORM(PLAYSTATION) || OS(QNX)
         baseSize = 128 * MB;
+#elif OS(PHOENIX)
+        // Phoenix maps anonymous memory eagerly (vm/map.c _vm_mmap), so this "reservation" is
+        // resident from the start and the aligned reservation briefly maps twice its size. Keep it
+        // small, but at least 64 MiB: mimalloc's arena (mi_manage_os_memory_ex) only uses whole
+        // 32 MiB chunks, and 32 MiB minus the first block leaves none (RELEASE_ASSERT at startup).
+        baseSize = 64 * MB;
 #elif (PLATFORM(IOS_FAMILY) && !CPU(ARM64E)) || PLATFORM(WATCHOS) || PLATFORM(APPLETV)
         baseSize = 512 * MB;
 #elif PLATFORM(IOS_FAMILY)
