-    
+
+#if OS(PHOENIX)
+// The wait trace (Phoenix-RTOS diagnostic; WPE_PHOENIX_WAIT_TRACE=1, or =<ms>). Every WTF wait --
+// ParkingLot's parks and through them Lock, Condition, BinarySemaphore and the IPC layer's waits
+// -- ends in ThreadCondition::wait() or timedWait(). With the variable set, each one that lasted
+// at least the threshold (500 ms for 1..9, otherwise the given milliseconds) says so when it
+// returns, on stderr, at most 16 lines a second (suppressed= counts the rest):
+//
+//   WPEB-WEBKIT wait-trace pid=P tid=T thread=NAME wait=timed|untimed result=timeout|woken
+//       waited_ms=W asked_ms=A suppressed=S ret=0x.. 0x.. ...
+//
+// A timed wait that ran to its timeout names a missed wake-up that the timeout covered; an
+// untimed one woken after a long time names a thread that sat idle (or blocked) that long. ret=
+// lists the return addresses found on the waiting thread's stack (words in the program's code
+// just after a BL/BLR: WebKit keeps no frame pointers), the nearest first; symbolise them with
+// addr2line -f -C -e <the unstripped wpe-browser>. Off (one getenv() at the first wait) costs
+// nothing else.
+extern "C" void _init(void) __attribute__((weak));
+extern "C" void _fini(void) __attribute__((weak));
+// StackBounds.cpp: the calling thread's stack (libphoenix has no pthread_getattr_np() of its own)
+extern "C" int pthread_getattr_np(pthread_t, pthread_attr_t*);
+
+static int64_t phoenixWaitTraceThresholdMs()
+{
+    static std::atomic<int64_t> threshold { -1 };
+    int64_t value = threshold.load(std::memory_order_relaxed);
+    if (value >= 0)
+        return value;
+    const char* env = getenv("WPE_PHOENIX_WAIT_TRACE");
+    long requested = env ? strtol(env, nullptr, 10) : 0;
+    value = requested <= 0 ? 0 : requested < 10 ? 500 : requested;
+    threshold.store(value, std::memory_order_relaxed);
+    return value;
+}
+
+static int64_t phoenixMonotonicMs()
+{
+    timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<int64_t>(now.tv_sec) * 1000 + now.tv_nsec / 1000000;
+}
+
+static bool phoenixIsReturnAddress(uintptr_t value)
+{
+    const uintptr_t codeStart = reinterpret_cast<uintptr_t>(&_init), codeEnd = reinterpret_cast<uintptr_t>(&_fini);
+    if (!codeStart || !codeEnd || value < codeStart + 4 || value >= codeEnd || (value & 3))
+        return false;
+    const uint32_t insn = *reinterpret_cast<const uint32_t*>(value - 4);
+    return (insn & 0xfc000000U) == 0x94000000U /* BL */ || (insn & 0xfffffc1fU) == 0xd63f0000U /* BLR */;
+}
+
+static NEVER_INLINE void phoenixWaitTraceEnd(int64_t startMs, int64_t thresholdMs, int64_t askedMs, bool timedOut)
+{
+    const int64_t nowMs = phoenixMonotonicMs();
+    const int64_t waitedMs = nowMs - startMs;
+    if (waitedMs < thresholdMs)
+        return;
+
+    static constexpr unsigned linesPerSecond = 16;
+    static std::atomic<int64_t> windowStartMs { 0 };
+    static std::atomic<unsigned> linesInWindow { 0 };
+    static std::atomic<unsigned> suppressed { 0 };
+    int64_t window = windowStartMs.load(std::memory_order_relaxed);
+    if (nowMs - window >= 1000 && windowStartMs.compare_exchange_strong(window, nowMs, std::memory_order_relaxed))
+        linesInWindow.store(0, std::memory_order_relaxed);
+    if (linesInWindow.fetch_add(1, std::memory_order_relaxed) >= linesPerSecond) {
+        suppressed.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+
+    char name[16];
+    if (pthread_getname_np(pthread_self(), name, sizeof(name)) || !name[0])
+        snprintf(name, sizeof(name), "-");
+
+    char line[640];
+    int length = snprintf(line, sizeof(line), "WPEB-WEBKIT wait-trace pid=%d tid=%d thread=%s wait=%s result=%s waited_ms=%lld asked_ms=%lld suppressed=%u ret=",
+        static_cast<int>(getpid()), static_cast<int>(gettid()), name, askedMs < 0 ? "untimed" : "timed", timedOut ? "timeout" : "woken",
+        static_cast<long long>(waitedMs), static_cast<long long>(askedMs), suppressed.exchange(0, std::memory_order_relaxed));
+
+    // The return addresses on this thread's stack, up to 16 KiB above here and never past its top
+    static constexpr unsigned maxReturns = 16;
+    static constexpr uintptr_t maxScan = 16 * 1024;
+    const uintptr_t here = reinterpret_cast<uintptr_t>(__builtin_frame_address(0)) & ~static_cast<uintptr_t>(7);
+    uintptr_t origin = 0;
+    pthread_attr_t attributes;
+    if (!pthread_getattr_np(pthread_self(), &attributes)) {
+        void* bound = nullptr;
+        size_t size = 0;
+        if (!pthread_attr_getstack(&attributes, &bound, &size) && bound)
+            origin = reinterpret_cast<uintptr_t>(bound) + size;
+        pthread_attr_destroy(&attributes);
+    }
+    const uintptr_t top = origin > here ? std::min(origin, here + maxScan) : here;
+    unsigned returns = 0;
+    for (uintptr_t at = here; at + sizeof(uint64_t) <= top && returns < maxReturns && length > 0 && length < static_cast<int>(sizeof(line)) - 24; at += sizeof(uint64_t)) {
+        const uintptr_t value = *reinterpret_cast<const uintptr_t*>(at);
+        if (!phoenixIsReturnAddress(value))
+            continue;
+        length += snprintf(line + length, sizeof(line) - length, "%s0x%lx", returns ? " " : "", static_cast<unsigned long>(value));
+        returns++;
+    }
+    if (length < 0)
+        return;
+    if (length > static_cast<int>(sizeof(line)) - 2)
+        length = sizeof(line) - 2;
+    line[length++] = '\n';
+    ssize_t written = write(STDERR_FILENO, line, length);
+    UNUSED_VARIABLE(written);
+}
+#endif
+
 void ThreadCondition::wait(Mutex& mutex)
 {
+#if OS(PHOENIX)
+    const int64_t traceMs = phoenixWaitTraceThresholdMs();
+    const int64_t startMs = traceMs ? phoenixMonotonicMs() : 0;
+#endif
     int result = pthread_cond_wait(&m_condition, &mutex.impl());
     ASSERT_UNUSED(result, !result);
+#if OS(PHOENIX)
+    if (traceMs)
+        phoenixWaitTraceEnd(startMs, traceMs, -1, false);
+#endif
 }
 
