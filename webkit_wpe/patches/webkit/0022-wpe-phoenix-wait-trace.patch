@@ -719,7 +856,12 @@ bool ThreadCondition::timedWait(Mutex& mutex, WallTime absoluteTime)
         targetTime.tv_sec++;
         targetTime.tv_nsec -= 1000000000;
     }
-    return !pthread_cond_clockwait(&m_condition, &mutex.impl(), CLOCK_MONOTONIC, &targetTime);
+    const int64_t traceMs = phoenixWaitTraceThresholdMs();
+    const int64_t startMs = traceMs ? phoenixMonotonicMs() : 0;
+    int result = pthread_cond_clockwait(&m_condition, &mutex.impl(), CLOCK_MONOTONIC, &targetTime);
+    if (traceMs)
+        phoenixWaitTraceEnd(startMs, traceMs, static_cast<int64_t>(remaining * 1000), result == ETIMEDOUT);
+    return !result;
 #else
     double rawSeconds = absoluteTime.secondsSinceEpoch().value();
 
