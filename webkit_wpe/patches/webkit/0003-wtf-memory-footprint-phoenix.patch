+#include "config.h"
+#include <wtf/MemoryFootprint.h>
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace WTF {
+
+// Phoenix-RTOS: the bytes of anonymous pages in this process's map entries, from the kernel's
+// meminfo() (what `psh mem <pid>` lists). Anonymous mappings are populated at mmap time there,
+// so this is close to the dirty resident footprint; shared program text is not counted.
+size_t memoryFootprint()
+{
+    int capacity = 64;
+    for (int attempt = 0; attempt < 4; ++attempt) {
+        auto* map = static_cast<entryinfo_t*>(malloc(sizeof(entryinfo_t) * capacity));
+        if (!map)
+            return 0;
+        meminfo_t info;
+        memset(&info, 0, sizeof(info));
+        info.page.mapsz = -1;
+        info.maps.mapsz = -1;
+        info.entry.kmapsz = -1;
+        info.entry.pid = static_cast<unsigned>(getpid());
+        info.entry.mapsz = capacity;
+        info.entry.map = map;
+        meminfo(&info);
+        if (info.entry.mapsz < 0) {
+            free(map);
+            return 0;
+        }
+        if (info.entry.mapsz <= capacity) {
+            size_t total = 0;
+            for (int i = 0; i < info.entry.mapsz; ++i) {
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+                // The kernel marks an entry with no anonymous pages as ~0U (vm/map.c), not 0.
+                if (map[i].anonsz != static_cast<size_t>(~0U) && map[i].anonsz != SIZE_MAX)
+                    total += map[i].anonsz;
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+            }
+            free(map);
+            return total;
+        }
+        capacity = info.entry.mapsz + 32;
+        free(map);
+    }
+    return 0;
+}
+
+} // namespace WTF
