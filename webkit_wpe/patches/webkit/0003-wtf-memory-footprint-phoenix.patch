+#pragma once
+
+#if OS(PHOENIX)
+
+#include <algorithm>
+#include <atomic>
+#include <wtf/MemoryFootprint.h>
+
+// The jsc shell's MemoryFootprint() / --dumpMemoryFootprint on Phoenix-RTOS. The kernel keeps no
+// peak, so `peak` is the largest footprint seen by now() since the last resetPeak().
+struct ProcessMemoryFootprint {
+    uint64_t current;
+    uint64_t peak;
+
+    static ProcessMemoryFootprint now()
+    {
+        uint64_t current = WTF::memoryFootprint();
+        uint64_t peak = peakStorage().load();
+        while (current > peak && !peakStorage().compare_exchange_weak(peak, current)) { }
+        return { current, std::max(peak, current) };
+    }
+
+    static void resetPeak()
+    {
+        peakStorage().store(0);
+    }
+
+private:
+    static std::atomic<uint64_t>& peakStorage()
+    {
+        static std::atomic<uint64_t> peak { 0 };
+        return peak;
+    }
+};
+
+#endif
