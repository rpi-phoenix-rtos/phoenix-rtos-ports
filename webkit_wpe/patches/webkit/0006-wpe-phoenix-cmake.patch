diff --git a/Source/WebKit/CMakeLists.txt b/Source/WebKit/CMakeLists.txt
index 85b2d74e..5c1d63de 100644
--- a/Source/WebKit/CMakeLists.txt
+++ b/Source/WebKit/CMakeLists.txt
@@ -785,6 +785,13 @@ endif ()
 set(WebProcess_LIBRARIES WebKit)
 set(NetworkProcess_LIBRARIES WebKit)
 set(GPUProcess_LIBRARIES WebKit)
+if (WebKit_LIBRARY_TYPE STREQUAL "STATIC")
+    # A static libWebKit does not carry the OBJECT/STATIC frameworks it is made of (only a
+    # shared one links them in), so its executables link them themselves.
+    set(WebProcess_FRAMEWORKS ${WebKit_FRAMEWORKS} WebKit)
+    set(NetworkProcess_FRAMEWORKS ${WebKit_FRAMEWORKS} WebKit)
+    set(GPUProcess_FRAMEWORKS ${WebKit_FRAMEWORKS} WebKit)
+endif ()
 
 # For platforms that want to use system-provided OpenGL (ES) / EGL headers,
 # these include directories, libraries or definitions need to be
@@ -835,17 +842,25 @@ if (NOT USE_HEADER_MAPS AND NOT USE_FRAMEWORK_BUNDLES)
     )
     set(WebKit_INTERFACE_DEPENDENCIES "")
 endif ()
-set(WebKit_INTERFACE_LINK_DEPENDS
-    $<TARGET_FILE:NetworkProcess>
-    $<TARGET_FILE:WebProcess>
-)
+if (NOT WebKit_LIBRARY_TYPE STREQUAL "STATIC")
+    set(WebKit_INTERFACE_LINK_DEPENDS
+        $<TARGET_FILE:NetworkProcess>
+        $<TARGET_FILE:WebProcess>
+    )
+else ()
+    # Static (Phoenix-RTOS): the auxiliary processes link libWebKit themselves (a cycle), and a
+    # multi-call program does not need them built at all.
+    set(WebKit_INTERFACE_LINK_DEPENDS "")
+endif ()
 
 WEBKIT_EXECUTABLE_DECLARE(WebProcess)
 WEBKIT_EXECUTABLE_DECLARE(NetworkProcess)
 
 if (ENABLE_GPU_PROCESS)
     WEBKIT_EXECUTABLE_DECLARE(GPUProcess)
-    list(APPEND WebKit_INTERFACE_LINK_DEPENDS $<TARGET_FILE:GPUProcess>)
+    if (NOT WebKit_LIBRARY_TYPE STREQUAL "STATIC")
+        list(APPEND WebKit_INTERFACE_LINK_DEPENDS $<TARGET_FILE:GPUProcess>)
+    endif ()
 endif ()
 
 set(WebKit_GENERATED_SERIALIZERS_SUFFIX cpp)
