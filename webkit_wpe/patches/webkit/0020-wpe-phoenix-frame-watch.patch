+int wpe_phoenix_frame_watch(int ui, int64_t limitMs, char* line, size_t size)
+{
+    using namespace WebKit::PhoenixFrameWatch;
+    static constexpr const char* stateNames[] = { "idle", "scheduled", "in-progress", "scheduled-while-in-progress", "invalidated" };
+    static constexpr const char* phaseNames[] = { "none", "will-render", "flush", "paint", "swap", "sync", "send" };
+    const int64_t now = nowMs();
+    // the age of a timestamp in ms, -1 when it was never set
+    auto age = [now](const std::atomic<int64_t>& at) -> long long {
+        const int64_t value = at.load(std::memory_order_relaxed);
+        return value ? static_cast<long long>(now - value) : -1;
+    };
+    auto load = [](const auto& value) {
+        return value.load(std::memory_order_relaxed);
+    };
+    auto exceeds = [limitMs](long long ms) {
+        return limitMs > 0 && ms > limitMs;
+    };
+
+    int kind = 0;
+    const char* kindName = "none";
+    if (ui) {
+        const auto& s = uiProcess;
+        if (exceeds(age(s.pendingMs))) {
+            kind = 7;
+            kindName = "ui-pending"; // a frame the UI received but has not handed to the view
+        } else if (exceeds(age(s.committedMs))) {
+            kind = 8;
+            kindName = "ui-callback"; // the view's buffer is with the compositor, no frame callback
+        }
+        snprintf(line, size, "frame-watch kind=%s backing-store received=%llu received_ms=%lld rendered=%llu render_failed=%llu"
+            " pending_ms=%lld committed_ms=%lld buffer_rendered=%llu released=%llu frame_done_sent=%llu"
+            " display-link ticks=%llu tick_ms=%lld fired=%llu observers=%u stops=%llu", kindName,
+            static_cast<unsigned long long>(load(s.framesReceived)), age(s.frameReceivedMs),
+            static_cast<unsigned long long>(load(s.framesRendered)), static_cast<unsigned long long>(load(s.renderFailed)),
+            age(s.pendingMs), age(s.committedMs), static_cast<unsigned long long>(load(s.buffersRendered)),
+            static_cast<unsigned long long>(load(s.buffersReleased)), static_cast<unsigned long long>(load(s.framesDoneSent)),
+            static_cast<unsigned long long>(load(s.displayLinkTicks)), age(s.displayLinkTickMs),
+            static_cast<unsigned long long>(load(s.displayLinkFired)), load(s.displayLinkObservers),
+            static_cast<unsigned long long>(load(s.displayLinkStops)));
+        return kind;
+    }
+
+    const auto& s = webProcess;
+    const unsigned state = load(s.state), phase = load(s.phase);
+    const bool inProgress = state == 2 || state == 3;
+    const bool suspended = load(s.suspended);
+    if (phase && exceeds(age(s.phaseMs))) {
+        kind = 1;
+        kindName = "render"; // the compositing thread has been inside one step of a frame
+    } else if (!suspended && load(s.waitingForTiles) && exceeds(age(s.waitingForTilesMs))) {
+        kind = 2;
+        kindName = "tiles"; // a rendering update waits for tiles still being painted
+    } else if (!suspended && inProgress && load(s.frameSentMs) > load(s.frameDoneMs) && exceeds(age(s.frameSentMs))) {
+        kind = 3;
+        kindName = "frame-done"; // the frame went to the UI process, which has not said it is done
+    } else if (!suspended && inProgress && exceeds(age(s.stateMs))) {
+        kind = 4;
+        kindName = "no-frame"; // a composition ended without sending a frame, so none can complete
+    } else if (!suspended && state == 1 && exceeds(age(s.stateMs))) {
