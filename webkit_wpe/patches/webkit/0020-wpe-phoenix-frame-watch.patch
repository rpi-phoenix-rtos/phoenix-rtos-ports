+        kindName = "renderer"; // the main thread waits for a composition that never reports back
+    }
+    snprintf(line, size, "frame-watch kind=%s compositor state=%s state_ms=%lld phase=%s phase_ms=%lld compositions=%llu"
+        " suspended=%u tiles_waiting=%d tiles_wait_ms=%lld tiles_pending=%d frames_sent=%llu frame_sent_ms=%lld"
+        " frames_done=%llu frame_done_ms=%lld released=%llu targets_locked=%u targets_free=%u no_target=%llu"
+        " updates=%llu update_ms=%lld waiting_for_renderer=%d renderer_wait_ms=%lld", kindName,
+        state < std::size(stateNames) ? stateNames[state] : "?", age(s.stateMs),
+        phase < std::size(phaseNames) ? phaseNames[phase] : "?", age(s.phaseMs),
+        static_cast<unsigned long long>(load(s.compositions)), load(s.suspended), load(s.waitingForTiles) ? 1 : 0,
+        load(s.waitingForTiles) ? age(s.waitingForTilesMs) : -1LL, load(s.tilesPending),
+        static_cast<unsigned long long>(load(s.framesSent)), age(s.frameSentMs),
+        static_cast<unsigned long long>(load(s.framesDone)), age(s.frameDoneMs),
+        static_cast<unsigned long long>(load(s.buffersReleased)), load(s.targetsLocked), load(s.targetsFree),
+        static_cast<unsigned long long>(load(s.noTarget)), static_cast<unsigned long long>(load(s.renderingUpdates)),
+        age(s.renderingUpdateMs), load(s.waitingForRenderer) ? 1 : 0,
+        load(s.waitingForRenderer) ? age(s.waitingForRendererMs) : -1LL);
+    return kind;
+}
