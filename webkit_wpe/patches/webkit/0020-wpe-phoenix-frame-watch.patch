+
+// Phoenix-RTOS: where the frame pipeline of this process stands, for the program's own watchdog
+// (the wpe-browser launcher). A page that stops drawing can be stuck in many places that leave
+// every main loop running: the compositing thread inside a frame, a rendering update waiting
+// for tiles or for the UI's frame-done, the UI waiting for the compositor's frame callback, or
+// no display refresh reaching requestAnimationFrame at all. Each place records its progress
+// here with relaxed atomic stores; wpe_phoenix_frame_watch() (ThreadedCompositor.cpp) reads
+// them without a lock, from another thread, as a stuck thread may hold any lock. The state is
+// per process, not per page: the browser runs one page per web process (wpe-browser, patch 0015).
+namespace WebKit::PhoenixFrameWatch {
+
+inline int64_t nowMs()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+// ThreadedCompositor::renderLayerTree(), in order
+enum class Phase : uint8_t { None, WillRender, Flush, Paint, Swap, Sync, Send };
+
+struct WebProcessState {
+    // ThreadedCompositor (compositing thread, and the main thread when it schedules)
+    std::atomic<uint8_t> state { 0 }; // ThreadedCompositor::State: Idle, Scheduled, InProgress, ScheduledWhileInProgress, Invalidated
+    std::atomic<int64_t> stateMs { 0 };
+    std::atomic<uint8_t> phase { 0 };
+    std::atomic<int64_t> phaseMs { 0 };
+    std::atomic<bool> waitingForTiles { false };
+    std::atomic<int64_t> waitingForTilesMs { 0 };
+    std::atomic<unsigned> suspended { 0 };
+    std::atomic<uint64_t> compositions { 0 };
+    std::atomic<uint64_t> framesDone { 0 };
+    std::atomic<int64_t> frameDoneMs { 0 };
+    // AcceleratedSurface
+    std::atomic<uint64_t> framesSent { 0 };
+    std::atomic<int64_t> frameSentMs { 0 };
+    std::atomic<uint64_t> buffersReleased { 0 };
+    std::atomic<uint64_t> noTarget { 0 };
+    std::atomic<unsigned> targetsLocked { 0 };
+    std::atomic<unsigned> targetsFree { 0 };
+    // CoordinatedSceneState: tiles painted asynchronously (Skia painting threads)
+    std::atomic<int> tilesPending { 0 };
+    // LayerTreeHost (main thread): rendering updates, rAF callbacks included
+    std::atomic<uint64_t> renderingUpdates { 0 };
+    std::atomic<int64_t> renderingUpdateMs { 0 };
+    std::atomic<bool> waitingForRenderer { false };
+    std::atomic<int64_t> waitingForRendererMs { 0 };
+};
+
+struct UIProcessState {
+    // AcceleratedBackingStore: frames from the web process to the WPEView
+    std::atomic<uint64_t> framesReceived { 0 };
+    std::atomic<int64_t> frameReceivedMs { 0 };
+    std::atomic<uint64_t> framesRendered { 0 };
+    std::atomic<uint64_t> renderFailed { 0 };
+    std::atomic<int64_t> pendingMs { 0 }; // a received frame not yet handed to the view (rendering fence, no toplevel); 0: none
+    std::atomic<int64_t> committedMs { 0 }; // handed to the view, its frame callback outstanding; 0: none
+    std::atomic<uint64_t> buffersRendered { 0 };
+    std::atomic<uint64_t> buffersReleased { 0 };
+    std::atomic<uint64_t> framesDoneSent { 0 };
+    // DisplayLink: the display refresh that drives requestAnimationFrame in web processes
+    std::atomic<uint64_t> displayLinkTicks { 0 };
+    std::atomic<int64_t> displayLinkTickMs { 0 };
+    std::atomic<uint64_t> displayLinkFired { 0 }; // ticks sent to a web process
+    std::atomic<unsigned> displayLinkObservers { 0 };
+    std::atomic<uint64_t> displayLinkStops { 0 };
+};
+
+inline WebProcessState webProcess;
+inline UIProcessState uiProcess;
+
+inline void mark(std::atomic<int64_t>& at)
+{
+    at.store(nowMs(), std::memory_order_relaxed);
+}
+
+inline void count(std::atomic<uint64_t>& counter, std::atomic<int64_t>* at = nullptr)
+{
+    counter.fetch_add(1, std::memory_order_relaxed);
+    if (at)
+        mark(*at);
+}
+
+inline void setPhase(Phase phase)
+{
+    webProcess.phase.store(static_cast<uint8_t>(phase), std::memory_order_relaxed);
+    mark(webProcess.phaseMs);
+}
+
+// Phase::None again when renderLayerTree() returns, by any path
+struct PhaseScope {
+    ~PhaseScope() { setPhase(Phase::None); }
+};
+
+} // namespace WebKit::PhoenixFrameWatch
+
+// The watchdog's view (wpe-browser): one line describing this process's frame pipeline into
+// `line`, and the kind of stall it is in when one of its waits has lasted longer than limitMs
+// (0: none). Every web and UI process has both halves; `ui` selects which one is described.
+extern "C" int wpe_phoenix_frame_watch(int ui, int64_t limitMs, char* line, size_t size);
+
+#endif // OS(PHOENIX)
