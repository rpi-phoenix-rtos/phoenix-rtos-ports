 } // namespace WebKit
 
-#endif // OS(LINUX)
+#elif OS(PHOENIX)
+
+#include "WebProcessPool.h"
+#include <algorithm>
+#include <mutex>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wtf/MemoryPressureHandler.h>
+#include <wtf/Threading.h>
+
+namespace WebKit {
+
+// Phoenix-RTOS has no /proc/meminfo and no cgroups. The system's free memory comes from the
+// kernel's page allocator through meminfo(), the counters libphoenix's sysconf(_SC_AVPHYS_PAGES)
+// and the panel's memory plugin read. The free count includes the kernel's cache of unreferenced
+// file objects, which the allocator gives up on demand, so it is the memory that can still be
+// allocated (the largest contiguous block may be much smaller; meminfo() does not report it).
+//
+// Each poll compares the free memory with two levels. Below one, every web and network process
+// gets a memory pressure event (AuxiliaryProcess::didReceiveMemoryPressureEvent) and the UI
+// process runs its own handler:
+//   warning   free below 20 % of RAM                     a non-critical event
+//   critical  free below 10 % of RAM or below 300 MB     a critical event
+// A web process releases its caches (WebCore's memory and back/forward caches, decoded images,
+// fonts, a JavaScriptCore collection); the UI process empties its back/forward and web process
+// caches, shuts prewarmed web processes down and drops view snapshots. Each process's handler
+// then holds further events off for 5 to 30 s (wtf/unix/MemoryPressureHandlerUnix.cpp).
+//
+// Released heap stays in the process: mimalloc does not decommit on Phoenix (patch 0005), so an
+// event stops the growth by letting the caches' memory be reused. Only a process that exits (a
+// prewarmed or cached web process shut down here) returns memory to the system.
+//
+// The build has no release logging: each level change is printed on stderr, next to patch
+// 0024's lines,
+//   WPEB-MEMPRESSURE pid=P system level=normal|warning|critical free_mb=F total_mb=T
+
+static const Seconds s_minPollingInterval { 1_s };
+static const Seconds s_maxPollingInterval { 5_s };
+static const double s_minUsedMemoryPercentageForPolling = 50;
+static const double s_maxUsedMemoryPercentageForPolling = 85;
+static const uint64_t s_warningFreePercentage = 20;
+static const uint64_t s_criticalFreePercentage = 10;
+static const uint64_t s_criticalFreeBytes = 300 * MB;
+
+enum class SystemMemoryLevel : uint8_t {
+    Normal,
+    Warning,
+    Critical,
+};
+
+struct SystemMemory {
+    uint64_t total { 0 };
+    uint64_t free { 0 };
+};
+
+static std::optional<SystemMemory> systemMemory()
+{
+    meminfo_t info;
+    memset(&info, 0, sizeof(info));
+    // the counters only, not the page, map entry or memory map tables
+    info.page.mapsz = -1;
+    info.entry.mapsz = -1;
+    info.entry.kmapsz = -1;
+    info.maps.mapsz = -1;
+    meminfo(&info);
+
+    // The kernel always sets page.sz (sizeof(page_t)): zero means the call did nothing. The byte
+    // counts are unsigned int, so they wrap above 4 GiB of RAM (a 4 GB Pi 4 manages 3.8 GiB).
+    if (!info.page.sz)
+        return std::nullopt;
+    SystemMemory memory;
+    memory.free = info.page.free;
+    memory.total = memory.free + info.page.alloc;
+    if (!memory.total)
+        return std::nullopt;
+    return memory;
+}
+
+static SystemMemoryLevel systemMemoryLevel(const SystemMemory& memory)
+{
+    if (memory.free < std::max(memory.total * s_criticalFreePercentage / 100, s_criticalFreeBytes))
+        return SystemMemoryLevel::Critical;
+    if (memory.free < memory.total * s_warningFreePercentage / 100)
+        return SystemMemoryLevel::Warning;
+    return SystemMemoryLevel::Normal;
+}
+
+static const char* systemMemoryLevelName(SystemMemoryLevel level)
+{
+    switch (level) {
+    case SystemMemoryLevel::Normal:
+        return "normal";
+    case SystemMemoryLevel::Warning:
+        return "warning";
+    case SystemMemoryLevel::Critical:
+        return "critical";
+    }
+    return "?";
+}
+
+static inline Seconds pollIntervalForUsedMemoryPercentage(double usedPercentage)
+{
+    // as on Linux: poll less often while most of the memory is free
+    if (usedPercentage < s_minUsedMemoryPercentageForPolling)
+        return s_maxPollingInterval;
+
+    if (usedPercentage >= s_maxUsedMemoryPercentageForPolling)
+        return s_minPollingInterval;
+
+    return s_minPollingInterval + (s_maxPollingInterval - s_minPollingInterval) *
+        ((s_maxUsedMemoryPercentageForPolling - usedPercentage) / (s_maxUsedMemoryPercentageForPolling - s_minUsedMemoryPercentageForPolling));
+}
+
+MemoryPressureMonitor& MemoryPressureMonitor::singleton()
+{
+    static NeverDestroyed<MemoryPressureMonitor> memoryMonitor;
+    return memoryMonitor;
+}
+
+void MemoryPressureMonitor::start()
+{
+    if (m_started)
+        return;
+
+    m_started = true;
+
+    Thread::create("MemoryPressureMonitor"_s, [] {
+        Seconds pollInterval = s_maxPollingInterval;
+        SystemMemoryLevel lastLevel = SystemMemoryLevel::Normal;
+        bool reportedFailure = false;
+        while (true) {
+            sleep(pollInterval);
+
+            auto memory = systemMemory();
+            if (!memory) {
+                if (!reportedFailure)
+                    WTFLogAlways("Failed to get the memory usage");
+                reportedFailure = true;
+                pollInterval = s_maxPollingInterval;
+                continue;
+            }
+
+            SystemMemoryLevel level = systemMemoryLevel(*memory);
+            if (level != lastLevel) {
+                fprintf(stderr, "WPEB-MEMPRESSURE pid=%d system level=%s free_mb=%llu total_mb=%llu\n", static_cast<int>(getpid()),
+                    systemMemoryLevelName(level), static_cast<unsigned long long>(memory->free / MB), static_cast<unsigned long long>(memory->total / MB));
+                lastLevel = level;
+            }
+
+            if (level != SystemMemoryLevel::Normal) {
+                bool isCritical = level == SystemMemoryLevel::Critical;
+                RunLoop::mainSingleton().dispatch([isCritical] {
+                    MemoryPressureHandler::singleton().triggerMemoryPressureEvent(isCritical);
+                    for (auto& processPool : WebProcessPool::allProcessPools())
+                        processPool->sendMemoryPressureEvent(isCritical);
+                });
+            }
+
+            double usedPercentage = 100.0 * static_cast<double>(memory->total - memory->free) / static_cast<double>(memory->total);
+            pollInterval = pollIntervalForUsedMemoryPercentage(usedPercentage);
+        }
+    })->detach();
+}
+
+bool MemoryPressureMonitor::s_disabled = false;
+
+bool MemoryPressureMonitor::disabled()
+{
+    static std::once_flag flag;
+    std::call_once(flag, []() {
+        auto envvar = getenv("WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR");
+        s_disabled = envvar && !strcmp(envvar, "1");
+    });
+    return s_disabled;
+}
+
+} // namespace WebKit
+
+#endif // OS(LINUX) && !OS(ANDROID), OS(PHOENIX)
