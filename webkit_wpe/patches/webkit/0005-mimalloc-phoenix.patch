Subject: bmalloc/mimalloc: Phoenix prim; mimalloc overrides malloc on Phoenix

Phoenix has no virtual reserve (anonymous mmap is resident at once), no overcommit, no madvise,
and mprotect cannot add a permission the mapping lacked at mmap time: map everything read-write,
make commit/decommit/reset no-ops, report a 39-bit user address space, quarter-size (32 MiB)
arenas. No getrandom (weak seed), short struct rusage. In WebKit's mimalloc wrapper, Phoenix builds
override malloc/free/new with mimalloc (libphoenix's allocator takes a kernel mutex per call once a
process has threads) and do not use -march=armv8.1-a (Cortex-A72 is ARMv8.0).

diff --git a/Source/bmalloc/mimalloc/CMakeLists.txt b/Source/bmalloc/mimalloc/CMakeLists.txt
index 76b86ba4..75d27eb6 100644
--- a/Source/bmalloc/mimalloc/CMakeLists.txt
+++ b/Source/bmalloc/mimalloc/CMakeLists.txt
@@ -1,4 +1,13 @@
-set(MI_OVERRIDE OFF CACHE BOOL "Disable mimalloc override" FORCE)
+if (CMAKE_SYSTEM_NAME STREQUAL "Phoenix")
+    # Phoenix-RTOS (static binaries only): mimalloc also replaces the process's malloc/free and
+    # operator new/delete, so ICU and libstdc++ allocations skip libphoenix's allocator, which
+    # takes a kernel mutex on every call once a process has threads (browser PLAN decision 4).
+    set(MI_OVERRIDE ON CACHE BOOL "Override malloc (Phoenix)" FORCE)
+    # Cortex-A72 is ARMv8.0: no -march=armv8.1-a (LSE atomics).
+    set(MI_NO_OPT_ARCH ON CACHE BOOL "No armv8.1-a (Phoenix, Cortex-A72)" FORCE)
+else ()
+    set(MI_OVERRIDE OFF CACHE BOOL "Disable mimalloc override" FORCE)
+endif ()
 set(MI_OSX_INTERPOSE OFF CACHE BOOL "Disable macOS malloc zone interpose" FORCE)
 set(MI_OSX_ZONE ON CACHE BOOL "Disable macOS malloc zone" FORCE)
 set(MI_BUILD_SHARED OFF CACHE BOOL "Build mimalloc shared library" FORCE)
@@ -9,6 +18,11 @@ set(MI_BUILD_TESTS OFF CACHE BOOL "Build mimalloc tests" FORCE)
 WEBKIT_INCLUDE_CONFIG_FILES_IF_EXISTS()
 
 add_subdirectory(mimalloc)
+if (CMAKE_SYSTEM_NAME STREQUAL "Phoenix")
+    # Anonymous memory is resident from mmap on Phoenix (no virtual reserve): reserve arenas of
+    # 128 MiB, which mimalloc quarters to 32 MiB without a virtual reserve, instead of 1 GiB.
+    target_compile_definitions(mimalloc-obj PRIVATE "MI_DEFAULT_ARENA_RESERVE=(128L*1024L)")
+endif ()
 WEBKIT_ADD_TARGET_CXX_FLAGS(mimalloc-obj
     -Wno-undef
     -Wno-cast-align)
