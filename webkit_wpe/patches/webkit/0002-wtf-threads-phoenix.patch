@@ -93,6 +101,26 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
     return StackBounds { origin, bound };
 }
 
+#elif OS(PHOENIX)
+
+// Phoenix can only report the stack of the calling thread (each stack is one anonymous map
+// entry; see the compat pthread_getattr_np), hence no HAVE(STACK_BOUNDS_FOR_NEW_THREAD).
+StackBounds StackBounds::currentThreadStackBoundsInternal()
+{
+    void* bound = nullptr;
+    size_t stackSize = 0;
+    pthread_attr_t sattr;
+    int rc = pthread_getattr_np(pthread_self(), &sattr);
+    RELEASE_ASSERT(!rc, rc);
+    rc = pthread_attr_getstack(&sattr, &bound, &stackSize);
+    RELEASE_ASSERT(!rc && bound && stackSize, rc);
+    pthread_attr_destroy(&sattr);
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    void* origin = static_cast<char*>(bound) + stackSize;
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+    return StackBounds { origin, bound };
+}
+
 #elif OS(UNIX) || OS(HAIKU)
 
 #if OS(OPENBSD)
