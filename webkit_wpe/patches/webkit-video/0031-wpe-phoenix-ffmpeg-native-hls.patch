+// WPE_PHOENIX_HLS_*: the variant policy, read once per process
+static const FFmpegMediaPolicy::Policy& hlsPolicy()
+{
+    static const FFmpegMediaPolicy::Policy policy = [] {
+        FFmpegMediaPolicy::Policy policy;
+        auto size = [](const char* name, unsigned& width, unsigned& height) {
+            const char* value = getenv(name);
+            unsigned w, h;
+            if (value && sscanf(value, "%ux%u", &w, &h) == 2 && w && h) {
+                width = w;
+                height = h;
+            }
+        };
+        size("WPE_PHOENIX_HLS_HEVC_MAX", policy.hevcMaxWidth, policy.hevcMaxHeight);
+        size("WPE_PHOENIX_HLS_H264_MAX", policy.h264MaxWidth, policy.h264MaxHeight);
+        if (const char* fps = getenv("WPE_PHOENIX_HLS_HEVC_MAX_FPS"); fps && atof(fps) > 0)
+            policy.hevcMaxFps = atof(fps);
+        if (const char* variant = getenv("WPE_PHOENIX_HLS_VARIANT"); variant && *variant)
+            policy.forcedVariant = atoi(variant);
+        if (const char* mode = getenv("WPE_PHOENIX_HLS_POLICY")) {
+            if (!strcmp(mode, "lowest"))
+                policy.mode = FFmpegMediaPolicy::Policy::Mode::Lowest;
+            else if (!strcmp(mode, "highest"))
+                policy.mode = FFmpegMediaPolicy::Policy::Mode::Highest;
+        }
+        return policy;
+    }();
+    return policy;
+}
+
+static std::string resolveAgainst(const std::string& uri, void* context)
+{
+    URL resolved { *static_cast<const URL*>(context), String::fromUTF8(uri.c_str()) };
+    if (!resolved.isValid())
+        return { };
+    CString utf8 = resolved.string().utf8();
+    return std::string { utf8.data(), utf8.length() };
+}
+
+static String fromStd(const std::string& string)
+{
+    return String::fromUTF8(std::span { string.data(), string.size() });
+}
+
+static bool parseHex16(const char* hex, uint8_t out[16])
+{
+    if (!hex || strlen(hex) != 32)
+        return false;
+    for (int i = 0; i < 16; ++i) {
+        unsigned byte;
+        if (sscanf(hex + 2 * i, "%2x", &byte) != 1)
+            return false;
+        out[i] = static_cast<uint8_t>(byte);
+    }
+    return true;
+}
+
+static bool isPlaylistPath(const URL& url)
+{
+    auto path = url.path();
+    return path.endsWithIgnoringASCIICase(".m3u8"_s) || path.endsWithIgnoringASCIICase(".m3u"_s);
+}
