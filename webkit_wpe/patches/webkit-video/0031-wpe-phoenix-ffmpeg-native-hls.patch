+// a playlist is read whole, up to this
+static constexpr uint64_t kPlaylistMax = 1024 * 1024;
+static constexpr uint64_t kKeyMaxAhead = 64 * 1024;
+static constexpr int kIOBufferSize = 64 * 1024;
+static constexpr int kMemoryIOBufferSize = 4096;
+// the demuxer's stream probe (startup latency: the variant fixes the streams already)
+static constexpr int64_t kProbeBytes = 2 * 1024 * 1024;
+static constexpr int64_t kAnalyzeMicroseconds = 3 * 1000 * 1000;
+// a live playlist reloaded this many times without a new segment ends the stream (hls.c's
+// default, 3, ends a live stream on a server a reload late)
