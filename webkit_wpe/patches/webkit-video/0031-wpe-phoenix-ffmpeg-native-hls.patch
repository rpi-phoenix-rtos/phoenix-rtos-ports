+/* --- HLS (the demux thread) ----------------------------------------------------------------- */
+
+int MediaPlayerPrivateFFmpeg::interruptCallback(void* opaque)
+{
+    return static_cast<MediaPlayerPrivateFFmpeg*>(opaque)->m_quit.load();
+}
+
+// The top-level playlist from the element's own stream, then the session's choice of a variant
+// and the hls demuxer over it.
+bool MediaPlayerPrivateFFmpeg::openHLS()
+{
+    AVIOContext* avio = m_stream->avioContext();
+    if (!avio)
+        return false;
+    Vector<uint8_t> playlist;
+    while (!m_quit) {
+        uint8_t chunk[16 * 1024];
+        int n = avio_read(avio, chunk, sizeof(chunk));
+        if (n == AVERROR_EOF || !n)
+            break;
+        if (n < 0) {
+            log("error hls-playlist read rc=%d (%s)", n, av_err2str(n));
+            return false;
+        }
+        if (playlist.size() + n > kPlaylistMax) {
+            log("error hls-playlist larger than %zu bytes", kPlaylistMax);
+            return false;
+        }
+        playlist.append(std::span<const uint8_t> { chunk, static_cast<size_t>(n) });
+    }
+    URL responseURL = m_stream->responseURL();
+    // all of it is here: the request is done with
+    m_stream->cancel();
+    if (m_quit || !m_hls->prepare(playlist.span(), responseURL))
+        return false;
+    return openHLSContainer();
+}
+
+bool MediaPlayerPrivateFFmpeg::openHLSContainer()
+{
+    m_format = m_hls->open(interruptCallback, this);
+    if (!m_format || m_quit)
+        return false;
+    // the stream probe decodes a picture when the demuxer did not say enough: on the CPU, so that
+    // a player that may never play does not take the rpivid block (one owner system-wide)
+    unsigned count = m_format->nb_streams;
+    Vector<AVDictionary*> options;
+    options.fill(nullptr, count);
+    for (auto& option : options)
+        av_dict_set(&option, "rpivid", "0", 0);
+    int ret = avformat_find_stream_info(m_format, count ? options.mutableSpan().data() : nullptr);
+    for (auto& option : options)
+        av_dict_free(&option);
+    if (m_quit)
+        return false;
+    m_containerDuration = m_format->duration != AV_NOPTS_VALUE ? m_format->duration / static_cast<double>(AV_TIME_BASE) : 0;
+    m_videoStream = av_find_best_stream(m_format, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+    m_audioStream = av_find_best_stream(m_format, AVMEDIA_TYPE_AUDIO, -1, m_videoStream, nullptr, 0);
+    // the demuxer stops fetching a playlist none of whose streams is wanted
+    for (unsigned i = 0; i < m_format->nb_streams; ++i) {
+        if (static_cast<int>(i) != m_videoStream && static_cast<int>(i) != m_audioStream)
+            m_format->streams[i]->discard = AVDISCARD_ALL;
+    }
+    log("hls opened streams=%u video=%d audio=%d probe-rc=%d live=%d duration=%.2f", m_format->nb_streams, m_videoStream, m_audioStream, ret,
+        m_hls->isLive(), m_containerDuration);
+    return m_videoStream >= 0 || m_audioStream >= 0;
+}
+
+// While parked (never played), the container's streams are closed below preload="auto"
+void MediaPlayerPrivateFFmpeg::closeHLSContainer()
+{
+    if (!m_format)
+        return;
+    m_format->pb = nullptr;
+    avformat_close_input(&m_format);
+    m_hls->closed();
+    m_videoStream = m_audioStream = -1;
+}
+
+// After the metadata: an HLS player waits for play() before it opens its decoders. False: quit
+// or the container could not be opened again.
+bool MediaPlayerPrivateFFmpeg::waitForPlay()
+{
+    if (m_playRequested)
+        return true;
+    bool close = !m_preloadAuto;
+    if (close)
+        closeHLSContainer();
+    m_hlsIdle = true;
+    log("hls idle container=%s (decoders open at play)", close ? "closed" : "open");
+    callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, close] {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->didIdleHLS(close);
+    });
+    while (!m_quit && !m_playRequested)
+        usleep(20000);
+    m_hlsIdle = false;
+    if (m_quit)
+        return false;
+    if (close) {
+        callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }] {
+            if (RefPtr protectedThis = weakThis.get())
+                protectedThis->setNetworkState(MediaPlayer::NetworkState::Loading);
+        });
+        if (!openHLSContainer()) {
+            if (!m_quit) {
+                callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }] {
+                    if (RefPtr protectedThis = weakThis.get())
+                        protectedThis->didFail(MediaPlayer::NetworkState::NetworkError);
+                });
+            }
+            return false;
+        }
+    }
+    return true;
+}
