+// the caps), the caps apply to either orientation.
+Capability videoCapability(CodecKind, unsigned width, unsigned height, double fps);
+Capability audioCapability(CodecKind);
+
+/* --- playlists ---------------------------------------------------------------------------- */
+
+struct Attribute {
+    std::string name;
+    std::string value;
+    bool quoted { false };
+};
+using Attributes = std::vector<Attribute>;
+
+// an attribute list (RFC 8216 §4.2): NAME=value,NAME="quoted, value"
+Attributes parseAttributes(std::string_view);
+const std::string* findAttribute(const Attributes&, std::string_view name);
+
+struct Variant {
+    Attributes attributes;
+    std::string uri;
+    uint64_t bandwidth { 0 };
+    unsigned width { 0 };
+    unsigned height { 0 };
+    double fps { 0 };
+    std::string codecs;
+    std::string audioGroup;
+    std::string videoRange;
+};
+
+struct Rendition {
+    Attributes attributes;
+    std::string type;
+    std::string groupID;
+    std::string name;
+    std::string uri;
+    std::string codecs;
+    bool isDefault { false };
+    bool autoselect { false };
+};
+
+struct Playlist {
+    // #EXTINF / #EXT-X-TARGETDURATION seen: a media playlist (nothing to choose)
+    bool isMediaPlaylist { false };
+    bool valid { false }; // starts with #EXTM3U
+    std::vector<Variant> variants;
+    std::vector<Rendition> renditions;
+    // master tags that apply to the whole presentation, copied into the synthesized master
+    std::vector<std::string> sessionTags;
+    // #EXT-X-SESSION-KEY METHOD (empty: none)
+    std::string sessionKeyMethod;
+};
+
+Playlist parsePlaylist(std::string_view);
+
+struct MediaPlaylistInfo {
+    unsigned segments { 0 };
+    double totalDuration { 0 };
+    double targetDuration { 0 };
+    int64_t mediaSequence { 0 };
+    unsigned discontinuities { 0 };
+    bool ended { false };        // #EXT-X-ENDLIST or PLAYLIST-TYPE:VOD
+    bool byteRanges { false };
+    bool initSection { false };  // #EXT-X-MAP
+    bool aes128 { false };
+    // an encryption the player cannot decrypt (SAMPLE-AES, a DRM key format): "METHOD[/KEYFORMAT]"
+    std::string refusedKey;
+    std::vector<std::string> keyURIs;
+    std::vector<std::string> initURIs;
+};
+
+MediaPlaylistInfo parseMediaPlaylist(std::string_view);
+
+struct Policy {
+    unsigned hevcMaxWidth { 1920 };
+    unsigned hevcMaxHeight { 1080 };
+    double hevcMaxFps { 30 };
+    unsigned h264MaxWidth { 1280 };
+    unsigned h264MaxHeight { 720 };
+    double h264MaxFps { 30 };
+    // variants without RESOLUTION (and so without a size to cap): the highest BANDWIDTH up to this
+    uint64_t unknownSizeMaxBandwidth { 3000000 };
+    enum class Mode : uint8_t { Default, Lowest, Highest };
+    Mode mode { Mode::Default };
+    int forcedVariant { -1 };
+};
+
+enum class VariantClass : uint8_t { None, Fallback, Audio, HEVCMain10, H264, HEVCMain };
+const char* variantClassName(VariantClass);
+
+struct VariantVerdict {
+    VariantClass eligibleAs { VariantClass::None };
+    CodecKind video { CodecKind::Unknown };
+    CodecKind audio { CodecKind::Unknown };
+    bool decodable { false };
+    std::string reason;
+};
+
+struct Choice {
+    int variant { -1 };
+    // hevc8 | h264 | main10 | audio | fallback | lowest | highest | forced | none
+    std::string rule;
+    int audioRendition { -1 };
+    std::vector<VariantVerdict> verdicts;
+};
+
+Choice chooseVariant(const Playlist&, const Policy&);
+
+using Resolver = std::string (*)(const std::string& uri, void* context);
+
+// The master FFmpeg's hls demuxer gets: the session tags, the chosen variant's audio rendition
+// and the variant (without SUBTITLES / VIDEO groups), every URI through `resolve`.
+std::string synthesizeMaster(const Playlist&, const Choice&, Resolver, void* context);
+
+// A media playlist with every URI (segment lines, URI="..." attributes) through `resolve`, and
+// without a byte order mark.
+std::string resolveMediaPlaylist(std::string_view, Resolver, void* context);
+
+} // namespace FFmpegMediaPolicy
+} // namespace WebCore
