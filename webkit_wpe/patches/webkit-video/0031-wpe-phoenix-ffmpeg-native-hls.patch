+
+// An HLS player waits for play() with its metadata: it can play (autoplay starts on
+// HaveEnoughData); a closed container is a suspended load
+void MediaPlayerPrivateFFmpeg::didIdleHLS(bool closed)
+{
+    if (m_readyState < MediaPlayer::ReadyState::HaveEnoughData)
+        setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
+    if (closed)
+        setNetworkState(MediaPlayer::NetworkState::Idle);
+}
+
+void MediaPlayerPrivateFFmpeg::didRebuffer(bool started)
+{
+    if (started) {
+        if (m_readyState > MediaPlayer::ReadyState::HaveCurrentData)
+            setReadyState(MediaPlayer::ReadyState::HaveCurrentData);
+    } else
+        setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
