+#include <wtf/HashSet.h>
+#include <wtf/Lock.h>
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/URL.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+struct AVDictionary;
+struct AVFormatContext;
+struct AVIOContext;
+
+namespace WebCore {
+
+class FFmpegMediaStream;
+class PlatformMediaResourceLoader;
+
+// Native HLS for MediaPlayerPrivateFFmpeg (<video src=*.m3u8>, the way Safari plays HLS):
+// FFmpeg's hls demuxer parses the playlists and demuxes the segments, but never touches the
+// network. Every URL it opens -- media playlists (also each live reload), init sections,
+// segments, AES keys -- comes back to this session through the context's io_open and becomes
+// an FFmpegMediaStream, i.e. a request of WebKit's media resource loader: cookies, TLS, CORS
+// and the HTTP cache stay the browser's (FFmpeg is built with --disable-network; the
+// video_player port's hls.c hunk lets it name http(s) URLs under custom I/O).
+//
+// The variant is ours to choose (FFmpegMediaPolicy: HEVC 8-bit up to 1080p30 for the rpivid
+// block, else H.264 up to 720p30, else HEVC Main10): the demuxer gets a master with that one
+// variant and its audio rendition, so it fetches nothing else (given the real master it would
+// open and probe every rendition). Media playlists are read whole (1 MiB at most), their URIs
+// made absolute against the response URL (redirects), refused when encrypted with anything but
+// AES-128 (SAMPLE-AES and DRM key formats), and handed to the demuxer from memory; AES-128
+// segments ("crypto+" URLs) are decrypted here (AES-CBC, PKCS#7). Segment streams share the
+// player's read-ahead budget.
+class FFmpegHLSSession final : public ThreadSafeRefCounted<FFmpegHLSSession> {
+public:
+    // Main thread. `url`: the media element's URL (the top-level playlist).
+    static Ref<FFmpegHLSSession> create(unsigned playerID, const URL&, RefPtr<PlatformMediaResourceLoader>&&, uint64_t maxAhead);
+    ~FFmpegHLSSession();
+
+    // The demux thread: the top-level playlist's bytes and the URL they came from -> the
+    // variant choice and the text the demuxer will read. False: nothing to play (logged).
+    bool prepare(std::span<const uint8_t> playlist, const URL& responseURL);
+
+    // The demux thread: the hls demuxer opened on a new context whose I/O is this session's;
+    // nullptr on a failure (logged). `interrupt(opaque)` aborts a blocked open or live reload.
+    AVFormatContext* open(int (*interrupt)(void*), void* opaque);
+    // After avformat_close_input() of the context open() made (or its failed open).
+    void closed();
+
+    // Any thread: wakes every blocked read; every later open fails. For teardown.
+    void cancel();
+    // Any thread: the player's read-ahead budget (shared by the segments being read).
+    void setMaxAhead(uint64_t);
+
+    // After prepare(): no end list in the main media playlist (a live stream: not seekable).
+    bool isLive() const { return m_live; }
+    // After prepare(): the chosen variant for the stat line (variant= codec= res= bw=).
+    String summary() const;
+
+    struct Stats {
+        unsigned streams { 0 };       // open inputs (segments, keys, playlists held in memory)
+        uint64_t bufferBytes { 0 };   // their buffers' capacity
+        uint64_t received { 0 };      // bytes received, closed inputs included
+        unsigned segments { 0 };      // segments opened
+        unsigned playlistSegments { 0 }; // segments in the main media playlist (its last load)
+        unsigned reloads { 0 };       // media playlist loads after the first
+    };
+    Stats stats() const;
+
+private:
+    struct Input;
+
+    FFmpegHLSSession(unsigned playerID, const URL&, RefPtr<PlatformMediaResourceLoader>&&, uint64_t maxAhead);
+
+    static int ioOpen(AVFormatContext*, AVIOContext**, const char* url, int flags, AVDictionary** options);
+    static int ioClose(AVFormatContext*, AVIOContext*);
+    static int readMaster(void*, uint8_t*, int);
+    static int readMemory(void*, uint8_t*, int);
+    static int readDecrypted(void*, uint8_t*, int);
+
+    int openURL(AVIOContext**, const char* url, AVDictionary* options);
+    int openPlaylist(AVIOContext**, const URL&);
+    int openMedia(AVIOContext**, const URL&, AVDictionary* options, bool crypto);
+    void closeInput(AVIOContext*);
+    bool addInput(std::unique_ptr<Input>&&);
+    void removeInput(Input*);
+    uint64_t segmentAhead() const;
+    void log(const char* format, ...) const WTF_ATTRIBUTE_PRINTF(2, 3);
+
+    const unsigned m_id;
+    const URL m_url;
+    const RefPtr<PlatformMediaResourceLoader> m_loader;
+    std::atomic<uint64_t> m_maxAhead;
+    std::atomic<bool> m_cancelled { false };
+    std::atomic<bool> m_live { false };
+
+    // the demux thread
+    std::string m_masterText;
+    size_t m_masterPosition { 0 };
+    AVIOContext* m_masterAVIO { nullptr };
+    String m_mainPlaylistURL;
+    HashSet<String> m_playlistURLs;
+    HashSet<String> m_keyURLs;
+    HashSet<String> m_initURLs;
+    HashMap<String, unsigned> m_playlistLoads;
+    std::atomic<unsigned> m_concurrentSegments { 1 };
+    unsigned m_openLogs { 0 };
+    std::string m_summary;
+
+    mutable Lock m_lock;
+    Vector<std::unique_ptr<Input>> m_inputs WTF_GUARDED_BY_LOCK(m_lock);
+    uint64_t m_closedReceived WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    unsigned m_segments WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    unsigned m_playlistSegments WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    unsigned m_reloads WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+};
+
+} // namespace WebCore
