+struct FFmpegHLSSession::Input {
+    WTF_MAKE_STRUCT_TZONE_ALLOCATED(Input);
+
+    ~Input()
+    {
+        if (ownsAVIO && avio) {
+            av_freep(&avio->buffer);
+            avio_context_free(&avio);
+        }
+        av_free(aes);
+    }
+
+    FFmpegHLSSession* session { nullptr };
+    // what the demuxer reads: the stream's own context, or one of ours (memory, decryption)
+    AVIOContext* avio { nullptr };
+    bool ownsAVIO { false };
+    RefPtr<FFmpegMediaStream> stream;
+    // a segment (or an init section): its read-ahead is a share of the player's budget
+    bool segment { false };
+    // a playlist, held whole
+    std::string memory;
+    size_t memoryPosition { 0 };
+    // AES-128-CBC: ciphertext not decrypted yet, plaintext not read yet
+    struct AVAES* aes { nullptr };
+    uint8_t iv[16] { };
+    Vector<uint8_t> cipher;
+    Vector<uint8_t> plain;
+    size_t plainPosition { 0 };
+    bool cipherEnd { false };
+};
