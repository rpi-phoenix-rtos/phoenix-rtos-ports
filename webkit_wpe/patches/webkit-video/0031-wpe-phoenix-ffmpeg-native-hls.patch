+/* --- the top-level playlist and the variant ------------------------------------------------ */
+
+bool FFmpegHLSSession::prepare(std::span<const uint8_t> bytes, const URL& responseURL)
+{
+    std::string_view text { reinterpret_cast<const char*>(bytes.data()), bytes.size() };
+    URL base = responseURL.isValid() ? responseURL : m_url;
+    CString baseUTF8 = base.string().utf8();
+    auto playlist = FFmpegMediaPolicy::parsePlaylist(text);
+    if (!playlist.valid) {
+        log("error hls-playlist not-m3u8 bytes=%zu url=%s", bytes.size(), baseUTF8.data());
+        return false;
+    }
+
+    if (playlist.isMediaPlaylist) {
+        // a media playlist as the source: nothing to choose
+        std::string resolved = FFmpegMediaPolicy::resolveMediaPlaylist(text, resolveAgainst, &base);
+        auto info = FFmpegMediaPolicy::parseMediaPlaylist(resolved);
+        log("hls media url=%s", baseUTF8.data());
+        log("hls live=%d segments=%u target=%.1f duration=%.1f media-sequence=%lld discontinuities=%u byterange=%d init=%d aes128=%d",
+            !info.ended, info.segments, info.targetDuration, info.totalDuration, static_cast<long long>(info.mediaSequence),
+            info.discontinuities, info.byteRanges, info.initSection, info.aes128);
+        if (!info.refusedKey.empty()) {
+            log("error hls-encryption=%s unsupported (only AES-128 with the identity key format)", info.refusedKey.c_str());
+            return false;
+        }
+        for (auto& uri : info.keyURIs)
+            m_keyURLs.add(fromStd(uri));
+        for (auto& uri : info.initURIs)
+            m_initURLs.add(fromStd(uri));
+        m_live = !info.ended;
+        {
+            Locker locker { m_lock };
+            m_playlistSegments = info.segments;
+        }
+        // the demuxer reloads a live playlist from the element's URL
+        m_mainPlaylistURL = m_url.string();
+        m_playlistURLs.add(m_mainPlaylistURL);
+        m_playlistLoads.add(m_mainPlaylistURL, 1);
+        m_concurrentSegments = 1;
+        m_masterText = WTF::move(resolved);
+        m_summary = "variant=- rule=media";
+        return true;
+    }
+
+    auto& policy = hlsPolicy();
+    unsigned audioGroups = 0;
+    {
+        HashSet<String> groups;
+        for (auto& rendition : playlist.renditions) {
+            if (rendition.type == "AUDIO" && groups.add(fromStd(rendition.groupID)).isNewEntry)
+                audioGroups++;
+        }
+    }
+    log("hls master url=%s variants=%zu audio-groups=%u renditions=%zu", baseUTF8.data(), playlist.variants.size(), audioGroups, playlist.renditions.size());
+    log("hls policy hevc<=%ux%u@%.0f h264<=%ux%u@%.0f mode=%s forced=%d", policy.hevcMaxWidth, policy.hevcMaxHeight, policy.hevcMaxFps,
+        policy.h264MaxWidth, policy.h264MaxHeight, policy.h264MaxFps,
+        policy.mode == FFmpegMediaPolicy::Policy::Mode::Lowest ? "lowest" : policy.mode == FFmpegMediaPolicy::Policy::Mode::Highest ? "highest" : "default",
+        policy.forcedVariant);
+    if (!playlist.sessionKeyMethod.empty() && playlist.sessionKeyMethod != "NONE" && playlist.sessionKeyMethod != "AES-128")
+        log("hls session-key method=%s (encrypted variants are refused)", playlist.sessionKeyMethod.c_str());
+
+    auto choice = FFmpegMediaPolicy::chooseVariant(playlist, policy);
+    for (size_t i = 0; i < playlist.variants.size(); ++i) {
+        auto& variant = playlist.variants[i];
+        auto& verdict = choice.verdicts[i];
+        bool eligible = verdict.eligibleAs == FFmpegMediaPolicy::VariantClass::HEVCMain || verdict.eligibleAs == FFmpegMediaPolicy::VariantClass::H264
+            || verdict.eligibleAs == FFmpegMediaPolicy::VariantClass::HEVCMain10 || verdict.eligibleAs == FFmpegMediaPolicy::VariantClass::Audio;
+        log("hls variant i=%zu bw=%llu res=%ux%u fps=%.3f codecs=%s range=%s eligible=%d class=%s reason=%s", i,
+            static_cast<unsigned long long>(variant.bandwidth), variant.width, variant.height, variant.fps,
+            variant.codecs.empty() ? "-" : variant.codecs.c_str(), variant.videoRange.empty() ? "-" : variant.videoRange.c_str(), eligible,
+            FFmpegMediaPolicy::variantClassName(verdict.eligibleAs), verdict.reason.c_str());
+    }
+    if (choice.variant < 0) {
+        log("error hls-master no-variants");
+        return false;
+    }
+    auto& variant = playlist.variants[choice.variant];
+    auto& verdict = choice.verdicts[choice.variant];
+    const FFmpegMediaPolicy::Rendition* audio = choice.audioRendition >= 0 ? &playlist.renditions[choice.audioRendition] : nullptr;
+    log("hls choose i=%d rule=%s audio=%s bw=%llu res=%ux%u codecs=%s", choice.variant, choice.rule.c_str(),
+        audio ? (audio->name.empty() ? audio->groupID.c_str() : audio->name.c_str()) : (variant.audioGroup.empty() ? "muxed" : "none"),
+        static_cast<unsigned long long>(variant.bandwidth), variant.width, variant.height, variant.codecs.empty() ? "-" : variant.codecs.c_str());
+
+    m_masterText = FFmpegMediaPolicy::synthesizeMaster(playlist, choice, resolveAgainst, &base);
+    m_mainPlaylistURL = fromStd(resolveAgainst(variant.uri, &base));
+    m_playlistURLs.add(m_mainPlaylistURL);
+    m_concurrentSegments = 1;
+    if (audio && !audio->uri.empty()) {
+        m_playlistURLs.add(fromStd(resolveAgainst(audio->uri, &base)));
+        m_concurrentSegments = 2;
+    }
+    char summary[256];
+    snprintf(summary, sizeof(summary), "variant=%d rule=%s vcodec=%s res=%ux%u bw=%llu", choice.variant, choice.rule.c_str(),
+        FFmpegMediaPolicy::codecKindName(verdict.video), variant.width, variant.height, static_cast<unsigned long long>(variant.bandwidth));
+    m_summary = summary;
+    return true;
+}
