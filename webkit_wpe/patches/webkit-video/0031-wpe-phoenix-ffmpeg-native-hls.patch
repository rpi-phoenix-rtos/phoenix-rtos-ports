+
+/* --- helpers ------------------------------------------------------------------------------ */
+
+static bool isSpace(char c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+static std::string_view trim(std::string_view s)
+{
+    while (!s.empty() && isSpace(s.front()))
+        s.remove_prefix(1);
+    while (!s.empty() && isSpace(s.back()))
+        s.remove_suffix(1);
+    return s;
+}
+
+static char lower(char c)
+{
+    return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c;
+}
+
+static bool startsWithIgnoringCase(std::string_view s, std::string_view prefix)
+{
+    if (s.size() < prefix.size())
+        return false;
+    for (size_t i = 0; i < prefix.size(); ++i) {
+        if (lower(s[i]) != lower(prefix[i]))
+            return false;
+    }
+    return true;
+}
+
+static bool equalIgnoringCase(std::string_view a, std::string_view b)
+{
+    return a.size() == b.size() && startsWithIgnoringCase(a, b);
+}
+
+static bool startsWith(std::string_view s, std::string_view prefix)
+{
+    return s.substr(0, prefix.size()) == prefix;
+}
+
+static uint64_t toUnsigned(std::string_view s)
+{
+    std::string copy { trim(s) };
+    return strtoull(copy.c_str(), nullptr, 10);
+}
+
+static double toDouble(std::string_view s)
+{
+    std::string copy { trim(s) };
+    return strtod(copy.c_str(), nullptr);
+}
+
+// the lines of a playlist, without line ends, surrounding blanks and a leading byte order mark
+static std::vector<std::string_view> splitLines(std::string_view text)
+{
+    if (startsWith(text, "\xEF\xBB\xBF"))
+        text.remove_prefix(3);
+    std::vector<std::string_view> lines;
+    while (!text.empty()) {
+        size_t end = text.find('\n');
+        std::string_view line = text.substr(0, end);
+        lines.push_back(trim(line));
+        if (end == std::string_view::npos)
+            break;
+        text.remove_prefix(end + 1);
+    }
+    return lines;
+}
+
+// the part after "#TAG:" if the line is that tag
+static bool tagValue(std::string_view line, std::string_view tag, std::string_view& value)
+{
+    if (!startsWith(line, tag))
+        return false;
+    value = line.substr(tag.size());
+    return true;
+}
+
+/* --- codecs ------------------------------------------------------------------------------- */
+
+// "hvc1.2.4.L120.B0" -> "2"; "vp09.00.10.08" -> "00"
+static std::string_view codecField(std::string_view codec, size_t index)
+{
+    for (size_t i = 0; i < index; ++i) {
+        size_t dot = codec.find('.');
+        if (dot == std::string_view::npos)
+            return { };
+        codec.remove_prefix(dot + 1);
+    }
+    return codec.substr(0, codec.find('.'));
+}
+
+CodecKind classifyCodec(std::string_view codec)
+{
+    codec = trim(codec);
+    if (startsWithIgnoringCase(codec, "avc1") || startsWithIgnoringCase(codec, "avc3"))
+        return CodecKind::H264;
+    if (startsWithIgnoringCase(codec, "hvc1") || startsWithIgnoringCase(codec, "hev1")) {
+        // general_profile_space (A-C) then general_profile_idc
+        std::string_view profile = codecField(codec, 1);
+        if (!profile.empty() && lower(profile.front()) >= 'a' && lower(profile.front()) <= 'c')
+            profile.remove_prefix(1);
+        if (profile.empty())
+            return CodecKind::HEVCMain;
+        switch (toUnsigned(profile)) {
+        case 1: // Main
+        case 3: // Main Still Picture
+            return CodecKind::HEVCMain;
+        case 2:
+            return CodecKind::HEVCMain10;
+        default:
+            return CodecKind::HEVCOther;
+        }
+    }
+    for (auto prefix : { "dvh1", "dvhe", "dva1", "dvav" }) {
+        if (startsWithIgnoringCase(codec, prefix))
+            return CodecKind::DolbyVision;
+    }
+    if (startsWithIgnoringCase(codec, "av01"))
+        return CodecKind::AV1;
+    if (startsWithIgnoringCase(codec, "vp09")) {
+        std::string_view profile = codecField(codec, 1);
+        return profile.empty() || !toUnsigned(profile) ? CodecKind::VP9Profile0 : CodecKind::VP9Other;
+    }
+    if (equalIgnoringCase(codec, "vp9") || equalIgnoringCase(codec, "vp9.0"))
+        return CodecKind::VP9Profile0;
+    if (equalIgnoringCase(codec, "vp8") || equalIgnoringCase(codec, "vp8.0") || startsWithIgnoringCase(codec, "vp08"))
+        return CodecKind::VP8;
+    if (startsWithIgnoringCase(codec, "mp4v"))
+        return CodecKind::MPEG4Visual;
+    if (startsWithIgnoringCase(codec, "mp4a")) {
+        // the MPEG-4 object type: 40 MPEG-4 audio, 66-68 MPEG-2 AAC, 69/6B MP3, A5 AC-3, A6 E-AC-3
+        std::string_view type = codecField(codec, 1);
+        if (type.empty())
+            return CodecKind::AAC;
+        for (auto aac : { "40", "66", "67", "68" }) {
+            if (equalIgnoringCase(type, aac))
+                return CodecKind::AAC;
+        }
+        if (equalIgnoringCase(type, "69") || equalIgnoringCase(type, "6b"))
+            return CodecKind::MP3;
+        if (equalIgnoringCase(type, "a5"))
+            return CodecKind::AC3;
+        if (equalIgnoringCase(type, "a6"))
+            return CodecKind::EAC3;
+        return CodecKind::UnsupportedAudio;
+    }
+    if (equalIgnoringCase(codec, "opus"))
+        return CodecKind::Opus;
+    if (equalIgnoringCase(codec, "vorbis"))
+        return CodecKind::Vorbis;
+    if (equalIgnoringCase(codec, "flac"))
+        return CodecKind::FLAC;
+    if (equalIgnoringCase(codec, "mp3"))
+        return CodecKind::MP3;
+    if (equalIgnoringCase(codec, "ac-3"))
+        return CodecKind::AC3;
+    if (equalIgnoringCase(codec, "ec-3"))
+        return CodecKind::EAC3;
+    for (auto prefix : { "ac-4", "mha1", "mhm1", "dts", "alac", "ipcm", "fpcm", "lpcm" }) {
+        if (startsWithIgnoringCase(codec, prefix))
+            return CodecKind::UnsupportedAudio;
+    }
+    return CodecKind::Unknown;
+}
+
+const char* codecKindName(CodecKind kind)
+{
+    switch (kind) {
+    case CodecKind::Unknown: return "unknown";
+    case CodecKind::H264: return "h264";
+    case CodecKind::HEVCMain: return "hevc8";
+    case CodecKind::HEVCMain10: return "hevc10";
+    case CodecKind::HEVCOther: return "hevc-other";
+    case CodecKind::VP8: return "vp8";
+    case CodecKind::VP9Profile0: return "vp9";
+    case CodecKind::VP9Other: return "vp9-other";
+    case CodecKind::AV1: return "av1";
+    case CodecKind::DolbyVision: return "dolby-vision";
+    case CodecKind::MPEG4Visual: return "mpeg4";
+    case CodecKind::AAC: return "aac";
+    case CodecKind::MP3: return "mp3";
+    case CodecKind::Opus: return "opus";
+    case CodecKind::Vorbis: return "vorbis";
+    case CodecKind::FLAC: return "flac";
+    case CodecKind::AC3: return "ac3";
+    case CodecKind::EAC3: return "eac3";
+    case CodecKind::UnsupportedAudio: return "audio-other";
+    }
+    return "?";
+}
+
+bool isVideoCodec(CodecKind kind)
+{
+    return kind >= CodecKind::H264 && kind <= CodecKind::MPEG4Visual;
+}
+
+bool isAudioCodec(CodecKind kind)
+{
+    return kind >= CodecKind::AAC && kind <= CodecKind::UnsupportedAudio;
+}
+
+bool canDecode(CodecKind kind)
+{
+    switch (kind) {
+    case CodecKind::H264:
+    case CodecKind::HEVCMain:
+    case CodecKind::HEVCMain10:
+    case CodecKind::VP8:
+    case CodecKind::VP9Profile0:
+    case CodecKind::MPEG4Visual:
+    case CodecKind::AAC:
+    case CodecKind::MP3:
+    case CodecKind::Opus:
+    case CodecKind::Vorbis:
+    case CodecKind::FLAC:
+    case CodecKind::AC3:
+    case CodecKind::EAC3:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// width x height within maxWidth x maxHeight in either orientation (0: not given, within)
+static bool within(unsigned width, unsigned height, unsigned maxWidth, unsigned maxHeight)
+{
+    if (!width || !height)
+        return true;
+    return std::max(width, height) <= std::max(maxWidth, maxHeight) && std::min(width, height) <= std::min(maxWidth, maxHeight);
+}
+
+Capability videoCapability(CodecKind kind, unsigned width, unsigned height, double fps)
+{
+    bool fps30 = fps <= 30.5;
+    bool fps60 = fps <= 60.5;
+    switch (kind) {
+    case CodecKind::HEVCMain:
+        // the rpivid block: 1080p30 measured; up to 4096 on a side it decodes, slower
+        if (within(width, height, 1920, 1080) && fps30)
+            return { true, true, true };
+        if (within(width, height, 4096, 4096) && fps60)
+            return { true, false, true };
+        return { };
+    case CodecKind::HEVCMain10:
+        // the block decodes it, the 10 -> 8-bit conversion runs on the CPU
+        if (within(width, height, 1920, 1080) && fps60)
+            return { true, false, false };
+        return { };
+    case CodecKind::H264:
+        // software only: 720p30 is real time beside the page, 1080p30 is not reliably
+        if (within(width, height, 1280, 720) && fps30)
+            return { true, true, false };
+        return { true, false, false };
+    case CodecKind::VP8:
+    case CodecKind::VP9Profile0:
+        if (within(width, height, 640, 360) && fps30)
+            return { true, true, false };
+        return { };
+    case CodecKind::MPEG4Visual:
+        return { true, within(width, height, 1280, 720) && fps30, false };
+    default:
+        return { };
+    }
+}
+
+Capability audioCapability(CodecKind kind)
+{
+    if (isAudioCodec(kind) && canDecode(kind))
+        return { true, true, true };
+    return { };
+}
+
+/* --- playlists ---------------------------------------------------------------------------- */
+
+Attributes parseAttributes(std::string_view text)
+{
+    Attributes attributes;
+    size_t i = 0;
+    while (i < text.size()) {
+        while (i < text.size() && (text[i] == ',' || isSpace(text[i])))
+            ++i;
+        size_t nameStart = i;
+        while (i < text.size() && text[i] != '=' && text[i] != ',')
+            ++i;
+        Attribute attribute;
+        attribute.name = std::string { trim(text.substr(nameStart, i - nameStart)) };
+        if (i < text.size() && text[i] == '=') {
+            ++i;
+            if (i < text.size() && text[i] == '"') {
+                size_t end = text.find('"', i + 1);
+                if (end == std::string_view::npos)
+                    end = text.size();
+                attribute.value = std::string { text.substr(i + 1, end - i - 1) };
+                attribute.quoted = true;
+                i = std::min(end + 1, text.size());
+            } else {
+                size_t end = text.find(',', i);
+                if (end == std::string_view::npos)
+                    end = text.size();
+                attribute.value = std::string { trim(text.substr(i, end - i)) };
+                i = end;
+            }
+        }
+        if (!attribute.name.empty())
+            attributes.push_back(std::move(attribute));
+    }
+    return attributes;
+}
+
+const std::string* findAttribute(const Attributes& attributes, std::string_view name)
+{
+    for (auto& attribute : attributes) {
+        if (attribute.name == name)
+            return &attribute.value;
+    }
+    return nullptr;
+}
+
+static std::string attributeOr(const Attributes& attributes, std::string_view name)
+{
+    auto* value = findAttribute(attributes, name);
+    return value ? *value : std::string { };
+}
+
+Playlist parsePlaylist(std::string_view text)
+{
+    Playlist playlist;
+    auto lines = splitLines(text);
+    size_t first = 0;
+    while (first < lines.size() && lines[first].empty())
+        ++first;
+    playlist.valid = first < lines.size() && lines[first] == "#EXTM3U";
+    bool pending = false;
+    Variant variant;
+    for (size_t i = first; i < lines.size(); ++i) {
+        std::string_view line = lines[i], value;
+        if (line.empty())
+            continue;
+        if (tagValue(line, "#EXT-X-STREAM-INF:", value)) {
+            variant = { };
+            variant.attributes = parseAttributes(value);
+            auto& a = variant.attributes;
+            variant.bandwidth = toUnsigned(attributeOr(a, "BANDWIDTH"));
+            if (auto* resolution = findAttribute(a, "RESOLUTION")) {
+                size_t x = resolution->find_first_of("xX");
+                if (x != std::string::npos) {
+                    variant.width = static_cast<unsigned>(toUnsigned(std::string_view { *resolution }.substr(0, x)));
+                    variant.height = static_cast<unsigned>(toUnsigned(std::string_view { *resolution }.substr(x + 1)));
+                }
+            }
+            variant.fps = toDouble(attributeOr(a, "FRAME-RATE"));
+            variant.codecs = attributeOr(a, "CODECS");
+            variant.audioGroup = attributeOr(a, "AUDIO");
+            variant.videoRange = attributeOr(a, "VIDEO-RANGE");
+            pending = true;
+        } else if (tagValue(line, "#EXT-X-MEDIA:", value)) {
+            Rendition rendition;
+            rendition.attributes = parseAttributes(value);
+            auto& a = rendition.attributes;
+            rendition.type = attributeOr(a, "TYPE");
+            rendition.groupID = attributeOr(a, "GROUP-ID");
+            rendition.name = attributeOr(a, "NAME");
+            rendition.uri = attributeOr(a, "URI");
+            rendition.codecs = attributeOr(a, "CODECS");
+            rendition.isDefault = attributeOr(a, "DEFAULT") == "YES";
+            rendition.autoselect = attributeOr(a, "AUTOSELECT") == "YES";
+            playlist.renditions.push_back(std::move(rendition));
+        } else if (startsWith(line, "#EXTINF") || startsWith(line, "#EXT-X-TARGETDURATION")) {
+            playlist.isMediaPlaylist = true;
+        } else if (startsWith(line, "#EXT-X-VERSION:") || line == "#EXT-X-INDEPENDENT-SEGMENTS" || startsWith(line, "#EXT-X-START:")) {
+            playlist.sessionTags.emplace_back(line);
+        } else if (tagValue(line, "#EXT-X-SESSION-KEY:", value)) {
+            playlist.sessionKeyMethod = attributeOr(parseAttributes(value), "METHOD");
+        } else if (line.front() != '#' && pending) {
+            variant.uri = std::string { line };
+            playlist.variants.push_back(std::move(variant));
+            variant = { };
+            pending = false;
+        }
+    }
+    return playlist;
+}
+
+MediaPlaylistInfo parseMediaPlaylist(std::string_view text)
+{
+    MediaPlaylistInfo info;
+    for (std::string_view line : splitLines(text)) {
+        std::string_view value;
+        if (tagValue(line, "#EXTINF:", value)) {
+            info.segments++;
+            info.totalDuration += toDouble(value.substr(0, value.find(',')));
+        } else if (tagValue(line, "#EXT-X-TARGETDURATION:", value))
+            info.targetDuration = toDouble(value);
+        else if (tagValue(line, "#EXT-X-MEDIA-SEQUENCE:", value))
+            info.mediaSequence = static_cast<int64_t>(toUnsigned(value));
+        else if (line == "#EXT-X-DISCONTINUITY")
+            info.discontinuities++;
+        else if (line == "#EXT-X-ENDLIST")
+            info.ended = true;
+        else if (tagValue(line, "#EXT-X-PLAYLIST-TYPE:", value))
+            info.ended |= trim(value) == "VOD";
+        else if (startsWith(line, "#EXT-X-BYTERANGE"))
+            info.byteRanges = true;
+        else if (tagValue(line, "#EXT-X-MAP:", value)) {
+            info.initSection = true;
+            auto attributes = parseAttributes(value);
+            if (auto* uri = findAttribute(attributes, "URI"))
+                info.initURIs.push_back(*uri);
+        }
+        else if (tagValue(line, "#EXT-X-KEY:", value)) {
+            auto attributes = parseAttributes(value);
+            std::string method = attributeOr(attributes, "METHOD");
+            std::string keyFormat = attributeOr(attributes, "KEYFORMAT");
+            if (method == "NONE")
+                continue;
+            if (method == "AES-128" && (keyFormat.empty() || keyFormat == "identity")) {
+                info.aes128 = true;
+                if (auto* uri = findAttribute(attributes, "URI"))
+                    info.keyURIs.push_back(*uri);
+                continue;
+            }
+            if (info.refusedKey.empty())
+                info.refusedKey = keyFormat.empty() ? method : method + "/" + keyFormat;
+        }
+    }
+    return info;
+}
+
+const char* variantClassName(VariantClass variantClass)
+{
+    switch (variantClass) {
+    case VariantClass::None: return "none";
+    case VariantClass::Fallback: return "fallback";
+    case VariantClass::Audio: return "audio";
+    case VariantClass::HEVCMain10: return "main10";
+    case VariantClass::H264: return "h264";
+    case VariantClass::HEVCMain: return "hevc8";
+    }
+    return "?";
+}
+
+static VariantVerdict judgeVariant(const Variant& variant, const Policy& policy)
+{
+    VariantVerdict verdict;
+    bool audioOK = true;
+    std::string badAudio, otherCodec;
+    std::string_view codecs = variant.codecs;
+    while (!trim(codecs).empty()) {
+        size_t comma = codecs.find(',');
+        std::string_view codec = trim(codecs.substr(0, comma));
+        CodecKind kind = classifyCodec(codec);
+        if (isVideoCodec(kind)) {
+            if (verdict.video == CodecKind::Unknown)
+                verdict.video = kind;
+        } else if (isAudioCodec(kind)) {
+            if (verdict.audio == CodecKind::Unknown)
+                verdict.audio = kind;
+            if (!canDecode(kind) && audioOK) {
+                audioOK = false;
+                badAudio = std::string { codec };
+            }
+        } else if (otherCodec.empty())
+            otherCodec = std::string { codec };
+        if (comma == std::string_view::npos)
+            break;
+        codecs.remove_prefix(comma + 1);
+    }
+    bool hasCodecs = !trim(variant.codecs).empty();
+    bool audioOnly = hasCodecs && verdict.video == CodecKind::Unknown && verdict.audio != CodecKind::Unknown;
+    // no CODECS (allowed): taken as H.264 and capped by its RESOLUTION
+    if (!hasCodecs)
+        verdict.video = CodecKind::H264;
+
+    if (variant.videoRange == "PQ" || variant.videoRange == "HLG") {
+        verdict.reason = "hdr video-range=" + variant.videoRange;
+        return verdict;
+    }
+    if (!audioOK) {
+        verdict.reason = "audio-codec=" + badAudio;
+        return verdict;
+    }
+    if (audioOnly) {
+        verdict.decodable = true;
+        verdict.eligibleAs = VariantClass::Audio;
+        verdict.reason = "audio-only";
+        return verdict;
+    }
+    if (verdict.video == CodecKind::Unknown) {
+        verdict.reason = "codec=" + (otherCodec.empty() ? std::string { "none" } : otherCodec);
+        return verdict;
+    }
+    verdict.decodable = canDecode(verdict.video);
+    bool hevcSize = within(variant.width, variant.height, policy.hevcMaxWidth, policy.hevcMaxHeight) && variant.fps <= policy.hevcMaxFps + 0.5;
+    bool h264Size = within(variant.width, variant.height, policy.h264MaxWidth, policy.h264MaxHeight) && variant.fps <= policy.h264MaxFps + 0.5;
+    switch (verdict.video) {
+    case CodecKind::HEVCMain:
+        verdict.eligibleAs = hevcSize ? VariantClass::HEVCMain : VariantClass::Fallback;
+        verdict.reason = hevcSize ? "hevc8" : "hevc8 above the cap";
+        break;
+    case CodecKind::H264:
+        verdict.eligibleAs = h264Size ? VariantClass::H264 : VariantClass::Fallback;
+        verdict.reason = h264Size ? (hasCodecs ? "h264" : "h264 (no CODECS)") : "h264 above the cap";
+        break;
+    case CodecKind::HEVCMain10:
+        verdict.eligibleAs = hevcSize ? VariantClass::HEVCMain10 : VariantClass::Fallback;
+        verdict.reason = hevcSize ? "main10 (CPU 10->8-bit conversion)" : "main10 above the cap";
+        break;
+    default:
+        verdict.eligibleAs = verdict.decodable ? VariantClass::Fallback : VariantClass::None;
+        verdict.reason = std::string { "codec=" } + codecKindName(verdict.video) + (verdict.decodable ? " not preferred" : " no decoder");
+        break;
+    }
+    return verdict;
+}
+
+// a better than b, both of the same class
+static bool better(const Variant& a, const Variant& b, VariantClass variantClass, const Policy& policy)
+{
+    if (variantClass == VariantClass::Fallback)
+        return a.bandwidth < b.bandwidth;
+    if (variantClass == VariantClass::Audio)
+        return a.bandwidth > b.bandwidth;
+    uint64_t pixelsA = static_cast<uint64_t>(a.width) * a.height, pixelsB = static_cast<uint64_t>(b.width) * b.height;
+    if (pixelsA != pixelsB)
+        return pixelsA > pixelsB;
+    if (!pixelsA) {
+        // no RESOLUTION: the highest BANDWIDTH up to the policy's limit, else the lowest
+        bool aUnder = a.bandwidth <= policy.unknownSizeMaxBandwidth, bUnder = b.bandwidth <= policy.unknownSizeMaxBandwidth;
+        if (aUnder != bUnder)
+            return aUnder;
+        return aUnder ? a.bandwidth > b.bandwidth : a.bandwidth < b.bandwidth;
+    }
+    return a.bandwidth < b.bandwidth;
+}
+
+static int chooseAudioRendition(const Playlist& playlist, const Variant& variant)
+{
+    if (variant.audioGroup.empty())
+        return -1;
+    int chosen = -1, chosenScore = -1;
+    for (size_t i = 0; i < playlist.renditions.size(); ++i) {
+        auto& rendition = playlist.renditions[i];
+        if (rendition.type != "AUDIO" || rendition.groupID != variant.audioGroup)
+            continue;
+        if (!rendition.codecs.empty() && !canDecode(classifyCodec(rendition.codecs)))
+            continue;
+        int score = rendition.isDefault ? 2 : rendition.autoselect ? 1 : 0;
+        if (score > chosenScore) {
+            chosen = static_cast<int>(i);
+            chosenScore = score;
+        }
+    }
+    return chosen;
+}
+
+Choice chooseVariant(const Playlist& playlist, const Policy& policy)
+{
+    Choice choice;
+    for (auto& variant : playlist.variants)
+        choice.verdicts.push_back(judgeVariant(variant, policy));
+    int count = static_cast<int>(playlist.variants.size());
+    if (!count) {
+        choice.rule = "none";
+        return choice;
+    }
+
+    if (policy.forcedVariant >= 0 && policy.forcedVariant < count) {
+        choice.variant = policy.forcedVariant;
+        choice.rule = "forced";
+    } else if (policy.mode != Policy::Mode::Default) {
+        bool lowest = policy.mode == Policy::Mode::Lowest;
+        choice.variant = 0;
+        for (int i = 1; i < count; ++i) {
+            uint64_t bandwidth = playlist.variants[i].bandwidth, chosen = playlist.variants[choice.variant].bandwidth;
+            if (lowest ? bandwidth < chosen : bandwidth > chosen)
+                choice.variant = i;
+        }
+        choice.rule = lowest ? "lowest" : "highest";
+    } else {
+        // the class order is the preference: HEVC 8-bit, H.264, HEVC Main10, any other decodable
+        // video (lowest bandwidth), audio only
+        for (auto variantClass : { VariantClass::HEVCMain, VariantClass::H264, VariantClass::HEVCMain10, VariantClass::Fallback, VariantClass::Audio }) {
+            for (int i = 0; i < count; ++i) {
+                if (choice.verdicts[i].eligibleAs != variantClass)
+                    continue;
+                if (choice.variant < 0 || better(playlist.variants[i], playlist.variants[choice.variant], variantClass, policy))
+                    choice.variant = i;
+            }
+            if (choice.variant >= 0) {
+                choice.rule = variantClassName(variantClass);
+                break;
+            }
+        }
+        if (choice.variant < 0) {
+            // nothing this player decodes: the lowest bandwidth, to fail with a reason in the log
+            choice.variant = 0;
+            for (int i = 1; i < count; ++i) {
+                if (playlist.variants[i].bandwidth < playlist.variants[choice.variant].bandwidth)
+                    choice.variant = i;
+            }
+            choice.rule = "undecodable";
+        }
+    }
+    choice.audioRendition = chooseAudioRendition(playlist, playlist.variants[choice.variant]);
+    return choice;
+}
+
+static std::string resolved(const std::string& uri, Resolver resolve, void* context)
+{
+    std::string absolute = resolve(uri, context);
+    return absolute.empty() ? uri : absolute;
+}
+
+static std::string serializeAttributes(const Attributes& attributes, Resolver resolve, void* context, std::initializer_list<std::string_view> skip)
+{
+    std::string out;
+    for (auto& attribute : attributes) {
+        if (std::find(skip.begin(), skip.end(), attribute.name) != skip.end())
+            continue;
+        if (!out.empty())
+            out += ',';
+        out += attribute.name;
+        out += '=';
+        std::string value = attribute.name == "URI" ? resolved(attribute.value, resolve, context) : attribute.value;
+        if (attribute.quoted)
+            out += '"' + value + '"';
+        else
+            out += value;
+    }
+    return out;
+}
+
+std::string synthesizeMaster(const Playlist& playlist, const Choice& choice, Resolver resolve, void* context)
+{
+    std::string out = "#EXTM3U\n";
+    for (auto& tag : playlist.sessionTags)
+        out += tag + '\n';
+    if (choice.variant < 0 || choice.variant >= static_cast<int>(playlist.variants.size()))
+        return out;
+    auto& variant = playlist.variants[choice.variant];
+    if (choice.audioRendition >= 0)
+        out += "#EXT-X-MEDIA:" + serializeAttributes(playlist.renditions[choice.audioRendition].attributes, resolve, context, { }) + '\n';
+    out += "#EXT-X-STREAM-INF:" + serializeAttributes(variant.attributes, resolve, context, { "SUBTITLES", "VIDEO" }) + '\n';
+    out += resolved(variant.uri, resolve, context) + '\n';
+    return out;
+}
+
+std::string resolveMediaPlaylist(std::string_view text, Resolver resolve, void* context)
+{
+    std::string out;
+    out.reserve(text.size() + text.size() / 2);
+    for (std::string_view line : splitLines(text)) {
+        if (line.empty()) {
+            out += '\n';
+            continue;
+        }
+        if (line.front() != '#') {
+            out += resolved(std::string { line }, resolve, context) + '\n';
+            continue;
+        }
+        size_t uri = line.find("URI=\"");
+        if (uri == std::string_view::npos) {
+            out.append(line);
+            out += '\n';
+            continue;
+        }
+        size_t start = uri + 5, end = line.find('"', start);
+        if (end == std::string_view::npos) {
+            out.append(line);
+            out += '\n';
+            continue;
+        }
+        out.append(line.substr(0, start));
+        out += resolved(std::string { line.substr(start, end - start) }, resolve, context);
+        out.append(line.substr(end));
+        out += '\n';
+    }
+    return out;
+}
