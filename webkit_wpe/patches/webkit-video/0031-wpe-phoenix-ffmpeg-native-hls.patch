+/* --- the demuxer's context ----------------------------------------------------------------- */
+
+AVFormatContext* FFmpegHLSSession::open(int (*interrupt)(void*), void* opaque)
+{
+    AVFormatContext* format = avformat_alloc_context();
+    auto* buffer = static_cast<unsigned char*>(av_malloc(kMemoryIOBufferSize));
+    m_masterPosition = 0;
+    m_masterAVIO = buffer ? avio_alloc_context(buffer, kMemoryIOBufferSize, 0, this, readMaster, nullptr, nullptr) : nullptr;
+    if (!format || !m_masterAVIO) {
+        if (!m_masterAVIO)
+            av_free(buffer);
+        avformat_free_context(format);
+        closed();
+        return nullptr;
+    }
+    format->pb = m_masterAVIO;
+    format->flags |= AVFMT_FLAG_CUSTOM_IO;
+    format->opaque = this;
+    format->io_open = ioOpen;
+    format->io_close2 = ioClose;
+    format->interrupt_callback.callback = interrupt;
+    format->interrupt_callback.opaque = opaque;
+    format->probesize = kProbeBytes;
+    format->max_analyze_duration = kAnalyzeMicroseconds;
+    AVDictionary* options = nullptr;
+    // one request per playlist and per segment, the next segment only when the last one is read
+    av_dict_set(&options, "http_persistent", "0", 0);
+    av_dict_set(&options, "http_multiple", "0", 0);
+    av_dict_set(&options, "max_reload", kMaxReload, 0);
+    av_dict_set(&options, "seg_max_retry", "2", 0);
+    CString url = m_url.string().utf8();
+    int ret = avformat_open_input(&format, url.data(), av_find_input_format("hls"), &options);
+    av_dict_free(&options);
+    if (ret < 0) {
+        // avformat_open_input() freed the context (and hls.c closed its inputs)
+        if (!m_cancelled)
+            log("error hls-open rc=%d (%s)", ret, av_err2str(ret));
+        closed();
+        return nullptr;
+    }
+    return format;
+}
+
+void FFmpegHLSSession::closed()
+{
+    if (m_masterAVIO) {
+        av_freep(&m_masterAVIO->buffer);
+        avio_context_free(&m_masterAVIO);
+    }
+    // hls.c closes what it opened; anything left (a failed open) goes here
+    Vector<std::unique_ptr<Input>> left;
+    {
+        Locker locker { m_lock };
+        left = WTF::move(m_inputs);
+        m_inputs = { };
+        for (auto& input : left) {
+            if (input->stream)
+                m_closedReceived += input->stream->bytesReceived();
+        }
+    }
+    for (auto& input : left) {
+        if (input->stream)
+            input->stream->cancel();
+    }
+}
+
+void FFmpegHLSSession::cancel()
+{
+    m_cancelled = true;
+    Locker locker { m_lock };
+    for (auto& input : m_inputs) {
+        if (input->stream)
+            input->stream->cancel();
+    }
+}
+
+uint64_t FFmpegHLSSession::segmentAhead() const
+{
+    return m_maxAhead / std::max(1u, m_concurrentSegments.load());
+}
+
+void FFmpegHLSSession::setMaxAhead(uint64_t maxAhead)
+{
+    m_maxAhead = maxAhead;
+    uint64_t share = segmentAhead();
+    Locker locker { m_lock };
+    for (auto& input : m_inputs) {
+        if (input->segment && input->stream)
+            input->stream->setMaxAhead(share);
+    }
+}
+
+auto FFmpegHLSSession::stats() const -> Stats
+{
+    Stats stats;
+    Locker locker { m_lock };
+    stats.streams = m_inputs.size();
+    stats.received = m_closedReceived;
+    for (auto& input : m_inputs) {
+        if (input->stream) {
+            stats.bufferBytes += input->stream->memory().capacity;
+            stats.received += input->stream->bytesReceived();
+        }
+        stats.bufferBytes += input->memory.capacity() + input->cipher.capacity() + input->plain.capacity();
+    }
+    stats.segments = m_segments;
+    stats.playlistSegments = m_playlistSegments;
+    stats.reloads = m_reloads;
+    return stats;
+}
+
+bool FFmpegHLSSession::addInput(std::unique_ptr<Input>&& input)
+{
+    Locker locker { m_lock };
+    if (m_cancelled)
+        return false;
+    m_inputs.append(WTF::move(input));
+    return true;
+}
+
+void FFmpegHLSSession::removeInput(Input* input)
+{
+    std::unique_ptr<Input> removed;
+    {
+        Locker locker { m_lock };
+        for (size_t i = 0; i < m_inputs.size(); ++i) {
+            if (m_inputs[i].get() == input) {
+                removed = WTF::move(m_inputs[i]);
+                m_inputs.removeAt(i);
+                break;
+            }
+        }
+        if (removed && removed->stream)
+            m_closedReceived += removed->stream->bytesReceived();
+    }
+    if (removed && removed->stream)
+        removed->stream->cancel();
+}
+
+void FFmpegHLSSession::closeInput(AVIOContext* avio)
+{
+    Input* found = nullptr;
+    {
+        Locker locker { m_lock };
+        for (auto& input : m_inputs) {
+            if (input->avio == avio) {
+                found = input.get();
+                break;
+            }
+        }
+    }
+    if (found)
+        removeInput(found);
+}
+
+/* --- I/O callbacks ------------------------------------------------------------------------- */
+
+int FFmpegHLSSession::ioOpen(AVFormatContext* format, AVIOContext** pb, const char* url, int flags, AVDictionary** options)
+{
+    *pb = nullptr;
+    if (flags & AVIO_FLAG_WRITE)
+        return AVERROR(EPERM);
+    return static_cast<FFmpegHLSSession*>(format->opaque)->openURL(pb, url, options ? *options : nullptr);
+}
+
+int FFmpegHLSSession::ioClose(AVFormatContext* format, AVIOContext* pb)
+{
+    if (pb)
+        static_cast<FFmpegHLSSession*>(format->opaque)->closeInput(pb);
+    return 0;
+}
+
+int FFmpegHLSSession::readMaster(void* opaque, uint8_t* buffer, int size)
+{
+    auto* session = static_cast<FFmpegHLSSession*>(opaque);
+    size_t left = session->m_masterText.size() - session->m_masterPosition;
+    if (!left)
+        return AVERROR_EOF;
+    size_t n = std::min<size_t>(left, size);
+    memcpy(buffer, session->m_masterText.data() + session->m_masterPosition, n);
+    session->m_masterPosition += n;
+    return n;
+}
+
+int FFmpegHLSSession::readMemory(void* opaque, uint8_t* buffer, int size)
+{
+    auto* input = static_cast<Input*>(opaque);
+    size_t left = input->memory.size() - input->memoryPosition;
+    if (!left)
+        return AVERROR_EOF;
+    size_t n = std::min<size_t>(left, size);
+    memcpy(buffer, input->memory.data() + input->memoryPosition, n);
+    input->memoryPosition += n;
+    return n;
+}
+
+// AES-128-CBC over the stream: whole blocks are decrypted as they arrive, except the last one
+// seen, which may be the final (padded) block until the stream's end is known
+int FFmpegHLSSession::readDecrypted(void* opaque, uint8_t* buffer, int size)
+{
+    auto* input = static_cast<Input*>(opaque);
+    while (input->plainPosition == input->plain.size()) {
+        if (input->cipherEnd)
+            return AVERROR_EOF;
+        uint8_t chunk[16 * 1024];
+        int n = avio_read(input->stream->avioContext(), chunk, sizeof(chunk));
+        if (n == AVERROR_EOF || !n)
+            input->cipherEnd = true;
+        else if (n < 0)
+            return n;
+        else
+            input->cipher.append(std::span<const uint8_t> { chunk, static_cast<size_t>(n) });
+        size_t blocks = input->cipher.size() / 16;
+        if (input->cipherEnd) {
+            if (input->cipher.size() % 16) {
+                input->session->log("error hls-aes ciphertext of %zu bytes is not whole blocks", input->cipher.size());
+                return AVERROR_INVALIDDATA;
+            }
+        } else {
+            // keep the last whole block (and any part of the next) until more arrives
+            if (blocks < 2)
+                continue;
+            blocks--;
+        }
+        input->plain.resize(blocks * 16);
+        input->plainPosition = 0;
+        if (blocks) {
+            av_aes_crypt(input->aes, input->plain.mutableSpan().data(), input->cipher.span().data(), blocks, input->iv, 1);
+            input->cipher.removeAt(0, blocks * 16);
+        }
+        if (input->cipherEnd && !input->plain.isEmpty()) {
+            // PKCS#7 padding
+            unsigned pad = input->plain.last();
+            if (pad >= 1 && pad <= 16 && pad <= input->plain.size())
+                input->plain.shrink(input->plain.size() - pad);
+        }
+    }
+    size_t n = std::min<size_t>(size, input->plain.size() - input->plainPosition);
+    memcpy(buffer, input->plain.span().data() + input->plainPosition, n);
+    input->plainPosition += n;
+    return n;
+}
+
+int FFmpegHLSSession::openURL(AVIOContext** pb, const char* spec, AVDictionary* options)
+{
+    if (m_cancelled)
+        return AVERROR_EXIT;
+    // AES-128 segments come as "crypto+<url>" (or "crypto:<url>"), the key and IV as options
+    bool crypto = false;
+    if (!strncmp(spec, "crypto+", 7) || !strncmp(spec, "crypto:", 7)) {
+        spec += 7;
+        crypto = true;
+    }
+    URL url { String::fromUTF8(spec) };
+    if (!url.isValid()) {
+        log("error hls-url invalid url=%s", spec);
+        return AVERROR(EINVAL);
+    }
+    // the browser's loader serves http(s); a local playlist may name local files
+    if (!url.protocolIsInHTTPFamily() && !(url.protocolIsFile() && m_url.protocolIsFile())) {
+        log("error hls-url refused scheme url=%s", spec);
+        return AVERROR(EPERM);
+    }
+    if (!crypto && (m_playlistURLs.contains(url.string()) || isPlaylistPath(url)))
+        return openPlaylist(pb, url);
+    return openMedia(pb, url, options, crypto);
+}
+
+int FFmpegHLSSession::openPlaylist(AVIOContext** pb, const URL& url)
+{
+    CString urlUTF8 = url.string().utf8();
+    auto stream = FFmpegMediaStream::create(url, RefPtr { m_loader }, kPlaylistMax);
+    if (!stream) {
+        log("error hls-playlist open-failed url=%s", urlUTF8.data());
+        return AVERROR(EIO);
+    }
+    auto owned = makeUnique<Input>();
+    Input* input = owned.get();
+    input->session = this;
+    input->stream = stream;
+    if (!addInput(WTF::move(owned))) {
+        stream->cancel();
+        return AVERROR_EXIT;
+    }
+
+    // the whole playlist (the stream's read wakes on cancel())
+    Vector<uint8_t> bytes;
+    AVIOContext* avio = stream->avioContext();
+    int ret = avio ? 0 : AVERROR(ENOMEM);
+    while (!ret) {
+        uint8_t chunk[16 * 1024];
+        int n = avio_read(avio, chunk, sizeof(chunk));
+        if (n == AVERROR_EOF || !n)
+            break;
+        if (n < 0)
+            ret = n;
+        else if (bytes.size() + n > kPlaylistMax)
+            ret = AVERROR(E2BIG);
+        else
+            bytes.append(std::span<const uint8_t> { chunk, static_cast<size_t>(n) });
+    }
+    URL base = stream->responseURL();
+    if (ret < 0 || bytes.isEmpty()) {
+        if (!m_cancelled)
+            log("error hls-playlist read rc=%d (%s) bytes=%zu url=%s", ret, ret < 0 ? av_err2str(ret) : "empty", bytes.size(), urlUTF8.data());
+        removeInput(input);
+        return ret < 0 ? ret : AVERROR_INVALIDDATA;
+    }
+
+    // every URI absolute (against the URL after redirects): the demuxer then opens exactly the
+    // URLs listed here, and the key URLs below are the ones it will ask for
+    std::string_view text { reinterpret_cast<const char*>(bytes.span().data()), bytes.size() };
+    std::string resolved = FFmpegMediaPolicy::resolveMediaPlaylist(text, resolveAgainst, &base);
+    auto info = FFmpegMediaPolicy::parseMediaPlaylist(resolved);
+    unsigned& loads = m_playlistLoads.add(url.string(), 0).iterator->value;
+    loads++;
+    bool main = url.string() == m_mainPlaylistURL;
+    if (loads == 1) {
+        log("hls playlist url=%s main=%d bytes=%zu", urlUTF8.data(), main, bytes.size());
+        log("hls live=%d segments=%u target=%.1f duration=%.1f media-sequence=%lld discontinuities=%u byterange=%d init=%d aes128=%d",
+            !info.ended, info.segments, info.targetDuration, info.totalDuration, static_cast<long long>(info.mediaSequence),
+            info.discontinuities, info.byteRanges, info.initSection, info.aes128);
+    } else if (loads <= 20 || !(loads % 10))
+        log("hls reload n=%u main=%d live=%d segments=%u media-sequence=%lld url=%s", loads - 1, main, !info.ended, info.segments,
+            static_cast<long long>(info.mediaSequence), urlUTF8.data());
+    if (!info.refusedKey.empty()) {
+        log("error hls-encryption=%s unsupported (only AES-128 with the identity key format) url=%s", info.refusedKey.c_str(), urlUTF8.data());
+        removeInput(input);
+        return AVERROR(ENOSYS);
+    }
+    for (auto& uri : info.keyURIs)
+        m_keyURLs.add(fromStd(uri));
+    for (auto& uri : info.initURIs)
+        m_initURLs.add(fromStd(uri));
+    if (main)
+        m_live = !info.ended;
+
+    // the stream is done with: the demuxer reads the text from memory
+    auto* buffer = static_cast<unsigned char*>(av_malloc(kMemoryIOBufferSize));
+    AVIOContext* memory = buffer ? avio_alloc_context(buffer, kMemoryIOBufferSize, 0, input, readMemory, nullptr, nullptr) : nullptr;
+    if (!memory) {
+        av_free(buffer);
+        removeInput(input);
+        return AVERROR(ENOMEM);
+    }
+    RefPtr<FFmpegMediaStream> done;
+    {
+        Locker locker { m_lock };
+        if (main)
+            m_playlistSegments = info.segments;
+        if (loads > 1)
+            m_reloads++;
+        m_closedReceived += stream->bytesReceived();
+        done = WTF::move(input->stream);
+        input->memory = WTF::move(resolved);
+        input->avio = memory;
+        input->ownsAVIO = true;
+    }
+    done->cancel();
+    *pb = memory;
+    return 0;
+}
+
+int FFmpegHLSSession::openMedia(AVIOContext** pb, const URL& url, AVDictionary* options, bool crypto)
+{
+    bool key = m_keyURLs.contains(url.string());
+    bool init = m_initURLs.contains(url.string());
+    // a byte range (EXT-X-BYTERANGE) comes as offset/end_offset; hls.c passes a ranged segment's
+    // options to its key's request too, so a key URL takes none
+    std::optional<FFmpegMediaStream::Range> range;
+    if (!key) {
+        AVDictionaryEntry* offset = av_dict_get(options, "offset", nullptr, 0);
+        AVDictionaryEntry* end = av_dict_get(options, "end_offset", nullptr, 0);
+        if (offset && end) {
+            long long start = atoll(offset->value), stop = atoll(end->value);
+            if (start >= 0 && stop > start)
+                range = FFmpegMediaStream::Range { static_cast<uint64_t>(start), static_cast<uint64_t>(stop) };
+        }
+    }
+    CString urlUTF8 = url.string().utf8();
+    unsigned opens;
+    {
+        Locker locker { m_lock };
+        if (!key && !init)
+            m_segments++;
+        opens = ++m_openLogs;
+    }
+    if (opens <= kOpenLogs || !(opens % 50)) {
+        log("hls open n=%u url=%s range=%lld-%lld crypto=%d kind=%s", opens, urlUTF8.data(), range ? static_cast<long long>(range->start) : 0LL,
+            range ? static_cast<long long>(range->end) : -1LL, crypto, key ? "key" : init ? "init" : "segment");
+    }
+
+    auto stream = FFmpegMediaStream::create(url, RefPtr { m_loader }, key ? kKeyMaxAhead : segmentAhead(), range);
+    if (!stream) {
+        log("error hls-open-failed url=%s", urlUTF8.data());
+        return AVERROR(EIO);
+    }
+    auto input = makeUnique<Input>();
+    input->session = this;
+    input->stream = stream;
+    input->segment = !key;
+    if (crypto) {
+        uint8_t keyBytes[16];
+        AVDictionaryEntry* keyOption = av_dict_get(options, "key", nullptr, 0);
+        AVDictionaryEntry* ivOption = av_dict_get(options, "iv", nullptr, 0);
+        if (!parseHex16(keyOption ? keyOption->value : nullptr, keyBytes) || !parseHex16(ivOption ? ivOption->value : nullptr, input->iv)) {
+            log("error hls-aes no key or iv url=%s", urlUTF8.data());
+            stream->cancel();
+            return AVERROR(EINVAL);
+        }
+        input->aes = av_aes_alloc();
+        auto* buffer = static_cast<unsigned char*>(av_malloc(kIOBufferSize));
+        if (input->aes)
+            av_aes_init(input->aes, keyBytes, 128, 1);
+        input->avio = input->aes && buffer ? avio_alloc_context(buffer, kIOBufferSize, 0, input.get(), readDecrypted, nullptr, nullptr) : nullptr;
+        if (!input->avio)
+            av_free(buffer);
+        input->ownsAVIO = true;
+    } else
+        input->avio = stream->avioContext();
+    if (!input->avio) {
+        stream->cancel();
+        return AVERROR(ENOMEM);
+    }
+    AVIOContext* avio = input->avio;
+    if (!addInput(WTF::move(input))) {
+        stream->cancel();
+        return AVERROR_EXIT;
+    }
+    *pb = avio;
+    return 0;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
