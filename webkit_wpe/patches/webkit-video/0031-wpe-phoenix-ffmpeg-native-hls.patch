+
+#if ENABLE(VIDEO) && USE(FFMPEG)
+#include "ContentType.h"
+#include "FFmpegMediaPolicy.h"
+#include "MediaPlayerPrivateFFmpeg.h"
+#include "PlatformMediaCapabilitiesDecodingInfo.h"
+#include "PlatformMediaDecodingConfiguration.h"
+#include <atomic>
+#include <cstdio>
+#include <time.h>
+#include <wtf/HashSet.h>
+#include <wtf/text/CString.h>
+
+namespace WebCore {
+
+static const char* configurationTypeName(PlatformMediaDecodingType type)
+{
+    switch (type) {
+    case PlatformMediaDecodingType::FileOrHLS:
+        return "file";
+    case PlatformMediaDecodingType::MediaSource:
+        return "media-source";
+    case PlatformMediaDecodingType::MediaStream:
+        return "media-stream";
+    }
+    return "?";
+}
+
+void createMediaPlayerDecodingConfigurationFFmpeg(PlatformMediaDecodingConfiguration&& configuration, Function<void(PlatformMediaCapabilitiesDecodingInfo&&)>&& callback)
+{
+    // the engine's types (empty with WPE_PHOENIX_MEDIA_DISABLE=1)
+    HashSet<String> types;
+    MediaPlayerPrivateFFmpeg::getSupportedTypes(types);
+    bool typeSupported = configuration.type == PlatformMediaDecodingType::FileOrHLS;
+#if ENABLE(MEDIA_SOURCE)
+    typeSupported |= configuration.type == PlatformMediaDecodingType::MediaSource;
+#endif
+    FFmpegMediaPolicy::Capability result { typeSupported && !types.isEmpty() && (configuration.video || configuration.audio), true, true };
+    auto combine = [&](FFmpegMediaPolicy::Capability capability) {
+        result.supported &= capability.supported;
+        result.smooth &= capability.smooth;
+        result.powerEfficient &= capability.powerEfficient;
+    };
+    auto containerSupported = [&](const ContentType& type) {
+        return types.contains(type.containerType().convertToASCIILowercase());
+    };
+
+    String videoCodec = "-"_s, audioCodec = "-"_s;
+    if (auto& video = configuration.video) {
+        ContentType type { video->contentType };
+        auto codecs = type.codecs();
+        if (!containerSupported(type) || codecs.size() != 1)
+            combine({ });
+        else {
+            videoCodec = codecs[0];
+            auto kind = FFmpegMediaPolicy::classifyCodec(videoCodec.utf8().data());
+            auto capability = FFmpegMediaPolicy::isVideoCodec(kind) ? FFmpegMediaPolicy::videoCapability(kind, video->width, video->height, video->framerate)
+                : FFmpegMediaPolicy::Capability { };
+            // no HDR output
+            if ((video->transferFunction && *video->transferFunction != PlatformMediaCapabilitiesTransferFunction::SRGB) || video->hdrMetadataType)
+                capability = { };
+            combine(capability);
+        }
+    }
+    if (auto& audio = configuration.audio) {
+        ContentType type { audio->contentType };
+        auto codecs = type.codecs();
+        if (!containerSupported(type) || codecs.size() > 1)
+            combine({ });
+        else if (!codecs.isEmpty()) {
+            audioCodec = codecs[0];
+            combine(FFmpegMediaPolicy::audioCapability(FFmpegMediaPolicy::classifyCodec(audioCodec.utf8().data())));
+        }
+        // (a single-codec container without codecs: audio/mpeg, audio/flac, ...: as the container)
+        if (audio->spatialRendering.value_or(false))
+            combine({ }); // everything is mixed down to stereo
+    }
+
+    PlatformMediaCapabilitiesDecodingInfo info;
+    info.supported = result.supported;
+    info.smooth = result.supported && result.smooth;
+    info.powerEfficient = result.supported && result.powerEfficient;
+
+    static std::atomic<unsigned> logged { 0 };
+    if (logged++ < 200) {
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        fprintf(stderr, "WPEB-MEDIA mono=%llu capabilities type=%s codec=%s %ux%u@%.0f audio=%s supported=%d smooth=%d efficient=%d\n",
+            static_cast<unsigned long long>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000, configurationTypeName(configuration.type), videoCodec.utf8().data(),
+            configuration.video ? configuration.video->width : 0, configuration.video ? configuration.video->height : 0,
+            configuration.video ? configuration.video->framerate : 0, audioCodec.utf8().data(), info.supported, info.smooth, info.powerEfficient);
+    }
+
+    info.configuration = WTF::move(configuration);
+    callback(WTF::move(info));
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
