+namespace WebCore {
+namespace FFmpegMediaPolicy {
+
+/* --- codecs ------------------------------------------------------------------------------- */
+
+enum class CodecKind : uint8_t {
+    Unknown,
+    // video
+    H264,
+    HEVCMain,         // Main and Main Still Picture: 8-bit 4:2:0 (the rpivid block)
+    HEVCMain10,       // 10-bit: decodes, converted to 8-bit on the CPU
+    HEVCOther,        // range extensions and the rest: not offered
+    VP8,
+    VP9Profile0,
+    VP9Other,         // profiles 1-3 (4:4:4, 10/12-bit): not offered
+    AV1,              // no decoder in this build
+    DolbyVision,      // dvh1/dvhe/dva1/dvav: HDR, no output for it
+    MPEG4Visual,
+    // audio
+    AAC,
+    MP3,
+    Opus,
+    Vorbis,
+    FLAC,
+    AC3,
+    EAC3,
+    UnsupportedAudio, // ac-4, mha1, ...
+};
+
+CodecKind classifyCodec(std::string_view);
+const char* codecKindName(CodecKind);
+bool isVideoCodec(CodecKind);
+bool isAudioCodec(CodecKind);
+// the build has a decoder for it and it is worth offering (canPlayType "probably")
+bool canDecode(CodecKind);
+
+struct Capability {
+    bool supported { false };
+    bool smooth { false };
+    bool powerEfficient { false };
