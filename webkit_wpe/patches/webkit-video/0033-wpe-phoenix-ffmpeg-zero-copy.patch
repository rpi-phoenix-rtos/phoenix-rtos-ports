+bool CoordinatedPlatformLayerBufferFFmpeg::isZeroCopyFrame(const AVFrame& frame)
+{
+    return frame.format == AV_PIX_FMT_DRM_PRIME;
+}
+
+#if HAVE_RPIVID_ZERO_COPY
+// The one DRM_PRIME layout this buffer can show: hevc_rpivid's (rpivid_drm.h), one buffer
+// holding an NV12 layer of two planes
+static bool isRpividFrame(const AVFrame& frame)
+{
+    auto* descriptor = reinterpret_cast<const AVDRMFrameDescriptor*>(frame.data[0]);
+    static constexpr uint32_t nv12 = 'N' | ('V' << 8) | ('1' << 16) | ('2' << 24);
+    return descriptor && descriptor->nb_objects == 1 && descriptor->nb_layers == 1 && descriptor->layers[0].format == nv12
+        && descriptor->layers[0].nb_planes == 2;
+}
+#endif
+
+bool CoordinatedPlatformLayerBufferFFmpeg::requestZeroCopy(AVCodecContext& context, AVDictionary** options)
+{
+#if HAVE_RPIVID_ZERO_COPY
+    if (!context.codec || strcmp(context.codec->name, "hevc_rpivid"))
+        return false;
+    const char* knob = getenv("WPE_PHOENIX_MEDIA_ZERO_COPY");
+    if (!knob || strcmp(knob, "1"))
+        return false;
+    static std::once_flag once;
+    static bool available;
+    std::call_once(once, [] {
+        auto& extensions = PlatformDisplay::sharedDisplay().eglExtensions();
+        const char* why = nullptr;
+        int rc = 0;
+        if (!extensions.EXT_image_dma_buf_import || !extensions.EXT_image_dma_buf_import_modifiers)
+            why = "no EGL_EXT_image_dma_buf_import_modifiers";
+        else if ((rc = rpivid_bo_drm_install()) < 0)
+            why = "no render node for GPU picture buffers";
+        available = !why;
+        fprintf(stderr, "WPEB-MEDIA zero-copy %s%s%s (rc=%d)\n", available ? "available" : "unavailable", why ? ": " : "", why ? why : "", rc);
+    });
+    if (!available)
+        return false;
+    // the block's buffers as the frames (rpivid_drm.h); that output needs no frame threads
+    context.thread_type = FF_THREAD_SLICE;
+    av_dict_set(options, "rpivid_out", "drm_prime", 0);
+    return true;
+#else
+    UNUSED_PARAM(context);
+    UNUSED_PARAM(options);
+    return false;
+#endif
+}
