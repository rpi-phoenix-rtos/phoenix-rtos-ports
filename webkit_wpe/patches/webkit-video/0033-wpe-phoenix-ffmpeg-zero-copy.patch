+#if HAVE_RPIVID_ZERO_COPY
+namespace {
+
+// The EGLImages of the decoders' picture buffers and their GL_TEXTURE_EXTERNAL_OES textures,
+// one per buffer: a texture made per picture would make Mesa allocate a new tiled shadow of
+// the picture (~3 MB at 1080p, through the render server) every frame. Per compositing
+// thread (each has its own GL context), touched only by it. A buffer is named by its dma-buf's
+// st_dev/st_ino (the render server's BO handle, never reused), so an entry cannot outlive its
+// buffer's identity; the import keeps the BO alive, so entries unused for a while (a decoder
+// closed, a video gone) are dropped.
+struct ZeroCopyImage {
+    dev_t dev { 0 };
+    ino_t ino { 0 };
+    int width { 0 };
+    int height { 0 };
+    int colorspace { 0 };
+    int range { 0 };
+    EGLImage image { EGL_NO_IMAGE };
+    GLuint texture { 0 };
+    MonotonicTime lastUse;
+};
+
+struct ZeroCopyCache {
+    Vector<ZeroCopyImage> entries;
+    bool importFailureLogged { false };
+};
+
+static constexpr size_t zeroCopyCacheMax = 48;
+static constexpr Seconds zeroCopyIdle = 3_s;
+
+static thread_local ZeroCopyCache* zeroCopyCache;
+
+static void releaseZeroCopyImage(ZeroCopyImage& entry)
+{
+    if (entry.texture)
+        glDeleteTextures(1, &entry.texture);
+    if (entry.image != EGL_NO_IMAGE)
+        PlatformDisplay::sharedDisplay().destroyEGLImage(entry.image);
+    entry.texture = 0;
+    entry.image = EGL_NO_IMAGE;
+}
+
+static EGLAttrib yuvColorSpaceHint(const AVFrame& frame)
+{
+    switch (frame.colorspace) {
+    case AVCOL_SPC_BT470BG:
+    case AVCOL_SPC_SMPTE170M:
+        return EGL_ITU_REC601_EXT;
+    case AVCOL_SPC_BT709:
+        return EGL_ITU_REC709_EXT;
+    case AVCOL_SPC_BT2020_NCL:
+    case AVCOL_SPC_BT2020_CL:
+        return EGL_ITU_REC2020_EXT;
+    default:
+        // unspecified: BT.709 for HD, BT.601 for SD (what players assume)
+        return frame.height >= 720 ? EGL_ITU_REC709_EXT : EGL_ITU_REC601_EXT;
+    }
+}
+
+// The texture of the frame's buffer, imported on first use; 0 when it cannot be imported
+static GLuint zeroCopyTexture(const AVFrame& frame)
+{
+    auto* descriptor = reinterpret_cast<const AVDRMFrameDescriptor*>(frame.data[0]);
+    if (!descriptor || descriptor->nb_objects != 1 || descriptor->nb_layers != 1 || descriptor->layers[0].nb_planes != 2
+        || descriptor->objects[0].fd < 0 || frame.crop_left || frame.crop_top)
+        return 0;
+    struct stat st;
+    if (fstat(descriptor->objects[0].fd, &st) < 0)
+        return 0;
+
+    if (!zeroCopyCache)
+        zeroCopyCache = new ZeroCopyCache;
+    auto& cache = *zeroCopyCache;
+    auto now = MonotonicTime::now();
+    int range = frame.color_range == AVCOL_RANGE_JPEG ? 1 : 0;
+    // drop what nothing drew for a while, and find this buffer
+    ZeroCopyImage* found = nullptr;
+    for (size_t i = cache.entries.size(); i-- > 0;) {
+        auto& entry = cache.entries[i];
+        if (entry.dev == st.st_dev && entry.ino == st.st_ino && entry.width == frame.width && entry.height == frame.height
+            && entry.colorspace == frame.colorspace && entry.range == range) {
+            found = &entry;
+            continue;
+        }
+        if (now - entry.lastUse > zeroCopyIdle) {
+            releaseZeroCopyImage(entry);
+            cache.entries.removeAt(i);
+            found = nullptr; // indices moved: look again below
+        }
+    }
+    if (!found) {
+        for (auto& entry : cache.entries) {
+            if (entry.dev == st.st_dev && entry.ino == st.st_ino && entry.width == frame.width && entry.height == frame.height
+                && entry.colorspace == frame.colorspace && entry.range == range) {
+                found = &entry;
+                break;
+            }
+        }
+    }
+    if (found) {
+        found->lastUse = now;
+        return found->texture;
+    }
+
+    const auto& layer = descriptor->layers[0];
+    uint64_t modifier = descriptor->objects[0].format_modifier;
+    Vector<EGLAttrib> attributes {
+        EGL_WIDTH, frame.width,
+        EGL_HEIGHT, frame.height,
+        EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLAttrib>(layer.format),
+        EGL_DMA_BUF_PLANE0_FD_EXT, descriptor->objects[layer.planes[0].object_index].fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLAttrib>(layer.planes[0].offset),
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLAttrib>(layer.planes[0].pitch),
+        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, static_cast<EGLAttrib>(modifier & 0xffffffff),
+        EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, static_cast<EGLAttrib>(modifier >> 32),
+        EGL_DMA_BUF_PLANE1_FD_EXT, descriptor->objects[layer.planes[1].object_index].fd,
+        EGL_DMA_BUF_PLANE1_OFFSET_EXT, static_cast<EGLAttrib>(layer.planes[1].offset),
+        EGL_DMA_BUF_PLANE1_PITCH_EXT, static_cast<EGLAttrib>(layer.planes[1].pitch),
+        EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT, static_cast<EGLAttrib>(modifier & 0xffffffff),
+        EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT, static_cast<EGLAttrib>(modifier >> 32),
+        EGL_YUV_COLOR_SPACE_HINT_EXT, yuvColorSpaceHint(frame),
+        EGL_SAMPLE_RANGE_HINT_EXT, range ? EGL_YUV_FULL_RANGE_EXT : EGL_YUV_NARROW_RANGE_EXT,
+        EGL_NONE
+    };
+    auto& display = PlatformDisplay::sharedDisplay();
+    EGLImage image = display.createEGLImage(EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attributes);
+    if (!image) {
+        if (!cache.importFailureLogged) {
+            cache.importFailureLogged = true;
+            fprintf(stderr, "WPEB-MEDIA zero-copy import failed (EGL 0x%x) %dx%d modifier=0x%016llx: CPU readback\n", eglGetError(),
+                frame.width, frame.height, static_cast<unsigned long long>(modifier));
+        }
+        return 0;
+    }
+    GLuint texture = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, texture);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, image);
+    GLenum error = glGetError();
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+    if (error != GL_NO_ERROR) {
+        glDeleteTextures(1, &texture);
+        display.destroyEGLImage(image);
+        if (!cache.importFailureLogged) {
+            cache.importFailureLogged = true;
+            fprintf(stderr, "WPEB-MEDIA zero-copy texture failed (GL 0x%x): CPU readback\n", error);
+        }
+        return 0;
+    }
+    if (cache.entries.size() >= zeroCopyCacheMax) {
+        size_t oldest = 0;
+        for (size_t i = 1; i < cache.entries.size(); ++i) {
+            if (cache.entries[i].lastUse < cache.entries[oldest].lastUse)
+                oldest = i;
+        }
+        releaseZeroCopyImage(cache.entries[oldest]);
+        cache.entries.removeAt(oldest);
+    }
+    cache.entries.append({ st.st_dev, st.st_ino, frame.width, frame.height, frame.colorspace, range, image, texture, now });
+    return texture;
+}
+
+} // namespace
+#endif
