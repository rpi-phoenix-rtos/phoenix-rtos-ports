+    return true;
+#else
+    UNUSED_PARAM(textureMapper);
+    UNUSED_PARAM(targetRect);
+    UNUSED_PARAM(modelViewMatrix);
+    UNUSED_PARAM(opacity);
+    return false;
+#endif
+}
