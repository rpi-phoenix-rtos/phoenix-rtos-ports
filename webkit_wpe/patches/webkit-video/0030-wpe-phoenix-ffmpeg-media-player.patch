+
+namespace WebCore {
+
+class PlatformMediaResource;
+class PlatformMediaResourceLoader;
+class ResourceResponse;
+
+// The bytes of a media resource for libavformat, read by the player's demux thread through
+// an AVIOContext. A local file (file://) is read directly; anything else goes through WebKit's
+// media resource loader (the network process; http, https, blob, data), the way GStreamer's
+// webkitwebsrc does: a seek outside the bytes already here is a new request with a Range
+// header, and a request is stopped while more than kMaxAhead bytes wait unread.
+class FFmpegMediaStream final : public ThreadSafeRefCounted<FFmpegMediaStream> {
+public:
+    // Main thread. nullptr if a local file cannot be opened.
+    static RefPtr<FFmpegMediaStream> create(const URL&, RefPtr<PlatformMediaResourceLoader>&&);
+    ~FFmpegMediaStream();
+
+    // The demux thread. The context is owned by the stream.
+    AVIOContext* avioContext();
+
+    // Any thread: wakes a blocked read, which then fails (AVERROR_EXIT). For teardown.
+    void cancel();
+
+    bool isLocalFile() const { return m_fd >= 0; }
+    uint64_t bytesReceived() const;
+    std::optional<uint64_t> size() const;
+    // Every byte of the resource arrived (a local file always).
+    bool isComplete() const;
+    const URL& url() const { return m_url; }
+
+    // The resource client's entry points (main thread).
+    void didReceiveResponse(unsigned request, const ResourceResponse&);
+    void didReceiveData(unsigned request, std::span<const uint8_t>);
+    void didFinish(unsigned request, bool failed);
+
+private:
+    FFmpegMediaStream(const URL&, int fd, RefPtr<PlatformMediaResourceLoader>&&);
+
+    static int readPacket(void*, uint8_t*, int);
+    static int64_t seekPacket(void*, int64_t, int);
+    int read(std::span<uint8_t>);
+    int64_t seek(int64_t, int whence);
+
+    void startRequestLocked(uint64_t position) WTF_REQUIRES_LOCK(m_lock);
+    void stopRequestLocked() WTF_REQUIRES_LOCK(m_lock);
+
+    const URL m_url;
+    const int m_fd { -1 };
+    RefPtr<PlatformMediaResourceLoader> m_loader;
+    AVIOContext* m_avio { nullptr };
+
+    mutable Lock m_lock;
+    Condition m_condition;
+    // m_buffer holds the resource's bytes [m_bufferStart, m_bufferStart + m_buffer.size())
+    Vector<uint8_t> m_buffer WTF_GUARDED_BY_LOCK(m_lock);
+    uint64_t m_bufferStart WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_position WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    uint64_t m_received WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    std::optional<uint64_t> m_size WTF_GUARDED_BY_LOCK(m_lock);
+    // bytes to drop at the head of a response that ignored the Range header (status 200)
+    uint64_t m_discard WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    unsigned m_request WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    bool m_requestActive WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_requestDone WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_failed WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_cancelled WTF_GUARDED_BY_LOCK(m_lock) { false };
+    // main thread only
+    RefPtr<PlatformMediaResource> m_resource;
+};
+
