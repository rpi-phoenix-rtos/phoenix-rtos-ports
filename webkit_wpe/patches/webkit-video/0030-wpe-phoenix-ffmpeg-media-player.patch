+    , m_frameCounters(FFmpegFrameCounters::create())
+    , m_statTimer(RunLoop::mainSingleton(), "MediaPlayerPrivateFFmpeg::StatTimer"_s, this, &MediaPlayerPrivateFFmpeg::statTimerFired)
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        av_log_set_callback(ffmpegLog);
+    });
+}
