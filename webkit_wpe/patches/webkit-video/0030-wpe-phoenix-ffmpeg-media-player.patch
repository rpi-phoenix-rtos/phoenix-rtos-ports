+static constexpr size_t kIOBufferSize = 64 * 1024;
+// a request is stopped while this much waits unread, and started again below kResumeAhead
+static constexpr uint64_t kMaxAhead = 16 * 1024 * 1024;
+static constexpr uint64_t kResumeAhead = 4 * 1024 * 1024;
+// bytes already read are dropped in steps of this, keeping kKeepBehind for short seeks back
+static constexpr uint64_t kCompactStep = 4 * 1024 * 1024;
+static constexpr uint64_t kKeepBehind = 1024 * 1024;
+
+class FFmpegMediaStreamClient final : public PlatformMediaResourceClient {
+public:
+    static Ref<FFmpegMediaStreamClient> create(FFmpegMediaStream& stream, unsigned request) { return adoptRef(*new FFmpegMediaStreamClient(stream, request)); }
+
+private:
+    FFmpegMediaStreamClient(FFmpegMediaStream& stream, unsigned request)
+        : m_stream(stream)
+        , m_request(request)
+    {
+    }
+
+    void responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler) final
+    {
+        m_stream->didReceiveResponse(m_request, response);
+        completionHandler(ShouldContinuePolicyCheck::Yes);
+    }
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& data) final
+    {
+        data.forEachSegment([&](std::span<const uint8_t> segment) {
+            m_stream->didReceiveData(m_request, segment);
+        });
+    }
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final { m_stream->didFinish(m_request, true); }
+    void loadFailed(PlatformMediaResource&, const ResourceError& error) final { m_stream->didFinish(m_request, !error.isCancellation()); }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final { m_stream->didFinish(m_request, false); }
+
+    Ref<FFmpegMediaStream> m_stream;
+    unsigned m_request;
+};
+
+RefPtr<FFmpegMediaStream> FFmpegMediaStream::create(const URL& url, RefPtr<PlatformMediaResourceLoader>&& loader)
+{
+    ASSERT(isMainThread());
+    int fd = -1;
+    if (url.protocolIsFile()) {
+        fd = open(url.fileSystemPath().utf8().data(), O_RDONLY);
+        if (fd < 0)
+            return nullptr;
+    } else if (!loader)
+        return nullptr;
+    return adoptRef(*new FFmpegMediaStream(url, fd, WTF::move(loader)));
+}
+
+FFmpegMediaStream::FFmpegMediaStream(const URL& url, int fd, RefPtr<PlatformMediaResourceLoader>&& loader)
+    : m_url(url)
+    , m_fd(fd)
+    , m_loader(WTF::move(loader))
+{
+    if (m_fd >= 0) {
+        struct stat st;
+        if (!fstat(m_fd, &st) && st.st_size > 0) {
+            Locker locker { m_lock };
+            m_size = st.st_size;
+            m_received = st.st_size;
+        }
+        return;
+    }
+    Locker locker { m_lock };
+    startRequestLocked(0);
+}
+
+FFmpegMediaStream::~FFmpegMediaStream()
+{
+    if (m_avio) {
+        av_freep(&m_avio->buffer);
+        avio_context_free(&m_avio);
+    }
+    if (m_fd >= 0)
+        close(m_fd);
+    // cancel() released the resource (while it is held, its client keeps this stream alive)
+    ASSERT(!m_resource);
+}
+
+AVIOContext* FFmpegMediaStream::avioContext()
+{
+    if (m_avio)
+        return m_avio;
+    auto* buffer = static_cast<unsigned char*>(av_malloc(kIOBufferSize));
+    if (!buffer)
+        return nullptr;
+    m_avio = avio_alloc_context(buffer, kIOBufferSize, 0, this, readPacket, nullptr, seekPacket);
+    if (!m_avio) {
+        av_free(buffer);
+        return nullptr;
+    }
+    // libavformat may seek as long as the size is known (the moov box at a file's end)
+    m_avio->seekable = size() ? AVIO_SEEKABLE_NORMAL : 0;
+    return m_avio;
+}
+
+// The resource holds its client, and the client the stream: the reference cycle is broken here
+// (teardown) and when a request replaces another.
+static void releaseResource(RefPtr<PlatformMediaResource>&& resource)
+{
+    ASSERT(isMainThread());
+    if (!resource)
+        return;
+    resource->setClient(nullptr);
+    resource->shutdown();
+}
+
+void FFmpegMediaStream::cancel()
+{
+    {
+        Locker locker { m_lock };
+        m_cancelled = true;
+        ++m_request;
+        m_condition.notifyAll();
+    }
+    if (m_fd >= 0)
+        return;
+    callOnMainThread([protectedThis = Ref { *this }] {
+        releaseResource(WTF::move(protectedThis->m_resource));
+    });
+}
+
+uint64_t FFmpegMediaStream::bytesReceived() const
+{
+    Locker locker { m_lock };
+    return m_received;
+}
+
+std::optional<uint64_t> FFmpegMediaStream::size() const
+{
+    Locker locker { m_lock };
+    return m_size;
+}
+
+bool FFmpegMediaStream::isComplete() const
+{
+    Locker locker { m_lock };
+    return m_size && m_received >= *m_size;
+}
+
+int FFmpegMediaStream::readPacket(void* opaque, uint8_t* data, int size)
+{
+    return static_cast<FFmpegMediaStream*>(opaque)->read({ data, static_cast<size_t>(size) });
+}
+
+int64_t FFmpegMediaStream::seekPacket(void* opaque, int64_t offset, int whence)
+{
+    return static_cast<FFmpegMediaStream*>(opaque)->seek(offset, whence);
+}
+
+int FFmpegMediaStream::read(std::span<uint8_t> out)
+{
+    if (m_fd >= 0) {
+        uint64_t position;
+        {
+            Locker locker { m_lock };
+            if (m_cancelled)
+                return AVERROR_EXIT;
+            position = m_position;
+        }
+        ssize_t n = pread(m_fd, out.data(), out.size(), position);
+        if (n < 0)
+            return AVERROR(errno);
+        if (!n)
+            return AVERROR_EOF;
+        Locker locker { m_lock };
+        m_position = position + n;
+        return n;
+    }
+
+    Locker locker { m_lock };
+    while (true) {
+        if (m_cancelled)
+            return AVERROR_EXIT;
+        uint64_t end = m_bufferStart + m_buffer.size();
+        if (m_position >= m_bufferStart && m_position < end) {
+            size_t offset = m_position - m_bufferStart;
+            size_t n = std::min<size_t>(out.size(), m_buffer.size() - offset);
+            memcpy(out.data(), m_buffer.span().subspan(offset).data(), n);
+            m_position += n;
+            if (m_position - m_bufferStart > kCompactStep + kKeepBehind) {
+                size_t drop = m_position - m_bufferStart - kKeepBehind;
+                m_buffer.removeAt(0, drop);
+                m_bufferStart += drop;
+            }
+            // flow control: a request stopped with enough unread is started again
+            if (!m_requestActive && !m_requestDone && end - m_position < kResumeAhead)
+                startRequestLocked(end);
+            return n;
+        }
+        if (m_size && m_position >= *m_size)
+            return AVERROR_EOF;
+        if (m_position != end) {
+            // outside the bytes here: read from there
+            m_buffer.clear();
+            m_bufferStart = m_position;
+            startRequestLocked(m_position);
+            continue;
+        }
+        if (m_requestDone)
+            return m_failed ? AVERROR(EIO) : AVERROR_EOF;
+        if (!m_requestActive)
+            startRequestLocked(end);
+        m_condition.wait(m_lock);
+    }
+}
+
+int64_t FFmpegMediaStream::seek(int64_t offset, int whence)
+{
+    Locker locker { m_lock };
+    if ((whence & ~AVSEEK_FORCE) == AVSEEK_SIZE)
+        return m_size ? static_cast<int64_t>(*m_size) : AVERROR(ENOSYS);
+    int64_t base = 0;
+    switch (whence & ~AVSEEK_FORCE) {
+    case SEEK_SET:
+        break;
+    case SEEK_CUR:
+        base = m_position;
+        break;
+    case SEEK_END:
+        if (!m_size)
+            return AVERROR(ENOSYS);
+        base = *m_size;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+    if (base + offset < 0)
+        return AVERROR(EINVAL);
+    // the next read starts a request there if needed
+    m_position = base + offset;
+    return m_position;
+}
+
+void FFmpegMediaStream::startRequestLocked(uint64_t position)
+{
+    ASSERT(m_fd < 0);
+    unsigned request = ++m_request;
+    m_requestActive = true;
+    m_requestDone = false;
+    m_failed = false;
+    m_discard = 0;
+    if (position != m_bufferStart + m_buffer.size()) {
+        m_buffer.clear();
+        m_bufferStart = position;
+    }
+    callOnMainThread([protectedThis = Ref { *this }, request, position] {
+        releaseResource(WTF::move(protectedThis->m_resource));
+        {
+            Locker locker { protectedThis->m_lock };
+            if (protectedThis->m_request != request || protectedThis->m_cancelled)
+                return;
+        }
+        ResourceRequest resourceRequest(URL { protectedThis->m_url });
+        resourceRequest.setAllowCookies(true);
+        if (position)
+            resourceRequest.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, position, '-'));
+#if USE(SOUP)
+        // the Content-Length must be the bytes we get
+        resourceRequest.setAcceptEncoding(false);
+#endif
+        auto resource = protectedThis->m_loader->requestResource(WTF::move(resourceRequest), 0);
+        if (!resource) {
+            protectedThis->didFinish(request, true);
+            return;
+        }
+        resource->setClient(FFmpegMediaStreamClient::create(protectedThis.get(), request));
+        protectedThis->m_resource = WTF::move(resource);
+    });
+}
+
+void FFmpegMediaStream::stopRequestLocked()
+{
+    m_requestActive = false;
+    ++m_request; // late data of the stopped request is ignored
+    callOnMainThread([protectedThis = Ref { *this }] {
+        releaseResource(WTF::move(protectedThis->m_resource));
+    });
+}
+
+void FFmpegMediaStream::didReceiveResponse(unsigned request, const ResourceResponse& response)
+{
+    ASSERT(isMainThread());
+    Locker locker { m_lock };
+    if (request != m_request)
+        return;
+    bool partial = response.httpStatusCode() == httpStatus206PartialContent;
+    uint64_t length = response.httpHeaderFields().contains(HTTPHeaderName::ContentEncoding) ? 0 : response.expectedContentLength();
+    if (m_bufferStart && !partial) {
+        // the server ignored the Range header: the body starts at 0
+        m_discard = m_bufferStart;
+    }
+    if (length && !m_size)
+        m_size = partial ? m_bufferStart + length : length;
+}
+
+void FFmpegMediaStream::didReceiveData(unsigned request, std::span<const uint8_t> data)
+{
+    ASSERT(isMainThread());
+    Locker locker { m_lock };
+    if (request != m_request)
+        return;
+    if (m_discard) {
+        size_t skip = std::min<uint64_t>(m_discard, data.size());
+        m_discard -= skip;
+        data = data.subspan(skip);
+    }
+    if (data.empty())
+        return;
+    m_buffer.append(data);
+    m_received += data.size();
+    m_condition.notifyAll();
+    if (m_bufferStart + m_buffer.size() - std::max(m_position, m_bufferStart) > kMaxAhead)
+        stopRequestLocked();
+}
+
+void FFmpegMediaStream::didFinish(unsigned request, bool failed)
+{
+    ASSERT(isMainThread());
+    Locker locker { m_lock };
+    if (request != m_request)
+        return;
+    m_requestActive = false;
+    m_requestDone = true;
+    m_failed = failed;
+    if (!failed && !m_size)
+        m_size = m_bufferStart + m_buffer.size();
+    // m_resource stays: this runs inside its client callback (the next request or cancel() releases it)
+    m_condition.notifyAll();
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && USE(FFMPEG)
