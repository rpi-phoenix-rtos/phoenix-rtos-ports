+void MediaPlayerPrivateFFmpeg::cancelLoad()
+{
+    stop();
+    setNetworkState(MediaPlayer::NetworkState::Empty);
+}
+
+// Joins every thread and frees the decoders (main thread). Nothing it waits for needs the main
+// thread: a blocked read is woken by the stream's cancel(), a blocked queue by its abort, and
+// the device is written 10 ms at a time.
+void MediaPlayerPrivateFFmpeg::stop()
+{
+    m_statTimer.stop();
+    m_quit = true;
+    if (m_stream)
+        m_stream->cancel();
+    queueAbort(m_videoQueue);
+    queueAbort(m_audioQueue);
+    for (auto* thread : { &m_demuxThread, &m_videoThread, &m_audioThread }) {
+        if (RefPtr t = std::exchange(*thread, nullptr))
+            t->waitForCompletion();
+    }
+    for (auto* queue : { &m_videoQueue, &m_audioQueue }) {
+        queueFlush(*queue);
+        Locker locker { queue->lock };
+        queue->aborted = false;
+    }
+    avcodec_free_context(&m_videoDecoder);
+    avcodec_free_context(&m_audioDecoder);
+    if (m_format) {
+        // the AVIOContext is the stream's
+        m_format->pb = nullptr;
+        avformat_close_input(&m_format);
+    }
+    if (m_audioFd >= 0) {
+        // the ring replays what it holds after close: leave it full of silence
+        audioSilence(0.25);
+        close(m_audioFd);
+        m_audioFd = -1;
+    }
+    if (m_audioLockFd >= 0) {
+        close(m_audioLockFd);
+        m_audioLockFd = -1;
+    }
+    m_audioDeviceTried = false;
+    m_audioWritten = 0;
+    m_audioFeedStart = { };
+    m_stream = nullptr;
+    m_videoStream = m_audioStream = -1;
+    m_videoDrainedSerial = m_audioDrainedSerial = kNotDrained;
+    if (auto seekPromise = std::exchange(m_seekPromise, std::nullopt))
+        seekPromise->reject(PlatformMediaError::Cancelled);
+}
+
+AVCodecContext* MediaPlayerPrivateFFmpeg::openDecoder(int index)
+{
+    AVStream* stream = m_format->streams[index];
+    const AVCodec* codec = avcodec_find_decoder(stream->codecpar->codec_id);
+    if (!codec) {
+        log("error no-decoder codec=%s", avcodec_get_name(stream->codecpar->codec_id));
+        return nullptr;
+    }
+    AVCodecContext* context = avcodec_alloc_context3(codec);
+    if (!context)
+        return nullptr;
+    avcodec_parameters_to_context(context, stream->codecpar);
+    context->pkt_timebase = stream->time_base;
+    context->thread_count = envNumber("WPE_PHOENIX_MEDIA_THREADS", 0);
+    context->opaque = &m_hardwareState;
+    if (avcodec_open2(context, codec, nullptr) < 0) {
+        log("error decoder-open codec=%s", codec->name);
+        avcodec_free_context(&context);
+        return nullptr;
+    }
+    // FFMPEG_RPIVID (0 CPU, 1 the block's verified tool set, 2 all tools) steers hevc_rpivid
+    const char* rpivid = getenv("FFMPEG_RPIVID");
+    log("decoder %s=%s codec=%s threads=%d FFMPEG_RPIVID=%s", stream->codecpar->codec_type == AVMEDIA_TYPE_VIDEO ? "video" : "audio", codec->name,
+        avcodec_get_name(stream->codecpar->codec_id), context->thread_count, rpivid ? rpivid : "unset");
+    return context;
+}
+
+bool MediaPlayerPrivateFFmpeg::openContainer()
+{
+    AVIOContext* avio = m_stream->avioContext();
+    m_format = avformat_alloc_context();
+    if (!avio || !m_format)
+        return false;
+    m_format->pb = avio;
+    m_format->flags |= AVFMT_FLAG_CUSTOM_IO;
+    CString url = m_stream->url().string().utf8();
+    int ret = avformat_open_input(&m_format, url.data(), nullptr, nullptr);
+    if (ret < 0) {
+        log("error container-open rc=%d (%s)", ret, av_err2str(ret));
+        return false;
+    }
+    if (m_quit)
+        return false;
+    avformat_find_stream_info(m_format, nullptr);
+    m_containerDuration = m_format->duration != AV_NOPTS_VALUE ? m_format->duration / static_cast<double>(AV_TIME_BASE) : 0;
+    m_videoStream = av_find_best_stream(m_format, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+    m_audioStream = av_find_best_stream(m_format, AVMEDIA_TYPE_AUDIO, -1, m_videoStream, nullptr, 0);
+    if (m_videoStream >= 0 && !(m_videoDecoder = openDecoder(m_videoStream)))
+        m_videoStream = -1;
+    if (m_audioStream >= 0 && !(m_audioDecoder = openDecoder(m_audioStream)))
+        m_audioStream = -1;
+    return m_videoStream >= 0 || m_audioStream >= 0;
+}
+
+void MediaPlayerPrivateFFmpeg::demuxThread()
+{
+    if (!openContainer()) {
+        if (!m_quit) {
+            bool readable = m_format && m_format->nb_streams;
+            callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, readable] {
+                if (RefPtr protectedThis = weakThis.get())
+                    protectedThis->didFail(readable ? MediaPlayer::NetworkState::FormatError : MediaPlayer::NetworkState::DecodeError);
+            });
+        }
+        return;
+    }
+
+    FloatSize size;
+    double fps = 0;
+    if (m_videoStream >= 0) {
+        AVStream* stream = m_format->streams[m_videoStream];
+        AVRational sar = av_guess_sample_aspect_ratio(m_format, stream, nullptr);
+        double aspect = sar.num > 0 && sar.den > 0 ? av_q2d(sar) : 1;
+        size = FloatSize(m_videoDecoder->width * aspect, m_videoDecoder->height);
+        fps = av_q2d(av_guess_frame_rate(m_format, stream, nullptr));
+    }
+    log("open container=%s duration=%.2f video=%s %dx%d fps=%.2f audio=%s %d Hz %d ch", m_format->iformat->name, m_containerDuration,
+        m_videoStream >= 0 ? avcodec_get_name(m_videoDecoder->codec_id) : "none", m_videoStream >= 0 ? m_videoDecoder->width : 0,
+        m_videoStream >= 0 ? m_videoDecoder->height : 0, fps, m_audioStream >= 0 ? avcodec_get_name(m_audioDecoder->codec_id) : "none",
+        m_audioStream >= 0 ? m_audioDecoder->sample_rate : 0, m_audioStream >= 0 ? m_audioDecoder->ch_layout.nb_channels : 0);
+    MediaTime duration = m_containerDuration > 0 ? MediaTime::createWithDouble(m_containerDuration) : MediaTime::positiveInfiniteTime();
+    callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, duration, size, video = m_videoStream >= 0, audio = m_audioStream >= 0] {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->didLoadMetadata(duration, size, video, audio);
+    });
+
+    if (m_videoStream >= 0) {
+        m_videoThread = Thread::create("FFmpegVideo"_s, [this] { videoThread(); }, ThreadType::Graphics, Thread::QOS::UserInteractive,
+            Thread::SchedulingPolicy::Other, StackAllocationSpecification::RequestSize(kThreadStack));
+    }
+    if (m_audioStream >= 0) {
+        m_audioThread = Thread::create("FFmpegAudio"_s, [this] { audioThread(); }, ThreadType::Audio, Thread::QOS::UserInteractive,
+            Thread::SchedulingPolicy::Other, StackAllocationSpecification::RequestSize(kThreadStack));
+    }
+
+    // One pass reads from the start or from a seek target to the end of the file. Only this
+    // thread starts a pass (flushes the queues to a new serial), so it can tell whether both
+    // decoding threads drained the current pass without racing a seek.
+    AVPacket* packet = av_packet_alloc();
+    bool eof = false, endPosted = false;
+    unsigned generation = 0;
+    uint64_t videoPackets = 0, audioPackets = 0;
+    while (!m_quit) {
+        bool seek;
+        double target;
+        {
+            Locker locker { m_seekLock };
+            seek = std::exchange(m_seekRequested, false);
+            target = m_seekTarget;
+            if (seek)
+                generation = m_seekGeneration;
+        }
+        if (seek) {
+            int64_t ts = static_cast<int64_t>(target * AV_TIME_BASE);
+            if (m_format->start_time != AV_NOPTS_VALUE)
+                ts += m_format->start_time;
+            int ret = avformat_seek_file(m_format, -1, INT64_MIN, ts, ts, 0);
+            log("seek target=%.3f rc=%d", target, ret);
+            eof = endPosted = false;
+            videoPackets = audioPackets = 0;
+            queueFlush(m_videoQueue);
+            queueFlush(m_audioQueue);
+        }
+        if (eof) {
+            if (!endPosted && playedToEnd()) {
+                endPosted = true;
+                callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, generation] {
+                    if (RefPtr protectedThis = weakThis.get())
+                        protectedThis->didEnd(generation);
+                });
+            }
+            usleep(10000);
+            continue;
+        }
+        bool full = queueBytes(m_videoQueue) + queueBytes(m_audioQueue) > kQueueMaxBytes
+            || ((m_videoStream < 0 || queueLength(m_videoQueue) > kQueueMaxPackets) && (m_audioStream < 0 || queueLength(m_audioQueue) > kQueueMaxPackets));
+        if (full) {
+            usleep(10000);
+            continue;
+        }
+        int ret = av_read_frame(m_format, packet);
+        if (ret < 0) {
+            if (m_quit)
+                break;
+            // the end of the file, or a read error (played up to there)
+            if (ret != AVERROR_EOF && !avio_feof(m_format->pb))
+                log("read-error rc=%d (%s)", ret, av_err2str(ret));
+            log("eof packets video=%llu audio=%llu", static_cast<unsigned long long>(videoPackets), static_cast<unsigned long long>(audioPackets));
+            eof = true;
+            queueSetEnd(m_videoQueue);
+            queueSetEnd(m_audioQueue);
+            continue;
+        }
+        if (packet->stream_index == m_videoStream) {
+            videoPackets++;
+            queuePut(m_videoQueue, packet);
+        } else if (packet->stream_index == m_audioStream) {
+            audioPackets++;
+            queuePut(m_audioQueue, packet);
+        } else
+            av_packet_unref(packet);
+    }
+    av_packet_free(&packet);
+}
+
+// The demux thread, at the end of a pass: both decoding threads drained it.
+bool MediaPlayerPrivateFFmpeg::playedToEnd()
+{
+    return (m_videoStream < 0 || m_videoDrainedSerial == queueSerial(m_videoQueue))
+        && (m_audioStream < 0 || m_audioDrainedSerial == queueSerial(m_audioQueue));
+}
+
+/* --- video ---------------------------------------------------------------------------------- */
+
+bool MediaPlayerPrivateFFmpeg::presentFrame(AVFrame& decoded)
+{
+    AVFrame* frame = &decoded;
+    if (!CoordinatedPlatformLayerBufferFFmpeg::supportsPixelFormat(decoded.format)) {
+        // 10-bit, 4:2:2, 4:4:4, RGB...: converted to 8-bit 4:2:0 on the CPU (libswscale)
+        if (!m_converter.frame || m_converter.frame->width != decoded.width || m_converter.frame->height != decoded.height || m_converter.format != decoded.format) {
+            sws_freeContext(m_converter.context);
+            av_frame_free(&m_converter.frame);
+            m_converter.format = decoded.format;
+            m_converter.context = sws_getContext(decoded.width, decoded.height, static_cast<AVPixelFormat>(decoded.format), decoded.width, decoded.height,
+                AV_PIX_FMT_YUV420P, SWS_BILINEAR, nullptr, nullptr, nullptr);
+            m_converter.frame = av_frame_alloc();
+            if (m_converter.frame) {
+                m_converter.frame->format = AV_PIX_FMT_YUV420P;
+                m_converter.frame->width = decoded.width;
+                m_converter.frame->height = decoded.height;
+            }
+            if (!m_converter.context || !m_converter.frame || av_frame_get_buffer(m_converter.frame, 0) < 0) {
+                log("error pixel-format %s: no converter", av_get_pix_fmt_name(static_cast<AVPixelFormat>(decoded.format)));
+                sws_freeContext(std::exchange(m_converter.context, nullptr));
+                av_frame_free(&m_converter.frame);
+                return false;
+            }
+            log("convert %s -> yuv420p %dx%d (CPU)", av_get_pix_fmt_name(static_cast<AVPixelFormat>(decoded.format)), decoded.width, decoded.height);
+        }
+        // the compositor may still hold the previous picture: a new buffer for each one
+        if (av_frame_make_writable(m_converter.frame) < 0)
+            return false;
+        sws_scale(m_converter.context, decoded.data, decoded.linesize, 0, decoded.height, m_converter.frame->data, m_converter.frame->linesize);
+        av_frame_copy_props(m_converter.frame, &decoded);
+        m_converter.frame->colorspace = decoded.colorspace;
+        m_converter.frame->color_range = decoded.color_range;
+        frame = m_converter.frame;
+    }
+    auto buffer = CoordinatedPlatformLayerBufferFFmpeg::create(*frame, m_frameCounters.copyRef());
+    if (!buffer)
+        return false;
+    m_contentsBufferProxy->setDisplayBuffer(WTF::move(buffer));
+    m_presented++;
+    return true;
+}
+
+void MediaPlayerPrivateFFmpeg::videoThread()
+{
+    AVPacket* packet = av_packet_alloc();
+    AVFrame* frame = av_frame_alloc();
+    double timeBase = av_q2d(m_format->streams[m_videoStream]->time_base);
+    double startTime = m_format->start_time != AV_NOPTS_VALUE ? m_format->start_time / static_cast<double>(AV_TIME_BASE) : 0;
+    unsigned serial = std::numeric_limits<unsigned>::max(), queueSerialNow;
+    bool drained = false, first = true;
+    double lastPts = 0;
+    MonotonicTime lastShown;
+    uint64_t heldFrames = 0;
+
+    while (!m_quit) {
+        auto got = queueGet(m_videoQueue, packet, serial, drained, queueSerialNow, 20_ms);
+        if (got == Get::Aborted)
+            break;
+        if (queueSerialNow != serial) {
+            avcodec_flush_buffers(m_videoDecoder);
+            serial = queueSerialNow;
+            drained = false;
+            first = true;
+        }
+        if (got == Get::Empty || (got == Get::End && drained))
+            continue;
+        if (got == Get::End) {
+            // the last packet is in: the decoder gives back the pictures it still holds
+            // (reordering, frame threads) and then AVERROR_EOF
+            avcodec_send_packet(m_videoDecoder, nullptr);
+            drained = true;
+            heldFrames = 0;
+        } else {
+            avcodec_send_packet(m_videoDecoder, packet);
+            av_packet_unref(packet);
+        }
+        int ret = 0;
+        while (!m_quit && !(ret = avcodec_receive_frame(m_videoDecoder, frame))) {
+            m_decoded++;
+            if (drained)
+                heldFrames++;
+            double pts = frame->best_effort_timestamp != AV_NOPTS_VALUE ? frame->best_effort_timestamp * timeBase - startTime : lastPts;
+            if (first) {
+                // the first picture at the start or after a seek: pictures before the target
+                // (decoded from the keyframe before it) are skipped; the clock starts at the one shown
+                double target;
+                {
+                    Locker locker { m_seekLock };
+                    target = m_seekTarget;
+                }
+                if (pts < target - 0.02) {
+                    av_frame_unref(frame);
+                    continue;
+                }
+                presentFrame(*frame);
+                clockSet(pts, false);
+                lastPts = pts;
+                lastShown = MonotonicTime::now();
+                first = false;
+                log("first-frame pts=%.3f %dx%d format=%s", pts, frame->width, frame->height, av_get_pix_fmt_name(static_cast<AVPixelFormat>(frame->format)));
+                callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, pts] {
+                    if (RefPtr protectedThis = weakThis.get())
+                        protectedThis->didShowFirstFrame(pts);
+                });
+                av_frame_unref(frame);
+                continue;
+            }
+            // wait for its time (the clock stands still while paused)
+            double wait = 0;
+            while (!m_quit && queueSerial(m_videoQueue) == serial) {
+                wait = pts - clockNow();
+                bool running = clockRunning();
+                if (!running || wait > 0.002) {
+                    usleep(wait > 0.02 || !running ? 10000 : static_cast<useconds_t>(wait * 1000000));
+                    continue;
+                }
+                break;
+            }
+            if (m_quit || queueSerial(m_videoQueue) != serial) {
+                av_frame_unref(frame);
+                break;
+            }
+            // late: dropped, unless nothing was shown for half a second (a decoder slower than
+            // the stream still shows a picture now and then)
+            if (wait < -kLateDrop && MonotonicTime::now() - lastShown < 500_ms)
+                m_dropped++;
+            else if (presentFrame(*frame))
+                lastShown = MonotonicTime::now();
+            lastPts = pts;
+            av_frame_unref(frame);
+        }
+        // drained: the decoder said AVERROR_EOF (not a break out of the loop for a seek or quit)
+        if (drained && ret && ret != AVERROR(EAGAIN) && !m_quit && queueSerial(m_videoQueue) == serial && m_videoDrainedSerial != serial) {
+            if (first) {
+                // a seek past the last picture: nothing to show, the seek still completes
+                double target;
+                {
+                    Locker locker { m_seekLock };
+                    target = m_seekTarget;
+                }
+                clockSet(target, false);
+                callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, target] {
+                    if (RefPtr protectedThis = weakThis.get())
+                        protectedThis->didShowFirstFrame(target);
+                });
+                first = false;
+            }
+            log("drained video held=%llu decoded=%llu rc=%d", static_cast<unsigned long long>(heldFrames), static_cast<unsigned long long>(m_decoded.load()), ret);
+            m_videoDrainedSerial = serial;
+        }
+    }
+    sws_freeContext(std::exchange(m_converter.context, nullptr));
+    av_frame_free(&m_converter.frame);
+    av_frame_free(&frame);
+    av_packet_free(&packet);
+}
+
+/* --- audio ---------------------------------------------------------------------------------- */
+
+void MediaPlayerPrivateFFmpeg::openAudioDevice()
+{
+    m_audioDeviceTried = true;
+    if (!envNumber("WPE_PHOENIX_MEDIA_AUDIO", 1)) {
+        log("audio sound=off reason=disabled");
+        return;
+    }
+    // one writer for the device: its ring would interleave two streams
+    m_audioLockFd = open(kAudioLockFile, O_RDWR | O_CREAT, 0666);
+    struct flock lock { };
+    lock.l_type = F_WRLCK;
+    lock.l_whence = SEEK_SET;
+    if (m_audioLockFd < 0 || fcntl(m_audioLockFd, F_SETLK, &lock) < 0) {
+        log("audio sound=off reason=busy (%s held by another player)", kAudioLockFile);
+        if (m_audioLockFd >= 0)
+            close(m_audioLockFd);
+        m_audioLockFd = -1;
+        return;
+    }
+    m_audioFd = open(kAudioDevice, O_WRONLY);
+    if (m_audioFd < 0) {
+        log("audio sound=off reason=open device=%s errno=%d", kAudioDevice, errno);
+        close(m_audioLockFd);
+        m_audioLockFd = -1;
+        return;
+    }
+    log("audio sound=on device=%s fill_ms=%.0f", kAudioDevice, kAudioFill * 1000);
+}
+
+// The fill (sound queued but not heard yet) is modelled as seconds written minus seconds
+// elapsed since the first write: the ring drains at the playback rate.
+double MediaPlayerPrivateFFmpeg::audioFill()
+{
+    if (!m_audioFeedStart)
+        return 0;
+    double fill = m_audioWritten - (MonotonicTime::now() - m_audioFeedStart).seconds();
+    if (fill < 0) {
+        // the ring ran dry (or the model drifted): start the model again
+        m_audioFeedStart = { };
+        m_audioWritten = 0;
+        fill = 0;
+    }
+    return fill;
+}
+
+void MediaPlayerPrivateFFmpeg::audioWrite(const uint8_t* data, size_t length)
+{
+    if (!m_audioFeedStart)
+        m_audioFeedStart = MonotonicTime::now();
+    m_audioWritten += length / (4.0 * kAudioRate);
+    while (length && m_audioFd >= 0) {
+        ssize_t n = write(m_audioFd, data, length);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            log("audio write-failed errno=%d: sound off", errno);
+            close(m_audioFd);
+            m_audioFd = -1;
+            return;
+        }
+        data += n;
+        length -= n;
+    }
+}
+
+void MediaPlayerPrivateFFmpeg::audioSilence(double seconds)
+{
+    static const uint8_t zero[4 * (kAudioRate / 100)] = { };
+    size_t length = static_cast<size_t>(seconds * kAudioRate) * 4;
+    while (length && m_audioFd >= 0) {
+        size_t n = std::min(length, sizeof(zero));
+        audioWrite(zero, n);
+        length -= n;
+    }
+}
+
+void MediaPlayerPrivateFFmpeg::audioThread()
+{
+    AVPacket* packet = av_packet_alloc();
+    AVFrame* frame = av_frame_alloc();
+    AVChannelLayout stereo = AV_CHANNEL_LAYOUT_STEREO;
+    SwrContext* resampler = nullptr;
+    Vector<uint8_t> out;
+    size_t outLength = 0;
+    unsigned serial = std::numeric_limits<unsigned>::max(), queueSerialNow = 0, haveSerial = 0;
+    bool drained = false, have = false;
+    double pts = 0, duration = 0;
+    double timeBase = av_q2d(m_format->streams[m_audioStream]->time_base);
+    double startTime = m_format->start_time != AV_NOPTS_VALUE ? m_format->start_time / static_cast<double>(AV_TIME_BASE) : 0;
+
+    while (!m_quit) {
+        if (!m_audioDeviceTried && clockRunning())
+            openAudioDevice();
+        double fill = audioFill();
+        if (m_audioFd >= 0 && fill > kAudioFill) {
+            usleep(fill - kAudioFill > 0.01 ? 10000 : static_cast<useconds_t>((fill - kAudioFill) * 1000000) + 500);
+            continue;
+        }
+        if (have && queueSerial(m_audioQueue) != haveSerial)
+            have = false; // decoded before a seek
+        if (!have) {
+            int ret = avcodec_receive_frame(m_audioDecoder, frame);
+            if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+                // AVERROR_EOF: drained, and every sound decoded was written (or dropped late)
+                if (ret == AVERROR_EOF && drained && m_audioDrainedSerial != serial && queueSerial(m_audioQueue) == serial) {
+                    log("drained audio");
+                    m_audioDrainedSerial = serial;
+                }
+                auto got = queueGet(m_audioQueue, packet, serial, drained, queueSerialNow, m_audioFd >= 0 ? 5_ms : 20_ms);
+                if (got == Get::Aborted)
+                    break;
+                if (queueSerialNow != serial) {
+                    avcodec_flush_buffers(m_audioDecoder);
+                    serial = queueSerialNow;
+                    drained = false;
+                }
+                if (got == Get::Packet) {
+                    avcodec_send_packet(m_audioDecoder, packet);
+                    av_packet_unref(packet);
+                } else if (got == Get::End && !drained) {
+                    avcodec_send_packet(m_audioDecoder, nullptr);
+                    drained = true;
+                }
+            } else if (!ret) {
+                if (frame->pts != AV_NOPTS_VALUE) {
+                    pts = frame->pts * timeBase - startTime;
+                    duration = static_cast<double>(frame->nb_samples) / frame->sample_rate;
+                    if (!resampler) {
+                        if (frame->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC)
+                            av_channel_layout_default(&frame->ch_layout, frame->ch_layout.nb_channels);
+                        if (swr_alloc_set_opts2(&resampler, &stereo, AV_SAMPLE_FMT_S16, kAudioRate, &frame->ch_layout,
+                            static_cast<AVSampleFormat>(frame->format), frame->sample_rate, 0, nullptr) < 0 || swr_init(resampler) < 0) {
+                            log("error audio-resampler: sound off");
+                            swr_free(&resampler);
+                        } else {
+                            log("audio %s %d Hz %d ch -> S16 %d Hz stereo", av_get_sample_fmt_name(static_cast<AVSampleFormat>(frame->format)),
+                                frame->sample_rate, frame->ch_layout.nb_channels, kAudioRate);
+                        }
+                    }
+                    if (resampler) {
+                        int maxSamples = swr_get_out_samples(resampler, frame->nb_samples);
+                        out.grow(std::max<size_t>(out.size(), maxSamples * 4));
+                        uint8_t* outPlane = out.mutableSpan().data();
+                        int n = swr_convert(resampler, &outPlane, maxSamples, const_cast<const uint8_t**>(frame->extended_data), frame->nb_samples);
+                        outLength = n > 0 ? n * 4 : 0;
+                        have = outLength;
+                        haveSerial = serial;
+                    }
+                }
+                av_frame_unref(frame);
+            }
+        }
+        if (have && m_videoStream < 0) {
+            // no picture stream: the first sound releases the clock (start, seek)
+            bool released = false;
+            {
+                Locker locker { m_clockLock };
+                if (m_clockHold) {
+                    m_clockPts = pts;
+                    m_clockStart = MonotonicTime::now();
+                    m_clockHold = false;
+                    released = true;
+                }
+            }
+            if (released) {
+                callOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, pts] {
+                    if (RefPtr protectedThis = weakThis.get())
+                        protectedThis->didShowFirstFrame(pts);
+                });
+            }
+        }
+        if (m_audioFd < 0) {
+            // no device: consume the sound at the clock's pace so the demuxer keeps going
+            if (have && (!clockRunning() ? false : pts <= clockNow() + 0.5))
+                have = false;
+            else if (have)
+                usleep(10000);
+            continue;
+        }
+        if (!have || !clockRunning()) {
+            audioSilence(kAudioChunk);
+            continue;
+        }
+        double heard = clockNow() + audioFill();
+        if (pts + duration < heard - kAudioLate) {
+            have = false; // late: dropped
+            continue;
+        }
+        if (pts > heard + kAudioEarly) {
+            audioSilence(std::min(pts - heard, kAudioChunk));
+            continue;
+        }
+        m_avDriftMs = static_cast<int>((pts - heard) * 1000);
+        double gain = m_muted ? 0 : m_volume.load();
+        if (gain < 0.999) {
+            auto* samples = reinterpret_cast<int16_t*>(out.mutableSpan().data());
+            for (size_t i = 0; i < outLength / 2; ++i)
+                samples[i] = static_cast<int16_t>(samples[i] * gain);
+        }
+        audioWrite(out.span().data(), outLength);
+        have = false;
+    }
+    swr_free(&resampler);
+    av_frame_free(&frame);
+    av_packet_free(&packet);
+}
+
+/* --- main thread: state for WebCore ---------------------------------------------------------- */
+
+void MediaPlayerPrivateFFmpeg::setReadyState(MediaPlayer::ReadyState state)
+{
+    if (m_readyState == state)
+        return;
+    m_readyState = state;
+    if (RefPtr player = m_player.get())
+        player->readyStateChanged();
+}
+
+void MediaPlayerPrivateFFmpeg::setNetworkState(MediaPlayer::NetworkState state)
+{
+    if (m_networkState == state)
+        return;
+    m_networkState = state;
+    if (RefPtr player = m_player.get())
+        player->networkStateChanged();
+}
+
+void MediaPlayerPrivateFFmpeg::didLoadMetadata(MediaTime duration, FloatSize size, bool hasVideo, bool hasAudio)
+{
+    m_duration = duration;
+    m_naturalSize = size;
+    m_hasVideo = hasVideo;
+    m_hasAudio = hasAudio;
+    m_buffered = m_stream && m_stream->isComplete() && duration.isFinite() ? PlatformTimeRanges(MediaTime::zeroTime(), duration) : PlatformTimeRanges();
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    player->durationChanged();
+    player->sizeChanged();
+    player->characteristicChanged();
+    setReadyState(MediaPlayer::ReadyState::HaveMetadata);
+    if (m_stream && m_stream->isLocalFile())
+        setNetworkState(MediaPlayer::NetworkState::Loaded);
+}
+
+void MediaPlayerPrivateFFmpeg::didFail(MediaPlayer::NetworkState state)
+{
+    log("error state=%s", convertEnumerationToString(state).utf8().data());
+    setNetworkState(state);
+}
+
+void MediaPlayerPrivateFFmpeg::didShowFirstFrame(double pts)
+{
+    if (RefPtr player = m_player.get()) {
+        if (m_readyState < MediaPlayer::ReadyState::HaveEnoughData) {
+            setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
+            if (m_hasVideo)
+                player->firstVideoFrameAvailable();
+        }
+    }
+    if (auto seekPromise = std::exchange(m_seekPromise, std::nullopt)) {
+        log("seek done pts=%.3f", pts);
+        seekPromise->resolve(MediaTime::createWithDouble(pts));
+        if (RefPtr player = m_player.get())
+            player->timeChanged();
+    }
+}
+
+void MediaPlayerPrivateFFmpeg::didEnd(unsigned seekGeneration)
+{
+    {
+        // a seek requested since the demuxer saw this end: that pass is gone
+        Locker locker { m_seekLock };
+        if (seekGeneration != m_seekGeneration)
+            return;
+    }
+    log("end clock=%.3f decoded=%llu presented=%llu painted=%llu dropped=%llu", clockNow(), static_cast<unsigned long long>(m_decoded.load()),
+        static_cast<unsigned long long>(m_presented.load()), static_cast<unsigned long long>(m_frameCounters->painted.load()),
+        static_cast<unsigned long long>(m_dropped.load()));
+    // the clock stops at the end and currentTime() is the duration; paused() stays as the element
+    // set it. timeChanged() lets HTMLMediaElement see the end: it fires 'timeupdate', then
+    // 'pause' + 'ended' and pauses us, or, with 'loop', seeks to the start (seekToTarget(0))
+    m_ended = true;
+    clockSetPaused(true);
+    if (RefPtr player = m_player.get())
+        player->timeChanged();
+}
+
+void MediaPlayerPrivateFFmpeg::play()
+{
+    if (!m_paused)
+        return;
+    m_paused = false;
+    // after the end the clock stays stopped until a seek (HTMLMediaElement seeks to the start
+    // when play() follows the end)
+    clockSetPaused(m_ended);
+    log("play clock=%.3f", clockNow());
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateFFmpeg::pause()
+{
+    if (m_paused)
+        return;
+    m_paused = true;
+    clockSetPaused(true);
+    log("pause clock=%.3f", clockNow());
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+PlatformLayer* MediaPlayerPrivateFFmpeg::platformLayer() const
+{
+    return m_contentsBufferProxy.get();
+}
+
+MediaTime MediaPlayerPrivateFFmpeg::currentTime() const
+{
+    if (m_ended && m_duration.isFinite())
+        return m_duration;
+    double now = std::max(0.0, clockNow());
+    if (m_duration.isFinite())
+        now = std::min(now, m_duration.toDouble());
+    return MediaTime::createWithDouble(now);
+}
+
+MediaTime MediaPlayerPrivateFFmpeg::maxTimeSeekable() const
+{
+    if (!m_stream || !m_stream->size() || !m_duration.isFinite())
+        return MediaTime::zeroTime();
+    return m_duration;
+}
+
+Ref<MediaTimePromise> MediaPlayerPrivateFFmpeg::seekToTarget(const SeekTarget& target)
+{
+    if (auto previous = std::exchange(m_seekPromise, std::nullopt))
+        previous->reject(PlatformMediaError::Cancelled);
+    // before the metadata the demux thread still opens the container
+    if (m_readyState < MediaPlayer::ReadyState::HaveMetadata || m_quit)
+        return MediaTimePromise::createAndReject(PlatformMediaError::Cancelled);
+    double time = std::max(0.0, target.time.toDouble());
+    if (m_duration.isFinite())
+        time = std::min(time, m_duration.toDouble());
+    m_ended = false;
+    clockSetPaused(m_paused);
+    m_seekPromise.emplace(PlatformMediaError::Cancelled);
+    Ref promise = m_seekPromise->promise();
+    {
+        Locker locker { m_seekLock };
+        m_seekTarget = time;
+        m_seekRequested = true;
+        m_seekGeneration++;
+    }
+    clockSet(time, true);
+    return promise;
+}
+
+void MediaPlayerPrivateFFmpeg::setVolumeDouble(double volume)
+{
+    m_volume = std::clamp(volume, 0.0, 1.0);
+}
+
+void MediaPlayerPrivateFFmpeg::setMuted(bool muted)
+{
+    m_muted = muted;
+}
+
+const PlatformTimeRanges& MediaPlayerPrivateFFmpeg::buffered() const
+{
+    if (!m_stream || !m_duration.isFinite())
+        return PlatformTimeRanges::emptyRanges();
+    if (m_stream->isComplete())
+        m_buffered = PlatformTimeRanges(MediaTime::zeroTime(), m_duration);
+    else if (auto size = m_stream->size(); size && *size) {
+        // bytes received as a share of the duration: right for a constant bit rate, and enough
+        // for the progress bar
+        double share = std::min(1.0, static_cast<double>(m_stream->bytesReceived()) / *size);
+        m_buffered = PlatformTimeRanges(MediaTime::zeroTime(), MediaTime::createWithDouble(m_duration.toDouble() * share));
+    }
+    return m_buffered;
+}
+
+bool MediaPlayerPrivateFFmpeg::didLoadingProgress() const
+{
+    uint64_t bytes = m_stream ? m_stream->bytesReceived() : 0;
+    bool progress = bytes != m_lastProgressBytes;
+    m_lastProgressBytes = bytes;
+    return progress;
+}
+
+unsigned long long MediaPlayerPrivateFFmpeg::totalBytes() const
+{
+    if (!m_stream)
+        return 0;
+    return m_stream->size().value_or(0);
+}
+
+DestinationColorSpace MediaPlayerPrivateFFmpeg::colorSpace()
+{
+    return DestinationColorSpace::SRGB();
+}
+
+void MediaPlayerPrivateFFmpeg::statTimerFired()
+{
+    if (m_stream && !m_stream->isLocalFile() && m_stream->isComplete())
+        setNetworkState(MediaPlayer::NetworkState::Loaded);
+    auto now = MonotonicTime::now();
+    uint64_t presented = m_presented;
+    double seconds = (now - m_lastStatTime).seconds();
+    double fps = seconds > 0 ? (presented - m_lastStatPresented) / seconds : 0;
+    m_lastStatPresented = presented;
+    m_lastStatTime = now;
+    uint64_t painted = m_frameCounters->painted;
+    uint64_t uploadUs = m_frameCounters->uploadMicroseconds;
+    int hardware = m_hardwareState;
+    log("stat clock=%.3f decoded=%llu presented=%llu painted=%llu dropped=%llu fps=%.1f av_ms=%d vq=%zu aq=%zu paused=%d hw=%s upload_ms=%.2f bytes=%llu",
+        clockNow(), static_cast<unsigned long long>(m_decoded.load()), static_cast<unsigned long long>(presented),
+        static_cast<unsigned long long>(painted), static_cast<unsigned long long>(m_dropped.load()), fps, m_avDriftMs.load(),
+        queueLength(m_videoQueue), queueLength(m_audioQueue), m_paused, hardware < 0 ? "-" : hardware ? "1" : "0",
+        painted ? uploadUs / 1000.0 / painted : 0.0, static_cast<unsigned long long>(m_stream ? m_stream->bytesReceived() : 0));
+}
