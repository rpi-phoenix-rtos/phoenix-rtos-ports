+struct AVFrame;
+
+namespace WebCore {
+
+// Counters shared by a player and the frames it hands to the compositor: a frame counts as
+// painted the first time the compositor draws it (a frame replaced before that was dropped
+// by the compositor, not by the player).
+struct FFmpegFrameCounters final : public ThreadSafeRefCounted<FFmpegFrameCounters> {
+    static Ref<FFmpegFrameCounters> create() { return adoptRef(*new FFmpegFrameCounters); }
+    std::atomic<uint64_t> painted { 0 };
+    std::atomic<uint64_t> uploadMicroseconds { 0 };
+};
+
+// A decoded picture in system memory (8-bit 4:2:0: three planes, or NV12) on its way to the
+// compositor. The planes are uploaded on the compositing thread when the frame is drawn:
+// by Skia from the plane pixmaps (Skia composition, the WPE default), or into three R8
+// textures drawn by TextureMapper's YUV shader. The colour conversion runs on the GPU either way.
+class CoordinatedPlatformLayerBufferFFmpeg final : public CoordinatedPlatformLayerBuffer {
+public:
+    // Takes a reference to the frame; nullptr when its pixel format is not one of the above.
+    static std::unique_ptr<CoordinatedPlatformLayerBufferFFmpeg> create(const AVFrame&, Ref<FFmpegFrameCounters>&&);
+    CoordinatedPlatformLayerBufferFFmpeg(AVFrame*, const IntSize&, Ref<FFmpegFrameCounters>&&);
+    virtual ~CoordinatedPlatformLayerBufferFFmpeg();
+
+    static bool supportsPixelFormat(int);
+
+private:
+    void paintToTextureMapper(TextureMapper&, const FloatRect&, const TransformationMatrix& modelViewMatrix = TransformationMatrix(), float opacity = 1.0) override;
+#if USE(SKIA)
+    sk_sp<SkImage> skiaImage() override;
+#endif
+
+    void countPaint(MonotonicTime uploadStart);
+    bool isNV12() const;
+
+    AVFrame* m_frame { nullptr };
+    Ref<FFmpegFrameCounters> m_counters;
+    bool m_painted { false };
+    std::array<unsigned, 3> m_textures { 0, 0, 0 };
+#if USE(SKIA)
+    sk_sp<SkImage> m_skiaImage;
+#endif
+};
+
+} // namespace WebCore
+
+#endif // USE(COORDINATED_GRAPHICS) && USE(FFMPEG)
