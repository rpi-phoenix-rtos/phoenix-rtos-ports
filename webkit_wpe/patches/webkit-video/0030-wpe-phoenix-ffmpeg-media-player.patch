+// the device: /dev/audio0 plays 44.1 kHz signed 16-bit stereo, a blocking write() paces the
+// writer (rpi4-audio: a free-running ~0.19 s DMA ring that replays what it holds when not fed)
+static constexpr int kAudioRate = 44100;
+static constexpr double kAudioFill = 0.12;   // seconds kept queued in the ring
+static constexpr double kAudioChunk = 0.01;  // silence is written in chunks of this
+static constexpr double kAudioLate = 0.05;   // a sound frame heard later than this is dropped
+static constexpr double kAudioEarly = 0.02;  // ... earlier than this waits behind silence
+static constexpr double kLateDrop = 0.10;    // a picture later than this is dropped
+static constexpr size_t kQueueMaxBytes = 16 * 1024 * 1024;
+static constexpr size_t kQueueMaxPackets = 256;
+static const char* const kAudioDevice = "/dev/audio0";
+// one writer of the device in the whole system: a process-owned record lock (dropped at exit)
+static const char* const kAudioLockFile = "/tmp/.wpe-audio0.lock";
+static constexpr size_t kThreadStack = 8 * 1024 * 1024;
+
+static unsigned nextPlayerID()
+{
+    static std::atomic<unsigned> id { 0 };
+    return ++id;
+}
+
+static uint64_t monotonicMs()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+static int envNumber(const char* name, int fallback)
+{
+    const char* value = getenv(name);
+    if (!value || !*value)
+        return fallback;
+    return atoi(value);
+}
+
+// FFmpeg's messages: warnings and errors, and the rpivid decoder's own lines (which also say
+// whether the block or the CPU decodes). A decoder context's opaque is its player.
+static void ffmpegLog(void* object, int level, const char* format, va_list args)
+{
+    if (level > AV_LOG_INFO)
+        return;
+    char line[512];
+    int printPrefix = 1;
+    va_list copy;
+    va_copy(copy, args);
+    av_log_format_line2(object, level, format, copy, line, sizeof(line), &printPrefix);
+    va_end(copy);
+    bool rpivid = strstr(line, "rpivid");
+    if (level > AV_LOG_WARNING && !rpivid)
+        return;
+    if (object && rpivid) {
+        auto* avClass = *static_cast<const AVClass* const*>(object);
+        if (avClass && !strcmp(avClass->class_name, "AVCodecContext")) {
+            if (auto* player = static_cast<std::atomic<int>*>(static_cast<AVCodecContext*>(object)->opaque)) {
+                if (strstr(line, "rpivid: hardware HEVC decode"))
+                    player->store(1);
+                else if (strstr(line, "rpivid: CPU decode") || strstr(line, "continuing on the CPU decoder"))
+                    player->store(0);
+            }
+        }
+    }
+    size_t length = strlen(line);
+    while (length && (line[length - 1] == '\n' || line[length - 1] == '\r'))
+        line[--length] = '\0';
+    fprintf(stderr, "WPEB-MEDIA mono=%llu ffmpeg %s\n", static_cast<unsigned long long>(monotonicMs()), line);
+}
