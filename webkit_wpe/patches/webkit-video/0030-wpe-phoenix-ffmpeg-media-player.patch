+class CoordinatedPlatformLayerBufferProxy;
+class FFmpegMediaStream;
+struct FFmpegFrameCounters;
+
+// A <video>/<audio> engine over FFmpeg's libraries, for ports without GStreamer (WPE on
+// Phoenix-RTOS, USE_FFMPEG). Progressive files only: no Media Source Extensions, no Web
+// Audio, no encrypted media, playback rate 1.
+//
+// Threads: demux (libavformat over FFmpegMediaStream: open, read, seek) -> two packet queues
+// -> video (libavcodec; each picture waits for its time and goes to the compositor through
+// the CoordinatedPlatformLayerBufferProxy, uploaded and colour-converted on the GPU) and audio
+// (libavcodec -> libswresample -> 44.1 kHz S16 stereo -> /dev/audio0, the BCM2711 PWM audio).
+// The master clock is a pausable wall clock: audio follows it (a late sound frame is dropped,
+// an early one waits behind silence), video pictures wait for it or are dropped when late.
+// The end: after the last packet the demuxer marks both queues' end; each decoding thread then
+// drains its decoder (a null packet), plays out the frames the decoder still held, and records
+// the queue serial it drained; the demux thread, which alone starts new serials (seeks), reports
+// the end once both have. HTMLMediaElement then fires 'ended', or seeks to 0 for 'loop'.
+// HEVC goes to the decoder that avcodec_find_decoder() returns, which on Phoenix is
+// hevc_rpivid (FFmpeg's HEVC decoder on the Pi 4's rpivid block, with its own CPU fallback).
+//
+// Every event prints a "WPEB-MEDIA mono=<ms> id=<n> ..." line on stderr; WPE_PHOENIX_MEDIA_STAT_MS
+// (default 2000, 0 off) sets the period of the "stat" line.
+class MediaPlayerPrivateFFmpeg final
+    : public MediaPlayerPrivateInterface
+    , public ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr<MediaPlayerPrivateFFmpeg, WTF::DestructionThread::Main> {
+    WTF_MAKE_TZONE_ALLOCATED(MediaPlayerPrivateFFmpeg);
+public:
+    explicit MediaPlayerPrivateFFmpeg(MediaPlayer&);
+    ~MediaPlayerPrivateFFmpeg();
+
+    void ref() const final { ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr::ref(); }
+    void deref() const final { ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr::deref(); }
+
+    constexpr MediaPlayerType mediaPlayerType() const final { return MediaPlayerType::FFmpeg; }
+
+    static void registerMediaEngine(MediaEngineRegistrar);
+    static void getSupportedTypes(HashSet<String>&);
+    static MediaPlayer::SupportsType supportsType(const MediaEngineSupportParameters&);
+
+    void load(const String&) final;
+#if ENABLE(MEDIA_SOURCE)
+    void load(const URL&, const LoadOptions&, MediaSourcePrivateClient&) final;
+#endif
+#if ENABLE(MEDIA_STREAM)
+    void load(MediaStreamPrivate&) final;
+#endif
+    void cancelLoad() final;
+
+    void play() final;
+    void pause() final;
+    bool paused() const final { return m_paused; }
+
+    PlatformLayer* platformLayer() const final;
+    bool supportsAcceleratedRendering() const final { return true; }
+
+    FloatSize naturalSize() const final { return m_naturalSize; }
+    bool hasVideo() const final { return m_hasVideo; }
+    bool hasAudio() const final { return m_hasAudio; }
+
+    void setPageIsVisible(bool) final { }
+
+    MediaTime duration() const final { return m_duration; }
+    MediaTime currentTime() const final;
+    MediaTime maxTimeSeekable() const final;
+    Ref<MediaTimePromise> seekToTarget(const SeekTarget&) final;
+    double rate() const final { return 1; }
+
+    void setVolumeDouble(double) final;
+    void setMuted(bool) final;
+
+    MediaPlayer::NetworkState networkState() const final { return m_networkState; }
+    MediaPlayer::ReadyState readyState() const final { return m_readyState; }
+    const PlatformTimeRanges& buffered() const final;
+    bool didLoadingProgress() const final;
+    unsigned long long totalBytes() const final;
+    MediaPlayer::MovieLoadType movieLoadType() const final { return MediaPlayer::MovieLoadType::Download; }
+
+    void paint(GraphicsContext&, const FloatRect&) final { }
+    DestinationColorSpace colorSpace() final;
+    String engineDescription() const final { return "FFmpeg"_s; }
+
+private:
+    struct PacketQueue {
+        Lock lock;
+        Condition condition;
+        Deque<AVPacket*> packets WTF_GUARDED_BY_LOCK(lock);
+        size_t bytes WTF_GUARDED_BY_LOCK(lock) { 0 };
+        unsigned serial WTF_GUARDED_BY_LOCK(lock) { 0 };
+        // the demuxer put the last packet of this serial (cleared by a flush)
+        bool end WTF_GUARDED_BY_LOCK(lock) { false };
+        bool aborted WTF_GUARDED_BY_LOCK(lock) { false };
+    };
+    // End: no packet left and none will come for this serial (the decoder is to be drained)
+    enum class Get : uint8_t { Packet, Empty, End, Aborted };
+    static void queuePut(PacketQueue&, AVPacket*);
+    static Get queueGet(PacketQueue&, AVPacket*, unsigned knownSerial, bool drained, unsigned& serial, Seconds timeout);
+    static void queueFlush(PacketQueue&);
+    static void queueSetEnd(PacketQueue&);
+    static void queueAbort(PacketQueue&);
+    static unsigned queueSerial(PacketQueue&);
+    static size_t queueLength(PacketQueue&);
+    static size_t queueBytes(PacketQueue&);
+
+    // the master clock (any thread)
+    double clockNow() const;
+    void clockSet(double pts, bool hold);
+    bool clockRunning() const;
+    void clockSetPaused(bool);
+
+    void stop();
+    void demuxThread();
+    bool openContainer();
+    AVCodecContext* openDecoder(int stream);
+    void videoThread();
+    void audioThread();
+    bool presentFrame(AVFrame&);
+    bool playedToEnd();
+    void openAudioDevice();
+    void audioWrite(const uint8_t*, size_t);
+    void audioSilence(double seconds);
+    double audioFill();
+
+    // posted to the main thread
+    void didLoadMetadata(MediaTime duration, FloatSize, bool hasVideo, bool hasAudio);
+    void didFail(MediaPlayer::NetworkState);
+    void didShowFirstFrame(double pts);
+    void didEnd(unsigned seekGeneration);
+    void setReadyState(MediaPlayer::ReadyState);
+    void setNetworkState(MediaPlayer::NetworkState);
+    void statTimerFired();
+    void log(const char* format, ...) const WTF_ATTRIBUTE_PRINTF(2, 3);
+
+    ThreadSafeWeakPtr<MediaPlayer> m_player;
+    const unsigned m_id;
+    RefPtr<CoordinatedPlatformLayerBufferProxy> m_contentsBufferProxy;
+    Ref<FFmpegFrameCounters> m_frameCounters;
+    RefPtr<FFmpegMediaStream> m_stream;
+    RunLoop::Timer m_statTimer;
+
+    // main thread
+    MediaPlayer::NetworkState m_networkState { MediaPlayer::NetworkState::Empty };
+    MediaPlayer::ReadyState m_readyState { MediaPlayer::ReadyState::HaveNothing };
+    MediaTime m_duration { MediaTime::invalidTime() };
+    FloatSize m_naturalSize;
+    bool m_hasVideo { false };
+    bool m_hasAudio { false };
+    bool m_paused { true };
+    bool m_ended { false };
+    std::optional<MediaTimePromise::AutoRejectProducer> m_seekPromise;
+    mutable uint64_t m_lastProgressBytes { 0 };
+    mutable PlatformTimeRanges m_buffered;
+    uint64_t m_lastStatPresented { 0 };
+    MonotonicTime m_lastStatTime;
+
+    // the threads
+    RefPtr<Thread> m_demuxThread;
+    RefPtr<Thread> m_videoThread;
+    RefPtr<Thread> m_audioThread;
+    std::atomic<bool> m_quit { false };
+    AVFormatContext* m_format { nullptr };
+    AVCodecContext* m_videoDecoder { nullptr };
+    AVCodecContext* m_audioDecoder { nullptr };
+    int m_videoStream { -1 };
+    int m_audioStream { -1 };
+    double m_containerDuration { 0 };
+    PacketQueue m_videoQueue;
+    PacketQueue m_audioQueue;
+    // the queue serial whose last frame the decoding thread has decoded and played (drained)
+    static constexpr unsigned kNotDrained = std::numeric_limits<unsigned>::max();
+    std::atomic<unsigned> m_videoDrainedSerial { kNotDrained };
+    std::atomic<unsigned> m_audioDrainedSerial { kNotDrained };
+
+    Lock m_seekLock;
+    bool m_seekRequested WTF_GUARDED_BY_LOCK(m_seekLock) { false };
+    double m_seekTarget WTF_GUARDED_BY_LOCK(m_seekLock) { 0 };
+    // seeks requested so far: an end reached before the latest one is not reported
+    unsigned m_seekGeneration WTF_GUARDED_BY_LOCK(m_seekLock) { 0 };
+
+    mutable Lock m_clockLock;
+    double m_clockPts WTF_GUARDED_BY_LOCK(m_clockLock) { 0 };
+    MonotonicTime m_clockStart WTF_GUARDED_BY_LOCK(m_clockLock);
+    bool m_clockPaused WTF_GUARDED_BY_LOCK(m_clockLock) { true };
+    bool m_clockHold WTF_GUARDED_BY_LOCK(m_clockLock) { true };
+
+    // pictures in a format the compositor does not take (video thread)
+    struct {
+        SwsContext* context { nullptr };
+        AVFrame* frame { nullptr };
+        int format { -1 };
+    } m_converter;
+
+    // the audio device (audio thread)
+    int m_audioFd { -1 };
+    int m_audioLockFd { -1 };
+    bool m_audioDeviceTried { false };
+    MonotonicTime m_audioFeedStart;
+    double m_audioWritten { 0 };
+    std::atomic<double> m_volume { 1 };
+    std::atomic<bool> m_muted { false };
+
+    // counters (any thread)
+    std::atomic<uint64_t> m_decoded { 0 };
+    std::atomic<uint64_t> m_presented { 0 };
+    std::atomic<uint64_t> m_dropped { 0 };
+    std::atomic<int> m_avDriftMs { 0 };
+    // the rpivid decoder's verdict, from its log lines: -1 none yet, 0 the CPU, 1 the block
+    std::atomic<int> m_hardwareState { -1 };
+};
+
+} // namespace WebCore
