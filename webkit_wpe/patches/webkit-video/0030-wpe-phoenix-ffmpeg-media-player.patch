+namespace WebCore {
+
+bool CoordinatedPlatformLayerBufferFFmpeg::supportsPixelFormat(int format)
+{
+    switch (format) {
+    case AV_PIX_FMT_YUV420P:
+    case AV_PIX_FMT_YUVJ420P:
+    case AV_PIX_FMT_NV12:
+        return true;
+    default:
+        return false;
+    }
+}
+
+std::unique_ptr<CoordinatedPlatformLayerBufferFFmpeg> CoordinatedPlatformLayerBufferFFmpeg::create(const AVFrame& frame, Ref<FFmpegFrameCounters>&& counters)
+{
+    if (!supportsPixelFormat(frame.format) || frame.width < 2 || frame.height < 2)
+        return nullptr;
+    AVFrame* reference = av_frame_clone(&frame);
+    if (!reference)
+        return nullptr;
+    return makeUnique<CoordinatedPlatformLayerBufferFFmpeg>(reference, IntSize(frame.width, frame.height), WTF::move(counters));
+}
+
+CoordinatedPlatformLayerBufferFFmpeg::CoordinatedPlatformLayerBufferFFmpeg(AVFrame* frame, const IntSize& size, Ref<FFmpegFrameCounters>&& counters)
+    // Type::Video: a decoded video frame (the GStreamer one is not compiled with USE(FFMPEG))
+    : CoordinatedPlatformLayerBuffer(Type::Video, size, { }, nullptr)
+    , m_frame(frame)
+    , m_counters(WTF::move(counters))
+{
+}
+
+CoordinatedPlatformLayerBufferFFmpeg::~CoordinatedPlatformLayerBufferFFmpeg()
+{
+    // The textures exist only once the frame was drawn, i.e. on the compositing thread, which
+    // is also where a committed buffer is replaced and destroyed. A frame replaced before it was
+    // ever drawn (on the player's thread) has none.
+    if (m_textures[0])
+        glDeleteTextures(m_textures.size(), m_textures.data());
+    av_frame_free(&m_frame);
+}
+
+bool CoordinatedPlatformLayerBufferFFmpeg::isNV12() const
+{
+    return m_frame->format == AV_PIX_FMT_NV12;
+}
+
+void CoordinatedPlatformLayerBufferFFmpeg::countPaint(MonotonicTime uploadStart)
+{
+    if (m_painted)
+        return;
+    m_painted = true;
+    m_counters->painted++;
+    m_counters->uploadMicroseconds += static_cast<uint64_t>((MonotonicTime::now() - uploadStart).microseconds());
+}
+
+// Limited-range ("TV") YCbCr to RGB, as CoordinatedPlatformLayerBufferYUV's matrices.
+static const std::array<GLfloat, 16>& yuvToRgbMatrix(const AVFrame& frame)
+{
+    static constexpr std::array<GLfloat, 16> bt601 {
+        1.164383561643836,  0.0,                1.596026785714286, -0.874202217873451,
+        1.164383561643836, -0.391762290094914, -0.812967647237771,  0.531667823499146,
+        1.164383561643836,  2.017232142857143,  0.0,               -1.085630789302022,
+        0.0,                0.0,                0.0,                1.0,
+    };
+    static constexpr std::array<GLfloat, 16> bt709 {
+        1.164383561643836,  0.0,                1.792741071428571, -0.972945075016308,
+        1.164383561643836, -0.213248614273730, -0.532909328559444,  0.301482665475862,
+        1.164383561643836,  2.112401785714286,  0.0,               -1.133402217873451,
+        0.0,                0.0,                0.0,                1.0,
+    };
+    switch (frame.colorspace) {
+    case AVCOL_SPC_BT470BG:
+    case AVCOL_SPC_SMPTE170M:
+        return bt601;
+    case AVCOL_SPC_BT709:
+        return bt709;
+    default:
+        // unspecified: BT.709 for HD, BT.601 for SD (what players assume)
+        return frame.height >= 720 ? bt709 : bt601;
+    }
+}
+
+void CoordinatedPlatformLayerBufferFFmpeg::paintToTextureMapper(TextureMapper& textureMapper, const FloatRect& targetRect, const TransformationMatrix& modelViewMatrix, float opacity)
+{
+    auto start = MonotonicTime::now();
+    unsigned planes = isNV12() ? 2 : 3;
+    if (!m_textures[0]) {
+        glGenTextures(planes, m_textures.data());
+        for (unsigned i = 0; i < planes; ++i) {
+            bool chroma = i > 0;
+            int width = chroma ? (m_frame->width + 1) / 2 : m_frame->width;
+            int height = chroma ? (m_frame->height + 1) / 2 : m_frame->height;
+            bool interleaved = chroma && isNV12();
+            int bytesPerPixel = interleaved ? 2 : 1;
+            glBindTexture(GL_TEXTURE_2D, m_textures[i]);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, m_frame->linesize[i] / bytesPerPixel);
+            glTexImage2D(GL_TEXTURE_2D, 0, interleaved ? GL_RG8 : GL_R8, width, height, 0, interleaved ? GL_RG : GL_RED, GL_UNSIGNED_BYTE, m_frame->data[i]);
+        }
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glBindTexture(GL_TEXTURE_2D, 0);
+    }
+
+    auto flags = m_flags;
+    if (planes == 2)
+        textureMapper.drawTextureSemiPlanarYUV({ m_textures[0], m_textures[1] }, false, yuvToRgbMatrix(*m_frame), flags, targetRect, modelViewMatrix, opacity, TextureMapper::TransferFunction::Bt709);
+    else
+        textureMapper.drawTexturePlanarYUV({ m_textures[0], m_textures[1], m_textures[2] }, yuvToRgbMatrix(*m_frame), flags, targetRect, modelViewMatrix, opacity, std::nullopt, TextureMapper::TransferFunction::Bt709);
+    countPaint(start);
+}
+
+#if USE(SKIA)
+static SkYUVColorSpace skiaColorSpace(const AVFrame& frame)
+{
+    bool full = frame.color_range == AVCOL_RANGE_JPEG || frame.format == AV_PIX_FMT_YUVJ420P;
+    switch (frame.colorspace) {
+    case AVCOL_SPC_BT470BG:
+    case AVCOL_SPC_SMPTE170M:
+        return full ? kJPEG_Full_SkYUVColorSpace : kRec601_Limited_SkYUVColorSpace;
+    case AVCOL_SPC_BT709:
+        return full ? kRec709_Full_SkYUVColorSpace : kRec709_Limited_SkYUVColorSpace;
+    case AVCOL_SPC_BT2020_NCL:
+    case AVCOL_SPC_BT2020_CL:
+        return full ? kBT2020_8bit_Full_SkYUVColorSpace : kBT2020_8bit_Limited_SkYUVColorSpace;
+    default:
+        if (frame.height >= 720)
+            return full ? kRec709_Full_SkYUVColorSpace : kRec709_Limited_SkYUVColorSpace;
+        return full ? kJPEG_Full_SkYUVColorSpace : kRec601_Limited_SkYUVColorSpace;
+    }
+}
+
+sk_sp<SkImage> CoordinatedPlatformLayerBufferFFmpeg::skiaImage()
+{
+    if (m_skiaImage)
+        return m_skiaImage;
+
+    auto start = MonotonicTime::now();
+    auto* grContext = PlatformDisplay::sharedDisplay().skiaGrContext();
+    if (!grContext)
+        return nullptr;
+
+    int width = m_frame->width;
+    int height = m_frame->height;
+    int chromaWidth = (width + 1) / 2;
+    int chromaHeight = (height + 1) / 2;
+    std::array<SkPixmap, SkYUVAPixmaps::kMaxPlanes> pixmaps;
+    SkYUVAInfo::PlaneConfig planeConfig;
+    pixmaps[0] = SkPixmap(SkImageInfo::Make(width, height, kGray_8_SkColorType, kOpaque_SkAlphaType), m_frame->data[0], m_frame->linesize[0]);
+    if (isNV12()) {
+        planeConfig = SkYUVAInfo::PlaneConfig::kY_UV;
+        pixmaps[1] = SkPixmap(SkImageInfo::Make(chromaWidth, chromaHeight, kR8G8_unorm_SkColorType, kOpaque_SkAlphaType), m_frame->data[1], m_frame->linesize[1]);
+    } else {
+        planeConfig = SkYUVAInfo::PlaneConfig::kY_U_V;
+        pixmaps[1] = SkPixmap(SkImageInfo::Make(chromaWidth, chromaHeight, kGray_8_SkColorType, kOpaque_SkAlphaType), m_frame->data[1], m_frame->linesize[1]);
+        pixmaps[2] = SkPixmap(SkImageInfo::Make(chromaWidth, chromaHeight, kGray_8_SkColorType, kOpaque_SkAlphaType), m_frame->data[2], m_frame->linesize[2]);
+    }
+    SkYUVAInfo info(SkISize::Make(width, height), planeConfig, SkYUVAInfo::Subsampling::k420, skiaColorSpace(*m_frame));
+    auto yuvaPixmaps = SkYUVAPixmaps::FromExternalPixmaps(info, pixmaps.data());
+    if (!yuvaPixmaps.isValid())
+        return nullptr;
+    m_skiaImage = SkImages::TextureFromYUVAPixmaps(grContext, yuvaPixmaps, skgpu::Mipmapped::kNo, false, SkColorSpace::MakeSRGB());
+    if (m_skiaImage)
+        countPaint(start);
+    return m_skiaImage;
+}
+#endif
+
+} // namespace WebCore
+
+#endif // USE(COORDINATED_GRAPHICS) && USE(FFMPEG)
