+/* --- loading -------------------------------------------------------------------------------- */
+
+void MediaPlayerPrivateFFmpeg::load(const String& urlString)
+{
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    stop();
+    m_quit = false;
+    URL url { urlString };
+    RefPtr<PlatformMediaResourceLoader> loader;
+    if (!url.protocolIsFile())
+        loader = player->mediaResourceLoader();
+    m_stream = FFmpegMediaStream::create(url, WTF::move(loader));
+    log("load uri=%s local=%d mime=%s", url.string().utf8().data(), url.protocolIsFile(), player->contentMIMEType().utf8().data());
+    if (!m_stream) {
+        log("error open-failed uri=%s errno=%d", url.string().utf8().data(), errno);
+        setNetworkState(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    setReadyState(MediaPlayer::ReadyState::HaveNothing);
+    m_lastStatTime = MonotonicTime::now();
+    if (int period = envNumber("WPE_PHOENIX_MEDIA_STAT_MS", 2000); period > 0)
+        m_statTimer.startRepeating(Seconds::fromMilliseconds(period));
+    m_demuxThread = Thread::create("FFmpegDemux"_s, [this] { demuxThread(); }, ThreadType::Unknown, Thread::QOS::UserInitiated,
+        Thread::SchedulingPolicy::Other, StackAllocationSpecification::RequestSize(kThreadStack));
+}
