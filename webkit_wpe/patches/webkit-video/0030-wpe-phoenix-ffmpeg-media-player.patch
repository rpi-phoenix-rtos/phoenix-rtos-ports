+/* --- packet queues -------------------------------------------------------------------------- */
+
+void MediaPlayerPrivateFFmpeg::queuePut(PacketQueue& queue, AVPacket* source)
+{
+    AVPacket* packet = av_packet_alloc();
+    if (!packet) {
+        av_packet_unref(source);
+        return;
+    }
+    av_packet_move_ref(packet, source);
+    Locker locker { queue.lock };
+    queue.bytes += packet->size;
+    queue.packets.append(packet);
+    queue.condition.notifyAll();
+}
+
+// Waits up to `timeout` for a packet. The wait also ends at once on an abort, on a flush (a
+// serial other than the caller's `knownSerial`) and, unless the caller has `drained` its decoder
+// already, at the end of the stream: none of these depends on the timeout firing. `serial` is
+// the queue's serial the result belongs to.
+auto MediaPlayerPrivateFFmpeg::queueGet(PacketQueue& queue, AVPacket* packet, unsigned knownSerial, bool drained, unsigned& serial, Seconds timeout) -> Get
+{
+    Locker locker { queue.lock };
+    queue.condition.waitFor(queue.lock, timeout, [&] {
+        assertIsHeld(queue.lock);
+        return !queue.packets.isEmpty() || queue.aborted || queue.serial != knownSerial || (queue.end && !drained);
+    });
+    serial = queue.serial;
+    if (queue.aborted)
+        return Get::Aborted;
+    if (queue.packets.isEmpty())
+        return queue.end ? Get::End : Get::Empty;
+    AVPacket* head = queue.packets.takeFirst();
+    queue.bytes -= head->size;
+    av_packet_move_ref(packet, head);
+    av_packet_free(&head);
+    return Get::Packet;
+}
+
+void MediaPlayerPrivateFFmpeg::queueFlush(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    while (!queue.packets.isEmpty()) {
+        AVPacket* packet = queue.packets.takeFirst();
+        av_packet_free(&packet);
+    }
+    queue.bytes = 0;
+    queue.serial++;
+    queue.end = false;
+    queue.condition.notifyAll();
+}
+
+void MediaPlayerPrivateFFmpeg::queueSetEnd(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    queue.end = true;
+    queue.condition.notifyAll();
+}
+
+void MediaPlayerPrivateFFmpeg::queueAbort(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    queue.aborted = true;
+    queue.condition.notifyAll();
+}
+
+unsigned MediaPlayerPrivateFFmpeg::queueSerial(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    return queue.serial;
+}
+
+size_t MediaPlayerPrivateFFmpeg::queueLength(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    return queue.packets.size();
+}
+
+size_t MediaPlayerPrivateFFmpeg::queueBytes(PacketQueue& queue)
+{
+    Locker locker { queue.lock };
+    return queue.bytes;
+}
+
+/* --- the clock ------------------------------------------------------------------------------ */
+
+double MediaPlayerPrivateFFmpeg::clockNow() const
+{
+    Locker locker { m_clockLock };
+    double t = m_clockPts;
+    if (!m_clockPaused && !m_clockHold)
+        t += (MonotonicTime::now() - m_clockStart).seconds();
+    return t;
+}
+
+void MediaPlayerPrivateFFmpeg::clockSet(double pts, bool hold)
+{
+    Locker locker { m_clockLock };
+    m_clockPts = pts;
+    m_clockStart = MonotonicTime::now();
+    m_clockHold = hold;
+}
+
+bool MediaPlayerPrivateFFmpeg::clockRunning() const
+{
+    Locker locker { m_clockLock };
+    return !m_clockPaused && !m_clockHold;
+}
+
+void MediaPlayerPrivateFFmpeg::clockSetPaused(bool paused)
+{
+    Locker locker { m_clockLock };
+    if (paused == m_clockPaused)
+        return;
+    if (paused && !m_clockHold)
+        m_clockPts += (MonotonicTime::now() - m_clockStart).seconds();
+    m_clockStart = MonotonicTime::now();
+    m_clockPaused = paused;
+}
