+
+// What an FFmpeg decoder is opened with: the codec parameters of one track of one
+// initialization segment (codec, extradata, picture size, sample rate, channels). Every coded
+// frame carries its configuration, so a new initialization segment (a quality or codec switch)
+// reaches the decoding thread exactly at the first frame that needs it.
+class FFmpegCodecConfig final : public ThreadSafeRefCounted<FFmpegCodecConfig> {
+public:
+    // takes the parameters (avcodec_parameters_alloc()ed)
+    static Ref<FFmpegCodecConfig> create(AVCodecParameters*, String&& codec);
+    ~FFmpegCodecConfig();
+
+    const AVCodecParameters& parameters() const { return *m_parameters; }
+    // the RFC 6381 name
+    const String& codec() const { return m_codec; }
+    bool isVideo() const;
+    FloatSize size() const;
+
+private:
+    FFmpegCodecConfig(AVCodecParameters*, String&&);
+
+    AVCodecParameters* m_parameters;
+    const String m_codec;
+};
+
+// Decodes and presents coded frames that arrive already demuxed: one video and one audio input
+// queue, each frame with its FFmpegCodecConfig, decode timestamps in order. The media player
+// that owns it feeds the queues and drives the clock (play, pause, seek, data starvation);
+// everything else happens on the engine's two threads:
+//
+//   video   libavcodec (hevc_rpivid for HEVC, as avcodec_find_decoder() picks it); each picture
+//           waits for the clock and goes to the compositor through the platform layer (8-bit
+//           4:2:0 planes uploaded and colour-converted on the GPU, anything else converted on
+//           the CPU first); a picture later than 100 ms is dropped
+//   audio   libavcodec -> libswresample -> 44.1 kHz S16 stereo -> /dev/audio0 (one writer in the
+//           system: a lock file shared with MediaPlayerPrivateFFmpeg)
+//
+// The clock is a pausable wall clock that runs while playing, not seeking, with data
+// (setWaitingForData) and once the first picture after a start, seek or flush is shown (without
+// video: the first sound). A video queue that runs dry while the clock runs holds the clock at
+// the last picture ("stall"), and the next picture resumes it. Frames enqueued as non-displaying
+// (the decode-only frames before a seek target) are decoded with AV_PKT_FLAG_DISCARD: libavcodec
+// returns no picture or sound for them. A frame with a new configuration first drains the old
+// decoder (its pictures are still shown), then reopens it.
+//
+// Packet timestamps are microseconds (pkt_timebase 1/1000000). Threads start at start() (the
+// owner's first play()): until then nothing is decoded and no decoder exists.
+class FFmpegPlaybackEngine final : public ThreadSafeRefCounted<FFmpegPlaybackEngine> {
+public:
+    enum class Track : uint8_t { Video, Audio };
+    enum class Event : uint8_t {
+        FirstFrame,   // a picture (or, without video, a sound) after a start, seek or flush: value = its time
+        Ended,        // every track that was set ended has played out
+        SizeChanged,  // the picture size of a new configuration (value unused; see naturalSize())
+        DecodeError,  // a decoder that does not open
+        Stalled,      // the video ran dry while playing (value: 1 start, 0 end)
+    };
+    using EventHandler = Function<void(Event, double)>;
+
+    static Ref<FFmpegPlaybackEngine> create(unsigned playerID, EventHandler&&);
+    ~FFmpegPlaybackEngine();
+
+    PlatformLayer* platformLayer() const;
+
+    // input (the MediaSource's dispatcher): takes the packet; its pts/dts are microseconds
+    void enqueue(Track, AVPacket*, Ref<FFmpegCodecConfig>&&, double durationSeconds);
+    void flush(Track);
+    void setEnded(Track);
+    bool isReadyForMore(Track);
+    // `ready` runs on the main thread once the queue is below its low mark
+    void notifyWhenReadyForMore(Track, Function<void()>&& ready);
+
+    // playback (main thread)
+    void start();
+    // back to the state before start(); queued frames are dropped
+    void stop();
+    bool isStarted() const { return m_started; }
+    void setPaused(bool);
+    void setWaitingForData(bool);
+    // whether a video track takes part (without one, the first sound starts the clock)
+    void setExpectsVideo(bool expects) { m_expectsVideo = expects; }
+    // a seek: the clock holds at `time`, the queues are emptied, and nothing is shown until
+    // endSeek() (the frames of the target are being enqueued meanwhile)
+    void beginSeek(double time);
+    void endSeek(double time);
+    void setVolume(double volume) { m_volume = volume; }
+    void setMuted(bool muted) { m_muted = muted; }
+
+    // any thread
+    double currentTime() const;
+    bool isClockRunning() const;
+    FloatSize naturalSize() const;
+
+    struct Counters {
+        uint64_t decoded { 0 };
+        uint64_t presented { 0 };
+        uint64_t painted { 0 };
+        uint64_t dropped { 0 };
+        uint64_t uploadMicroseconds { 0 };
+        int avDriftMs { 0 };
+        int hardware { -1 }; // the rpivid verdict: -1 none yet, 0 the CPU, 1 the block
+        unsigned stalls { 0 };
+        size_t videoPackets { 0 };
+        size_t audioPackets { 0 };
+        size_t queuedBytes { 0 };
+    };
+    Counters counters();
+
+private:
+    FFmpegPlaybackEngine(unsigned playerID, EventHandler&&);
+
+    struct Packet {
+        AVPacket* packet { nullptr };
+        RefPtr<FFmpegCodecConfig> config;
+        double duration { 0 };
+    };
+    struct Queue {
+        Lock lock;
+        Condition condition;
+        Deque<Packet> packets WTF_GUARDED_BY_LOCK(lock);
+        size_t bytes WTF_GUARDED_BY_LOCK(lock) { 0 };
+        double seconds WTF_GUARDED_BY_LOCK(lock) { 0 };
+        unsigned serial WTF_GUARDED_BY_LOCK(lock) { 0 };
+        bool end WTF_GUARDED_BY_LOCK(lock) { false };
+        bool aborted WTF_GUARDED_BY_LOCK(lock) { false };
+        Function<void()> whenReady WTF_GUARDED_BY_LOCK(lock);
+        // set by the first frame queued: the track takes part in the end
+        bool used WTF_GUARDED_BY_LOCK(lock) { false };
+    };
+    enum class Get : uint8_t { Packet, Empty, End, Aborted };
+    Queue& queue(Track track) { return track == Track::Video ? m_videoQueue : m_audioQueue; }
+    Get queueGet(Queue&, Packet&, unsigned knownSerial, bool drained, unsigned& serial, Seconds timeout);
+    void queueFlush(Queue&);
+    unsigned queueSerial(Queue&);
