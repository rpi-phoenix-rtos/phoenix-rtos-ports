+#pragma once
+
+// Plain C++ on purpose: no WebCore or WTF types, no FFmpeg, so that the coordination repo's host
+// harness (tools/browser/media/hosttest) compiles this very file against FFmpeg's mov demuxer.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace WebCore {
+
+// A parser for the ISO BMFF byte stream format of Media Source Extensions: fragmented MP4 as
+// SourceBuffer.appendBuffer() delivers it, an initialization segment (ftyp + moov) and then
+// media segments ([styp] [sidx] moof + mdat), split anywhere across appends.
+//
+// A top-level box is parsed when it is complete; the bytes of an incomplete one wait for the
+// next append. A media segment's samples are reported when its mdat is complete, in file order,
+// each with its payload. Timestamps are in the track's timescale: decode time from tfdt and the
+// sample durations, presentation time = decode time + composition offset, and the track's edit
+// list applied as FFmpeg's mov demuxer applies it (so a stream plays with the same timing through
+// MSE as through MediaPlayerPrivateFFmpeg): an edit list of empty edits (a presentation delay)
+// followed by one media edit moves every time by delay - media_time (the AAC priming, the B-frame
+// delay of a muxer that starts presentation at zero, an audio start offset). Other edit lists
+// are not applied. Encrypted tracks, an explicit base-data-offset and the other forms that the
+// byte stream format excludes are parse errors.
+class FFmpegFMP4Parser {
+public:
+    enum class TrackKind : uint8_t { Video, Audio };
+
+    struct Track {
+        uint32_t id { 0 };
+        TrackKind kind { TrackKind::Video };
+        uint32_t timescale { 0 };
+        // the sample entry's type ("avc1", "hvc1", "mp4a", "Opus", ...) and its RFC 6381 name
+        std::string sampleEntry;
+        std::string codec;
+        // mp4a: the esds object type (0x40 AAC, 0x69/0x6b MP3, ...)
+        uint8_t objectType { 0 };
+        // the decoder configuration as FFmpeg's mov demuxer hands it over: avcC / hvcC payload,
+        // AudioSpecificConfig, an OpusHead built from dOps, FLAC STREAMINFO
+        std::vector<uint8_t> extradata;
+        uint32_t width { 0 };
+        uint32_t height { 0 };
+        uint32_t sampleRate { 0 };
+        uint32_t channels { 0 };
+        std::string language;
+        // added to every decode and presentation time by the edit list (0: none);
+        // editListIgnored: an edit list of a shape that is not applied
+        int64_t editOffset { 0 };
+        bool editListIgnored { false };
+        // the edit list's empty edits (movie timescale) and media edit, until the movie timescale is known
+        uint64_t editDelay { 0 };
+        int64_t editMediaTime { -1 };
+        // mvex/trex
+        uint32_t defaultDuration { 0 };
+        uint32_t defaultSize { 0 };
+        uint32_t defaultFlags { 0 };
+    };
+
+    struct InitSegment {
+        uint32_t movieTimescale { 0 };
+        // movie time units; 0: not known (a live or open-ended presentation)
+        uint64_t duration { 0 };
+        std::vector<Track> tracks;
+        // 1 for the first initialization segment, then one more for each that follows
+        unsigned generation { 0 };
+    };
+
+    struct Sample {
+        uint32_t trackID { 0 };
+        int64_t decodeTime { 0 };
+        int64_t presentationTime { 0 };
+        uint32_t duration { 0 };
+        uint32_t size { 0 };
+        bool isSync { false };
+    };
+
+    class Client {
+    public:
+        virtual ~Client() = default;
+        virtual void didParseInitSegment(const InitSegment&) = 0;
+        // `data` holds `sample.size` bytes, valid during the call only
+        virtual void didParseSample(const Track&, const Sample&, const uint8_t* data) = 0;
+    };
+
+    // False: a parse error (error() says what); the parser rejects everything until reset().
+    bool append(const uint8_t*, size_t, Client&);
+    // SourceBuffer.abort() / the reset parser state algorithm: the bytes of an incomplete box and
+    // a media segment still waiting for its mdat are dropped; the initialization segment stays.
+    void reset();
+
+    const InitSegment* initSegment() const { return m_hasInitSegment ? &m_init : nullptr; }
+    const std::string& error() const { return m_error; }
+    size_t pendingBytes() const { return m_pending.size(); }
+    // The edit lists are applied (the default); the host harness also compares without them.
+    void setApplyEditLists(bool apply) { m_applyEditLists = apply; }
+
+private:
+    struct PendingSample {
+        Sample sample;
+        size_t track { 0 };      // index into m_init.tracks
+        uint64_t offset { 0 };   // in the byte stream
+    };
+
+    // parses the complete top-level boxes of [data, data + size), which starts at stream offset
+    // m_offset; returns the bytes consumed or -1 on an error
+    int64_t parseBoxes(const uint8_t*, size_t, Client&);
+    bool parseMovie(const uint8_t*, size_t);
+    bool parseTrack(const uint8_t*, size_t, Track&, bool& keep);
+    bool parseSampleEntry(const uint8_t*, size_t, Track&);
+    bool parseFragment(const uint8_t*, size_t, uint64_t moofOffset);
+    bool emitSamples(uint64_t payloadOffset, uint64_t end, const uint8_t* payload, Client&);
+    bool fail(std::string);
+    int trackIndex(uint32_t id) const;
+
+    InitSegment m_init;
+    bool m_hasInitSegment { false };
+    // per track of m_init: the decode time where the next fragment without a tfdt starts
+    std::vector<int64_t> m_nextDecodeTime;
+    // the samples of a moof whose mdat has not arrived yet
+    std::vector<PendingSample> m_fragment;
+    bool m_hasFragment { false };
+    // the bytes of an incomplete top-level box; m_offset is the stream offset of the next byte to
+    // parse (m_pending[0] when there are pending bytes)
+    std::vector<uint8_t> m_pending;
+    uint64_t m_offset { 0 };
+    unsigned m_generation { 0 };
+    bool m_applyEditLists { true };
+    std::string m_error;
+};
