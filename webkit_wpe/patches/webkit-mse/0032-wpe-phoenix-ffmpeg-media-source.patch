+/* --- input queues --------------------------------------------------------------------------- */
+
+void FFmpegPlaybackEngine::freePacket(Packet& packet)
+{
+    av_packet_free(&packet.packet);
+    packet.config = nullptr;
+}
+
+void FFmpegPlaybackEngine::enqueue(Track track, AVPacket* packet, Ref<FFmpegCodecConfig>&& config, double duration)
+{
+    auto& queue = this->queue(track);
+    Locker locker { queue.lock };
+    if (queue.aborted) {
+        av_packet_free(&packet);
+        return;
+    }
+    // more frames after the end (the MediaSource was reopened): the stream goes on
+    queue.end = false;
+    m_endPosted = false;
+    queue.used = true;
+    queue.bytes += packet->size;
+    queue.seconds += duration;
+    queue.packets.append({ packet, WTF::move(config), duration });
+    queue.condition.notifyAll();
+}
+
+void FFmpegPlaybackEngine::flush(Track track)
+{
+    // a new pass (WebCore enqueues again from a sync frame): its end is reported again
+    m_endPosted = false;
+    queueFlush(queue(track));
+}
+
+void FFmpegPlaybackEngine::setEnded(Track track)
+{
+    auto& queue = this->queue(track);
+    Locker locker { queue.lock };
+    queue.end = true;
+    queue.condition.notifyAll();
+}
+
+bool FFmpegPlaybackEngine::isReadyForMore(Track track)
+{
+    auto& queue = this->queue(track);
+    Locker locker { queue.lock };
+    return queue.seconds < kQueueFull && (track == Track::Audio || queue.packets.size() < kQueueMaxVideo);
+}
+
+void FFmpegPlaybackEngine::notifyWhenReadyForMore(Track track, Function<void()>&& ready)
+{
+    auto& queue = this->queue(track);
+    Locker locker { queue.lock };
+    queue.whenReady = WTF::move(ready);
+}
+
+// Waits up to `timeout` for a packet; also ends at once on an abort, a flush (a serial other
+// than `knownSerial`) and, unless the caller has drained its decoder already, the end.
+auto FFmpegPlaybackEngine::queueGet(Queue& queue, Packet& packet, unsigned knownSerial, bool drained, unsigned& serial, Seconds timeout) -> Get
+{
+    Function<void()> ready;
+    Get result;
+    {
+        Locker locker { queue.lock };
+        queue.condition.waitFor(queue.lock, timeout, [&] {
+            assertIsHeld(queue.lock);
+            return !queue.packets.isEmpty() || queue.aborted || queue.serial != knownSerial || (queue.end && !drained);
+        });
+        serial = queue.serial;
+        if (queue.aborted)
+            return Get::Aborted;
+        if (queue.packets.isEmpty())
+            return queue.end ? Get::End : Get::Empty;
+        packet = queue.packets.takeFirst();
+        queue.bytes -= packet.packet->size;
+        queue.seconds = std::max(0.0, queue.seconds - packet.duration);
+        if (queue.whenReady && queue.seconds < kQueueLow)
+            ready = std::exchange(queue.whenReady, nullptr);
+        result = Get::Packet;
+    }
+    if (ready)
+        callOnMainThread(WTF::move(ready));
+    return result;
+}
+
+void FFmpegPlaybackEngine::queueFlush(Queue& queue)
+{
+    Locker locker { queue.lock };
+    while (!queue.packets.isEmpty()) {
+        auto packet = queue.packets.takeFirst();
+        freePacket(packet);
+    }
+    queue.bytes = 0;
+    queue.seconds = 0;
+    queue.serial++;
+    queue.end = false;
+    queue.condition.notifyAll();
+}
+
+unsigned FFmpegPlaybackEngine::queueSerial(Queue& queue)
+{
+    Locker locker { queue.lock };
+    return queue.serial;
+}
