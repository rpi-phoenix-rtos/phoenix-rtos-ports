+// The MockMediaPlayerMediaSource pattern: wait until the MediaSource has the target, then
+// WebCore flushes and enqueues every track from the sync frame before it. The clock holds at the
+// target meanwhile and runs again from the first picture.
+Ref<MediaTimePromise> MediaPlayerPrivateFFmpegMSE::seekToTarget(const SeekTarget& target)
+{
+    if (auto previous = std::exchange(m_seekPromise, std::nullopt))
+        previous->reject(PlatformMediaError::Cancelled);
+    RefPtr mediaSourcePrivate = m_mediaSourcePrivate;
+    if (!mediaSourcePrivate)
+        return MediaTimePromise::createAndReject(PlatformMediaError::Cancelled);
+    unsigned generation = ++m_seekGeneration;
+    {
+        Locker locker { m_timeLock };
+        m_pendingSeekTime = target.time;
+        m_ended = false;
+    }
+    log("mse seek target=%.3f", target.time.toDouble());
+    m_engine->beginSeek(target.time.toDouble());
+    m_seekPromise.emplace(PlatformMediaError::Cancelled);
+    Ref promise = m_seekPromise->promise();
+    mediaSourcePrivate->waitForTarget(target)->whenSettled(RunLoop::mainSingleton(), [weakThis = ThreadSafeWeakPtr { *this }, generation](auto&& result) {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis || generation != protectedThis->m_seekGeneration)
+            return;
+        if (!result) {
+            protectedThis->log("mse seek failed");
+            {
+                Locker locker { protectedThis->m_timeLock };
+                protectedThis->m_pendingSeekTime = std::nullopt;
+            }
+            if (auto seekPromise = std::exchange(protectedThis->m_seekPromise, std::nullopt))
+                seekPromise->reject(result.error());
+            return;
+        }
+        MediaTime seekTime = *result;
+        protect(protectedThis->m_mediaSourcePrivate)->reenqueueMediaForTime(seekTime)->whenSettled(RunLoop::mainSingleton(), [weakThis, generation, seekTime](auto&& result) {
+            RefPtr protectedThis = weakThis.get();
+            if (!protectedThis || generation != protectedThis->m_seekGeneration || !result)
+                return;
+            {
+                Locker locker { protectedThis->m_timeLock };
+                protectedThis->m_pendingSeekTime = std::nullopt;
+            }
+            // every track's frames from the sync frame on are enqueued: the first picture may show
+            protectedThis->m_engine->endSeek(seekTime.toDouble());
+            protectedThis->log("seek done pts=%.3f", seekTime.toDouble());
+            if (auto seekPromise = std::exchange(protectedThis->m_seekPromise, std::nullopt))
+                seekPromise->resolve(seekTime);
+        });
+    });
+    return promise;
+}
