+MediaPlayerPrivateFFmpegMSE::MediaPlayerPrivateFFmpegMSE(MediaPlayer& player)
+    : m_player(player)
+    , m_id(nextPlayerID())
+    , m_engine(FFmpegPlaybackEngine::create(m_id, [weakThis = ThreadSafeWeakPtr { *this }](FFmpegPlaybackEngine::Event event, double value) {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->engineEvent(event, value);
+    }))
+    , m_statTimer(RunLoop::mainSingleton(), "MediaPlayerPrivateFFmpegMSE::StatTimer"_s, this, &MediaPlayerPrivateFFmpegMSE::statTimerFired)
+{
+    livePlayers++;
+}
