+// One numbering with MediaPlayerPrivateFFmpeg's players would need a shared symbol; the MSE
+// players count from 1001, so that the two kinds of "id=" never collide in a log.
+static unsigned nextPlayerID()
+{
+    static std::atomic<unsigned> id { 1000 };
+    return ++id;
+}
