+static const HashSet<String>& mimeTypeCache()
+{
+    static NeverDestroyed<HashSet<String>> cache = HashSet<String> { "video/mp4"_s, "audio/mp4"_s };
+    return cache;
+}
+
+// The level of an H.264 name: avc1.PPCCLL (hex) or the older avc1.<profile>.<level> (decimal);
+// nullopt: none given
+static std::optional<unsigned> h264Level(StringView codec)
+{
+    auto dot = codec.find('.');
+    if (dot == notFound)
+        return std::nullopt;
+    auto rest = codec.substring(dot + 1);
+    if (rest.length() == 6 && rest.containsOnly<isASCIIHexDigit>())
+        return parseInteger<unsigned>(rest.substring(4, 2), 16);
+    if (auto second = rest.find('.'); second != notFound)
+        return parseInteger<unsigned>(rest.substring(second + 1));
+    return std::nullopt;
+}
+
+// The level_idc of an HEVC name: hvc1.<profile>.<compatibility>.<tier><level>[.<constraints>]
+static std::optional<unsigned> hevcLevel(StringView codec)
+{
+    unsigned field = 0;
+    for (auto part : codec.split('.')) {
+        if (field++ == 3 && part.length() > 1 && (part[0] == 'L' || part[0] == 'H'))
+            return parseInteger<unsigned>(part.substring(1));
+    }
+    return std::nullopt;
+}
+
+static constexpr unsigned kH264Level31 = 31;   // 1280x720 30 fps
+static constexpr unsigned kH264Level42 = 42;   // 1920x1080 60 fps
+static constexpr unsigned kHEVCLevel41 = 123;  // level_idc = 30 x level: 4.1, 1920x1080 60 fps
+
+// IsSupported or IsNotSupported for one RFC 6381 name in `container`; `reason` says why not
+static bool codecPlays(StringView codec, bool videoContainer, const ContentType& type, const char*& reason)
+{
+    using namespace FFmpegMediaPolicy;
+    auto kind = classifyCodec(codec.utf8().data());
+    unsigned width = parseInteger<unsigned>(type.parameter("width"_s)).value_or(0);
+    unsigned height = parseInteger<unsigned>(type.parameter("height"_s)).value_or(0);
+    double framerate = type.parameter("framerate"_s).toDouble();
+    switch (kind) {
+    case CodecKind::H264: {
+        if (!videoContainer) {
+            reason = "video-in-audio";
+            return false;
+        }
+        bool full = envFlag("WPE_PHOENIX_MSE_H264_1080");
+        auto level = h264Level(codec);
+        if (level && *level > (full ? kH264Level42 : kH264Level31)) {
+            reason = "h264-level";
+            return false;
+        }
+        unsigned maxWidth = full ? 1920 : 1280, maxHeight = full ? 1080 : 720;
+        if (std::max(width, height) > maxWidth || std::min(width, height) > maxHeight || framerate > 30) {
+            reason = "h264-size";
+            return false;
+        }
+        return true;
+    }
+    case CodecKind::HEVCMain:
+    case CodecKind::HEVCMain10: {
+        if (!videoContainer) {
+            reason = "video-in-audio";
+            return false;
+        }
+        bool large = envFlag("WPE_PHOENIX_MSE_HEVC_4K");
+        auto level = hevcLevel(codec);
+        if (!large && level && *level > kHEVCLevel41) {
+            reason = "hevc-level";
+            return false;
+        }
+        if (!large && (std::max(width, height) > 1920 || std::min(width, height) > 1088 || framerate > 60)) {
+            reason = "hevc-size";
+            return false;
+        }
+        return true;
+    }
+    case CodecKind::AAC:
+    case CodecKind::MP3:
+    case CodecKind::Opus:
+    case CodecKind::AC3:
+    case CodecKind::EAC3:
+    case CodecKind::FLAC:
+        return true;
+    default:
+        // VP8/VP9 (WebM, stage 2), AV1 (no decoder), Dolby Vision (no HDR), MPEG-4 Part 2, ...
+        reason = "codec";
+        return false;
+    }
+}
+
+static MediaPlayer::SupportsType answerSupportsType(const MediaEngineSupportParameters& parameters, const char*& reason)
+{
+    if (envFlag("WPE_PHOENIX_MEDIA_DISABLE")) {
+        reason = "disabled";
+        return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    if (parameters.platformType != PlatformMediaDecodingType::MediaSource) {
+        reason = "not-mse";
+        return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    auto container = parameters.type.containerType().convertToASCIILowercase();
+    // the engine choice for a MediaSource load: its blob: URL has no type (the SourceBuffers' types
+    // are asked for one by one)
+    if (container.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+    if (!mimeTypeCache().contains(container)) {
+        reason = "container";
+        return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    auto codecs = parameters.type.codecs();
+    if (codecs.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+    bool videoContainer = container == "video/mp4"_s;
+    for (auto& codec : codecs) {
+        if (!codecPlays(codec, videoContainer, parameters.type, reason))
+            return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    return MediaPlayer::SupportsType::IsSupported;
+}
+
+void MediaPlayerPrivateFFmpegMSE::getSupportedTypes(HashSet<String>& types)
+{
+    types = mimeTypeCache();
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateFFmpegMSE::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    const char* reason = "";
+    auto answer = answerSupportsType(parameters, reason);
+    // MediaSource.isTypeSupported(), addSourceBuffer(), changeType(); MediaSource caches the
+    // first two per type. The first 200 per process.
+    static std::atomic<unsigned> logged { 0 };
+    if (parameters.platformType == PlatformMediaDecodingType::MediaSource && logged++ < 200) {
+        fprintf(stderr, "WPEB-MEDIA mono=%llu canplaytype type=%s platform=media-source answer=%s engine=mse%s%s\n",
+            static_cast<unsigned long long>(monotonicMs()), parameters.type.raw().utf8().data(),
+            answer == MediaPlayer::SupportsType::IsSupported ? "probably" : answer == MediaPlayer::SupportsType::MayBeSupported ? "maybe" : "",
+            *reason ? " reason=" : "", reason);
+    }
+    return answer;
+}
