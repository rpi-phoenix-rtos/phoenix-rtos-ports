+#include <libavcodec/packet.h>
+}
+
+namespace WebCore {
+
+Ref<MediaSampleFFmpeg> MediaSampleFFmpeg::create(AVPacket* packet, Ref<FFmpegCodecConfig>&& config, TrackID trackID, const MediaTime& presentationTime,
+    const MediaTime& decodeTime, const MediaTime& duration, bool isSync)
+{
+    return adoptRef(*new MediaSampleFFmpeg(packet, WTF::move(config), trackID, presentationTime, decodeTime, duration, isSync ? IsSync : None));
+}
+
+MediaSampleFFmpeg::MediaSampleFFmpeg(AVPacket* packet, Ref<FFmpegCodecConfig>&& config, TrackID trackID, const MediaTime& presentationTime,
+    const MediaTime& decodeTime, const MediaTime& duration, SampleFlags flags)
+    : m_packet(packet)
+    , m_config(WTF::move(config))
+    , m_trackID(trackID)
+    , m_presentationTime(presentationTime)
+    , m_decodeTime(decodeTime)
+    , m_duration(duration)
+    , m_flags(flags)
+{
+}
+
+MediaSampleFFmpeg::~MediaSampleFFmpeg()
+{
+    av_packet_free(&m_packet);
+}
+
+size_t MediaSampleFFmpeg::sizeInBytes() const
+{
+    return m_packet ? static_cast<size_t>(m_packet->size) : 0;
+}
+
+void MediaSampleFFmpeg::offsetTimestampsBy(const MediaTime& offset)
+{
+    m_presentationTime += offset;
+    m_decodeTime += offset;
+}
+
+void MediaSampleFFmpeg::setTimestamps(const MediaTime& presentationTime, const MediaTime& decodeTime)
+{
+    m_presentationTime = presentationTime;
+    m_decodeTime = decodeTime;
+}
+
+MediaSample::SampleFlags MediaSampleFFmpeg::flags() const
+{
+    return m_flags;
+}
+
+PlatformSample MediaSampleFFmpeg::platformSample() const
+{
+    return PlatformSample { static_cast<const AVPacket*>(m_packet) };
+}
+
+Ref<MediaSample> MediaSampleFFmpeg::createNonDisplayingCopy() const
+{
+    // the copy shares the payload (a packet reference)
+    return adoptRef(*new MediaSampleFFmpeg(av_packet_clone(m_packet), m_config.copyRef(), m_trackID, m_presentationTime, m_decodeTime, m_duration,
+        static_cast<SampleFlags>(m_flags | IsNonDisplaying)));
+}
+
+// Trimming at an append window edge: the times move forward by `offset`, the end stays
+Ref<MediaSample> MediaSampleFFmpeg::createCopyWithAdjustedStartTime(const MediaTime& offset) const
+{
+    MediaTime clamped = std::max(MediaTime::zeroTime(), std::min(offset, m_duration));
+    return adoptRef(*new MediaSampleFFmpeg(av_packet_clone(m_packet), m_config.copyRef(), m_trackID, m_presentationTime + clamped, m_decodeTime + clamped,
+        m_duration - clamped, m_flags));
+}
+
+AVPacket* MediaSampleFFmpeg::createPacket() const
+{
+    AVPacket* packet = av_packet_clone(m_packet);
+    if (!packet)
+        return nullptr;
+    packet->pts = m_presentationTime.toMicroseconds();
+    packet->dts = m_decodeTime.toMicroseconds();
+    packet->duration = m_duration.toMicroseconds();
+    packet->flags = 0;
+    if (m_flags & IsSync)
+        packet->flags |= AV_PKT_FLAG_KEY;
+    if (m_flags & IsNonDisplaying)
+        packet->flags |= AV_PKT_FLAG_DISCARD;
+    return packet;
+}
+
+} // namespace WebCore
