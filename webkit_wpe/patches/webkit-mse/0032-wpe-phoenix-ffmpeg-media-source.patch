+/* --- the clock ------------------------------------------------------------------------------ */
+
+double FFmpegPlaybackEngine::clockNow() const
+{
+    Locker locker { m_clockLock };
+    double t = m_clockTime;
+    if (!m_clockPaused && !m_clockWaiting && !m_clockHold)
+        t += (MonotonicTime::now() - m_clockStart).seconds();
+    return t;
+}
+
+void FFmpegPlaybackEngine::clockSet(double time, bool hold)
+{
+    Locker locker { m_clockLock };
+    m_clockTime = time;
+    m_clockStart = MonotonicTime::now();
+    m_clockHold = hold;
+}
+
+bool FFmpegPlaybackEngine::clockRunning() const
+{
+    Locker locker { m_clockLock };
+    return !m_clockPaused && !m_clockWaiting && !m_clockHold;
+}
+
+bool FFmpegPlaybackEngine::clockHeld() const
+{
+    Locker locker { m_clockLock };
+    return m_clockHold;
+}
+
+double FFmpegPlaybackEngine::currentTime() const
+{
+    return clockNow();
+}
