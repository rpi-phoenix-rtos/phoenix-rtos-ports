+
+Ref<MediaPromise> SourceBufferPrivateFFmpeg::appendInternal(Ref<SharedBuffer>&& buffer)
+{
+    RefPtr player = this->player();
+    auto data = buffer->span();
+    ParserClient client(*this);
+    m_appendSamples = 0;
+    bool parsed = m_parser.append(data.data(), data.size(), client);
+    if (!parsed) {
+        if (player)
+            player->log("mse append-error bytes=%zu reason=%s", data.size(), m_parser.error().c_str());
+        return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+    }
+    if (player)
+        player->log("mse append bytes=%zu samples=%u pending=%zu buffered_kb=%llu", data.size(), m_appendSamples, m_parser.pendingBytes(),
+            static_cast<unsigned long long>(contentSize() / 1024));
+    return MediaPromise::createAndResolve();
+}
+
+void SourceBufferPrivateFFmpeg::resetParserStateInternal()
+{
+    if (RefPtr player = this->player())
+        player->log("mse reset-parser pending=%zu", m_parser.pendingBytes());
+    m_parser.reset();
+}
+
+bool SourceBufferPrivateFFmpeg::canSwitchToType(const ContentType& type)
+{
+    MediaEngineSupportParameters parameters {
+        .platformType = PlatformMediaDecodingType::MediaSource,
+        .type = type
+    };
+    bool supported = MediaPlayerPrivateFFmpegMSE::supportsType(parameters) != MediaPlayer::SupportsType::IsNotSupported;
+    if (RefPtr player = this->player())
+        player->log("mse changetype from=%s to=%s supported=%d", m_type.utf8().data(), type.raw().utf8().data(), supported);
+    if (supported)
+        m_type = type.raw();
+    return supported;
+}
+
+void SourceBufferPrivateFFmpeg::didParseInitSegment(const FFmpegFMP4Parser::InitSegment& init)
+{
+    InitializationSegment segment;
+    segment.duration = init.duration && init.movieTimescale ? MediaTime(static_cast<int64_t>(init.duration), init.movieTimescale) : MediaTime::invalidTime();
+    m_configs.clear();
+    m_hasVideo = false;
+    String videoCodec = "none"_s, audioCodec = "none"_s;
+    FloatSize size;
+    std::optional<TrackID> firstVideo, firstAudio;
+    for (auto& track : init.tracks) {
+        TrackID id = track.id;
+        Ref config = createCodecConfig(track);
+        String language = String::fromUTF8(track.language.c_str());
+        if (track.kind == FFmpegFMP4Parser::TrackKind::Video) {
+            segment.videoTracks.append({ FFmpegMediaDescription::create(config), FFmpegVideoTrackPrivate::create(id, WTF::move(language)) });
+            if (!m_hasVideo) {
+                videoCodec = String::fromLatin1(avcodec_get_name(config->parameters().codec_id));
+                size = config->size();
+                firstVideo = id;
+            }
+            m_hasVideo = true;
+        } else {
+            segment.audioTracks.append({ FFmpegMediaDescription::create(config), FFmpegAudioTrackPrivate::create(id, WTF::move(language)) });
+            if (!firstAudio) {
+                audioCodec = String::fromLatin1(avcodec_get_name(config->parameters().codec_id));
+                firstAudio = id;
+            }
+        }
+        m_configs.set(id, WTF::move(config));
+    }
+    if (RefPtr mediaSource = mediaSourcePrivate())
+        mediaSource->sourceBufferTracksChanged(*this, firstVideo, firstAudio);
+    RefPtr player = this->player();
+    if (player) {
+        player->log("mse init tracks=%zu video=%s %.0fx%.0f audio=%s generation=%u duration=%.3f", init.tracks.size(), videoCodec.utf8().data(),
+            size.width(), size.height(), audioCodec.utf8().data(), init.generation, segment.duration.isValid() ? segment.duration.toDouble() : -1.0);
+        for (auto& track : init.tracks) {
+            player->log("mse track id=%u kind=%s codec=%s timescale=%u edit=%lld%s", track.id, track.kind == FFmpegFMP4Parser::TrackKind::Video ? "video" : "audio",
+                track.codec.c_str(), track.timescale, static_cast<long long>(track.editOffset), track.editListIgnored ? " (edit list not applied)" : "");
+        }
+        if (m_hasVideo)
+            player->videoSizeChanged(size);
+    }
+    SourceBufferPrivate::didReceiveInitializationSegment(WTF::move(segment));
+}
+
+void SourceBufferPrivateFFmpeg::didParseSample(const FFmpegFMP4Parser::Track& track, const FFmpegFMP4Parser::Sample& sample, const uint8_t* data)
+{
+    auto config = m_configs.find(static_cast<TrackID>(track.id));
+    if (config == m_configs.end())
+        return;
+    // a copy with FFmpeg's input padding: decoders read a little past the end
+    AVPacket* packet = av_packet_alloc();
+    if (!packet || av_new_packet(packet, static_cast<int>(sample.size)) < 0) {
+        av_packet_free(&packet);
+        return;
+    }
+    memcpy(packet->data, data, sample.size);
+    m_appendSamples++;
+    m_samplesReceived++;
+    SourceBufferPrivate::didReceiveSample(MediaSampleFFmpeg::create(packet, config->value.copyRef(), track.id,
+        MediaTime(sample.presentationTime, track.timescale), MediaTime(sample.decodeTime, track.timescale), MediaTime(sample.duration, track.timescale),
+        sample.isSync));
+}
+
+std::optional<FFmpegPlaybackEngine::Track> SourceBufferPrivateFFmpeg::engineTrack(TrackID trackID)
+{
+    auto config = m_configs.find(trackID);
+    if (config == m_configs.end())
+        return std::nullopt;
+    auto track = config->value->isVideo() ? FFmpegPlaybackEngine::Track::Video : FFmpegPlaybackEngine::Track::Audio;
+    RefPtr mediaSource = mediaSourcePrivate();
+    if (!mediaSource || !mediaSource->claimEngineTrack(track, *this, trackID))
+        return std::nullopt;
+    return track;
+}
+
+void SourceBufferPrivateFFmpeg::flush(TrackID trackID)
+{
+    RefPtr player = this->player();
+    if (auto track = engineTrack(trackID); track && player)
+        player->engine().flush(*track);
+}
+
+void SourceBufferPrivateFFmpeg::enqueueSample(Ref<MediaSample>&& sample, TrackID trackID)
+{
+    RefPtr player = this->player();
+    auto track = engineTrack(trackID);
+    if (!player || !track || !is<MediaSampleFFmpeg>(sample.get()))
+        return;
+    auto& ffmpegSample = downcast<MediaSampleFFmpeg>(sample.get());
+    if (AVPacket* packet = ffmpegSample.createPacket())
+        player->engine().enqueue(*track, packet, ffmpegSample.config(), ffmpegSample.duration().toDouble());
+}
+
+void SourceBufferPrivateFFmpeg::allSamplesInTrackEnqueued(TrackID trackID)
+{
+    RefPtr player = this->player();
+    if (auto track = engineTrack(trackID); track && player) {
+        player->log("mse track-ended id=%llu", static_cast<unsigned long long>(trackID));
+        player->engine().setEnded(*track);
+    }
+}
+
+bool SourceBufferPrivateFFmpeg::isReadyForMoreSamples(TrackID trackID)
+{
+    RefPtr player = this->player();
+    auto track = engineTrack(trackID);
+    // a track that does not play takes everything (and drops it)
+    return !player || !track || player->engine().isReadyForMore(*track);
+}
+
+void SourceBufferPrivateFFmpeg::notifyClientWhenReadyForMoreSamples(TrackID trackID)
+{
+    RefPtr player = this->player();
+    auto track = engineTrack(trackID);
+    if (!player || !track)
+        return;
+    player->engine().notifyWhenReadyForMore(*track, [weakThis = ThreadSafeWeakPtr { *this }, trackID] {
+        if (RefPtr protectedThis = weakThis.get())
+            protectedThis->provideMediaData(trackID);
+    });
+}
+
+size_t SourceBufferPrivateFFmpeg::platformMaximumBufferSize() const
+{
+    RefPtr player = this->player();
+    bool played = player && player->hasPlayed();
+    // before the first initialization segment: as a video SourceBuffer
+    bool video = m_hasVideo || m_configs.isEmpty();
+    if (played)
+        return video ? megabytes("WPE_PHOENIX_MSE_MAX_MB", 40) : 8 * 1024 * 1024;
+    return video ? megabytes("WPE_PHOENIX_MSE_IDLE_MAX_MB", 8) : 2 * 1024 * 1024;
+}
+
+void SourceBufferPrivateFFmpeg::updateMaximumBufferSize()
+{
+    setMaximumBufferSize(platformMaximumBufferSize());
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && ENABLE(MEDIA_SOURCE) && USE(FFMPEG)
