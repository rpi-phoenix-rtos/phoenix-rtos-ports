+void MediaPlayerPrivateFFmpegMSE::durationChanged(const MediaTime& duration)
+{
+    {
+        Locker locker { m_timeLock };
+        if (m_duration == duration)
+            return;
+        m_duration = duration;
+    }
+    log("mse duration %.3f", duration.isFinite() ? duration.toDouble() : -1.0);
+    if (RefPtr player = m_player.get())
+        player->durationChanged();
+}
+
+MediaTime MediaPlayerPrivateFFmpegMSE::currentTime() const
+{
+    MediaTime duration;
+    {
+        Locker locker { m_timeLock };
+        if (m_pendingSeekTime)
+            return *m_pendingSeekTime;
+        if (m_ended && m_duration.isFinite())
+            return m_duration;
+        duration = m_duration;
+    }
+    MediaTime now = MediaTime::createWithDouble(std::max(0.0, m_engine->currentTime()));
+    return duration.isFinite() ? std::min(now, duration) : now;
+}
