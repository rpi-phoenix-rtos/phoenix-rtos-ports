+void FFmpegPlaybackEngine::setPaused(bool paused)
+{
+    Locker locker { m_clockLock };
+    if (paused == m_clockPaused)
+        return;
+    if (!m_clockPaused && !m_clockWaiting && !m_clockHold)
+        m_clockTime += (MonotonicTime::now() - m_clockStart).seconds();
+    m_clockStart = MonotonicTime::now();
+    m_clockPaused = paused;
+}
+
+void FFmpegPlaybackEngine::setWaitingForData(bool waiting)
+{
+    Locker locker { m_clockLock };
+    if (waiting == m_clockWaiting)
+        return;
+    if (!m_clockPaused && !m_clockWaiting && !m_clockHold)
+        m_clockTime += (MonotonicTime::now() - m_clockStart).seconds();
+    m_clockStart = MonotonicTime::now();
+    m_clockWaiting = waiting;
+}
