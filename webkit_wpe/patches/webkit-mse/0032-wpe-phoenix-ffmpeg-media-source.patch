+void FFmpegPlaybackEngine::beginSeek(double time)
+{
+    m_seekPending = true;
+    m_seekTarget = time;
+    m_endPosted = false;
+    clockSet(time, true);
+    // what is queued belongs to the old position
+    queueFlush(m_videoQueue);
+    queueFlush(m_audioQueue);
+}
+
+void FFmpegPlaybackEngine::endSeek(double time)
+{
+    m_seekTarget = time;
+    m_seekPending = false;
+}
+
+/* --- threads -------------------------------------------------------------------------------- */
+
+void FFmpegPlaybackEngine::start()
+{
+    if (m_started)
+        return;
+    m_started = true;
+    m_quit = false;
+    log("start (decoders open with the first frames)");
+    m_videoThread = Thread::create("FFmpegMSEVideo"_s, [this] { videoThread(); }, ThreadType::Graphics, Thread::QOS::UserInteractive,
+        Thread::SchedulingPolicy::Other, StackAllocationSpecification::RequestSize(mediaThreadStack()));
+    m_audioThread = Thread::create("FFmpegMSEAudio"_s, [this] { audioThread(); }, ThreadType::Audio, Thread::QOS::UserInteractive,
+        Thread::SchedulingPolicy::Other, StackAllocationSpecification::RequestSize(mediaThreadStack()));
+}
+
+// Joins the threads and returns to the state before start() (main thread): the owner may load
+// again. Nothing the threads wait for needs the main thread: a blocked queue is woken by its
+// abort, and the device is written 10 ms at a time.
+void FFmpegPlaybackEngine::stop()
+{
+    m_quit = true;
+    for (auto* queue : { &m_videoQueue, &m_audioQueue }) {
+        Locker locker { queue->lock };
+        queue->aborted = true;
+        queue->whenReady = nullptr;
+        queue->condition.notifyAll();
+    }
+    for (auto* thread : { &m_videoThread, &m_audioThread }) {
+        if (RefPtr t = std::exchange(*thread, nullptr))
+            t->waitForCompletion();
+    }
+    m_run++;
+    for (auto* queue : { &m_videoQueue, &m_audioQueue }) {
+        queueFlush(*queue);
+        Locker locker { queue->lock };
+        queue->aborted = false;
+        queue->used = false;
+    }
+    {
+        Locker locker { m_clockLock };
+        m_clockTime = 0;
+        m_clockPaused = true;
+        m_clockWaiting = false;
+        m_clockHold = true;
+    }
+    m_seekPending = false;
+    m_seekTarget = 0;
+    m_endPosted = false;
+    m_videoDrainedSerial = m_audioDrainedSerial = kNotDrained;
+    m_audioDeviceTried = false;
+    m_audioWritten = 0;
+    m_audioFeedStart = { };
+    m_quit = false;
+    if (m_audioFd >= 0) {
+        // the ring replays what it holds after close: leave it full of silence
+        audioSilence(0.25);
+        close(m_audioFd);
+        m_audioFd = -1;
+    }
+    if (m_audioLockFd >= 0) {
+        close(m_audioLockFd);
+        m_audioLockFd = -1;
+    }
+    m_started = false;
+}
+
+AVCodecContext* FFmpegPlaybackEngine::openDecoder(const FFmpegCodecConfig& config)
+{
+    const AVCodecParameters& parameters = config.parameters();
+    const AVCodec* codec = avcodec_find_decoder(parameters.codec_id);
+    if (!codec) {
+        log("error no-decoder codec=%s", avcodec_get_name(parameters.codec_id));
+        return nullptr;
+    }
+    AVCodecContext* context = avcodec_alloc_context3(codec);
+    if (!context)
+        return nullptr;
+    avcodec_parameters_to_context(context, &parameters);
+    context->pkt_timebase = kTimeBase;
+    // H.264 (720p30) needs less than three cores; the page and the compositor share them
+    context->thread_count = envNumber("WPE_PHOENIX_MEDIA_THREADS", codec->id == AV_CODEC_ID_H264 ? 3 : 0);
+    context->opaque = &m_hardwareState;
+    if (avcodec_open2(context, codec, nullptr) < 0) {
+        log("error decoder-open codec=%s", codec->name);
+        avcodec_free_context(&context);
+        return nullptr;
+    }
+    const char* rpivid = getenv("FFMPEG_RPIVID");
+    log("decoder %s=%s codec=%s config=%s threads=%d FFMPEG_RPIVID=%s", config.isVideo() ? "video" : "audio", codec->name,
+        avcodec_get_name(parameters.codec_id), config.codec().utf8().data(), context->thread_count, rpivid ? rpivid : "unset");
+    return context;
+}
+
+bool FFmpegPlaybackEngine::presentFrame(AVFrame& decoded)
+{
+    AVFrame* frame = &decoded;
+    if (!CoordinatedPlatformLayerBufferFFmpeg::supportsPixelFormat(decoded.format)) {
+        // 10-bit, 4:2:2, 4:4:4, RGB...: converted to 8-bit 4:2:0 on the CPU (libswscale)
+        if (!m_converter.frame || m_converter.frame->width != decoded.width || m_converter.frame->height != decoded.height || m_converter.format != decoded.format) {
+            sws_freeContext(m_converter.context);
+            av_frame_free(&m_converter.frame);
+            m_converter.format = decoded.format;
+            m_converter.context = sws_getContext(decoded.width, decoded.height, static_cast<AVPixelFormat>(decoded.format), decoded.width, decoded.height,
+                AV_PIX_FMT_YUV420P, SWS_BILINEAR, nullptr, nullptr, nullptr);
+            m_converter.frame = av_frame_alloc();
+            if (m_converter.frame) {
+                m_converter.frame->format = AV_PIX_FMT_YUV420P;
+                m_converter.frame->width = decoded.width;
+                m_converter.frame->height = decoded.height;
+            }
+            if (!m_converter.context || !m_converter.frame || av_frame_get_buffer(m_converter.frame, 0) < 0) {
+                log("error pixel-format %s: no converter", av_get_pix_fmt_name(static_cast<AVPixelFormat>(decoded.format)));
+                sws_freeContext(std::exchange(m_converter.context, nullptr));
+                av_frame_free(&m_converter.frame);
+                return false;
+            }
+            log("convert %s -> yuv420p %dx%d (CPU)", av_get_pix_fmt_name(static_cast<AVPixelFormat>(decoded.format)), decoded.width, decoded.height);
+        }
+        // the compositor may still hold the previous picture: a new buffer for each one
+        if (av_frame_make_writable(m_converter.frame) < 0)
+            return false;
+        sws_scale(m_converter.context, decoded.data, decoded.linesize, 0, decoded.height, m_converter.frame->data, m_converter.frame->linesize);
+        av_frame_copy_props(m_converter.frame, &decoded);
+        m_converter.frame->colorspace = decoded.colorspace;
+        m_converter.frame->color_range = decoded.color_range;
+        frame = m_converter.frame;
+    }
+    auto buffer = CoordinatedPlatformLayerBufferFFmpeg::create(*frame, m_frameCounters.copyRef());
+    if (!buffer)
+        return false;
+    m_contentsBufferProxy->setDisplayBuffer(WTF::move(buffer));
+    m_presented++;
+    return true;
+}
+
+// A decoding thread played out its queue's end: the end is reported once every track that was
+// fed has (each serial is a pass from a start, seek or flush)
+void FFmpegPlaybackEngine::didDrain(Track track, unsigned serial)
+{
+    (track == Track::Video ? m_videoDrainedSerial : m_audioDrainedSerial) = serial;
+    auto drained = [&](Queue& queue, std::atomic<unsigned>& drainedSerial) {
+        Locker locker { queue.lock };
+        return !queue.used || (queue.end && queue.packets.isEmpty() && drainedSerial == queue.serial);
+    };
+    if (drained(m_videoQueue, m_videoDrainedSerial) && drained(m_audioQueue, m_audioDrainedSerial) && !m_endPosted.exchange(true)) {
+        log("end clock=%.3f decoded=%llu presented=%llu painted=%llu dropped=%llu", clockNow(), static_cast<unsigned long long>(m_decoded.load()),
+            static_cast<unsigned long long>(m_presented.load()), static_cast<unsigned long long>(m_frameCounters->painted.load()),
+            static_cast<unsigned long long>(m_dropped.load()));
+        post(Event::Ended);
+    }
+}
+
+void FFmpegPlaybackEngine::videoThread()
+{
+    Packet packet;
+    AVFrame* frame = av_frame_alloc();
+    AVCodecContext* decoder = nullptr;
+    RefPtr<FFmpegCodecConfig> config;
+    unsigned serial = std::numeric_limits<unsigned>::max(), queueSerialNow;
+    bool drained = false, first = true, stalled = false;
+    double lastPts = 0;
+    MonotonicTime lastShown, stallStart;
+
+    // the frames the decoder returns: a first picture after a start, seek or flush starts the
+    // clock; the others wait for their time or are dropped when late
+    auto receiveFrames = [&]() -> int {
+        int ret = 0;
+        while (!m_quit && decoder && !(ret = avcodec_receive_frame(decoder, frame))) {
+            m_decoded++;
+            double pts = frame->best_effort_timestamp != AV_NOPTS_VALUE ? frame->best_effort_timestamp * av_q2d(kTimeBase) : lastPts;
+            if (first) {
+                // nothing is shown until the seek's frames are all enqueued
+                while (!m_quit && m_seekPending && queueSerial(m_videoQueue) == serial)
+                    usleep(5000);
+                if (m_quit || queueSerial(m_videoQueue) != serial) {
+                    av_frame_unref(frame);
+                    break;
+                }
+                double target = m_seekTarget;
+                presentFrame(*frame);
+                clockSet(std::max(pts, target), false);
+                lastPts = pts;
+                lastShown = MonotonicTime::now();
+                first = false;
+                log("first-frame pts=%.3f %dx%d format=%s", pts, frame->width, frame->height, av_get_pix_fmt_name(static_cast<AVPixelFormat>(frame->format)));
+                post(Event::FirstFrame, std::max(pts, target));
+                av_frame_unref(frame);
+                continue;
+            }
+            if (stalled) {
+                // after a stall the clock resumes at this picture
+                log("stall end after_ms=%.0f pts=%.3f", (MonotonicTime::now() - stallStart).milliseconds(), pts);
+                presentFrame(*frame);
+                clockSet(pts, false);
+                lastPts = pts;
+                lastShown = MonotonicTime::now();
+                stalled = false;
+                post(Event::Stalled, 0);
+                av_frame_unref(frame);
+                continue;
+            }
+            // wait for its time (the clock stands still while paused, seeking or without data)
+            double wait = 0;
+            while (!m_quit && queueSerial(m_videoQueue) == serial) {
+                wait = pts - clockNow();
+                bool running = clockRunning();
+                if (!running || wait > 0.002) {
+                    usleep(wait > 0.02 || !running ? 10000 : static_cast<useconds_t>(wait * 1000000));
+                    continue;
+                }
+                break;
+            }
+            if (m_quit || queueSerial(m_videoQueue) != serial) {
+                av_frame_unref(frame);
+                break;
+            }
+            // late: dropped, unless nothing was shown for half a second (a decoder slower than
+            // the stream still shows a picture now and then)
+            if (wait < -kLateDrop && MonotonicTime::now() - lastShown < 500_ms)
+                m_dropped++;
+            else if (presentFrame(*frame))
+                lastShown = MonotonicTime::now();
+            lastPts = pts;
+            av_frame_unref(frame);
+        }
+        return ret;
+    };
+
+    while (!m_quit) {
+        auto got = queueGet(m_videoQueue, packet, serial, drained, queueSerialNow, 20_ms);
+        if (got == Get::Aborted)
+            break;
+        if (queueSerialNow != serial) {
+            if (decoder)
+                avcodec_flush_buffers(decoder);
+            serial = queueSerialNow;
+            drained = false;
+            first = true;
+            stalled = false;
+        }
+        if (got == Get::Empty && !first && !stalled && !drained && clockRunning() && clockNow() > lastPts + kStallAfter) {
+            double held = clockNow();
+            clockSet(held, true);
+            stalled = true;
+            stallStart = MonotonicTime::now();
+            log("stall start clock=%.3f last-pts=%.3f n=%u", held, lastPts, ++m_stalls);
+            post(Event::Stalled, 1);
+        }
+        if (got == Get::Empty || (got == Get::End && drained))
+            continue;
+        if (got == Get::End) {
+            // the last frame is in: the decoder gives back the pictures it still holds
+            if (decoder)
+                avcodec_send_packet(decoder, nullptr);
+            drained = true;
+        } else {
+            if (drained) {
+                // more frames after an end that was already played out
+                if (decoder)
+                    avcodec_flush_buffers(decoder);
+                drained = false;
+            }
+            if (packet.config != config) {
+                if (decoder) {
+                    // a new configuration: the old decoder's last pictures first
+                    avcodec_send_packet(decoder, nullptr);
+                    receiveFrames();
+                    avcodec_free_context(&decoder);
+                    log("decoder reopen %s -> %s", config->codec().utf8().data(), packet.config->codec().utf8().data());
+                }
+                config = packet.config;
+                decoder = openDecoder(*config);
+                if (!decoder)
+                    post(Event::DecodeError);
+                FloatSize size = config->size();
+                bool sizeChanged;
+                {
+                    Locker locker { m_sizeLock };
+                    sizeChanged = size != m_naturalSize;
+                    m_naturalSize = size;
+                }
+                if (sizeChanged)
+                    post(Event::SizeChanged);
+            }
+            if (decoder)
+                avcodec_send_packet(decoder, packet.packet);
+            freePacket(packet);
+        }
+        int ret = receiveFrames();
+        // drained: the decoder said AVERROR_EOF (not a break for a seek or quit)
+        if (drained && (ret == AVERROR_EOF || !decoder) && !m_quit && queueSerial(m_videoQueue) == serial && m_videoDrainedSerial != serial) {
+            log("drained video decoded=%llu", static_cast<unsigned long long>(m_decoded.load()));
+            didDrain(Track::Video, serial);
+        }
+    }
+    freePacket(packet);
+    avcodec_free_context(&decoder);
+    sws_freeContext(std::exchange(m_converter.context, nullptr));
+    av_frame_free(&m_converter.frame);
+    av_frame_free(&frame);
+}
+
+/* --- audio ---------------------------------------------------------------------------------- */
+
+void FFmpegPlaybackEngine::openAudioDevice()
+{
+    m_audioDeviceTried = true;
+    if (!envNumber("WPE_PHOENIX_MEDIA_AUDIO", 1)) {
+        log("audio sound=off reason=disabled");
+        return;
+    }
+    // one writer for the device: its ring would interleave two streams
+    m_audioLockFd = open(kAudioLockFile, O_RDWR | O_CREAT, 0666);
+    struct flock lock { };
+    lock.l_type = F_WRLCK;
+    lock.l_whence = SEEK_SET;
+    if (m_audioLockFd < 0 || fcntl(m_audioLockFd, F_SETLK, &lock) < 0) {
+        log("audio sound=off reason=busy (%s held by another player)", kAudioLockFile);
+        if (m_audioLockFd >= 0)
+            close(m_audioLockFd);
+        m_audioLockFd = -1;
+        return;
+    }
+    m_audioFd = open(kAudioDevice, O_WRONLY);
+    if (m_audioFd < 0) {
+        log("audio sound=off reason=open device=%s errno=%d", kAudioDevice, errno);
+        close(m_audioLockFd);
+        m_audioLockFd = -1;
+        return;
+    }
+    log("audio sound=on device=%s fill_ms=%.0f", kAudioDevice, kAudioFill * 1000);
+}
+
+// The fill (sound queued but not heard yet): seconds written minus seconds elapsed since the
+// first write; the ring drains at the playback rate
+double FFmpegPlaybackEngine::audioFill()
+{
+    if (!m_audioFeedStart)
+        return 0;
+    double fill = m_audioWritten - (MonotonicTime::now() - m_audioFeedStart).seconds();
+    if (fill < 0) {
+        // the ring ran dry (or the model drifted): start the model again
+        m_audioFeedStart = { };
+        m_audioWritten = 0;
+        fill = 0;
+    }
+    return fill;
+}
+
+void FFmpegPlaybackEngine::audioWrite(const uint8_t* data, size_t length)
+{
+    if (!m_audioFeedStart)
+        m_audioFeedStart = MonotonicTime::now();
+    m_audioWritten += length / (4.0 * kAudioRate);
+    while (length && m_audioFd >= 0) {
+        ssize_t n = write(m_audioFd, data, length);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            log("audio write-failed errno=%d: sound off", errno);
+            close(m_audioFd);
+            m_audioFd = -1;
+            return;
+        }
+        data += n;
+        length -= n;
+    }
+}
+
+void FFmpegPlaybackEngine::audioSilence(double seconds)
+{
+    static const uint8_t zero[4 * (kAudioRate / 100)] = { };
+    size_t length = static_cast<size_t>(seconds * kAudioRate) * 4;
+    while (length && m_audioFd >= 0) {
+        size_t n = std::min(length, sizeof(zero));
+        audioWrite(zero, n);
+        length -= n;
+    }
+}
+
+void FFmpegPlaybackEngine::audioThread()
+{
+    Packet packet;
+    AVFrame* frame = av_frame_alloc();
+    AVCodecContext* decoder = nullptr;
+    RefPtr<FFmpegCodecConfig> config;
+    AVChannelLayout stereo = AV_CHANNEL_LAYOUT_STEREO;
+    SwrContext* resampler = nullptr;
+    // what the resampler was set up for
+    int resamplerRate = 0, resamplerFormat = -1, resamplerChannels = 0;
+    Vector<uint8_t> out;
+    size_t outLength = 0;
+    unsigned serial = std::numeric_limits<unsigned>::max(), queueSerialNow = 0, haveSerial = 0;
+    bool drained = false, have = false;
+    double pts = 0, duration = 0;
+
+    while (!m_quit) {
+        if (!m_audioDeviceTried && clockRunning())
+            openAudioDevice();
+        double fill = audioFill();
+        if (m_audioFd >= 0 && fill > kAudioFill) {
+            usleep(fill - kAudioFill > 0.01 ? 10000 : static_cast<useconds_t>((fill - kAudioFill) * 1000000) + 500);
+            continue;
+        }
+        if (have && queueSerial(m_audioQueue) != haveSerial)
+            have = false; // decoded before a seek
+        if (!have) {
+            int ret = decoder ? avcodec_receive_frame(decoder, frame) : AVERROR(EAGAIN);
+            if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+                // AVERROR_EOF: drained, and every sound decoded was written (or dropped late)
+                if ((ret == AVERROR_EOF || !decoder) && drained && m_audioDrainedSerial != serial && queueSerial(m_audioQueue) == serial) {
+                    log("drained audio");
+                    didDrain(Track::Audio, serial);
+                }
+                auto got = queueGet(m_audioQueue, packet, serial, drained, queueSerialNow, m_audioFd >= 0 ? 5_ms : 20_ms);
+                if (got == Get::Aborted)
+                    break;
+                if (queueSerialNow != serial) {
+                    if (decoder)
+                        avcodec_flush_buffers(decoder);
+                    serial = queueSerialNow;
+                    drained = false;
+                }
+                if (got == Get::Packet) {
+                    if (drained) {
+                        if (decoder)
+                            avcodec_flush_buffers(decoder);
+                        drained = false;
+                    }
+                    if (packet.config != config) {
+                        if (decoder)
+                            log("decoder reopen %s -> %s", config->codec().utf8().data(), packet.config->codec().utf8().data());
+                        avcodec_free_context(&decoder);
+                        config = packet.config;
+                        decoder = openDecoder(*config);
+                        if (!decoder)
+                            post(Event::DecodeError);
+                    }
+                    if (decoder)
+                        avcodec_send_packet(decoder, packet.packet);
+                    freePacket(packet);
+                } else if (got == Get::End && !drained) {
+                    if (decoder)
+                        avcodec_send_packet(decoder, nullptr);
+                    drained = true;
+                }
+            } else if (!ret) {
+                if (frame->pts != AV_NOPTS_VALUE) {
+                    pts = frame->pts * av_q2d(kTimeBase);
+                    duration = static_cast<double>(frame->nb_samples) / frame->sample_rate;
+                    if (resampler && (frame->sample_rate != resamplerRate || frame->format != resamplerFormat || frame->ch_layout.nb_channels != resamplerChannels))
+                        swr_free(&resampler); // a new configuration
+                    if (!resampler) {
+                        if (frame->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC)
+                            av_channel_layout_default(&frame->ch_layout, frame->ch_layout.nb_channels);
+                        if (swr_alloc_set_opts2(&resampler, &stereo, AV_SAMPLE_FMT_S16, kAudioRate, &frame->ch_layout,
+                            static_cast<AVSampleFormat>(frame->format), frame->sample_rate, 0, nullptr) < 0 || swr_init(resampler) < 0) {
+                            log("error audio-resampler: sound off");
+                            swr_free(&resampler);
+                        } else {
+                            resamplerRate = frame->sample_rate;
+                            resamplerFormat = frame->format;
+                            resamplerChannels = frame->ch_layout.nb_channels;
+                            log("audio %s %d Hz %d ch -> S16 %d Hz stereo", av_get_sample_fmt_name(static_cast<AVSampleFormat>(frame->format)),
+                                frame->sample_rate, frame->ch_layout.nb_channels, kAudioRate);
+                        }
+                    }
+                    if (resampler) {
+                        int maxSamples = swr_get_out_samples(resampler, frame->nb_samples);
+                        out.grow(std::max<size_t>(out.size(), maxSamples * 4));
+                        uint8_t* outPlane = out.mutableSpan().data();
+                        int n = swr_convert(resampler, &outPlane, maxSamples, const_cast<const uint8_t**>(frame->extended_data), frame->nb_samples);
+                        outLength = n > 0 ? n * 4 : 0;
+                        have = outLength;
+                        haveSerial = serial;
+                    }
+                }
+                av_frame_unref(frame);
+            }
+        }
+        if (have && !m_expectsVideo && !m_seekPending) {
+            // no picture stream: the first sound starts the clock (start, seek)
+            bool released = false;
+            {
+                Locker locker { m_clockLock };
+                if (m_clockHold) {
+                    m_clockTime = std::max(pts, m_seekTarget.load());
+                    m_clockStart = MonotonicTime::now();
+                    m_clockHold = false;
+                    released = true;
+                }
+            }
+            if (released) {
+                log("first-sound pts=%.3f", pts);
+                post(Event::FirstFrame, pts);
+            }
+        }
+        if (m_audioFd < 0) {
+            // no device: consume the sound at the clock's pace so the queue keeps moving
+            if (have && clockRunning() && pts <= clockNow() + 0.5)
+                have = false;
+            else if (have)
+                usleep(10000);
+            continue;
+        }
+        if (!have || !clockRunning()) {
+            audioSilence(kAudioChunk);
+            continue;
+        }
+        double heard = clockNow() + audioFill();
+        if (pts + duration < heard - kAudioLate) {
+            have = false; // late: dropped
+            continue;
+        }
+        if (pts > heard + kAudioEarly) {
+            audioSilence(std::min(pts - heard, kAudioChunk));
+            continue;
+        }
+        m_avDriftMs = static_cast<int>((pts - heard) * 1000);
+        double gain = m_muted ? 0 : m_volume.load();
+        if (gain < 0.999) {
+            auto* samples = reinterpret_cast<int16_t*>(out.mutableSpan().data());
+            for (size_t i = 0; i < outLength / 2; ++i)
+                samples[i] = static_cast<int16_t>(samples[i] * gain);
+        }
+        audioWrite(out.span().data(), outLength);
+        have = false;
+    }
+    freePacket(packet);
+    avcodec_free_context(&decoder);
+    swr_free(&resampler);
+    av_frame_free(&frame);
+}
+
+auto FFmpegPlaybackEngine::counters() -> Counters
+{
+    Counters counters;
+    counters.decoded = m_decoded;
+    counters.presented = m_presented;
+    counters.painted = m_frameCounters->painted;
+    counters.dropped = m_dropped;
+    counters.uploadMicroseconds = m_frameCounters->uploadMicroseconds;
+    counters.avDriftMs = m_avDriftMs;
+    counters.hardware = m_hardwareState;
+    counters.stalls = m_stalls;
+    {
+        Locker locker { m_videoQueue.lock };
+        counters.videoPackets = m_videoQueue.packets.size();
+        counters.queuedBytes += m_videoQueue.bytes;
+    }
+    {
+        Locker locker { m_audioQueue.lock };
+        counters.audioPackets = m_audioQueue.packets.size();
+        counters.queuedBytes += m_audioQueue.bytes;
+    }
+    return counters;
+}
