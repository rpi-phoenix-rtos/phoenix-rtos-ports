+
+void MediaPlayerPrivateFFmpegMSE::load(const URL&, const LoadOptions&, MediaSourcePrivateClient& client)
+{
+    if (m_mediaSourcePrivate) {
+        // MediaPlayer chose this engine again for another MediaSource: from the start
+        m_engine->stop();
+        m_hasPlayed = false;
+        m_paused = true;
+        m_firstFrameShown = false;
+        m_naturalSize = { };
+        Locker locker { m_timeLock };
+        m_duration = MediaTime::invalidTime();
+        m_pendingSeekTime = std::nullopt;
+        m_ended = false;
+    }
+    if (auto seekPromise = std::exchange(m_seekPromise, std::nullopt))
+        seekPromise->reject(PlatformMediaError::Cancelled);
+    if (RefPtr mediaSourcePrivate = dynamicDowncast<MediaSourcePrivateFFmpeg>(client.mediaSourcePrivate())) {
+        // a MediaSource that was attached before (detached, then attached to this element)
+        mediaSourcePrivate->setPlayer(this);
+        m_mediaSourcePrivate = WTF::move(mediaSourcePrivate);
+        client.reOpen();
+    } else
+        m_mediaSourcePrivate = MediaSourcePrivateFFmpeg::create(*this, client);
+    log("mse load players=%u", livePlayers.load());
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    m_lastStatTime = MonotonicTime::now();
+    const char* period = getenv("WPE_PHOENIX_MEDIA_STAT_MS");
+    if (int ms = period && *period ? atoi(period) : 2000; ms > 0)
+        m_statTimer.startRepeating(Seconds::fromMilliseconds(ms));
+}
