+// the device, as MediaPlayerPrivateFFmpeg drives it: 44.1 kHz signed 16-bit stereo, a blocking
+// write() paces the writer (a free-running ~0.19 s DMA ring that replays what it holds when not fed)
+static constexpr int kAudioRate = 44100;
+static constexpr double kAudioFill = 0.12;   // seconds kept queued in the ring
+static constexpr double kAudioChunk = 0.01;  // silence is written in chunks of this
+static constexpr double kAudioLate = 0.05;   // a sound frame heard later than this is dropped
+static constexpr double kAudioEarly = 0.02;  // ... earlier than this waits behind silence
+static constexpr double kLateDrop = 0.10;    // a picture later than this is dropped
+// no picture this long after the last one's time while the clock runs: a stall (the clock holds)
+static constexpr double kStallAfter = 0.25;
+// the input queues: ready for more below kQueueFull seconds (and, video, kQueueMaxVideo frames);
+// a waiting producer is called back below kQueueLow
+static constexpr double kQueueFull = 2.0;
+static constexpr double kQueueLow = 1.0;
+static constexpr size_t kQueueMaxVideo = 120;
+static constexpr AVRational kTimeBase = { 1, 1000000 };
+static const char* const kAudioDevice = "/dev/audio0";
+// one writer of the device in the whole system: a process-owned record lock (dropped at exit),
+// the same file as MediaPlayerPrivateFFmpeg's
+static const char* const kAudioLockFile = "/tmp/.wpe-audio0.lock";
+
+static uint64_t monotonicMs()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+static int envNumber(const char* name, int fallback)
+{
+    const char* value = getenv(name);
+    if (!value || !*value)
+        return fallback;
+    return atoi(value);
+}
+
+// The player threads' stack: WPE_PHOENIX_MEDIA_STACK_KB as MediaPlayerPrivateFFmpeg's
+static size_t mediaThreadStack()
+{
+    static const size_t bytes = static_cast<size_t>(std::max(envNumber("WPE_PHOENIX_MEDIA_STACK_KB", 2048), 256)) * 1024;
+    return bytes;
+}
