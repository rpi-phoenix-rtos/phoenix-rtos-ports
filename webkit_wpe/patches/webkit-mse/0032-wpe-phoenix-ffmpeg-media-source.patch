+class MediaPlayerPrivateFFmpegMSE;
+class SourceBufferPrivateFFmpeg;
+
+// The platform side of a MediaSource for MediaPlayerPrivateFFmpegMSE: creates the SourceBuffers
+// (fragmented MP4 of the types the engine answers for), passes the duration to the player, and
+// decides which SourceBuffer's track feeds the engine's one video and one audio input (the first
+// track of each kind; a second video track, in another SourceBuffer, is parsed and buffered but
+// not played).
+class MediaSourcePrivateFFmpeg final : public MediaSourcePrivate {
+public:
+    static Ref<MediaSourcePrivateFFmpeg> create(MediaPlayerPrivateFFmpegMSE&, MediaSourcePrivateClient&);
+    virtual ~MediaSourcePrivateFFmpeg();
+
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::FFmpeg; }
+
+    RefPtr<MediaPlayerPrivateInterface> player() const final;
+    void setPlayer(MediaPlayerPrivateInterface*) final;
+    RefPtr<MediaPlayerPrivateFFmpegMSE> ffmpegPlayer() const { return m_player.get(); }
+
+    AddStatus addSourceBuffer(const ContentType&, const MediaSourceConfiguration&, RefPtr<SourceBufferPrivate>&) final;
+    void removeSourceBuffer(SourceBufferPrivate&) final;
+    void durationChanged(const MediaTime&) final;
+    void notifyActiveSourceBuffersChanged() final;
+
+    // main thread (the dispatcher): whether `trackID` of `sourceBuffer` is the one that plays
+    // `track`; the first to ask for a kind gets it
+    bool claimEngineTrack(FFmpegPlaybackEngine::Track, const SourceBufferPrivateFFmpeg&, TrackID);
+    // a SourceBuffer's new initialization segment: its first video and audio track
+    void sourceBufferTracksChanged(const SourceBufferPrivateFFmpeg&, std::optional<TrackID> video, std::optional<TrackID> audio);
+    // the player played: its SourceBuffers may hold more
+    void playerDidPlay();
+
+    struct Stats {
+        unsigned sourceBuffers { 0 };
+        uint64_t bufferedBytes { 0 };
+        uint64_t samples { 0 };
+    };
+    Stats stats() const;
+
+private:
+    MediaSourcePrivateFFmpeg(MediaPlayerPrivateFFmpegMSE&, MediaSourcePrivateClient&);
+
+    ThreadSafeWeakPtr<MediaPlayerPrivateFFmpegMSE> m_player;
+    struct Owner {
+        const SourceBufferPrivateFFmpeg* sourceBuffer { nullptr };
+        TrackID track { 0 };
+    };
+    std::optional<Owner> m_videoOwner;
+    std::optional<Owner> m_audioOwner;
+};
+
