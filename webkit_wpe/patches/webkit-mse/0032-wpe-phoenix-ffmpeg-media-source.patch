+// WebCore's verdict on the buffered data: below HaveFutureData the clock waits (HTMLMediaElement
+// keeps a stalled element playing; 'waiting' fires) and resumes when data is back
+void MediaPlayerPrivateFFmpegMSE::readyStateFromMediaSourceChanged()
+{
+    auto state = readyState();
+    if (state != m_lastReadyState) {
+        log("mse ready-state %d -> %d clock=%.3f", static_cast<int>(m_lastReadyState), static_cast<int>(state), m_engine->currentTime());
+        m_lastReadyState = state;
+    }
+    m_engine->setWaitingForData(state < MediaPlayer::ReadyState::HaveFutureData);
+    if (RefPtr player = m_player.get())
+        player->readyStateChanged();
+}
