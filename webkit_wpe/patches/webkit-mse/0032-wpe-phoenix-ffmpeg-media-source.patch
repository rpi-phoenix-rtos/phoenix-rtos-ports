+namespace WebCore {
+
+Ref<MediaSourcePrivateFFmpeg> MediaSourcePrivateFFmpeg::create(MediaPlayerPrivateFFmpegMSE& player, MediaSourcePrivateClient& client)
+{
+    Ref source = adoptRef(*new MediaSourcePrivateFFmpeg(player, client));
+    client.setPrivateAndOpen(source.copyRef());
+    return source;
+}
+
+MediaSourcePrivateFFmpeg::MediaSourcePrivateFFmpeg(MediaPlayerPrivateFFmpegMSE& player, MediaSourcePrivateClient& client)
+    : MediaSourcePrivate(client)
+    , m_player(player)
+{
+#if !RELEASE_LOG_DISABLED
+    client.setLogIdentifier(player.mediaPlayerLogIdentifier());
+#endif
+}
+
+MediaSourcePrivateFFmpeg::~MediaSourcePrivateFFmpeg() = default;
+
+RefPtr<MediaPlayerPrivateInterface> MediaSourcePrivateFFmpeg::player() const
+{
+    return m_player.get();
+}
+
+void MediaSourcePrivateFFmpeg::setPlayer(MediaPlayerPrivateInterface* player)
+{
+    // a detached MediaSource attached to another element: a new engine, nothing plays from before
+    m_player = downcast<MediaPlayerPrivateFFmpegMSE>(player);
+    m_videoOwner = std::nullopt;
+    m_audioOwner = std::nullopt;
+}
+
+MediaSourcePrivate::AddStatus MediaSourcePrivateFFmpeg::addSourceBuffer(const ContentType& type, const MediaSourceConfiguration&, RefPtr<SourceBufferPrivate>& sourceBuffer)
+{
+    MediaEngineSupportParameters parameters {
+        .platformType = PlatformMediaDecodingType::MediaSource,
+        .type = type
+    };
+    bool supported = MediaPlayerPrivateFFmpegMSE::supportsType(parameters) != MediaPlayer::SupportsType::IsNotSupported;
+    RefPtr player = ffmpegPlayer();
+    if (player)
+        player->log("mse addsourcebuffer type=%s supported=%d", type.raw().utf8().data(), supported);
+    if (!supported)
+        return AddStatus::NotSupported;
+    {
+        Locker locker { m_lock };
+        m_sourceBuffers.append(SourceBufferPrivateFFmpeg::create(*this, type));
+        sourceBuffer = m_sourceBuffers.last();
+    }
+    sourceBuffer->setMediaSourceDuration(duration());
+    return AddStatus::Ok;
+}
+
+void MediaSourcePrivateFFmpeg::removeSourceBuffer(SourceBufferPrivate& sourceBuffer)
+{
+    for (auto* owner : { &m_videoOwner, &m_audioOwner }) {
+        if (*owner && (*owner)->sourceBuffer == &sourceBuffer)
+            *owner = std::nullopt;
+    }
+    MediaSourcePrivate::removeSourceBuffer(sourceBuffer);
+}
+
+void MediaSourcePrivateFFmpeg::durationChanged(const MediaTime& duration)
+{
+    MediaSourcePrivate::durationChanged(duration);
+    ensureOnMainThread([weakThis = ThreadSafeWeakPtr { *this }, duration] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+        if (RefPtr player = protectedThis->ffmpegPlayer())
+            player->durationChanged(duration);
+    });
+}
+
+void MediaSourcePrivateFFmpeg::notifyActiveSourceBuffersChanged()
+{
+    if (RefPtr player = ffmpegPlayer())
+        player->notifyActiveSourceBuffersChanged();
+}
+
+bool MediaSourcePrivateFFmpeg::claimEngineTrack(FFmpegPlaybackEngine::Track track, const SourceBufferPrivateFFmpeg& sourceBuffer, TrackID trackID)
+{
+    auto& owner = track == FFmpegPlaybackEngine::Track::Video ? m_videoOwner : m_audioOwner;
+    if (!owner) {
+        owner = Owner { &sourceBuffer, trackID };
+        if (RefPtr player = ffmpegPlayer())
+            player->log("mse plays %s track=%llu", track == FFmpegPlaybackEngine::Track::Video ? "video" : "audio", static_cast<unsigned long long>(trackID));
+    }
+    return owner->sourceBuffer == &sourceBuffer && owner->track == trackID;
+}
+
+void MediaSourcePrivateFFmpeg::sourceBufferTracksChanged(const SourceBufferPrivateFFmpeg& sourceBuffer, std::optional<TrackID> video, std::optional<TrackID> audio)
+{
+    // a new initialization segment of a SourceBuffer that plays: its track of that kind (WebCore
+    // renames the track buffer when the track ID changes)
+    for (auto [owner, track] : { std::pair { &m_videoOwner, video }, std::pair { &m_audioOwner, audio } }) {
+        if (!*owner || (*owner)->sourceBuffer != &sourceBuffer)
+            continue;
+        if (track)
+            (*owner)->track = *track;
+        else
+            *owner = std::nullopt;
+    }
+}
+
+void MediaSourcePrivateFFmpeg::playerDidPlay()
+{
+    for (Ref sourceBuffer : sourceBuffers())
+        downcast<SourceBufferPrivateFFmpeg>(sourceBuffer.get()).updateMaximumBufferSize();
+}
+
+auto MediaSourcePrivateFFmpeg::stats() const -> Stats
+{
+    Stats stats;
+    for (Ref sourceBuffer : sourceBuffers()) {
+        stats.sourceBuffers++;
+        stats.bufferedBytes += sourceBuffer->contentSize();
+        stats.samples += downcast<SourceBufferPrivateFFmpeg>(sourceBuffer.get()).samplesReceived();
+    }
+    return stats;
+}
+
