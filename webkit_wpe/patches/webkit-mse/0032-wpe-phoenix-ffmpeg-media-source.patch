+// The decoder parameters of a parsed track, as FFmpeg's mov demuxer fills them in
+static Ref<FFmpegCodecConfig> createCodecConfig(const FFmpegFMP4Parser::Track& track)
+{
+    AVCodecParameters* parameters = avcodec_parameters_alloc();
+    RELEASE_ASSERT(parameters);
+    const std::string& entry = track.sampleEntry;
+    bool video = track.kind == FFmpegFMP4Parser::TrackKind::Video;
+    parameters->codec_type = video ? AVMEDIA_TYPE_VIDEO : AVMEDIA_TYPE_AUDIO;
+    if (entry == "avc1" || entry == "avc3")
+        parameters->codec_id = AV_CODEC_ID_H264;
+    else if (entry == "hvc1" || entry == "hev1")
+        parameters->codec_id = AV_CODEC_ID_HEVC;
+    else if (entry == "vp09")
+        parameters->codec_id = AV_CODEC_ID_VP9;
+    else if (entry == "mp4v")
+        parameters->codec_id = AV_CODEC_ID_MPEG4;
+    else if (entry == "Opus")
+        parameters->codec_id = AV_CODEC_ID_OPUS;
+    else if (entry == "ac-3")
+        parameters->codec_id = AV_CODEC_ID_AC3;
+    else if (entry == "ec-3")
+        parameters->codec_id = AV_CODEC_ID_EAC3;
+    else if (entry == "fLaC")
+        parameters->codec_id = AV_CODEC_ID_FLAC;
+    else if (entry == "mp4a") {
+        // the esds object type (ISO/IEC 14496-1 Table 5, as the mp4 registration authority lists it)
+        switch (track.objectType) {
+        case 0x69:
+        case 0x6b:
+            parameters->codec_id = AV_CODEC_ID_MP3;
+            break;
+        case 0xa5:
+            parameters->codec_id = AV_CODEC_ID_AC3;
+            break;
+        case 0xa6:
+            parameters->codec_id = AV_CODEC_ID_EAC3;
+            break;
+        default:
+            parameters->codec_id = AV_CODEC_ID_AAC;
+            break;
+        }
+    }
+    if (!track.extradata.empty()) {
+        parameters->extradata = static_cast<uint8_t*>(av_mallocz(track.extradata.size() + AV_INPUT_BUFFER_PADDING_SIZE));
+        RELEASE_ASSERT(parameters->extradata);
+        memcpy(parameters->extradata, track.extradata.data(), track.extradata.size());
+        parameters->extradata_size = static_cast<int>(track.extradata.size());
+    }
+    if (video) {
+        parameters->width = static_cast<int>(track.width);
+        parameters->height = static_cast<int>(track.height);
+    } else {
+        parameters->sample_rate = static_cast<int>(track.sampleRate);
+        if (track.channels)
+            av_channel_layout_default(&parameters->ch_layout, static_cast<int>(track.channels));
+    }
+    return FFmpegCodecConfig::create(parameters, String::fromUTF8(track.codec.c_str()));
+}
