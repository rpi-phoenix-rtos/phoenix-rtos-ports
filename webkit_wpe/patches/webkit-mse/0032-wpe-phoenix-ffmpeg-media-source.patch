+// The largest top-level box held back for completion: a media segment's mdat is a few MB
+static constexpr uint64_t kMaxBoxSize = 256 * 1024 * 1024;
+// The most samples one media segment may describe (a 6 s segment holds a few hundred): a trun's
+// sample count is not otherwise bounded when its samples take their sizes from the defaults
+static constexpr size_t kMaxFragmentSamples = 1 << 20;
+
+// trun / tfhd flags (ISO/IEC 14496-12 §8.8.7, §8.8.8)
+static constexpr uint32_t kTfhdBaseDataOffset = 0x000001;
+static constexpr uint32_t kTfhdSampleDescriptionIndex = 0x000002;
+static constexpr uint32_t kTfhdDefaultDuration = 0x000008;
+static constexpr uint32_t kTfhdDefaultSize = 0x000010;
+static constexpr uint32_t kTfhdDefaultFlags = 0x000020;
+static constexpr uint32_t kTfhdDefaultBaseIsMoof = 0x020000;
+static constexpr uint32_t kTrunDataOffset = 0x000001;
+static constexpr uint32_t kTrunFirstSampleFlags = 0x000004;
+static constexpr uint32_t kTrunDuration = 0x000100;
+static constexpr uint32_t kTrunSize = 0x000200;
+static constexpr uint32_t kTrunFlags = 0x000400;
+static constexpr uint32_t kTrunCompositionOffset = 0x000800;
+// sample flags: sample_is_non_sync_sample, sample_depends_on == 1 (not an I picture); a sample
+// with either is not a random access point (as FFmpeg's mov demuxer reads them)
+static constexpr uint32_t kSampleNonSync = 0x00010000;
+static constexpr uint32_t kSampleDependsOnOthers = 0x01000000;
+
+namespace {
+
+// Big-endian reads over a box's bytes; a read past the end sets `failed` and returns zeros.
+class Reader {
+public:
+    Reader(const uint8_t* data, size_t size)
+        : m_data(data)
+        , m_size(size)
+    {
+    }
+
+    size_t position() const { return m_position; }
+    size_t remaining() const { return m_size - m_position; }
+    bool failed() const { return m_failed; }
+    const uint8_t* current() const { return m_data + m_position; }
+
+    bool skip(size_t count)
+    {
+        if (count > remaining()) {
+            m_failed = true;
+            m_position = m_size;
+            return false;
+        }
+        m_position += count;
+        return true;
+    }
+    uint64_t read(unsigned bytes)
+    {
+        if (bytes > remaining()) {
+            m_failed = true;
+            m_position = m_size;
+            return 0;
+        }
+        uint64_t value = 0;
+        for (unsigned i = 0; i < bytes; ++i)
+            value = value << 8 | m_data[m_position++];
+        return value;
+    }
+    uint8_t u8() { return static_cast<uint8_t>(read(1)); }
+    uint16_t u16() { return static_cast<uint16_t>(read(2)); }
+    uint32_t u32() { return static_cast<uint32_t>(read(4)); }
+    uint64_t u64() { return read(8); }
+
+private:
+    const uint8_t* m_data;
+    size_t m_size;
+    size_t m_position { 0 };
+    bool m_failed { false };
+};
+
+struct Box {
+    uint32_t type { 0 };
+    size_t headerSize { 0 };
+    uint64_t size { 0 };    // header included
+};
+
+constexpr uint32_t fourcc(const char (&name)[5])
+{
+    return static_cast<uint32_t>(static_cast<uint8_t>(name[0])) << 24 | static_cast<uint32_t>(static_cast<uint8_t>(name[1])) << 16
+        | static_cast<uint32_t>(static_cast<uint8_t>(name[2])) << 8 | static_cast<uint8_t>(name[3]);
+}
+
+std::string fourccString(uint32_t type)
+{
+    std::string name;
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        char c = static_cast<char>(type >> shift);
+        name += c >= 0x20 && c < 0x7f ? c : '?';
+    }
+    return name;
+}
+
+// The header of the box at `data`: false when fewer bytes than the header are there; a size
+// of 0 (to the end of the file) is reported as such for the caller to refuse.
+bool readBoxHeader(const uint8_t* data, size_t available, Box& box)
+{
+    if (available < 8)
+        return false;
+    Reader reader(data, available);
+    box.size = reader.u32();
+    box.type = reader.u32();
+    box.headerSize = 8;
+    if (box.size == 1) {
+        if (available < 16)
+            return false;
+        box.size = reader.u64();
+        box.headerSize = 16;
+    }
+    return true;
+}
+
+// Calls `visit(type, payload, payloadSize)` for each child box of [data, data + size); false on
+// a malformed child.
+template<typename Visitor>
+bool forEachChild(const uint8_t* data, size_t size, Visitor&& visit)
+{
+    size_t position = 0;
+    while (position + 8 <= size) {
+        Box box;
+        if (!readBoxHeader(data + position, size - position, box) || box.size < box.headerSize || box.size > size - position)
+            return false;
+        if (!visit(box.type, data + position + box.headerSize, static_cast<size_t>(box.size - box.headerSize)))
+            return false;
+        position += box.size;
+    }
+    return true;
+}
+
+// An MPEG-4 descriptor header (ISO/IEC 14496-1 §8.3.3): tag and size, the size in 1-4 bytes of 7 bits
+bool readDescriptor(Reader& reader, uint8_t& tag, size_t& size)
+{
+    tag = reader.u8();
+    size = 0;
+    for (int i = 0; i < 4; ++i) {
+        uint8_t byte = reader.u8();
+        size = size << 7 | (byte & 0x7f);
+        if (!(byte & 0x80))
+            break;
+    }
+    return !reader.failed() && size <= reader.remaining();
+}
+
+// esds: ES_Descriptor > DecoderConfigDescriptor (object type) > DecoderSpecificInfo (the
+// AudioSpecificConfig for AAC)
+bool parseESDS(const uint8_t* data, size_t size, FFmpegFMP4Parser::Track& track)
+{
+    Reader reader(data, size);
+    reader.skip(4); // version, flags
+    uint8_t tag;
+    size_t length;
+    if (!readDescriptor(reader, tag, length) || tag != 3)
+        return false;
+    reader.skip(2); // ES_ID
+    uint8_t flags = reader.u8();
+    if (flags & 0x80)
+        reader.skip(2); // dependsOn_ES_ID
+    if (flags & 0x40)
+        reader.skip(reader.u8()); // URL
+    if (flags & 0x20)
+        reader.skip(2); // OCR_ES_Id
+    if (!readDescriptor(reader, tag, length) || tag != 4)
+        return false;
+    size_t end = reader.position() + length;
+    track.objectType = reader.u8();
+    reader.skip(12); // streamType, bufferSizeDB, maxBitrate, avgBitrate
+    if (reader.failed())
+        return false;
+    if (reader.position() < end && readDescriptor(reader, tag, length) && tag == 5)
+        track.extradata.assign(reader.current(), reader.current() + length);
+    return true;
+}
+
+// dOps (Opus in ISO BMFF, big-endian) -> the OpusHead identification header (RFC 7845 §5.1,
+// little-endian) FFmpeg's Opus decoder reads
+bool parseDOps(const uint8_t* data, size_t size, FFmpegFMP4Parser::Track& track)
+{
+    Reader reader(data, size);
+    if (reader.u8()) // Version
+        return false;
+    uint8_t channels = reader.u8();
+    uint16_t preSkip = reader.u16();
+    uint32_t inputRate = reader.u32();
+    uint16_t gain = reader.u16();
+    uint8_t family = reader.u8();
+    if (reader.failed())
+        return false;
+    std::vector<uint8_t> head = { 'O', 'p', 'u', 's', 'H', 'e', 'a', 'd', 1, channels,
+        static_cast<uint8_t>(preSkip), static_cast<uint8_t>(preSkip >> 8),
+        static_cast<uint8_t>(inputRate), static_cast<uint8_t>(inputRate >> 8), static_cast<uint8_t>(inputRate >> 16), static_cast<uint8_t>(inputRate >> 24),
+        static_cast<uint8_t>(gain), static_cast<uint8_t>(gain >> 8), family };
+    if (family) {
+        // StreamCount, CoupledCount, ChannelMapping[channels]
+        size_t tableSize = 2 + channels;
+        if (reader.remaining() < tableSize)
+            return false;
+        head.insert(head.end(), reader.current(), reader.current() + tableSize);
+    }
+    track.extradata = std::move(head);
+    track.channels = channels;
+    return true;
+}
+
+// dfLa: the FLAC metadata blocks; FFmpeg takes the STREAMINFO block (34 bytes) as extradata
+bool parseDfLa(const uint8_t* data, size_t size, FFmpegFMP4Parser::Track& track)
+{
+    Reader reader(data, size);
+    reader.skip(4); // version, flags
+    uint8_t blockType = reader.u8() & 0x7f;
+    uint32_t blockSize = static_cast<uint32_t>(reader.read(3));
+    if (reader.failed() || blockType || blockSize != 34 || reader.remaining() < 34)
+        return false;
+    track.extradata.assign(reader.current(), reader.current() + 34);
+    return true;
+}
+
+std::string hexByte(uint8_t value, bool upper)
+{
+    char text[3];
+    snprintf(text, sizeof(text), upper ? "%02X" : "%02x", value);
+    return text;
+}
+
+// RFC 6381 names: avc1.PPCCLL; hvc1.<space><profile>.<compatibility>.<tier><level>[.<constraints>]
+// (ISO/IEC 14496-15 Annex E); mp4a.40.<audio object type> / mp4a.<object type>
+std::string avcCodecString(const std::string& entry, const std::vector<uint8_t>& avcC)
+{
+    if (avcC.size() < 4)
+        return entry;
+    return entry + "." + hexByte(avcC[1], false) + hexByte(avcC[2], false) + hexByte(avcC[3], false);
+}
+
+std::string hevcCodecString(const std::string& entry, const std::vector<uint8_t>& hvcC)
+{
+    if (hvcC.size() < 13)
+        return entry;
+    unsigned space = hvcC[1] >> 6;
+    unsigned tier = (hvcC[1] >> 5) & 1;
+    unsigned profile = hvcC[1] & 0x1f;
+    uint32_t compatibility = static_cast<uint32_t>(hvcC[2]) << 24 | static_cast<uint32_t>(hvcC[3]) << 16 | static_cast<uint32_t>(hvcC[4]) << 8 | hvcC[5];
+    uint32_t reversed = 0;
+    for (int bit = 0; bit < 32; ++bit) {
+        if (compatibility & (1u << bit))
+            reversed |= 1u << (31 - bit);
+    }
+    char text[64];
+    snprintf(text, sizeof(text), ".%s%u.%X.%c%u", space ? std::string(1, static_cast<char>('A' + space - 1)).c_str() : "", profile, reversed, tier ? 'H' : 'L', hvcC[12]);
+    std::string codec = entry + text;
+    size_t constraints = 6;
+    while (constraints && !hvcC[5 + constraints])
+        --constraints;
+    for (size_t i = 0; i < constraints; ++i)
+        codec += "." + hexByte(hvcC[6 + i], true);
+    return codec;
+}
+
+std::string mp4aCodecString(const FFmpegFMP4Parser::Track& track)
+{
+    if (track.objectType == 0x40 && !track.extradata.empty()) {
+        unsigned objectType = track.extradata[0] >> 3;
+        if (objectType == 31 && track.extradata.size() > 1)
+            objectType = 32 + ((track.extradata[0] & 7) << 3 | track.extradata[1] >> 5);
+        return "mp4a.40." + std::to_string(objectType);
+    }
+    return "mp4a." + hexByte(track.objectType, false);
+}
+
+std::string languageString(uint16_t packed)
+{
+    // ISO 639-2/T, three letters of five bits each (+0x60)
+    std::string language;
+    for (int shift = 10; shift >= 0; shift -= 5)
+        language += static_cast<char>(((packed >> shift) & 0x1f) + 0x60);
+    return language == "und" || packed == 0 ? std::string() : language;
+}
+
+} // namespace
+
+bool FFmpegFMP4Parser::fail(std::string message)
+{
+    if (m_error.empty())
+        m_error = std::move(message);
+    return false;
+}
+
+int FFmpegFMP4Parser::trackIndex(uint32_t id) const
+{
+    for (size_t i = 0; i < m_init.tracks.size(); ++i) {
+        if (m_init.tracks[i].id == id)
+            return static_cast<int>(i);
+    }
+    return -1;
+}
+
+void FFmpegFMP4Parser::reset()
+{
+    m_pending.clear();
+    m_fragment.clear();
+    m_hasFragment = false;
+    m_error.clear();
+}
+
+bool FFmpegFMP4Parser::append(const uint8_t* data, size_t size, Client& client)
+{
+    if (!m_error.empty())
+        return false;
+    if (m_pending.empty()) {
+        // the common case, whole boxes: parsed where they are, only a tail is kept
+        int64_t used = parseBoxes(data, size, client);
+        if (used < 0)
+            return false;
+        m_pending.assign(data + used, data + size);
+        return true;
+    }
+    m_pending.insert(m_pending.end(), data, data + size);
+    int64_t used = parseBoxes(m_pending.data(), m_pending.size(), client);
+    if (used < 0)
+        return false;
+    m_pending.erase(m_pending.begin(), m_pending.begin() + used);
+    return true;
+}
+
+int64_t FFmpegFMP4Parser::parseBoxes(const uint8_t* data, size_t size, Client& client)
+{
+    size_t position = 0;
+    while (true) {
+        Box box;
+        if (!readBoxHeader(data + position, size - position, box))
+            break;
+        std::string name = fourccString(box.type);
+        if (!box.size)
+            return fail("box " + name + " extends to the end of the stream"), -1;
+        if (box.size < box.headerSize || box.size > kMaxBoxSize)
+            return fail("box " + name + " has an invalid size " + std::to_string(box.size)), -1;
+        if (box.size > size - position)
+            break; // incomplete: wait for the rest
+        const uint8_t* payload = data + position + box.headerSize;
+        size_t payloadSize = static_cast<size_t>(box.size - box.headerSize);
+        uint64_t boxOffset = m_offset;
+        switch (box.type) {
+        case fourcc("moov"):
+            if (m_hasFragment)
+                return fail("moov inside a media segment"), -1;
+            if (!parseMovie(payload, payloadSize))
+                return -1;
+            client.didParseInitSegment(m_init);
+            break;
+        case fourcc("moof"):
+            if (!m_hasInitSegment)
+                return fail("moof before the initialization segment"), -1;
+            if (m_hasFragment)
+                return fail("moof without an mdat"), -1;
+            if (!parseFragment(payload, payloadSize, boxOffset))
+                return -1;
+            break;
+        case fourcc("mdat"):
+            if (!m_hasFragment)
+                return fail("mdat without a moof"), -1;
+            if (!emitSamples(boxOffset + box.headerSize, boxOffset + box.size, payload, client))
+                return -1;
+            break;
+        default:
+            // ftyp, styp, sidx, ssix, prft, emsg, free, skip, uuid, meta, ...: nothing to play
+            break;
+        }
+        position += box.size;
+        m_offset += box.size;
+    }
+    return static_cast<int64_t>(position);
+}
+
+bool FFmpegFMP4Parser::parseMovie(const uint8_t* data, size_t size)
+{
+    InitSegment init;
+    std::vector<Track> tracks;
+    bool encrypted = false;
+    uint64_t mvhdDuration = 0, fragmentDuration = 0;
+    struct Defaults {
+        uint32_t trackID, duration, size, flags;
+    };
+    std::vector<Defaults> defaults;
+    bool ok = forEachChild(data, size, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        Reader reader(payload, payloadSize);
+        switch (type) {
+        case fourcc("mvhd"): {
+            uint8_t version = reader.u8();
+            reader.skip(3 + (version ? 16 : 8));
+            init.movieTimescale = reader.u32();
+            mvhdDuration = version ? reader.u64() : reader.u32();
+            if (version == 0 && mvhdDuration == 0xffffffff)
+                mvhdDuration = 0;
+            return !reader.failed();
+        }
+        case fourcc("trak"): {
+            Track track;
+            bool keep = false;
+            if (!parseTrack(payload, payloadSize, track, keep))
+                return false;
+            if (track.sampleEntry == "encv" || track.sampleEntry == "enca")
+                encrypted = true;
+            if (keep)
+                tracks.push_back(std::move(track));
+            return true;
+        }
+        case fourcc("mvex"):
+            return forEachChild(payload, payloadSize, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+                Reader reader(payload, payloadSize);
+                if (type == fourcc("mehd")) {
+                    uint8_t version = reader.u8();
+                    reader.skip(3);
+                    fragmentDuration = version ? reader.u64() : reader.u32();
+                } else if (type == fourcc("trex")) {
+                    reader.skip(4);
+                    Defaults trex;
+                    trex.trackID = reader.u32();
+                    reader.skip(4); // default_sample_description_index
+                    trex.duration = reader.u32();
+                    trex.size = reader.u32();
+                    trex.flags = reader.u32();
+                    defaults.push_back(trex);
+                }
+                return !reader.failed();
+            });
+        default:
+            return true;
+        }
+    });
+    if (!ok)
+        return fail("malformed moov");
+    if (encrypted)
+        return fail("encrypted track (encv/enca): no encrypted media");
+    if (tracks.empty())
+        return fail("moov has no audio or video track");
+    for (auto& track : tracks) {
+        if (track.editMediaTime >= 0) {
+            // the delay in the track's timescale, rounded to the nearest unit (as av_rescale())
+            uint64_t delay = init.movieTimescale ? (track.editDelay * track.timescale + init.movieTimescale / 2) / init.movieTimescale : 0;
+            track.editOffset = static_cast<int64_t>(delay) - track.editMediaTime;
+        }
+        for (auto& trex : defaults) {
+            if (trex.trackID == track.id) {
+                track.defaultDuration = trex.duration;
+                track.defaultSize = trex.size;
+                track.defaultFlags = trex.flags;
+            }
+        }
+    }
+    init.duration = fragmentDuration ? fragmentDuration : mvhdDuration;
+    init.tracks = std::move(tracks);
+    init.generation = ++m_generation;
+    m_init = std::move(init);
+    m_hasInitSegment = true;
+    m_nextDecodeTime.assign(m_init.tracks.size(), 0);
+    return true;
+}
+
+// One trak: `keep` is false for a track that is neither audio nor video (subtitles, timed
+// metadata, hint tracks): its fragments are skipped.
+bool FFmpegFMP4Parser::parseTrack(const uint8_t* data, size_t size, Track& track, bool& keep)
+{
+    uint32_t handler = 0;
+    const uint8_t* sampleTable = nullptr;
+    size_t sampleTableSize = 0;
+    std::vector<std::pair<uint64_t, int64_t>> edits;
+    auto parseMedia = [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        Reader reader(payload, payloadSize);
+        switch (type) {
+        case fourcc("mdhd"): {
+            uint8_t version = reader.u8();
+            reader.skip(3 + (version ? 16 : 8));
+            track.timescale = reader.u32();
+            reader.skip(version ? 8 : 4);
+            track.language = languageString(reader.u16());
+            return !reader.failed();
+        }
+        case fourcc("hdlr"):
+            reader.skip(8);
+            handler = reader.u32();
+            return !reader.failed();
+        case fourcc("minf"):
+            return forEachChild(payload, payloadSize, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+                if (type == fourcc("stbl")) {
+                    return forEachChild(payload, payloadSize, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+                        if (type == fourcc("stsd")) {
+                            sampleTable = payload;
+                            sampleTableSize = payloadSize;
+                        }
+                        return true;
+                    });
+                }
+                return true;
+            });
+        default:
+            return true;
+        }
+    };
+    bool ok = forEachChild(data, size, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        Reader reader(payload, payloadSize);
+        switch (type) {
+        case fourcc("tkhd"): {
+            uint8_t version = reader.u8();
+            reader.skip(3 + (version ? 16 : 8));
+            track.id = reader.u32();
+            return !reader.failed();
+        }
+        case fourcc("edts"):
+            return forEachChild(payload, payloadSize, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+                if (type != fourcc("elst"))
+                    return true;
+                Reader reader(payload, payloadSize);
+                uint8_t version = reader.u8();
+                reader.skip(3);
+                uint32_t count = reader.u32();
+                for (uint32_t i = 0; i < count && !reader.failed(); ++i) {
+                    uint64_t duration = version ? reader.u64() : reader.u32();
+                    int64_t mediaTime = version ? static_cast<int64_t>(reader.u64()) : static_cast<int32_t>(reader.u32());
+                    reader.skip(4); // media_rate
+                    edits.emplace_back(duration, mediaTime);
+                }
+                return !reader.failed();
+            });
+        case fourcc("mdia"):
+            return forEachChild(payload, payloadSize, parseMedia);
+        default:
+            return true;
+        }
+    });
+    if (!ok)
+        return fail("malformed trak");
+    if (handler != fourcc("vide") && handler != fourcc("soun")) {
+        keep = false;
+        return true;
+    }
+    keep = true;
+    track.kind = handler == fourcc("vide") ? TrackKind::Video : TrackKind::Audio;
+    if (!track.id || !track.timescale)
+        return fail("trak without a track ID or a timescale");
+    // empty edits (media_time -1: a presentation delay) and then one edit that starts the
+    // presentation at media_time; parseMovie() turns it into an offset
+    size_t empty = 0;
+    while (empty < edits.size() && edits[empty].second == -1)
+        track.editDelay += edits[empty++].first;
+    if (empty + 1 == edits.size() && edits[empty].second >= 0)
+        track.editMediaTime = edits[empty].second;
+    else if (!edits.empty())
+        track.editListIgnored = true;
+    if (!sampleTable)
+        return fail("trak " + std::to_string(track.id) + " has no stsd");
+    Reader reader(sampleTable, sampleTableSize);
+    reader.skip(4);
+    if (!reader.u32())
+        return fail("stsd of track " + std::to_string(track.id) + " is empty");
+    // the first sample entry: fragments refer to description 1
+    Box entry;
+    if (!readBoxHeader(reader.current(), reader.remaining(), entry) || entry.size < entry.headerSize || entry.size > reader.remaining())
+        return fail("malformed stsd");
+    track.sampleEntry = fourccString(entry.type);
+    return parseSampleEntry(reader.current() + entry.headerSize, static_cast<size_t>(entry.size - entry.headerSize), track);
+}
+
+bool FFmpegFMP4Parser::parseSampleEntry(const uint8_t* data, size_t size, Track& track)
+{
+    const std::string& entry = track.sampleEntry;
+    if (entry == "encv" || entry == "enca")
+        return true; // refused by the caller
+    Reader reader(data, size);
+    size_t childrenAt;
+    if (track.kind == TrackKind::Video) {
+        // VisualSampleEntry: reserved, data_reference_index, pre_defined/reserved, width, height,
+        // resolutions, reserved, frame_count, compressorname, depth, pre_defined
+        reader.skip(24);
+        track.width = reader.u16();
+        track.height = reader.u16();
+        childrenAt = 78;
+    } else {
+        // AudioSampleEntry (and QuickTime sound description versions 1 and 2)
+        reader.skip(8);
+        uint16_t version = reader.u16();
+        reader.skip(6);
+        track.channels = reader.u16();
+        reader.skip(6);
+        track.sampleRate = reader.u32() >> 16;
+        childrenAt = 28 + (version == 1 ? 16 : version == 2 ? 36 : 0);
+    }
+    if (reader.failed() || childrenAt > size)
+        return fail("short " + entry + " sample entry");
+
+    bool configured = false;
+    bool ok = forEachChild(data + childrenAt, size - childrenAt, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        if ((type == fourcc("avcC") && (entry == "avc1" || entry == "avc3")) || (type == fourcc("hvcC") && (entry == "hvc1" || entry == "hev1"))
+            || (type == fourcc("vpcC") && entry == "vp09")) {
+            track.extradata.assign(payload, payload + payloadSize);
+            configured = true;
+        } else if (type == fourcc("esds") && entry == "mp4a")
+            configured = parseESDS(payload, payloadSize, track);
+        else if (type == fourcc("dOps") && entry == "Opus")
+            configured = parseDOps(payload, payloadSize, track);
+        else if (type == fourcc("dfLa") && entry == "fLaC")
+            configured = parseDfLa(payload, payloadSize, track);
+        else if ((type == fourcc("dac3") && entry == "ac-3") || (type == fourcc("dec3") && entry == "ec-3"))
+            configured = true; // the decoder reads everything from the bitstream
+        return true;
+    });
+    if (!ok)
+        return fail("malformed " + entry + " sample entry");
+    if (entry == "avc1" || entry == "avc3")
+        track.codec = avcCodecString(entry, track.extradata);
+    else if (entry == "hvc1" || entry == "hev1")
+        track.codec = hevcCodecString(entry, track.extradata);
+    else if (entry == "mp4a")
+        track.codec = mp4aCodecString(track);
+    else if (entry == "Opus")
+        track.codec = "opus";
+    else if (entry == "ac-3" || entry == "ec-3")
+        track.codec = entry;
+    else if (entry == "fLaC")
+        track.codec = "flac";
+    else if (entry == "vp09")
+        track.codec = "vp09";
+    else if (entry == "mp4v")
+        track.codec = "mp4v";
+    else
+        return fail("unsupported sample entry " + entry);
+    if (!configured && entry != "mp4v")
+        return fail(entry + " sample entry without its decoder configuration");
+    return true;
+}
+
+bool FFmpegFMP4Parser::parseFragment(const uint8_t* data, size_t size, uint64_t moofOffset)
+{
+    m_fragment.clear();
+    // where the next track fragment's data starts when it names no base (§8.8.7.1)
+    uint64_t implicitBase = moofOffset;
+    bool ok = forEachChild(data, size, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+        if (type != fourcc("traf"))
+            return true;
+        int index = -1;
+        uint32_t tfhdFlags = 0, defaultDuration = 0, defaultSize = 0, defaultFlags = 0;
+        bool hasTfhd = false, hasBaseTime = false;
+        int64_t baseTime = 0;
+        uint64_t dataEnd = implicitBase;
+        bool first = true;
+        bool ok = forEachChild(payload, payloadSize, [&](uint32_t type, const uint8_t* payload, size_t payloadSize) {
+            Reader reader(payload, payloadSize);
+            if (type == fourcc("tfhd")) {
+                hasTfhd = true;
+                tfhdFlags = reader.u32() & 0xffffff;
+                uint32_t trackID = reader.u32();
+                if (tfhdFlags & kTfhdBaseDataOffset)
+                    return fail("tfhd with an explicit base-data-offset");
+                index = trackIndex(trackID);
+                if (tfhdFlags & kTfhdSampleDescriptionIndex)
+                    reader.skip(4);
+                if (index >= 0) {
+                    const Track& track = m_init.tracks[index];
+                    defaultDuration = tfhdFlags & kTfhdDefaultDuration ? reader.u32() : track.defaultDuration;
+                    defaultSize = tfhdFlags & kTfhdDefaultSize ? reader.u32() : track.defaultSize;
+                    defaultFlags = tfhdFlags & kTfhdDefaultFlags ? reader.u32() : track.defaultFlags;
+                }
+                return !reader.failed() || fail("malformed tfhd");
+            }
+            if (!hasTfhd)
+                return fail(fourccString(type) + " before tfhd");
+            if (index < 0)
+                return true; // a track that does not play
+            if (type == fourcc("tfdt")) {
+                uint8_t version = reader.u8();
+                reader.skip(3);
+                baseTime = static_cast<int64_t>(version ? reader.u64() : reader.u32());
+                hasBaseTime = true;
+                return !reader.failed() || fail("malformed tfdt");
+            }
+            if (type == fourcc("senc") || type == fourcc("saiz") || type == fourcc("saio"))
+                return fail("encrypted samples (" + fourccString(type) + "): no encrypted media");
+            if (type != fourcc("trun"))
+                return true;
+            const Track& track = m_init.tracks[index];
+            uint32_t flags = reader.u32() & 0xffffff;
+            uint32_t count = reader.u32();
+            uint64_t base = tfhdFlags & kTfhdDefaultBaseIsMoof ? moofOffset : implicitBase;
+            uint64_t offset = dataEnd;
+            if (flags & kTrunDataOffset)
+                offset = base + static_cast<int64_t>(static_cast<int32_t>(reader.u32()));
+            else if (first)
+                offset = base;
+            uint32_t firstFlags = flags & kTrunFirstSampleFlags ? reader.u32() : defaultFlags;
+            size_t perSample = 4 * (!!(flags & kTrunDuration) + !!(flags & kTrunSize) + !!(flags & kTrunFlags) + !!(flags & kTrunCompositionOffset));
+            if (reader.failed() || (perSample && count > reader.remaining() / perSample))
+                return fail("malformed trun");
+            // the samples must fit in the largest mdat taken (with default sizes nothing above
+            // bounds the count)
+            if (count > kMaxFragmentSamples - m_fragment.size() || (!(flags & kTrunSize) && static_cast<uint64_t>(count) * defaultSize > kMaxBoxSize))
+                return fail("trun with " + std::to_string(count) + " samples");
+            if (!hasBaseTime) {
+                // no tfdt: this fragment continues where the track's previous one ended
+                baseTime = m_nextDecodeTime[index];
+                hasBaseTime = true;
+            }
+            int64_t time = baseTime;
+            for (uint32_t i = 0; i < count; ++i) {
+                PendingSample pending;
+                Sample& sample = pending.sample;
+                sample.trackID = track.id;
+                sample.duration = flags & kTrunDuration ? reader.u32() : defaultDuration;
+                sample.size = flags & kTrunSize ? reader.u32() : defaultSize;
+                uint32_t sampleFlags = flags & kTrunFlags ? reader.u32() : (!i ? firstFlags : defaultFlags);
+                if (!i && (flags & kTrunFirstSampleFlags))
+                    sampleFlags = firstFlags;
+                // version 0 offsets are unsigned and version 1 signed; read as signed either way,
+                // as FFmpeg's mov demuxer does
+                int64_t compositionOffset = flags & kTrunCompositionOffset ? static_cast<int32_t>(reader.u32()) : 0;
+                sample.decodeTime = time;
+                sample.presentationTime = time + compositionOffset;
+                sample.isSync = track.kind == TrackKind::Audio || !(sampleFlags & (kSampleNonSync | kSampleDependsOnOthers));
+                if (m_applyEditLists) {
+                    sample.decodeTime += track.editOffset;
+                    sample.presentationTime += track.editOffset;
+                }
+                pending.track = static_cast<size_t>(index);
+                pending.offset = offset;
+                offset += sample.size;
+                time += sample.duration;
+                m_fragment.push_back(pending);
+            }
+            m_nextDecodeTime[index] = time;
+            baseTime = time;
+            dataEnd = offset;
+            first = false;
+            return true;
+        });
+        if (!ok)
+            return false;
+        if (!hasTfhd)
+            return fail("traf without tfhd");
+        implicitBase = dataEnd;
+        return true;
+    });
+    if (!ok)
+        return fail("malformed moof");
+    // file order, as a demuxer reads them (stable: a track's samples keep their order)
+    std::stable_sort(m_fragment.begin(), m_fragment.end(), [](const PendingSample& a, const PendingSample& b) {
+        return a.offset < b.offset;
+    });
+    m_hasFragment = true;
+    return true;
+}
+
+bool FFmpegFMP4Parser::emitSamples(uint64_t payloadOffset, uint64_t end, const uint8_t* payload, Client& client)
+{
+    for (auto& pending : m_fragment) {
+        if (pending.offset < payloadOffset || pending.offset > end || pending.sample.size > end - pending.offset)
+            return fail("sample data outside the mdat (track " + std::to_string(pending.sample.trackID) + ")");
+    }
+    for (auto& pending : m_fragment)
+        client.didParseSample(m_init.tracks[pending.track], pending.sample, payload + (pending.offset - payloadOffset));
+    m_fragment.clear();
+    m_hasFragment = false;
+    return true;
+}
+
