+
+#include "FFmpegPlaybackEngine.h"
+#include "MediaSample.h"
+
+struct AVPacket;
+
+namespace WebCore {
+
+// One coded frame of a SourceBuffer: its payload in an AVPacket (with FFmpeg's input padding;
+// copies of the sample share it), its times as rationals of the track's timescale, and the
+// decoder configuration of the initialization segment it came after.
+class MediaSampleFFmpeg final : public MediaSample {
+public:
+    // takes the packet
+    static Ref<MediaSampleFFmpeg> create(AVPacket*, Ref<FFmpegCodecConfig>&&, TrackID, const MediaTime& presentationTime, const MediaTime& decodeTime,
+        const MediaTime& duration, bool isSync);
+    virtual ~MediaSampleFFmpeg();
+
+    MediaTime presentationTime() const final { return m_presentationTime; }
+    MediaTime decodeTime() const final { return m_decodeTime; }
+    MediaTime duration() const final { return m_duration; }
+    TrackID trackID() const final { return m_trackID; }
+    size_t sizeInBytes() const final;
+    FloatSize presentationSize() const final { return m_config->size(); }
+    void offsetTimestampsBy(const MediaTime&) final;
+    void setTimestamps(const MediaTime& presentationTime, const MediaTime& decodeTime) final;
+    Ref<MediaSample> createNonDisplayingCopy() const final;
+    Ref<MediaSample> createCopyWithAdjustedStartTime(const MediaTime& offset) const final;
+    SampleFlags flags() const final;
+    PlatformSample platformSample() const final;
+    Type type() const final { return Type::FFmpegSample; }
+
+    FFmpegCodecConfig& config() const { return m_config.get(); }
+    // For the decoder: a new reference to the payload, pts/dts in microseconds, flagged as a key
+    // frame (sync) and, for a non-displaying sample, AV_PKT_FLAG_DISCARD
+    AVPacket* createPacket() const;
+
+private:
+    MediaSampleFFmpeg(AVPacket*, Ref<FFmpegCodecConfig>&&, TrackID, const MediaTime&, const MediaTime&, const MediaTime&, SampleFlags);
+
+    AVPacket* m_packet;
+    const Ref<FFmpegCodecConfig> m_config;
+    const TrackID m_trackID;
+    MediaTime m_presentationTime;
+    MediaTime m_decodeTime;
+    MediaTime m_duration;
+    SampleFlags m_flags;
+};
+
+} // namespace WebCore
+
+SPECIALIZE_TYPE_TRAITS_BEGIN(WebCore::MediaSampleFFmpeg)
+static bool isType(const WebCore::MediaSample& sample) { return sample.type() == WebCore::MediaSample::Type::FFmpegSample; }
+SPECIALIZE_TYPE_TRAITS_END()
+
