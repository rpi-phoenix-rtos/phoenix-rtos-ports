+void MediaPlayerPrivateFFmpegMSE::play()
+{
+    if (!m_hasPlayed) {
+        m_hasPlayed = true;
+        // the decoders open with the first frames: a player that never plays holds none
+        m_engine->start();
+        if (m_mediaSourcePrivate)
+            m_mediaSourcePrivate->playerDidPlay();
+    }
+    if (!m_paused)
+        return;
+    m_paused = false;
+    m_engine->setPaused(false);
+    log("mse play clock=%.3f ready=%d", m_engine->currentTime(), static_cast<int>(readyState()));
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
