+namespace WebCore {
+
+class MediaSourcePrivateFFmpeg;
+
+// The Media Source Extensions engine over FFmpeg's decoders (WPE on Phoenix-RTOS, USE_FFMPEG):
+// a separate engine from MediaPlayerPrivateFFmpeg (which plays URLs and native HLS), chosen by
+// MediaPlayer only for a MediaSource (platformType MediaSource).
+//
+//   MediaSourcePrivateFFmpeg    the MediaSource's platform side: SourceBuffers, duration
+//   SourceBufferPrivateFFmpeg   appendBuffer() -> FFmpegFMP4Parser (fragmented MP4) -> one
+//                               MediaSampleFFmpeg per coded frame; WebCore's TrackBuffers keep
+//                               them (coded frame processing, eviction, buffered ranges) and
+//                               enqueue them back in decode order
+//   FFmpegPlaybackEngine        the decoding threads, the clock, the picture and sound output
+//
+// What plays is what WebCore enqueues: a seek waits for the MediaSource to buffer the target
+// (waitForTarget), then WebCore flushes every track and enqueues from the sync frame before the
+// target (the frames before the target non-displaying: decoded, never shown). The readyState is
+// WebCore's (MediaSource::monitorSourceBuffers); the clock runs only from HaveFutureData on.
+// Duration, buffered and seekable are the MediaSource's. The decoders open at the first play():
+// a MediaSource player that never plays holds parsed samples only, no decoder and not the rpivid
+// block.
+//
+// The type answers steer adaptive players (hls.js, Shaka and dash.js choose renditions by
+// MediaSource.isTypeSupported()): fragmented MP4 only; HEVC Main and Main10 up to level 4.1
+// (1080p60: the rpivid block; WPE_PHOENIX_MSE_HEVC_4K=1 lifts it); H.264 up to level 3.1 (720p30,
+// the CPU's limit; WPE_PHOENIX_MSE_H264_1080=1: up to 4.2); AAC, MP3, Opus, AC-3, E-AC-3, FLAC.
+// No WebM, no MPEG-TS, no VP9, no AV1, no encrypted media. Width/height/framerate parameters
+// of a type are held to the same limits.
+//
+// Every event prints a "WPEB-MEDIA mono=<ms> id=<n> mse ..." line on stderr; the "stat" line
+// every WPE_PHOENIX_MEDIA_STAT_MS (default 2000, 0 off).
+class MediaPlayerPrivateFFmpegMSE final
+    : public MediaPlayerPrivateInterface
+    , public ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr<MediaPlayerPrivateFFmpegMSE, WTF::DestructionThread::Main> {
+    WTF_MAKE_TZONE_ALLOCATED(MediaPlayerPrivateFFmpegMSE);
+public:
+    explicit MediaPlayerPrivateFFmpegMSE(MediaPlayer&);
+    ~MediaPlayerPrivateFFmpegMSE();
+
+    void ref() const final { ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr::ref(); }
+    void deref() const final { ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr::deref(); }
+
+    constexpr MediaPlayerType mediaPlayerType() const final { return MediaPlayerType::FFmpegMSE; }
+
+    static void registerMediaEngine(MediaEngineRegistrar);
+    static void getSupportedTypes(HashSet<String>&);
+    static MediaPlayer::SupportsType supportsType(const MediaEngineSupportParameters&);
+
+    // for MediaSourcePrivateFFmpeg and SourceBufferPrivateFFmpeg (main thread)
+    unsigned playerID() const { return m_id; }
+    FFmpegPlaybackEngine& engine() const { return m_engine.get(); }
+    bool hasPlayed() const { return m_hasPlayed; }
+    void durationChanged(const MediaTime&);
+    void videoSizeChanged(FloatSize);
+    void notifyActiveSourceBuffersChanged() final;
+    void log(const char* format, ...) const WTF_ATTRIBUTE_PRINTF(2, 3);
+#if !RELEASE_LOG_DISABLED
+    const Logger& mediaPlayerLogger() const;
+    uint64_t mediaPlayerLogIdentifier() const;
+#endif
+
+private:
+    void load(const String&) final;
+    void load(const URL&, const LoadOptions&, MediaSourcePrivateClient&) final;
+#if ENABLE(MEDIA_STREAM)
+    void load(MediaStreamPrivate&) final;
+#endif
+    void cancelLoad() final;
+
+    void play() final;
+    void pause() final;
+    bool paused() const final { return m_paused; }
+
+    PlatformLayer* platformLayer() const final;
+    bool supportsAcceleratedRendering() const final { return true; }
+
+    FloatSize naturalSize() const final { return m_naturalSize; }
+    bool hasVideo() const final;
+    bool hasAudio() const final;
+
+    void setPageIsVisible(bool) final { }
+
+    MediaTime duration() const final;
+    MediaTime currentTime() const final;
+    bool timeIsProgressing() const final;
+    Ref<MediaTimePromise> seekToTarget(const SeekTarget&) final;
+    MediaTime maxTimeSeekable() const final;
+    double rate() const final { return 1; }
+
+    void setVolumeDouble(double) final;
+    void setMuted(bool) final;
+
+    MediaPlayer::NetworkState networkState() const final { return m_networkState; }
+    MediaPlayer::ReadyState readyState() const final;
+    const PlatformTimeRanges& buffered() const final;
+    bool didLoadingProgress() const final;
+
+    void readyStateFromMediaSourceChanged() final;
+    void characteristicsFromMediaSourceChanged() final;
+    void mediaSourceHasRetrievedAllData() final;
+    std::optional<VideoPlaybackQualityMetrics> videoPlaybackQualityMetrics() final;
+
+    void paint(GraphicsContext&, const FloatRect&) final { }
+    DestinationColorSpace colorSpace() final;
+    String engineDescription() const final { return "FFmpeg MSE"_s; }
+
+    void setNetworkState(MediaPlayer::NetworkState);
+    void engineEvent(FFmpegPlaybackEngine::Event, double);
+    void statTimerFired();
+
+    ThreadSafeWeakPtr<MediaPlayer> m_player;
+    const unsigned m_id;
+    const Ref<FFmpegPlaybackEngine> m_engine;
+    RefPtr<MediaSourcePrivateFFmpeg> m_mediaSourcePrivate;
+    RunLoop::Timer m_statTimer;
+
+    // main thread
+    MediaPlayer::NetworkState m_networkState { MediaPlayer::NetworkState::Empty };
+    MediaPlayer::ReadyState m_lastReadyState { MediaPlayer::ReadyState::HaveNothing };
+    FloatSize m_naturalSize;
+    bool m_paused { true };
+    bool m_hasPlayed { false };
+    bool m_firstFrameShown { false };
+    mutable PlatformTimeRanges m_buffered;
+    mutable PlatformTimeRanges m_lastProgressBuffered;
+    std::optional<MediaTimePromise::AutoRejectProducer> m_seekPromise;
+    // seeks requested so far: a seek completes only if no later one started
+    unsigned m_seekGeneration { 0 };
+    uint64_t m_lastStatPresented { 0 };
+    MonotonicTime m_lastStatTime;
+
+    // currentTime() and timeIsProgressing() are also called from the MediaSource's dispatcher
+    mutable Lock m_timeLock;
+    MediaTime m_duration WTF_GUARDED_BY_LOCK(m_timeLock) { MediaTime::invalidTime() };
+    std::optional<MediaTime> m_pendingSeekTime WTF_GUARDED_BY_LOCK(m_timeLock);
+    bool m_ended WTF_GUARDED_BY_LOCK(m_timeLock) { false };
+};
+
