+void MediaPlayerPrivateFFmpegMSE::pause()
+{
+    if (m_paused)
+        return;
+    m_paused = true;
+    m_engine->setPaused(true);
+    log("mse pause clock=%.3f", m_engine->currentTime());
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
