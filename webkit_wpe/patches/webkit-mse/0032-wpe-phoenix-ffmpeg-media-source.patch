+void MediaPlayerPrivateFFmpegMSE::videoSizeChanged(FloatSize size)
+{
+    if (size.isEmpty() || size == m_naturalSize)
+        return;
+    log("mse size %.0fx%.0f -> %.0fx%.0f", m_naturalSize.width(), m_naturalSize.height(), size.width(), size.height());
+    m_naturalSize = size;
+    if (RefPtr player = m_player.get())
+        player->sizeChanged();
+}
+
+const PlatformTimeRanges& MediaPlayerPrivateFFmpegMSE::buffered() const
+{
+    m_buffered = m_mediaSourcePrivate ? m_mediaSourcePrivate->buffered() : PlatformTimeRanges();
+    return m_buffered;
+}
+
+bool MediaPlayerPrivateFFmpegMSE::didLoadingProgress() const
+{
+    auto buffered = m_mediaSourcePrivate ? m_mediaSourcePrivate->buffered() : PlatformTimeRanges();
+    bool progress = buffered != m_lastProgressBuffered;
+    m_lastProgressBuffered = WTF::move(buffered);
+    return progress;
+}
+
+std::optional<VideoPlaybackQualityMetrics> MediaPlayerPrivateFFmpegMSE::videoPlaybackQualityMetrics()
+{
+    auto counters = m_engine->counters();
+    return VideoPlaybackQualityMetrics {
+        static_cast<uint32_t>(counters.presented + counters.dropped),
+        static_cast<uint32_t>(counters.dropped),
+        0,
+        0,
+        static_cast<uint32_t>(counters.painted),
+    };
+}
+
+DestinationColorSpace MediaPlayerPrivateFFmpegMSE::colorSpace()
+{
+    return DestinationColorSpace::SRGB();
+}
+
+void MediaPlayerPrivateFFmpegMSE::engineEvent(FFmpegPlaybackEngine::Event event, double value)
+{
+    RefPtr player = m_player.get();
+    switch (event) {
+    case FFmpegPlaybackEngine::Event::FirstFrame:
+        if (!m_firstFrameShown && hasVideo() && player)
+            player->firstVideoFrameAvailable();
+        m_firstFrameShown = true;
+        break;
+    case FFmpegPlaybackEngine::Event::Ended:
+        {
+            Locker locker { m_timeLock };
+            m_ended = true;
+        }
+        // HTMLMediaElement sees currentTime == duration: 'ended' (or a seek to 0 for 'loop')
+        if (player)
+            player->timeChanged();
+        break;
+    case FFmpegPlaybackEngine::Event::SizeChanged:
+        videoSizeChanged(m_engine->naturalSize());
+        break;
+    case FFmpegPlaybackEngine::Event::DecodeError:
+        log("mse error decoder");
+        setNetworkState(MediaPlayer::NetworkState::DecodeError);
+        break;
+    case FFmpegPlaybackEngine::Event::Stalled:
+        log("mse stall %s clock=%.3f", value ? "start" : "end", m_engine->currentTime());
+        break;
+    }
+}
+
+void MediaPlayerPrivateFFmpegMSE::statTimerFired()
+{
+    auto now = MonotonicTime::now();
+    auto counters = m_engine->counters();
+    double seconds = (now - m_lastStatTime).seconds();
+    double fps = seconds > 0 ? (counters.presented - m_lastStatPresented) / seconds : 0;
+    m_lastStatPresented = counters.presented;
+    m_lastStatTime = now;
+    auto stats = m_mediaSourcePrivate ? m_mediaSourcePrivate->stats() : MediaSourcePrivateFFmpeg::Stats { };
+    log("stat clock=%.3f decoded=%llu presented=%llu painted=%llu dropped=%llu fps=%.1f av_ms=%d vq=%zu aq=%zu paused=%d hw=%s upload_ms=%.2f"
+        " ready=%d stalls=%u q_kb=%zu mse_sb=%u mse_kb=%llu mse_samples=%llu played=%d players=%u",
+        m_engine->currentTime(), static_cast<unsigned long long>(counters.decoded), static_cast<unsigned long long>(counters.presented),
+        static_cast<unsigned long long>(counters.painted), static_cast<unsigned long long>(counters.dropped), fps, counters.avDriftMs,
+        counters.videoPackets, counters.audioPackets, m_paused, counters.hardware < 0 ? "-" : counters.hardware ? "1" : "0",
+        counters.painted ? counters.uploadMicroseconds / 1000.0 / counters.painted : 0.0, static_cast<int>(readyState()), counters.stalls,
+        counters.queuedBytes / 1024, stats.sourceBuffers, static_cast<unsigned long long>(stats.bufferedBytes / 1024),
+        static_cast<unsigned long long>(stats.samples), m_hasPlayed, livePlayers.load());
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(VIDEO) && ENABLE(MEDIA_SOURCE) && USE(FFMPEG)
