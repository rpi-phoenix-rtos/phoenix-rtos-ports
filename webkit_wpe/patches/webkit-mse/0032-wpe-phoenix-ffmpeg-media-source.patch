+
+namespace WebCore {
+
+class MediaPlayerPrivateFFmpegMSE;
+class MediaSourcePrivateFFmpeg;
+
+// A SourceBuffer of MediaPlayerPrivateFFmpegMSE. appendBuffer() bytes go through
+// FFmpegFMP4Parser on the dispatcher (the main thread; parsing walks boxes, it decodes nothing),
+// which reports initialization segments and coded frames back to WebCore's SourceBufferPrivate;
+// the frames WebCore then enqueues go to the player's FFmpegPlaybackEngine.
+//
+// Buffer limit (WebCore evicts above it): 40 MB for a SourceBuffer with video
+// (WPE_PHOENIX_MSE_MAX_MB), 8 MB for audio only; 8 / 2 MB as long as the player has not
+// played (WPE_PHOENIX_MSE_IDLE_MAX_MB), as MediaPlayerPrivateFFmpeg's idle read-ahead.
+class SourceBufferPrivateFFmpeg final : public SourceBufferPrivate {
+public:
+    static Ref<SourceBufferPrivateFFmpeg> create(MediaSourcePrivateFFmpeg&, const ContentType&);
+    virtual ~SourceBufferPrivateFFmpeg();
+
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::FFmpeg; }
+
+    // MediaSourcePrivateFFmpeg
+    void updateMaximumBufferSize();
+    uint64_t samplesReceived() const { return m_samplesReceived; }
+
+#if !RELEASE_LOG_DISABLED
+    const Logger& sourceBufferLogger() const final { return m_logger.get(); }
+    uint64_t sourceBufferLogIdentifier() final { return m_logIdentifier; }
+    const Logger& logger() const final { return m_logger.get(); }
+    ASCIILiteral logClassName() const final { return "SourceBufferPrivateFFmpeg"_s; }
+    uint64_t logIdentifier() const final { return m_logIdentifier; }
+    WTFLogChannel& logChannel() const final;
+#endif
+
+private:
+    SourceBufferPrivateFFmpeg(MediaSourcePrivateFFmpeg&, const ContentType&);
+
+    RefPtr<MediaSourcePrivateFFmpeg> mediaSourcePrivate() const;
+    RefPtr<MediaPlayerPrivateFFmpegMSE> player() const;
+    // the engine input that `trackID` feeds, if it is the track that plays its kind
+    std::optional<FFmpegPlaybackEngine::Track> engineTrack(TrackID);
+
+    // SourceBufferPrivate
+    Ref<MediaPromise> appendInternal(Ref<SharedBuffer>&&) final;
+    void resetParserStateInternal() final;
+    bool canSwitchToType(const ContentType&) final;
+    void flush(TrackID) final;
+    void enqueueSample(Ref<MediaSample>&&, TrackID) final;
+    void allSamplesInTrackEnqueued(TrackID) final;
+    bool isReadyForMoreSamples(TrackID) final;
+    void notifyClientWhenReadyForMoreSamples(TrackID) final;
+    size_t platformMaximumBufferSize() const final;
+
+    class ParserClient;
+    void didParseInitSegment(const FFmpegFMP4Parser::InitSegment&);
+    void didParseSample(const FFmpegFMP4Parser::Track&, const FFmpegFMP4Parser::Sample&, const uint8_t*);
+
+    FFmpegFMP4Parser m_parser;
+    String m_type;
+    // per track of the last initialization segment
+    HashMap<TrackID, Ref<FFmpegCodecConfig>> m_configs;
+    bool m_hasVideo { false };
+    unsigned m_appendSamples { 0 };
+    std::atomic<uint64_t> m_samplesReceived { 0 };
+#if !RELEASE_LOG_DISABLED
+    const Ref<const Logger> m_logger;
+    const uint64_t m_logIdentifier;
+#endif
+};
+
+} // namespace WebCore
