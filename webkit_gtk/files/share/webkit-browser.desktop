[Desktop Entry]
Type=Application
Name=WebKit Browser
GenericName=Web Browser
Comment=Browse the web with tabs and downloads (WebKitGTK)
Exec=/usr/bin/webkit-browser %U
Icon=web-browser
Terminal=false
StartupNotify=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;internet;www;http;tabs;
