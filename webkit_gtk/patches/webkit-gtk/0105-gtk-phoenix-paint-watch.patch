+
+#if OS(PHOENIX)
+void webkit_gtk_phoenix_paint_watch_before_paint(void)
+{
+    auto& state = WebKit::PhoenixPaintWatch::state;
+    state.total.cycles++;
+    state.cycleStartUs = WebKit::PhoenixPaintWatch::nowUs();
+    state.cycleDrewFrame = false;
+    if (!state.reportedUs)
+        state.reportedUs = state.cycleStartUs; // the first report's interval
+}
+
+int webkit_gtk_phoenix_paint_watch_after_paint(char* line, size_t size)
+{
+    auto& state = WebKit::PhoenixPaintWatch::state;
+    if (!state.cycleStartUs)
+        return 0;
+    const int64_t nowUs = WebKit::PhoenixPaintWatch::nowUs();
+    state.cycle.add(nowUs - state.cycleStartUs);
+    if (!state.cycleDrewFrame)
+        return 0;
+    state.total.cyclesWithFrame++;
+    state.afterDraw.add(nowUs - state.drawEndUs);
+    // one frame, in ms: received -> cycle -> paint -> swap/draw -> after-paint, and since the previous frame
+    auto ms = [](int64_t us) { return us / 1000.0; };
+    snprintf(line, size, "n=%" PRIu64 " wait=%.1f before=%.1f swap=%.1f draw=%.1f after=%.1f rx_to_after=%.1f dt=%.1f",
+        state.total.drawn, ms(state.cycleStartUs - state.frameReceivedUs), ms(state.drawStartUs - state.cycleStartUs),
+        ms(state.swapEndUs - state.drawStartUs), ms(state.drawEndUs - state.swapEndUs), ms(nowUs - state.drawEndUs),
+        ms(nowUs - state.frameReceivedUs), state.previousDrawEndUs ? ms(state.drawEndUs - state.previousDrawEndUs) : -1.0);
+    return 1;
+}
+
+void webkit_gtk_phoenix_paint_watch_report(char* line, size_t size)
+{
+    using WebKit::PhoenixPaintWatch::Duration;
+    auto& state = WebKit::PhoenixPaintWatch::state;
+    const auto& now = state.total;
+    const auto& then = state.reported;
+    const int64_t nowUs = WebKit::PhoenixPaintWatch::nowUs();
+    const double secs = state.reportedUs ? (nowUs - state.reportedUs) / 1e6 : 0;
+    auto delta = [](uint64_t a, uint64_t b) { return static_cast<unsigned long long>(a - b); };
+    const struct {
+        const char* name;
+        Duration* duration;
+    } durations[] = { { "wait", &state.wait }, { "rx_to_draw", &state.receiveToDraw }, { "before", &state.beforeDraw }, { "swap", &state.swap },
+        { "draw", &state.draw }, { "after", &state.afterDraw }, { "cycle", &state.cycle }, { "dt", &state.frameInterval } };
+    // " <name>_ms=<average>/<maximum>" each
+    char averages[512];
+    size_t used = 0;
+    for (const auto& [name, duration] : durations) {
+        const int n = snprintf(averages + used, sizeof(averages) - used, " %s_ms=%.1f/%.1f", name, duration->averageMs(), duration->maxMs());
+        if (n < 0 || static_cast<size_t>(n) >= sizeof(averages) - used)
+            break;
+        used += n;
+    }
+    snprintf(line, size, "secs=%.1f received=%llu drawn=%llu superseded=%llu dropped=%llu unknown=%llu frame_done=%llu repaints=%llu"
+        " fence_waits=%llu imports=%llu cycles=%llu cycles_frame=%llu%s dt_hist=%llu/%llu/%llu/%llu total_drawn=%llu",
+        secs, delta(now.received, then.received), delta(now.drawn, then.drawn), delta(now.superseded, then.superseded),
+        delta(now.dropped, then.dropped), delta(now.unknownBuffer, then.unknownBuffer), delta(now.framesDone, then.framesDone),
+        delta(now.repaints, then.repaints), delta(now.fenceWaits, then.fenceWaits), delta(now.imports, then.imports),
+        delta(now.cycles, then.cycles), delta(now.cyclesWithFrame, then.cyclesWithFrame), averages,
+        static_cast<unsigned long long>(state.intervalHistogram[0]), static_cast<unsigned long long>(state.intervalHistogram[1]),
+        static_cast<unsigned long long>(state.intervalHistogram[2]), static_cast<unsigned long long>(state.intervalHistogram[3]),
+        static_cast<unsigned long long>(now.drawn));
+
+    state.reported = state.total;
+    state.reportedUs = nowUs;
+    for (const auto& entry : durations)
+        *entry.duration = { };
+    for (auto& count : state.intervalHistogram)
+        count = 0;
+}
+#endif // OS(PHOENIX)
