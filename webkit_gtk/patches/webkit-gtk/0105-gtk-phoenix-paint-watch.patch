 {
     ASSERT(!m_pendingBuffer);
+#if OS(PHOENIX)
+    PhoenixPaintWatch::didReceiveFrame();
+    if (m_pendingBuffer)
+        PhoenixPaintWatch::state.total.superseded++;
+#endif
     auto* buffer = m_buffers.get(bufferID);
     if (!buffer) {
+#if OS(PHOENIX)
+        PhoenixPaintWatch::state.total.unknownBuffer++;
+#endif
         frameDone();
         return;
     }
 
     m_pendingBuffer = buffer;
+#if OS(PHOENIX)
+    // before the fence monitor: without a fence it queues the redraw from inside this call
+    m_pendingReceivedUs = PhoenixPaintWatch::nowUs();
+    PhoenixFrameWatch::mark(PhoenixFrameWatch::uiProcess.pendingMs);
+#endif
     m_pendingDamageRects = WTF::move(damageRects);
     m_fenceMonitor.addFileDescriptor(WTF::move(renderingFenceFD));
 }
 
 void AcceleratedBackingStore::frameDone()
 {
+#if OS(PHOENIX)
+    PhoenixPaintWatch::state.total.framesDone++;
+    PhoenixFrameWatch::count(PhoenixFrameWatch::uiProcess.framesDoneSent);
+#endif
     if (RefPtr legacyMainFrameProcess = m_legacyMainFrameProcess.get())
         legacyMainFrameProcess->send(Messages::AcceleratedSurface::FrameDone(), m_surfaceID);
 }
@@ -821,6 +988,10 @@ void AcceleratedBackingStore::update(const LayerTreeContext& context)
 
     if (m_surfaceID) {
         if (m_pendingBuffer) {
+#if OS(PHOENIX)
+            PhoenixPaintWatch::state.total.dropped++;
+            PhoenixFrameWatch::uiProcess.pendingMs.store(0, std::memory_order_relaxed);
+#endif
             frameDone();
             m_pendingBuffer = nullptr;
             m_pendingDamageRects = { };
@@ -877,11 +1048,26 @@ bool AcceleratedBackingStore::snapshot(GtkSnapshot* gtkSnapshot)
 #else
 bool AcceleratedBackingStore::paint(cairo_t* cr, const IntRect& clipRect)
 {
+#if OS(PHOENIX)
+    const int64_t startUs = PhoenixPaintWatch::nowUs();
+    const int64_t receivedUs = m_pendingReceivedUs;
+    if (m_pendingBuffer && m_fenceMonitor.hasFileDescriptor())
+        PhoenixPaintWatch::state.total.fenceWaits++;
+#endif
