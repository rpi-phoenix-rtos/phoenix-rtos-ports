+#if OS(PHOENIX)
+    const int64_t swapEndUs = PhoenixPaintWatch::nowUs();
+#endif
     m_committedBuffer->paint(cr, clipRect);
+#if OS(PHOENIX)
+    if (didSwapBuffers)
+        PhoenixPaintWatch::didDrawFrame(receivedUs, startUs, swapEndUs, PhoenixPaintWatch::nowUs());
+    else
+        PhoenixPaintWatch::state.total.repaints++;
+#endif
     if (didSwapBuffers)
