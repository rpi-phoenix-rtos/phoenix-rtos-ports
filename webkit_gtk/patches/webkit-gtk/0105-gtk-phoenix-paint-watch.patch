+#if OS(PHOENIX)
+// Phoenix-RTOS: the paint watch of the GTK UI process, for webkit-browser --present-stats. Where
+// each frame of the web process spends its time between arriving here and leaving in GDK's
+// eglSwapBuffers(): the wait for GDK's frame clock, this view's draw (the frame's GL texture into
+// GDK's window), the rest of GDK's paint (the other widgets, its own texture uploads, the swap).
+// The program forwards the toplevel's frame clock (before-paint, after-paint) and asks for a
+// report line; everything runs on the main thread.
+extern "C" {
+void webkit_gtk_phoenix_paint_watch_before_paint(void);
+// 1 when this paint drew a new frame; then `line` has that frame's breakdown
+int webkit_gtk_phoenix_paint_watch_after_paint(char* line, size_t size);
+// the counts, averages and maxima since the previous report
+void webkit_gtk_phoenix_paint_watch_report(char* line, size_t size);
+}
+#endif
