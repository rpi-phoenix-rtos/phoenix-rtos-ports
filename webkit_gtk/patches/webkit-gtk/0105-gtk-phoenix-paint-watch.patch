+// Phoenix-RTOS: the paint watch (AcceleratedBackingStore.h). Per frame of the web process:
+//   received   frame(): the web process sent it; with no rendering fence (patch 0016 keeps the
+//              fences in the web process) the fence monitor queues a redraw of the view at once
+//   paint      paint(), inside GDK's paint of the window on its frame clock: swapBuffersIfNeeded()
+//              makes the frame current (its GL texture on first use, the previous frame released),
+//              Buffer::paint() draws it with gdk_cairo_draw_from_gl(), then FrameDone goes back
+//   after      the frame clock's after-paint: GDK has drawn the other widgets, uploaded what cairo
+//              drew and called eglSwapBuffers()
+// The web process renders its next frame only after FrameDone, so one frame is in flight and a
+// frame replaced before it was drawn ("superseded") should not exist; it is counted all the same.
+// Main thread only (IPC messages, GDK's paint and frame clock, the program's report timer).
+namespace PhoenixPaintWatch {
+
+static int64_t nowUs()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<int64_t>(ts.tv_sec) * 1000000 + ts.tv_nsec / 1000;
+}
+
+// a duration's count, sum and maximum over one report interval
+struct Duration {
+    uint64_t count { 0 };
+    int64_t sumUs { 0 };
+    int64_t maxUs { 0 };
+
+    void add(int64_t us)
+    {
+        if (us < 0)
+            return;
+        count++;
+        sumUs += us;
+        maxUs = std::max(maxUs, us);
+    }
+    double averageMs() const { return count ? sumUs / 1000.0 / count : 0; }
+    double maxMs() const { return maxUs / 1000.0; }
+};
+
+struct Counts {
+    uint64_t received { 0 };
+    uint64_t superseded { 0 }; // a frame arrived while the previous one was still pending
+    uint64_t unknownBuffer { 0 }; // a frame in a buffer this process does not have: FrameDone at once
+    uint64_t dropped { 0 }; // the pending frame thrown away when the view changed surface
+    uint64_t drawn { 0 }; // paints that made a new frame current and drew it
+    uint64_t repaints { 0 }; // paints that drew the current frame again (GDK redrew the view)
+    uint64_t fenceWaits { 0 }; // paints with a frame pending behind its rendering fence
+    uint64_t framesDone { 0 };
+    uint64_t imports { 0 }; // GL textures made from a buffer's EGLImage (first use of a buffer)
+    uint64_t cycles { 0 }; // frame clock cycles (before-paint)
+    uint64_t cyclesWithFrame { 0 };
+};
+
+struct State {
+    Counts total;
+    Counts reported; // `total` at the previous report
+    int64_t reportedUs { 0 };
+    // this interval
+    Duration wait; // received -> the frame clock cycle that drew it began
+    Duration receiveToDraw; // received -> its paint() began
+    Duration beforeDraw; // the cycle began -> paint(): GDK's begin-paint, the widgets drawn before the view
+    Duration swap; // swapBuffersIfNeeded(): texture on first use, the previous frame released
+    Duration draw; // Buffer::paint(): gdk_cairo_draw_from_gl()
+    Duration afterDraw; // paint() returned -> after-paint: the rest of GDK's paint and eglSwapBuffers()
+    Duration cycle; // before-paint -> after-paint, every cycle
+    Duration frameInterval; // between two drawn frames
+    uint64_t intervalHistogram[4] { }; // < 25, < 42, < 58, >= 58 ms: 1, 2, 3, 4+ refreshes at 60 Hz
+    // the cycle in progress
+    int64_t cycleStartUs { 0 };
+    bool cycleDrewFrame { false };
+    // the last frame drawn
+    int64_t frameReceivedUs { 0 };
+    int64_t drawStartUs { 0 };
+    int64_t swapEndUs { 0 };
+    int64_t drawEndUs { 0 };
+    int64_t previousDrawEndUs { 0 };
+};
+
+static State state;
+
+static void didReceiveFrame()
+{
+    state.total.received++;
+    PhoenixFrameWatch::count(PhoenixFrameWatch::uiProcess.framesReceived, &PhoenixFrameWatch::uiProcess.frameReceivedMs);
+}
+
+static void didDrawFrame(int64_t receivedUs, int64_t startUs, int64_t swapEndUs, int64_t endUs)
+{
+    state.total.drawn++;
+    auto& shared = PhoenixFrameWatch::uiProcess;
+    shared.framesRendered.fetch_add(1, std::memory_order_relaxed);
+    shared.pendingMs.store(0, std::memory_order_relaxed);
+
+    // the cycle's start is known only when the program forwards the frame clock
+    const bool inCycle = state.cycleStartUs && state.cycleStartUs >= receivedUs;
+    if (inCycle) {
+        state.wait.add(state.cycleStartUs - receivedUs);
+        state.beforeDraw.add(startUs - state.cycleStartUs);
+    }
+    state.cycleDrewFrame = true;
+    state.receiveToDraw.add(startUs - receivedUs);
+    state.swap.add(swapEndUs - startUs);
+    state.draw.add(endUs - swapEndUs);
+    if (state.drawEndUs) {
+        const int64_t interval = endUs - state.drawEndUs;
+        state.frameInterval.add(interval);
+        state.intervalHistogram[interval < 25000 ? 0 : interval < 42000 ? 1 : interval < 58000 ? 2 : 3]++;
+    }
+    state.previousDrawEndUs = state.drawEndUs;
+    state.frameReceivedUs = receivedUs;
+    state.drawStartUs = startUs;
+    state.swapEndUs = swapEndUs;
+    state.drawEndUs = endUs;
+}
+
+static void didImportTexture(const IntSize& size, const DMABufBufferAttributes& attributes)
+{
+    state.total.imports++;
+    static bool logged;
+    if (logged)
+        return;
+    logged = true;
+    // gdk_cairo_draw_from_gl() blends a texture that has alpha over the cairo surface below the
+    // view, which it first uploads as a texture of its own, every paint (GTK 3 gdk/gdkgl.c). GDK
+    // asks the texture as here, on GL ES 3.1 and later; before that it assumes alpha. (-1: not
+    // asked; glGetTexLevelParameteriv() is not in GL ES 3.0, and epoxy aborts on a missing entry)
+    GLint alphaBits = -1;
+    if (epoxy_gl_version() >= 31)
+        glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_ALPHA_SIZE, &alphaBits);
+    const uint32_t fourcc = attributes.fourcc.value;
+    WTFLogAlways("WPEB-WEBKIT gtk-paint import pid=%d size=%dx%d fourcc=%c%c%c%c modifier=0x%016" PRIx64 " alpha_bits=%d", getpid(),
+        size.width(), size.height(), fourcc & 0xff, (fourcc >> 8) & 0xff, (fourcc >> 16) & 0xff, (fourcc >> 24) & 0xff,
+        attributes.modifier, alphaBits);
+}
+
+} // namespace PhoenixPaintWatch
+#endif // OS(PHOENIX)
