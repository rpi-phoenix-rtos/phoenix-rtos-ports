Subject: GTK 3, USE_LIBDRM=OFF: two build fixes in the GLib API (2.54.0)

- WebKitDownload.cpp: webkit_download_set_destination()'s webkit2gtk-4.1 branch
  (!ENABLE(2022_GLIB_API): GTK 3) calls CStringView::unsafeFromUTF8() without including
  <wtf/text/CStringView.h>; it compiles only where the unified-source bundle happens to pull the
  header in through a neighbour.
- WebKitProtocolHandler.cpp (webkit://gpu): the non-accelerated branch calls
  renderBufferDescription(), which exists only with USE(LIBDRM).

Neither is Phoenix-specific; a GTK build without libdrm (the Phoenix one: no DRM device in the
UI process) hits both.

diff --git a/Source/WebKit/UIProcess/API/glib/WebKitDownload.cpp b/Source/WebKit/UIProcess/API/glib/WebKitDownload.cpp
index 27143dbb..63152631 100644
--- a/Source/WebKit/UIProcess/API/glib/WebKitDownload.cpp
+++ b/Source/WebKit/UIProcess/API/glib/WebKitDownload.cpp
@@ -35,6 +35,7 @@
 #include <wtf/glib/GWeakPtr.h>
 #include <wtf/glib/WTFGType.h>
 #include <wtf/text/CString.h>
+#include <wtf/text/CStringView.h>
 
 using namespace WebKit;
 using namespace WebCore;
diff --git a/Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp b/Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp
index 8752d807..6c34ae30 100644
--- a/Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp
+++ b/Source/WebKit/UIProcess/API/glib/WebKitProtocolHandler.cpp
@@ -757,7 +757,7 @@ void WebKitProtocolHandler::handleGPU(WebKitURISchemeRequest* request, RenderPro
         if (hasEGLContext)
             addEGLInfo(hardwareAccelerationObject);
     } else {
-#if PLATFORM(GTK)
+#if PLATFORM(GTK) && USE(LIBDRM)
         addTableRow(hardwareAccelerationObject, "Buffer format"_s, renderBufferDescription(request));
 #endif
     }
