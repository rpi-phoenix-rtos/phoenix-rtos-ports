@@ -220,10 +222,24 @@ static void didImportTexture(const IntSize& size, const DMABufBufferAttributes&
     GLint alphaBits = -1;
     if (epoxy_gl_version() >= 31)
         glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_ALPHA_SIZE, &alphaBits);
-    const uint32_t fourcc = attributes.fourcc.value;
     WTFLogAlways("WPEB-WEBKIT gtk-paint import pid=%d size=%dx%d fourcc=%c%c%c%c modifier=0x%016" PRIx64 " alpha_bits=%d", getpid(),
         size.width(), size.height(), fourcc & 0xff, (fourcc >> 8) & 0xff, (fourcc >> 16) & 0xff, (fourcc >> 24) & 0xff,
-        attributes.modifier, alphaBits);
+        modifier, alphaBits);
+}
+
+// The opaque variant of a dma-buf format with alpha: the same memory layout, the alpha byte ignored.
+// Mesa makes such an EGLImage a GL_RGB8 texture (dri_util.c: __DRI_IMAGE_FORMAT_XBGR8888 ->
+// GL_RGB8), so its GL_TEXTURE_ALPHA_SIZE is 0; the V3D samples it as RGBX8 (alpha read as 1).
+static uint32_t opaqueFourcc(uint32_t fourcc)
+{
+    auto code = [](char a, char b, char c, char d) {
+        return static_cast<uint32_t>(a) | static_cast<uint32_t>(b) << 8 | static_cast<uint32_t>(c) << 16 | static_cast<uint32_t>(d) << 24;
+    };
+    if (fourcc == code('A', 'B', '2', '4')) // DRM_FORMAT_ABGR8888: the web process's frames (patch 0016)
+        return code('X', 'B', '2', '4');
+    if (fourcc == code('A', 'R', '2', '4'))
+        return code('X', 'R', '2', '4');
+    return fourcc;
 }
 
