+    m_importedFourcc = m_dmaBufAttributes.fourcc.value;
+#endif
 }
 
+#if OS(PHOENIX)
+// WEBKIT_PHOENIX_OPAQUE=1: the same dma-buf imported again, as opaque or with alpha as the view now
+// is (swapBuffersIfNeeded(), with the GL context current; the buffer is the pending one, which GTK
+// does not sample). m_dmaBufAttributes keeps the web process's format (bufferDescription()).
+void AcceleratedBackingStore::BufferEGLImage::setOpaque(bool opaque)
+{
+    const uint32_t fourcc = opaque ? PhoenixPaintWatch::opaqueFourcc(m_dmaBufAttributes.fourcc.value) : m_dmaBufAttributes.fourcc.value;
+    if (fourcc == m_importedFourcc || fourcc == m_failedFourcc)
+        return;
+    auto* glDisplay = Display::singleton().glDisplay();
+    if (!glDisplay)
+        return;
+
+    const auto webProcessFourcc = m_dmaBufAttributes.fourcc;
+    m_dmaBufAttributes.fourcc = fourcc;
+    auto* image = DMABufBuffer::createEGLImage(*glDisplay, m_dmaBufAttributes);
+    m_dmaBufAttributes.fourcc = webProcessFourcc;
+    if (!image) {
+        // keep the image there is (frames with alpha are drawn right, only slower); not again
+        m_failedFourcc = fourcc;
+        WTFLogAlways("WPEB-WEBKIT gtk-paint reimport failed pid=%d fourcc=%c%c%c%c", getpid(), fourcc & 0xff, (fourcc >> 8) & 0xff,
+            (fourcc >> 16) & 0xff, (fourcc >> 24) & 0xff);
+        return;
+    }
+    glDisplay->destroyImage(m_image);
+    m_image = image;
+    m_importedFourcc = fourcc;
+#if !USE(GTK4)
+    // didUpdateContents() makes the texture from the new image
+    if (m_textureID) {
+        gdk_gl_context_make_current(m_gdkGLContext.get());
+        glDeleteTextures(1, &m_textureID);
+        m_textureID = 0;
+    }
+#endif
+}
+#endif
