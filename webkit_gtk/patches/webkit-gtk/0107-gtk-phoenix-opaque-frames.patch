+    const char* opaque = getenv("WEBKIT_PHOENIX_OPAQUE");
+    m_opaqueFrames = opaque && !strcmp(opaque, "1");
+    WTFLogAlways("WPEB-WEBKIT frame-pacing pid=%d ahead=%d opaque=%d", getpid(), m_frameAhead, m_opaqueFrames);
