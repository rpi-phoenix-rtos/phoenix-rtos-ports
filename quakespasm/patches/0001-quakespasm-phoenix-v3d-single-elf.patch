diff --git a/Quake/net_udp.c b/Quake/net_udp.c
index 1f3644b..c1cd407 100644
--- a/Quake/net_udp.c
+++ b/Quake/net_udp.c
@@ -262,22 +262,37 @@ int UDP_Connect (sys_socket_t socketid, struct qsockaddr *addr)
 
 sys_socket_t UDP_CheckNewConnections (void)
 {
-	int		available;
 	struct sockaddr_in	from;
-	socklen_t	fromlen;
+	socklen_t	fromlen = sizeof(from);
 	char		buff[1];
+	int		ret;
 
 	if (net_acceptsocket == INVALID_SOCKET)
 		return INVALID_SOCKET;
 
-	if (ioctl (net_acceptsocket, FIONREAD, &available) == -1)
+	/* Phoenix/lwIP port: upstream probes the accept socket with ioctl(FIONREAD),
+	 * but the Pi's lwIP build has LWIP_SO_RCVBUF==0 / LWIP_FIONREAD_LINUXMODE==0, so
+	 * FIONREAD is unimplemented and the syscall errors -- and upstream turns that into
+	 * a fatal Sys_Error, which (with stray LAN broadcast traffic) hung the flagship as
+	 * soon as a packet arrived (task #26). FIONBIO *is* implemented, so the accept
+	 * socket is non-blocking (see UDP_OpenSocket); peek it instead. A non-blocking
+	 * MSG_PEEK recvfrom returns >=0 when a datagram is pending and EWOULDBLOCK when
+	 * not -- the same "is there data?" answer FIONREAD gave, with no kernel change and
+	 * no Sys_Error path. NOTE: returns the socket on a pending datagram WITHOUT
+	 * consuming it (PEEK), matching the FIONREAD>0 case; the empty/zero-length packet
+	 * is consumed below exactly as upstream did. */
+	ret = recvfrom (net_acceptsocket, buff, sizeof(buff), MSG_PEEK,
+			(struct sockaddr *) &from, &fromlen);
+	if (ret > 0)
+		return net_acceptsocket;
+	if (ret == SOCKET_ERROR)
 	{
 		int err = SOCKETERRNO;
-		Sys_Error ("UDP: ioctlsocket (FIONREAD) failed (%s)", socketerror(err));
+		if (err != NET_EWOULDBLOCK && err != NET_ECONNREFUSED)
+			Con_SafePrintf ("UDP_CheckNewConnections, recvfrom: %s\n", socketerror(err));
+		return INVALID_SOCKET;
 	}
-	if (available)
-		return net_acceptsocket;
-	// quietly absorb empty packets
+	// quietly absorb empty (zero-length) packets
 	recvfrom (net_acceptsocket, buff, 0, 0, (struct sockaddr *) &from, &fromlen);
 	return INVALID_SOCKET;
 }
