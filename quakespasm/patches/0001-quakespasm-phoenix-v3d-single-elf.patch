+	 * bound for single-pose models; keep it at the valid block 0 (there is no duplicate 2nd
+	 * block anymore -- see gl_mesh.c). Multi-pose models bind the real second pose as usual. */
+	pose2bind = (paliashdr->numposes == 1) ? 0 : lerpdata.pose2;
+
 	GL_UseProgramFunc (r_alias_program);
 
 	GL_BindBuffer (GL_ARRAY_BUFFER, currententity->model->meshvbo);
@@ -242,16 +249,33 @@ void GL_DrawAliasFrame_GLSL (aliashdr_t *paliashdr, lerpdata_t lerpdata, gltextu
 
 	GL_EnableVertexAttribArrayFunc (texCoordsAttrIndex);
 	GL_EnableVertexAttribArrayFunc (pose1VertexAttrIndex);
-	GL_EnableVertexAttribArrayFunc (pose2VertexAttrIndex);
 	GL_EnableVertexAttribArrayFunc (pose1NormalAttrIndex);
-	GL_EnableVertexAttribArrayFunc (pose2NormalAttrIndex);
 
 	GL_VertexAttribPointerFunc (texCoordsAttrIndex, 2, GL_FLOAT, GL_FALSE, 0, (void *)(intptr_t)currententity->model->vbostofs);
 	GL_VertexAttribPointerFunc (pose1VertexAttrIndex, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof (meshxyz_t), GLARB_GetXYZOffset (paliashdr, lerpdata.pose1));
-	GL_VertexAttribPointerFunc (pose2VertexAttrIndex, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof (meshxyz_t), GLARB_GetXYZOffset (paliashdr, lerpdata.pose2));
 // GL_TRUE to normalize the signed bytes to [-1 .. 1]
 	GL_VertexAttribPointerFunc (pose1NormalAttrIndex, 4, GL_BYTE, GL_TRUE, sizeof (meshxyz_t), GLARB_GetNormalOffset (paliashdr, lerpdata.pose1));
-	GL_VertexAttribPointerFunc (pose2NormalAttrIndex, 4, GL_BYTE, GL_TRUE, sizeof (meshxyz_t), GLARB_GetNormalOffset (paliashdr, lerpdata.pose2));
+
+	/* #67 SINGLE-POSE FIX (2026-07-27): the deterministic alias spike glitch (pickups/torches/idle
+	 * viewmodel = mangled black-triangle wedges) is triggered by drawing with blend==0 while TWO
+	 * byte position attributes (Pose1+Pose2, identical data) are active — the V3D mishandles this
+	 * single-effective-pose draw (HW-confirmed by video; aliasing + the Mesa byte-attr path were
+	 * ruled out). At blend==0 the shader's mix(Pose1,Pose2,0.0) == Pose1, so Pose2 is mathematically
+	 * unused: DON'T bind/enable it at all. A disabled attribute supplies the generic default, which
+	 * mix()es away at blend==0 -> position/normal come solely from Pose1. Only bind Pose2 for the
+	 * real lerp (blend!=0), which already renders correctly. */
+	if (blend != 0)
+	{
+		GL_EnableVertexAttribArrayFunc (pose2VertexAttrIndex);
+		GL_EnableVertexAttribArrayFunc (pose2NormalAttrIndex);
+		GL_VertexAttribPointerFunc (pose2VertexAttrIndex, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof (meshxyz_t), GLARB_GetXYZOffset (paliashdr, pose2bind));
+		GL_VertexAttribPointerFunc (pose2NormalAttrIndex, 4, GL_BYTE, GL_TRUE, sizeof (meshxyz_t), GLARB_GetNormalOffset (paliashdr, pose2bind));
+	}
+	else
+	{
+		GL_DisableVertexAttribArrayFunc (pose2VertexAttrIndex);
+		GL_DisableVertexAttribArrayFunc (pose2NormalAttrIndex);
+	}
 
 // set uniforms
 	GL_Uniform1fFunc (blendLoc, blend);
