+/* Draw a robust 6-bit BINARY BLOCK CODE for r_mg_shown_idx in the 2D pass: a solid white
+ * ANCHOR block at the top-left, then 6 data blocks (LSB first) each white=1 / black=0. Read
+ * straight off the HDMI frame — immune to gamma/downscale/colour crosstalk that defeated the
+ * earlier background-colour ramp. Called from SCR_UpdateScreen after GL_Set2D. */
+void R_ModelGallery_DrawTag (void)
+{
+	const int y = 8, h = 72, w = 96, gap = 12, x0 = 8;
+	int j, x;
+	/* anchor: always-white block marks where the code starts */
+	Draw_Fill (x0, y, w, h, 15, 1.0f);
+	for (j = 0; j < 6; j++)
+	{
+		int bit = (r_mg_shown_idx >> j) & 1;
+		x = x0 + (j + 1) * (w + gap);
+		Draw_Fill (x, y, w, h, bit ? 15 : 0, 1.0f);
+	}
+}
