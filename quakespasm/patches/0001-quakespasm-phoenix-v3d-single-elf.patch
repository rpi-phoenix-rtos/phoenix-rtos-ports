+/* top of R_RenderView (worldmodel guaranteed): fix the view + make ONE test model the
+ * only visible entity, centered 60u dead ahead, static frame 0 (=> blend==0, the bug path). */
+static void R_ModelGallery_Setup (void)
+{
+	qmodel_t *m;
+	int n = 0;
+	while (r_mg_models[n]) n++;
+	if (r_mg_idx >= n) { Con_Printf ("#MG loop done (%d models), restarting\n", n); r_mg_idx = 0; r_mg_settle = 0; }   /* LOOP so a capture always catches it */
+
+	m = Mod_ForName (r_mg_models[r_mg_idx], false);
+	if (!m || m->type != mod_alias) { Con_Printf ("#MG skip %s (not alias)\n", r_mg_models[r_mg_idx]); r_mg_idx++; r_mg_settle = 0; return; }
+
+	if (r_mg_settle == 0)
+	{
+		aliashdr_t *ah = (aliashdr_t *) Mod_Extradata (m);
+		r_mg_tstart = realtime;
+		r_mg_settle = 1;
+		Con_Printf ("#MG show[%d] %s\n", r_mg_idx, r_mg_models[r_mg_idx]);
+		/* structural fields, to correlate the on-screen collapse with the VBO layout */
+		Con_Printf ("#MGdiag[%d] %s nvvbo=%d nidx=%d nposes=%d skin=%dx%d\n",
+			r_mg_idx, r_mg_models[r_mg_idx], ah->numverts_vbo, ah->numindexes,
+			ah->numposes, ah->skinwidth, ah->skinheight);
+	}
+	r_mg_shown_idx = r_mg_idx;   /* model rendered THIS frame; read by the 2D block-code tag */
+
+	/* map-independent fixed camera at origin, looking +X */
+	r_refdef.vieworg[0] = r_refdef.vieworg[1] = r_refdef.vieworg[2] = 0.0f;
+	r_refdef.viewangles[0] = r_refdef.viewangles[1] = r_refdef.viewangles[2] = 0.0f;
+
+	{
+		/* normalize framing: place each model's bbox center at a fixed screen point, at a
+		 * distance proportional to its size, so tiny guns and big monsters appear the same
+		 * size and centered (fair 1:1 comparison across models and vs the host reference). */
+		const float yawdeg = 30.0f;                 /* fixed 3/4 view */
+		float yaw = yawdeg * (float)(M_PI / 180.0);
+		float cw = cosf (yaw), sw = sinf (yaw);
+		float cx = (m->mins[0] + m->maxs[0]) * 0.5f;
+		float cy = (m->mins[1] + m->maxs[1]) * 0.5f;
+		float cz = (m->mins[2] + m->maxs[2]) * 0.5f;
+		float ex = m->maxs[0] - m->mins[0], ey = m->maxs[1] - m->mins[1], ez = m->maxs[2] - m->mins[2];
+		float rad = 0.5f * (ex > ey ? (ex > ez ? ex : ez) : (ey > ez ? ey : ez));
+		float dist;
+		if (rad < 1.0f) rad = 16.0f;
+		dist = rad * 2.6f + 16.0f;                  /* subtend a consistent, generous size */
+
+		memset (&r_mg_ent, 0, sizeof(r_mg_ent));
+		r_mg_ent.model = m;
+		/* world center = origin + R(yaw)*center ; want it at (dist,0,0) => origin = (dist,0,0) - R(yaw)*center */
+		r_mg_ent.origin[0] = dist - (cx * cw - cy * sw);
+		r_mg_ent.origin[1] =      - (cx * sw + cy * cw);
+		r_mg_ent.origin[2] =      - cz;
+		r_mg_ent.angles[1] = yawdeg;
+		r_mg_ent.frame = 0;                         /* static -> pose1==pose2 -> blend==0 */
+		r_mg_ent.alpha = 0;                         /* ENTALPHA_DEFAULT (opaque) */
+		r_mg_ent.scale = ENTSCALE_DEFAULT;
+		r_mg_ent.lerpflags = LERP_RESETMOVE;
+	}
