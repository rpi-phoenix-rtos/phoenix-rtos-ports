+			glPixelStorei (GL_PACK_ALIGNMENT, 1);
+			glReadPixels (glx, gly, glwidth, glheight, GL_RGB, GL_UNSIGNED_BYTE, buf);
+			q_snprintf (name, sizeof(name), "mg/%s.tga", base);
+			Image_WriteTGA (name, buf, glwidth, glheight, 24, false);
+			free (buf);
+			Con_Printf ("#MG shot mg/%s.tga\n", base);
+		}
+	}
+	r_mg_idx++; r_mg_settle = 0;
