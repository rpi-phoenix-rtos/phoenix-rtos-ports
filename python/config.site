ac_cv_func_sched_get_priority_max=yes
# Phoenix <sched.h> DECLARES these POSIX scheduling-policy funcs but libphoenix
# does not DEFINE them, so configure's compile-only probe (against the fresh
# dev-mode sysroot) would set HAVE_*=yes and posixmodule.c would emit calls that
# fail at the static link (undefined reference to sched_getparam, ...). Force
# them absent so os.sched_{get,set}param/scheduler are #if'd out — this matches
# the HW-verified ad-hoc binary, which built with these auto-detected as absent.
ac_cv_func_sched_getparam=no
ac_cv_func_sched_setparam=no
ac_cv_func_sched_getscheduler=no
ac_cv_func_sched_setscheduler=no
ac_cv_func_sched_rr_get_interval=no
