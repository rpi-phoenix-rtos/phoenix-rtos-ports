diff --git a/backend/ev-builtin-backends.py b/backend/ev-builtin-backends.py
new file mode 100755
index 0000000..c07edf6
--- /dev/null
+++ b/backend/ev-builtin-backends.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+#
+# ev-builtin-backends.py OUTPUT.c BACKEND.atril-backend...
+#
+# Writes the table of the document backends linked into a program
+# (-Dbuiltin_backends=true; libdocument/ev-builtin-backends.h): for each
+# .atril-backend file its Module, Resident, TypeDescription and MimeType, and
+# the backend's register_atril_backend () under the name its static library
+# was compiled with, ev_builtin_<Module>_register ().
+#
+# This file is part of atril, a mate document viewer; GPL-2.0-or-later.
+
+import sys
+
+GROUP = 'Atril Backend'
+
+
+def read_backend(path):
+    keys = {}
+    group = None
+    with open(path, encoding='utf-8') as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith('#'):
+                continue
+            if line.startswith('[') and line.endswith(']'):
+                group = line[1:-1]
+                continue
+            if group != GROUP or '=' not in line:
+                continue
+            key, value = line.split('=', 1)
+            keys[key.strip()] = value.strip()   # localized keys (Key[ll]) are skipped below
+    for key in ('Module', 'TypeDescription', 'MimeType'):
+        if key not in keys:
+            sys.exit('%s: no %s in [%s]' % (path, key, GROUP))
+    return keys
+
+
+def c_string(s):
+    return '"' + s.replace('\\', '\\\\').replace('"', '\\"') + '"'
+
+
+def main(argv):
+    out, inputs = argv[0], argv[1:]
+    backends = [read_backend(p) for p in inputs]
+    lines = ['/* Generated by backend/ev-builtin-backends.py: do not edit. */',
+             '',
+             '#include <config.h>',
+             '',
+             '#include "ev-builtin-backends.h"',
+             '']
+    for b in backends:
+        lines.append('GType ev_builtin_%s_register (GTypeModule *module);' % b['Module'])
+    lines.append('')
+    for b in backends:
+        mimes = [m for m in b['MimeType'].split(';') if m]
+        lines.append('static const gchar * const %s_mime_types[] = {' % b['Module'])
+        lines.extend('\t%s,' % c_string(m) for m in mimes)
+        lines.append('\tNULL')
+        lines.append('};')
+        lines.append('')
+    lines.append('const EvBuiltinBackend ev_builtin_backends[] = {')
+    for b in backends:
+        resident = 'TRUE' if b.get('Resident', 'false').lower() == 'true' else 'FALSE'
+        lines.append('\t{ %s, %s, %s, %s_mime_types, ev_builtin_%s_register },' % (
+            c_string(b['Module']), resident, c_string(b['TypeDescription']), b['Module'], b['Module']))
+    lines.append('\t{ NULL, FALSE, NULL, NULL, NULL }')
+    lines.append('};')
+    with open(out, 'w', encoding='utf-8') as f:
+        f.write('\n'.join(lines) + '\n')
+
+
+if __name__ == '__main__':
+    main(sys.argv[1:])
diff --git a/backend/meson.build b/backend/meson.build
index ca9108d..b796e60 100644
--- a/backend/meson.build
+++ b/backend/meson.build
@@ -1,5 +1,44 @@
 backendsdir = join_paths(prefix, libdir, meson.project_name(), binary_major_version, 'backends')
 
+# -Dbuiltin_backends=true: each backend is a static library whose
+# register_atril_backend () is renamed ev_builtin_<Module>_register (); the
+# table ev_builtin_backends[] (libdocument/ev-builtin-backends.h) is generated
+# from the backends' .atril-backend files and linked, with the backends, into
+# every program that loads documents (builtin_backends_dep).
+builtin_backend_libs = []
+builtin_backend_deps = []
+builtin_backend_files = []
+if get_option('builtin_backends')
+    foreach sub : backend_subdirs
+        if sub not in ['pdf']
+            error('builtin_backends: the @0@ backend can only be built as a module'.format(sub))
+        endif
+    endforeach
+endif
+
 foreach sub : backend_subdirs
     subdir(sub)
 endforeach
+
+if get_option('builtin_backends')
+    builtin_backends_c = custom_target(
+        'ev-builtin-backends.c',
+        input: builtin_backend_files,
+        output: 'ev-builtin-backends.c',
+        command: [find_program('ev-builtin-backends.py'), '@OUTPUT@', '@INPUT@'],
+    )
+    libevbuiltinbackends = static_library(
+        'evbuiltinbackends',
+        builtin_backends_c,
+        include_directories: include_dirs,
+        dependencies: [libdocument_dep, gtk],
+        link_whole: builtin_backend_libs,
+    )
+    # (the backends' own dependencies do not travel through link_whole)
+    builtin_backends_dep = declare_dependency(
+        link_whole: libevbuiltinbackends,
+        dependencies: builtin_backend_deps,
+    )
+else
+    builtin_backends_dep = declare_dependency()
+endif
diff --git a/backend/pdf/meson.build b/backend/pdf/meson.build
index 2a81d71..cf90247 100644
--- a/backend/pdf/meson.build
+++ b/backend/pdf/meson.build
@@ -9,22 +9,33 @@ pdf_deps = [
     poppler,
 ]
 
-shared_module(
-    'pdfdocument',
-    pdf_sources,
-    link_with: [libdocument],
-    link_args: ['-Wl,-Bsymbolic', '-Wl,-z,relro', '-Wl,-z,now'],
-    include_directories: include_dirs,
-    dependencies: pdf_deps,
-    install: true,
-    install_dir: backendsdir,
-)
+if get_option('builtin_backends')
+    builtin_backend_libs += static_library(
+        'pdfdocument',
+        pdf_sources,
+        cpp_args: ['-Dregister_atril_backend=ev_builtin_pdfdocument_register'],
+        include_directories: include_dirs,
+        dependencies: pdf_deps + [libdocument_dep],
+    )
+    builtin_backend_deps += pdf_deps
+else
+    shared_module(
+        'pdfdocument',
+        pdf_sources,
+        link_with: [libdocument],
+        link_args: ['-Wl,-Bsymbolic', '-Wl,-z,relro', '-Wl,-z,now'],
+        include_directories: include_dirs,
+        dependencies: pdf_deps,
+        install: true,
+        install_dir: backendsdir,
+    )
+endif
 
-i18n.merge_file(
+builtin_backend_files += i18n.merge_file(
   input: 'pdfdocument.atril-backend.desktop.in',
   output: 'pdfdocument.atril-backend',
   type: 'desktop',
   po_dir: po_dir,
-  install: true,
+  install: not get_option('builtin_backends'),
   install_dir: backendsdir,
 )
diff --git a/libdocument/ev-backends-manager.c b/libdocument/ev-backends-manager.c
index a690675..cf4d1e0 100644
--- a/libdocument/ev-backends-manager.c
+++ b/libdocument/ev-backends-manager.c
@@ -23,6 +23,7 @@
 #include <gmodule.h>
 
 #include "ev-module.h"
+#include "ev-builtin-backends.h"
 #include "ev-backends-manager.h"
 
 static GList *ev_backends_list = NULL;
@@ -37,6 +38,9 @@ struct _EvBackendInfo {
 
 	gchar       *type_desc;
 	gchar      **mime_types;
+
+	/* set for a backend linked into the program */
+	EvModuleRegisterFunc builtin_register_func;
 };
 
 #define EV_BACKENDS_GROUP     "Atril Backend"
@@ -128,6 +132,41 @@ ev_backends_manager_load_backend (const gchar *file)
 	return info;
 }
 
+static gboolean
+ev_backends_manager_has_module (const gchar *module_name)
+{
+	GList *l;
+
+	for (l = ev_backends_list; l; l = g_list_next (l)) {
+		if (g_strcmp0 (((EvBackendInfo *)l->data)->module_name, module_name) == 0)
+			return TRUE;
+	}
+
+	return FALSE;
+}
+
+static void
+ev_backends_manager_load_builtin (void)
+{
+	const EvBuiltinBackend *builtin;
+
+	if (!ev_builtin_backends)
+		return;
+
+	for (builtin = ev_builtin_backends; builtin->module_name; builtin++) {
+		EvBackendInfo *info;
+
+		info = g_new0 (EvBackendInfo, 1);
+		info->module_name = g_strdup (builtin->module_name);
+		info->resident = builtin->resident;
+		info->type_desc = g_strdup (builtin->type_desc);
+		info->mime_types = g_strdupv ((gchar **)builtin->mime_types);
+		info->builtin_register_func = builtin->register_func;
+
+		ev_backends_list = g_list_prepend (ev_backends_list, info);
+	}
+}
+
 static gboolean
 ev_backends_manager_load (void)
 {
@@ -135,12 +174,16 @@ ev_backends_manager_load (void)
 	const gchar *dirent;
 	GError      *error = NULL;
 
+	ev_backends_manager_load_builtin ();
+
 	dir = g_dir_open (backends_dir(), 0, &error);
 	if (!dir) {
-		g_warning ("%s", error->message);
+		/* no backends directory: an error only without built-in backends */
+		if (!ev_backends_list)
+			g_warning ("%s", error->message);
 		g_error_free (error);
 
-		return FALSE;
+		return ev_backends_list != NULL;
 	}
 
 	while ((dirent = g_dir_read_name (dir))) {
@@ -157,6 +200,12 @@ ev_backends_manager_load (void)
 		if (!info)
 			continue;
 
+		/* a built-in backend takes precedence over a module of the same name */
+		if (ev_backends_manager_has_module (info->module_name)) {
+			ev_backend_info_free (info);
+			continue;
+		}
+
 		ev_backends_list = g_list_prepend (ev_backends_list, info);
 	}
 
@@ -227,7 +276,10 @@ ev_backends_manager_get_document (const gchar *mime_type)
 	if (!info)
 		return NULL;
 
-	if (!info->module) {
+	if (!info->module && info->builtin_register_func) {
+		info->module = G_TYPE_MODULE (ev_module_new_builtin (info->module_name,
+								     info->builtin_register_func));
+	} else if (!info->module) {
 		gchar *path;
 
 		path = g_module_build_path (backends_dir(), info->module_name);
diff --git a/libdocument/ev-builtin-backends.h b/libdocument/ev-builtin-backends.h
new file mode 100644
index 0000000..6057f19
--- /dev/null
+++ b/libdocument/ev-builtin-backends.h
@@ -0,0 +1,50 @@
+/* this file is part of atril, a mate document viewer
+ *
+ * Document backends linked into the program (-Dbuiltin_backends=true).
+ *
+ * Atril is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Atril is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301, USA.
+ */
+
+#if !defined (ATRIL_COMPILATION)
+#error "This is a private header."
+#endif
+
+#ifndef EV_BUILTIN_BACKENDS_H
+#define EV_BUILTIN_BACKENDS_H
+
+#include <glib-object.h>
+
+#include "ev-module.h"
+
+G_BEGIN_DECLS
+
+/* One backend: what its .atril-backend file says, and its
+ * register_atril_backend () under a unique name. */
+typedef struct {
+	const gchar         *module_name;
+	gboolean             resident;
+	const gchar         *type_desc;
+	const gchar * const *mime_types;
+	EvModuleRegisterFunc register_func;
+} EvBuiltinBackend;
+
+/* Generated by backend/ev-builtin-backends.py into the program's
+ * libevbuiltinbackends; ends with a NULL module_name. A program linked
+ * without it has no built-in backends: the reference is weak. */
+extern const EvBuiltinBackend ev_builtin_backends[] __attribute__ ((weak));
+
+G_END_DECLS
+
+#endif /* EV_BUILTIN_BACKENDS_H */
diff --git a/libdocument/ev-module.c b/libdocument/ev-module.c
index 10c91c9..80c9470 100644
--- a/libdocument/ev-module.c
+++ b/libdocument/ev-module.c
@@ -58,9 +58,10 @@ struct _EvModule {
 
         gchar *path;
         GType type;
-};
 
-typedef GType (*EvModuleRegisterFunc) (GTypeModule *);
+        /* a backend linked into the program: no library to open */
+        EvModuleRegisterFunc builtin_register_func;
+};
 
 G_DEFINE_TYPE (EvModule, ev_module, G_TYPE_TYPE_MODULE)
 
@@ -70,6 +71,17 @@ ev_module_load (GTypeModule *gmodule)
         EvModule *module = EV_MODULE (gmodule);
         EvModuleRegisterFunc register_func;
 
+        if (module->builtin_register_func) {
+                module->type = module->builtin_register_func (gmodule);
+                if (module->type == 0) {
+                        g_warning ("Invalid built-in atril backend %s", module->path);
+
+                        return FALSE;
+                }
+
+                return TRUE;
+        }
+
         module->library = g_module_open (module->path, 0);
 
         if (!module->library) {
@@ -115,7 +127,8 @@ ev_module_unload (GTypeModule *gmodule)
 {
         EvModule *module = EV_MODULE (gmodule);
 
-        g_module_close (module->library);
+        if (module->library)
+                g_module_close (module->library);
 
         module->library = NULL;
         module->type = 0;
@@ -191,3 +204,23 @@ ev_module_new (const gchar *path,
 
         return result;
 }
+
+/* A backend linked into the program (built with -Dbuiltin_backends=true):
+ * loading it calls @register_func instead of opening a library. */
+EvModule *
+ev_module_new_builtin (const gchar          *name,
+		       EvModuleRegisterFunc  register_func)
+{
+        EvModule *result;
+
+	g_return_val_if_fail (name != NULL && name[0] != '\0', NULL);
+	g_return_val_if_fail (register_func != NULL, NULL);
+
+        result = g_object_new (EV_TYPE_MODULE, NULL);
+
+        g_type_module_set_name (G_TYPE_MODULE (result), name);
+        result->path = g_strconcat ("builtin:", name, NULL);
+        result->builtin_register_func = register_func;
+
+        return result;
+}
