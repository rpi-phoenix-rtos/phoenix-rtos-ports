From 42e075949331b4031b3e3a7f7da178e5b4204016 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Sun, 27 Sep 2026 21:13:56 +0200
Subject: [PATCH 1/5] build: X11, ICE/SM and mate-desktop are optional
 (Wayland-only builds)

Two new feature options, both 'auto':

  x11           x11 + ice + sm, for EggSMClient's XSMP backend. Without
                them, EggSMClient and EggDesktopFile are built from the
                bundled copy in cut-n-paste/smclient without a backend:
                egg_sm_client_get() then returns the base client, which
                never saves or restores a session (as on any system
                without a session manager). The mate-submodules
                subproject is only needed with XSMP.
  mate_desktop  libmate-desktop provides only MateImageMenuItem to
                Atril; without it, HAVE_MATE_DESKTOP is not defined and
                the shell uses GtkImageMenuItem (the widget
                MateImageMenuItem was copied from).

For GTK 3 builds with only the Wayland GDK backend (no libX11 at all).
With every dependency present the build is what it was.
---
 cut-n-paste/smclient/meson.build | 16 ++++++++++++++++
 meson.build                      | 25 ++++++++++++++++++-------
 meson_options.txt                | 10 ++++++++++
 3 files changed, 44 insertions(+), 7 deletions(-)
 create mode 100644 cut-n-paste/smclient/meson.build

diff --git a/cut-n-paste/smclient/meson.build b/cut-n-paste/smclient/meson.build
new file mode 100644
index 0000000..7c0d509
--- /dev/null
+++ b/cut-n-paste/smclient/meson.build
@@ -0,0 +1,16 @@
+# EggSMClient without a session-management backend (no X11): egg_sm_client_get()
+# returns the base client, which never saves or restores a session. Used when the
+# mate-submodules copy (XSMP) cannot be built.
+libegg = static_library(
+    'egg',
+    'libegg/eggdesktopfile.c',
+    'libegg/eggsmclient.c',
+    c_args: ['-DG_LOG_DOMAIN="EggSMClient"'],
+    include_directories: include_root,
+    dependencies: [config_h, glib, gtk],
+)
+
+mate_submodules_dep = declare_dependency(
+    link_with: libegg,
+    include_directories: include_directories('libegg'),
+)
diff --git a/meson.build b/meson.build
index bfb6cba..628902f 100644
--- a/meson.build
+++ b/meson.build
@@ -59,14 +59,20 @@ gio = dependency('gio-2.0', version: '>= 2.36.0')
 glib = dependency('glib-2.0', version: '>= ' + glib_version)
 gmodule = dependency('gmodule-2.0')
 gtk = dependency('gtk+-' + gtk_api_version, version: '>= ' + gtk_version)
-ice = dependency('ice')
-sm = dependency('sm')
-X11 = dependency('x11')
+# X11 session management (EggSMClient's XSMP backend): optional, a Wayland-only
+# build uses EggSMClient without a backend (cut-n-paste/smclient)
+X11 = dependency('x11', required: get_option('x11'))
+ice = dependency('ice', required: get_option('x11'))
+sm = dependency('sm', required: get_option('x11'))
 xml = dependency('libxml-2.0', version: '>= 2.5.0')
 zlib = dependency('zlib')
 libsecret = dependency('libsecret-1', version: '>= 0.5', required: get_option('keyring'))
 gtk_unix_print = dependency('gtk+-unix-print-3.0', version: '>= ' + gtk_version, required: get_option('gtk_unix_print'))
-mate_desktop = dependency('mate-desktop-2.0', version: '>= 1.27.1')
+# libmate-desktop provides only MateImageMenuItem here; without it GtkImageMenuItem
+mate_desktop = dependency('mate-desktop-2.0', version: '>= 1.27.1', required: get_option('mate_desktop'))
+if mate_desktop.found()
+  atril_conf.set('HAVE_MATE_DESKTOP', 1)
+endif
 
 # Backend configuration
 enabled_backend_names = []
@@ -161,9 +167,6 @@ atril_conf.set_quoted('SUPPORTED_MIMETYPES', atril_mime_types)
 # Math library
 math = cc.find_library('m', required: false)
 
-mate_submodules_dep = dependency('mate-submodules', version: '1.24.0',
-fallback: ['mate-submodules', 'mate_submodules_dep'])
-
 # Generate config.h
 config_h_file = configure_file(
   output: 'config.h',
@@ -235,6 +238,14 @@ endif
 add_project_arguments(c_args, language: 'c')
 add_project_arguments(cpp_args, language: 'cpp')
 
+if X11.found() and ice.found() and sm.found()
+  mate_submodules_dep = dependency('mate-submodules', version: '1.24.0',
+  fallback: ['mate-submodules', 'mate_submodules_dep'])
+else
+  # EggSMClient + EggDesktopFile from the bundled copy, without the XSMP backend
+  subdir('cut-n-paste/smclient')
+endif
+
 # Define shell_core_deps before including subdirectories that need it
 shell_core_deps = [
   glib,
diff --git a/meson_options.txt b/meson_options.txt
index 74f088f..f07cc64 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -40,6 +40,16 @@ option('xps',
     type: 'feature',
     description: 'Support for the xps backend'
 )
+option('x11',
+    type: 'feature',
+    value: 'auto',
+    description: 'X11 session management (XSMP: needs x11, ice, sm)'
+)
+option('mate_desktop',
+    type: 'feature',
+    value: 'auto',
+    description: 'Use MateImageMenuItem from libmate-desktop (else GtkImageMenuItem)'
+)
 option('caja',
     type: 'feature',
     description: 'Support for the Caja extension'
-- 
