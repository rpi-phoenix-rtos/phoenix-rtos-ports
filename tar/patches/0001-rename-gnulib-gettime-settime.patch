Rename gnulib's gettime()/settime() to gl_gettime()/gl_settime().

libphoenix's <sys/time.h> already declares its own, incompatible
`int gettime(time_t *raw, time_t *offs)` / `int settime(time_t offs)`.
Any TU that includes both that header and gnulib's timespec.h fails to
compile with a conflicting-types error, and the definitions would clash
at link time as well. Renaming the gnulib pair (declaration, definition
and every call site in gnu/ and src/) is the least invasive fix; the
same patch is carried by the coreutils port.

diff -Naur a/gnu/gettime.c b/gnu/gettime.c
--- a/gnu/gettime.c	2023-06-17 08:47:53.000000000 +0200
+++ b/gnu/gettime.c	2026-09-20 13:50:27.082831025 +0200
@@ -1,4 +1,4 @@
-/* gettime -- get the system clock
+/* gl_gettime -- get the system clock
 
    Copyright (C) 2002, 2004-2007, 2009-2023 Free Software Foundation, Inc.
 
@@ -26,7 +26,7 @@
 /* Get the system time into *TS.  */
 
 void
-gettime (struct timespec *ts)
+gl_gettime (struct timespec *ts)
 {
 #if defined CLOCK_REALTIME && HAVE_CLOCK_GETTIME
   clock_gettime (CLOCK_REALTIME, ts);
@@ -46,6 +46,6 @@
 current_timespec (void)
 {
   struct timespec ts;
-  gettime (&ts);
+  gl_gettime (&ts);
   return ts;
 }
