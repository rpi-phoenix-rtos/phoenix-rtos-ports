diff --git a/lib/nfs_v4.c b/lib/nfs_v4.c
index 31d89d7..8270d1b 100644
--- a/lib/nfs_v4.c
+++ b/lib/nfs_v4.c
@@ -1592,6 +1592,75 @@ nfs4_mount_2_cb(struct rpc_context *rpc, int status, void *command_data,
         }
 }
 
+/*
+ * RENEW - keep the NFSv4.0 lease alive without doing any file operation.
+ *
+ * libnfs otherwise never sends RENEW, so an idle client's lease expires (~90s on
+ * Linux nfsd) and the next stateful op fails with NFS4ERR_EXPIRED. A single-op
+ * COMPOUND carrying the client id renews the lease (RFC 7530 section 9.5). This
+ * is a Phoenix-RTOS addition (see phoenix-rtos-ports/libnfs patches).
+ */
+static void
+nfs4_renew_cb(struct rpc_context *rpc, int status, void *command_data,
+              void *private_data)
+{
+        struct nfs4_cb_data *data = private_data;
+        struct nfs_context *nfs = data->nfs;
+        COMPOUND4res *res = command_data;
+
+        assert(rpc->magic == RPC_CONTEXT_MAGIC);
+
+        if (check_nfs4_error(nfs, status, data, res, "RENEW")) {
+                return;
+        }
+
+        data->cb(0, nfs, NULL, data->private_data);
+        free_nfs4_cb_data(data);
+}
+
+int
+nfs4_renew_async(struct nfs_context *nfs, nfs_cb cb, void *private_data)
+{
+        struct nfs4_cb_data *data;
+        COMPOUND4args args;
+        nfs_argop4 op[1];
+
+        data = calloc(1, sizeof(*data));
+        if (data == NULL) {
+                nfs_set_error(nfs, "Out of memory. Failed to allocate "
+                              "nfs4_cb_data for RENEW");
+                return -1;
+        }
+        data->nfs          = nfs;
+        data->cb           = cb;
+        data->private_data = private_data;
+        /* check_nfs4_error formats data->path into its error message. */
+        data->path         = strdup("<renew>");
+        if (data->path == NULL) {
+                nfs_set_error(nfs, "Out of memory. Failed to allocate "
+                              "path for RENEW");
+                free(data);
+                return -1;
+        }
+
+        memset(op, 0, sizeof(op));
+        op[0].argop = OP_RENEW;
+        op[0].nfs_argop4_u.oprenew.clientid = nfs->nfsi->clientid;
+
+        memset(&args, 0, sizeof(args));
+        args.argarray.argarray_len = 1;
+        args.argarray.argarray_val = op;
+
+        if (rpc_nfs4_compound_task(nfs->rpc, nfs4_renew_cb, &args, data) == NULL) {
+                nfs_set_error(nfs, "Failed to queue RENEW. %s",
+                              nfs_get_error(nfs));
+                free_nfs4_cb_data(data);
+                return -1;
+        }
+
+        return 0;
+}
+
