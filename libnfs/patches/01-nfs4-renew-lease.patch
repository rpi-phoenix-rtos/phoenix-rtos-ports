+/*
+ * Sync NFSv4 lease renewal (Phoenix-RTOS addition).
+ * Sends a single RENEW operation to keep an otherwise-idle NFSv4.0 lease alive.
+ * For NFSv3 (stateless) this is a NO-OP that returns 0.
+ *
+ * Function returns
+ *      0 : The operation was successful (or NFSv3).
+ * -errno : The command failed. Notably -ERANGE with an NFS4ERR_EXPIRED /
+ *          NFS4ERR_STALE_CLIENTID string in nfs_get_error() means the lease has
+ *          already lapsed and client state must be re-established (re-mount).
+ */
+EXTERN int nfs_renew(struct nfs_context *nfs);
+
 
 
 
diff --git a/lib/libnfs-sync.c b/lib/libnfs-sync.c
index 51c4ca1..e303a94 100644
--- a/lib/libnfs-sync.c
+++ b/lib/libnfs-sync.c
@@ -425,6 +425,51 @@ nfs_umount(struct nfs_context *nfs)
 }
 
 
+/*
+ * renew the NFSv4 lease (Phoenix-RTOS addition; NO-OP for NFSv3)
+ */
+static void
+renew_cb(int status, struct nfs_context *nfs, void *data, void *private_data)
+{
+	struct sync_cb_data *cb_data = private_data;
+
+	if (status < 0) {
+		nfs_set_error(nfs, "%s: %s", __FUNCTION__, nfs_get_error(nfs));
+	}
+	cb_data_is_finished(cb_data, status);
+}
+
+int
+nfs_renew(struct nfs_context *nfs)
+{
+	struct sync_cb_data cb_data;
+	struct rpc_context *rpc = nfs_get_rpc_context(nfs);
+
+	assert(rpc->magic == RPC_CONTEXT_MAGIC);
+
+	/* NFSv3 is stateless: no lease to renew. */
+	if (nfs->nfsi->version != NFS_V4) {
+		return 0;
+	}
+
+	if (nfs_init_cb_data(&nfs, &cb_data)) {
+		return -1;
+	}
+
+	if (nfs4_renew_async(nfs, renew_cb, &cb_data) != 0) {
+		nfs_set_error(nfs, "nfs4_renew_async failed. %s",
+			      nfs_get_error(nfs));
+		nfs_destroy_cb_sem(&cb_data);
+		return -1;
+	}
+
+	wait_for_nfs_reply(nfs, &cb_data);
+	nfs_destroy_cb_sem(&cb_data);
+
+	return cb_data.status;
+}
+
+
