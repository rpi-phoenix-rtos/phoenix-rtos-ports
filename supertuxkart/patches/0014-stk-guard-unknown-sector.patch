                                      const float add_angle)
 {
-    float angle = DriveGraph::get()->getAngleToNext(sector,
-                                                    getNextSector(sector));
+    /* `sector` is unsigned, so Graph::UNKNOWN_SECTOR (-1) arrives here as
+     * 0xFFFFFFFF. DriveGraph::getNode() only guards its index with an assert(),
+     * which is compiled out under NDEBUG, so letting that through indexes far
+     * past m_all_nodes and dereferences the garbage as a Node*. Check before
+     * handing the value to the graph. */
+    const DriveGraph *graph = DriveGraph::get();
+    if (graph == NULL || sector >= graph->getNumNodes())
+    {
+        /* No usable graph direction this frame: hold the current heading and
+         * apply only the caller's adjustment. */
+        float held = (m_kart->getBlockedByPlungerTicks() > 0)
+                   ? add_angle * 0.2f
+                   : add_angle;
+        return normalizeAngle(held);
+    }
+
+    float angle = graph->getAngleToNext(sector,
+                                        getNextSector(sector));
 
     //Desired angle minus current angle equals how many angles to turn
     float steer_angle = angle - m_kart->getHeading();
