     /** Returns the i-th successor node. */
+    // PHOENIX: this was a raw vector index with NO bounds check -- not even an
+    // assert, unlike DriveGraph::getNode(). An out-of-range i reads
+    // m_successor_nodes out of bounds and returns garbage, which callers then
+    // use as a NODE index: DriveGraph::determineDirection() does exactly that,
+    // feeding getSuccessor()'s result straight into getAngleToNext() ->
+    // getNode(). That is how a wild index reached getNode and faulted on
+    // hardware (far=0x20a0ca76c).
+    //
+    // getNode() is now clamped (patch 0017), so the crash is already contained;
+    // this check exists to name the ACTUAL defect one level up -- "successor i
+    // out of range on a node with n successors" -- instead of reporting the
+    // laundered index that arrives at getNode.
+    //
+    // Returning 0 keeps the caller on a valid node; reporting once keeps the
+    // out-of-range index visible, since it is still unexplained.
     unsigned int getSuccessor(unsigned int i)  const
-                                               { return m_successor_nodes[i]; }
+    {
+        if (i >= m_successor_nodes.size())
+        {
+            static bool reported = false;
+            if (!reported)
+            {
+                reported = true;
+                printf("stk: DriveNode::getSuccessor(%u) out of range"
+                       " (%u successors) -- returning 0\n",
+                       i, (unsigned int)m_successor_nodes.size());
+            }
+            return 0;
+        }
+        return m_successor_nodes[i];
+    }
