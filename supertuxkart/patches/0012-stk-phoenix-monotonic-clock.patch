@@ -105,10 +108,38 @@
      */
     static uint64_t getMonoTimeMs()
     {
+#ifdef __phoenix__
+        // libstdc++ for aarch64-phoenix is configured with NONE of its time
+        // backends: _GLIBCXX_USE_CLOCK_MONOTONIC, _GLIBCXX_USE_CLOCK_REALTIME
+        // and _GLIBCXX_USE_GETTIMEOFDAY are all #undef in c++config.h. So
+        // std::chrono::steady_clock falls back to std::time() and advances in
+        // whole SECONDS. MainLoop::getLimitedDt() then sits in
+        //     while (dt == 0) { StkTime::sleep(1); dt = ...getMonoTimeMs(); }
+        // waiting for the second to roll over, which pins the whole game to
+        // exactly ONE FRAME PER SECOND regardless of scene, resolution or
+        // render settings -- measured at 1000.0 ms/frame +/-0.08% with only
+        // ~150 ms of GPU and ~23 ms of physics in it.
+        // The POSIX monotonic clock does have real resolution here, so read it
+        // directly. Start offset is captured lazily; callers only ever take
+        // differences, and init() cannot be relied on to run first for the
+        // Phoenix path.
+        struct timespec ts;
+        static uint64_t phoenix_start_ms = 0;
+        uint64_t now_ms;
+
+        if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+            return 0;
+        now_ms = (uint64_t)ts.tv_sec * 1000ull
+               + (uint64_t)ts.tv_nsec / 1000000ull;
+        if (phoenix_start_ms == 0)
+            phoenix_start_ms = now_ms;
+        return now_ms - phoenix_start_ms;
+#else
         auto duration = std::chrono::steady_clock::now() - m_mono_start;
         auto value =
             std::chrono::duration_cast<std::chrono::milliseconds>(duration);
         return value.count();
+#endif
     }
