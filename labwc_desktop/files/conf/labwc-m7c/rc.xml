<?xml version="1.0"?>
<!--
  labwc on Phoenix-RTOS (new GPU lane, M7 m7c-desktop): stage as /etc/xdg/labwc-m7c/rc.xml
  (the m7a/m7b configuration in /etc/xdg/labwc/ stays as registered).
  labwc's built-in theme (no theme directory on the export), DejaVu Sans through
  fontconfig, server-side decorations, the Openbox-style default key and mouse
  bindings plus a terminal on Super+Return, mc on Super+E, the fuzzel launcher on
  Super+D and Alt+F2.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow" name="DejaVu Sans" size="11" weight="bold" />
    <font place="InactiveWindow" name="DejaVu Sans" size="11" />
    <font place="MenuItem" name="DejaVu Sans" size="11" />
    <font place="OnScreenDisplay" name="DejaVu Sans" size="11" />
  </theme>

  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="/bin/foot" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="/bin/foot -e /bin/mc" />
    </keybind>
    <!-- the launcher -->
    <keybind key="W-d">
      <action name="Execute" command="/bin/fuzzel" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="/bin/fuzzel" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

</labwc_config>
