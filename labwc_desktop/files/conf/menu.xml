<?xml version="1.0" encoding="UTF-8"?>
<!--
  labwc root menu on Phoenix-RTOS (M7): stage as /etc/xdg/labwc/menu.xml.
  Right click on the desktop opens it.
-->
<openbox_menu>

<menu id="client-menu">
  <item label="Minimize"><action name="Iconify" /></item>
  <item label="Maximize"><action name="ToggleMaximize" /></item>
  <item label="Fullscreen"><action name="ToggleFullscreen" /></item>
  <item label="Decorations"><action name="ToggleDecorations" /></item>
  <item label="Always on Top"><action name="ToggleAlwaysOnTop" /></item>
  <item label="Close"><action name="Close" /></item>
</menu>

<menu id="root-menu">
  <item label="Terminal">
    <action name="Execute" command="/bin/foot" />
  </item>
  <item label="Files">
    <!-- Midnight Commander in a terminal (TERM=xterm-256color from foot.ini:
         Phoenix's ncurses has it compiled in, no terminfo files needed) -->
    <action name="Execute" command="/bin/foot -e /bin/mc" />
  </item>
  <item label="File Manager (GUI)">
    <!-- Thunar on GTK3 Wayland: built by the gtk3-wayland port (not yet staged) -->
    <action name="Execute" command="/bin/thunar" />
  </item>
  <separator />
  <item label="Reconfigure"><action name="Reconfigure" /></item>
  <item label="Exit"><action name="Exit" /></item>
</menu>

</openbox_menu>
