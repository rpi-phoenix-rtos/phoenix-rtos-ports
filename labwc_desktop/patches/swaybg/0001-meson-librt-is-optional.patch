From 55401615b6a269cc9cdf86defd0c67243cd7e342 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 17:27:59 +0200
Subject: [PATCH] meson: librt is optional

Phoenix-RTOS has no librt: its clock and shm functions live in libc.
---
 meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index de0452c..8cd9661 100644
--- a/meson.build
+++ b/meson.build
@@ -27,7 +27,7 @@ if is_freebsd
 	add_project_arguments('-D_C11_SOURCE', language: 'c')
 endif
 
-rt = cc.find_library('rt')
+rt = cc.find_library('rt', required: false)
 
 wayland_client = dependency('wayland-client')
 wayland_protos = dependency('wayland-protocols', version: '>=1.31')
-- 
2.53.0

