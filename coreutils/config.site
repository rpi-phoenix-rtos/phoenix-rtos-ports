# cross-compile common answers
ac_cv_func_malloc_0_nonnull=yes
ac_cv_func_realloc_0_nonnull=yes
ac_cv_func_malloc_0_nonnull_gnu=yes
ac_cv_func_realloc_0_nonnull_gnu=yes
gl_cv_func_malloc_0_nonnull=1
gl_cv_func_realloc_0_nonnull=1
ac_cv_func_working_mktime=yes
gl_cv_func_working_mkstemp=yes
gl_cv_func_working_mktime=yes
# chown/lchown work fine on Phoenix -> don't compile gnulib replacement
gl_cv_func_chown_slash_works=yes
gl_cv_func_chown_ctime_works=yes
gl_cv_func_chown_works=yes
gl_cv_func_lchown_works=yes
ac_cv_func_getrlimit=yes
ac_cv_func_setrlimit=yes
# AC_FUNC_CHOWN cross-guess is "broken"; Phoenix chown honors -1 and works
ac_cv_func_chown_works=yes
gl_cv_func_chown_follows_symlink=yes
# statfs()/fstatfs() + <sys/statfs.h>/<sys/vfs.h> added to libphoenix (session 47);
# cross func-checks can't run, so assert them here. struct-member detection is
# compile-time and works cross, so leave those to configure.
ac_cv_func_statfs=yes
ac_cv_func_fstatfs=yes
ac_cv_header_sys_statfs_h=yes
ac_cv_header_sys_vfs_h=yes
