+ * INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS, IN NO
+ * EVENT SHALL THE COPYRIGHT HOLDERS BE LIABLE FOR ANY SPECIAL, INDIRECT OR
+ * CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE,
+ * DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER
+ * TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE
+ * OF THIS SOFTWARE.
+ */
+
+#if HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include <sched.h>
+#include <unistd.h>
+
+#include "xshmfenceint.h"
+
+/* See xshmfence_phoenix.h for the design. */
+
+static inline void
+cpu_relax(void)
+{
+#if defined(__aarch64__) || defined(__arm__)
+	__asm__ __volatile__("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(__i386__)
+	__asm__ __volatile__("pause" ::: "memory");
+#else
+	__asm__ __volatile__("" ::: "memory");
+#endif
+}
+
+/**
+ * xshmfence_trigger:
+ * @f: An X fence
+ *
+ * Set @f to triggered. Waiters poll, so there is nobody to wake.
+ *
+ * Return value: 0.
+ **/
+int
+xshmfence_trigger(struct xshmfence *f)
+{
+	__atomic_store_n(&f->v, 1, __ATOMIC_RELEASE);
+	return 0;
+}
+
+/**
+ * xshmfence_await:
+ * @f: An X fence
+ *
+ * Wait for @f to be triggered. If @f is already triggered, this
+ * function returns immediately.
+ *
+ * Return value: 0.
+ **/
+int
+xshmfence_await(struct xshmfence *f)
+{
+	unsigned int n = 0;
+	useconds_t us = XSHMFENCE_POLL_MIN_US;
+
+	while (__atomic_load_n(&f->v, __ATOMIC_ACQUIRE) != 1) {
+		if (n < XSHMFENCE_POLL_SPIN) {
+			cpu_relax();
+		}
+		else if (n < XSHMFENCE_POLL_SPIN + XSHMFENCE_POLL_YIELD) {
+			sched_yield();
+		}
+		else {
+			usleep(us);
+			if (us < XSHMFENCE_POLL_MAX_US) {
+				us *= 2;
+				if (us > XSHMFENCE_POLL_MAX_US)
+					us = XSHMFENCE_POLL_MAX_US;
+			}
+		}
+		if (n < XSHMFENCE_POLL_SPIN + XSHMFENCE_POLL_YIELD)
+			n++;
+	}
+	return 0;
+}
+
+/**
+ * xshmfence_query:
+ * @f: An X fence
+ *
+ * Return value: 1 if @f is triggered, else returns 0.
+ **/
+int
+xshmfence_query(struct xshmfence *f)
+{
+	return __atomic_load_n(&f->v, __ATOMIC_ACQUIRE) == 1;
+}
+
+/**
+ * xshmfence_reset:
+ * @f: An X fence
+ *
+ * Reset @f to untriggered. If @f is already untriggered,
+ * this function has no effect.
+ **/
+void
+xshmfence_reset(struct xshmfence *f)
+{
+	__atomic_store_n(&f->v, 0, __ATOMIC_RELEASE);
+}
+
+#ifdef __phoenix__
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/msg.h>
+
+#include "shm_proto.h"   /* the shmsrv wire protocol (new GPU lane) */
+
+int
+xshmfence_phoenix_alloc_shm(void)
+{
+	static int warned;
+	oid_t oid;
+	msg_t msg;
+	shmsrv_create_req_t req = { .op = SHMSRV_OP_CREATE, .proto = SHMSRV_PROTO };
+	shmsrv_create_rsp_t rsp;
+	char path[32];
+
+	if (lookup(SHMSRV_NS, NULL, &oid) < 0) {
+		if (!warned) {
+			warned = 1;
+			fprintf(stderr, "xshmfence: no shmsrv (" SHMSRV_NS "): falling back to a " SHMDIR
+				" file, which is NOT coherent across processes on Phoenix-RTOS once its id is reused\n");
+		}
+		return -1;
+	}
+	memset(&msg, 0, sizeof(msg));
+	msg.type = mtDevCtl;
+	msg.oid.port = oid.port;
+	msg.oid.id = 0;
+	memcpy(msg.i.raw, &req, sizeof(req));
+	if (msgSend(oid.port, &msg) < 0)
+		return -1;
+	memcpy(&rsp, msg.o.raw, sizeof(rsp));
+	if (rsp.err < 0) {
+		errno = -rsp.err;
+		return -1;
+	}
+	(void)snprintf(path, sizeof(path), SHMSRV_NS "/%u", (unsigned)rsp.id);
+	return open(path, O_RDWR | O_CLOEXEC);
+}
+
+#endif /* __phoenix__ */
