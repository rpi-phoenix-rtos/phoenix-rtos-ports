+ * DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER
+ * TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE
+ * OF THIS SOFTWARE.
+ */
+
+#ifndef _XSHMFENCE_PHOENIX_H_
+#define _XSHMFENCE_PHOENIX_H_
+
+#include <stdint.h>
+
+/*
+ * Phoenix-RTOS backend. The kernel has no futex and libphoenix's mutexes and
+ * condition variables are per-process kernel handles, so neither the futex nor
+ * the pthread backend can synchronise two processes. A fence is one 32-bit
+ * word in memory both processes map (0 = untriggered, 1 = triggered); trigger,
+ * reset and query are single atomic accesses, await polls with a bounded
+ * back-off (spin, yield, then sleeps of XSHMFENCE_POLL_MIN_US doubling up to
+ * XSHMFENCE_POLL_MAX_US). Only clients await (the X server triggers, resets and
+ * queries), and a client normally awaits a fence the server has already
+ * triggered, so the back-off is rarely entered.
+ *
+ * The word must live in memory that every mapping sees coherently: the backing
+ * object comes from the shmsrv server (/shm, the memfd_create() stand-in of the
+ * new GPU lane), whose pages are the same physical, cached pages in every
+ * process. A /tmp file is not safe on Phoenix-RTOS (the kernel keys a file's
+ * pages by the file id, which the RAM file system reuses), so it is only a
+ * fallback with a warning.
+ */
+
+#ifndef XSHMFENCE_POLL_SPIN
+#define XSHMFENCE_POLL_SPIN   64      /* busy iterations before the first yield */
+#endif
+#ifndef XSHMFENCE_POLL_YIELD
+#define XSHMFENCE_POLL_YIELD  16      /* sched_yield() calls before the first sleep */
+#endif
+#ifndef XSHMFENCE_POLL_MIN_US
+#define XSHMFENCE_POLL_MIN_US 50
+#endif
+#ifndef XSHMFENCE_POLL_MAX_US
+#define XSHMFENCE_POLL_MAX_US 1000
+#endif
+
+struct xshmfence {
+    int32_t     v;
+};
+
+/* ftruncate() zero-fills: a fresh fence is untriggered, nothing to write. */
+#define xshmfence_init(fd)
+
+/* A descriptor of a fresh shmsrv object (size 0), or -1 when no shmsrv runs. */
+int
+xshmfence_phoenix_alloc_shm(void);
+
+#endif /* _XSHMFENCE_PHOENIX_H_ */
