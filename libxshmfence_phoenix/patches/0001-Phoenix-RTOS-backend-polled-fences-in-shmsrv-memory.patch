index 178cbdd..3bb9b62 100644
--- a/src/xshmfenceint.h
+++ b/src/xshmfenceint.h
@@ -36,4 +36,8 @@
 #include "xshmfence_pthread.h"
 #endif
 
+#if HAVE_PHOENIX_FENCE
+#include "xshmfence_phoenix.h"
+#endif
+
 #endif /* _XSHMFENCEINT_H_ */
