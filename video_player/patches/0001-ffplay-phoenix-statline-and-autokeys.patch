+/*
+ * Phoenix-RTOS (M10), two opt-in knobs read from the environment:
+ *   FFPLAY_STATLINE_MS=<ms>  every <ms>, one newline-terminated "ffplay-stat" line (instead of
+ *                            the \r status line, which a serial console log cannot split) with
+ *                            the count of frames shown and the fps since the previous line
+ *   FFPLAY_AUTOKEYS=<s>:<key>[,<s>:<key>...]  at <s> seconds of wall time after the first
+ *                            refresh, push that key press through the normal event loop
+ *                            (keys: pause fs left right up down step quit), so an unattended
+ *                            run exercises the same controls as a keyboard
+ */
+static void phx_init(void)
+{
+    const char *e;
+
+    if (phx_stat_us >= 0)
+        return;
+    e = getenv("FFPLAY_STATLINE_MS");
+    phx_stat_us = e ? FFMAX(atoi(e), 0) * 1000LL : 0;
+    e = getenv("FFPLAY_AUTOKEYS");
+    phx_keys = e ? av_strdup(e) : NULL;
+    phx_t0 = av_gettime_relative();
+}
+
+static void phx_statline(VideoState *is)
+{
+    static int64_t last_us, last_shown;
+    int64_t now = av_gettime_relative();
+    double av_diff = 0;
+    int w = 0, h = 0;
+
+    if (phx_stat_us <= 0 || (last_us && now - last_us < phx_stat_us))
+        return;
+    if (is->audio_st && is->video_st)
+        av_diff = get_clock(&is->audclk) - get_clock(&is->vidclk);
+    if (window)
+        SDL_GetWindowSize(window, &w, &h);
+    av_log(NULL, AV_LOG_INFO, "ffplay-stat t=%.2f clock=%.2f av=%.3f shown=%"PRId64" fps=%.1f "
+           "drop_early=%d drop_late=%d aq=%dKB vq=%dKB paused=%d fs=%d win=%dx%d\n",
+           (now - phx_t0) / 1000000.0, get_master_clock(is), av_diff, is->frames_shown,
+           last_us ? (is->frames_shown - last_shown) * 1000000.0 / (now - last_us) : 0.0,
+           is->frame_drops_early, is->frame_drops_late, is->audioq.size / 1024, is->videoq.size / 1024,
+           is->paused, is_full_screen, w, h);
+    last_us = now;
+    last_shown = is->frames_shown;
+}
+
+static void phx_autokeys(VideoState *is)
+{
+    static const struct { const char *name; SDL_Keycode sym; } keys[] = {
+        { "pause", SDLK_SPACE }, { "fs", SDLK_f }, { "left", SDLK_LEFT }, { "right", SDLK_RIGHT },
+        { "up", SDLK_UP }, { "down", SDLK_DOWN }, { "step", SDLK_s }, { "quit", SDLK_q },
+    };
+    char *p = phx_keys, *colon, *end;
+    double at;
+    SDL_Event ev;
+    int i;
+
+    /* key events are ignored until the window exists (event_loop) */
+    if (!p || !*p || !is->width)
+        return;
+    at = strtod(p, &colon);
+    if (colon == p || *colon != ':') {
+        av_log(NULL, AV_LOG_ERROR, "ffplay-auto bad schedule at '%s'\n", p);
+        *p = '\0';
+        return;
+    }
+    if ((av_gettime_relative() - phx_t0) / 1000000.0 < at)
+        return;
+    end = strchr(colon + 1, ',');
+    if (end)
+        *end = '\0';
+    for (i = 0; i < FF_ARRAY_ELEMS(keys); i++)
+        if (!strcmp(colon + 1, keys[i].name))
+            break;
+    if (i == FF_ARRAY_ELEMS(keys)) {
+        av_log(NULL, AV_LOG_ERROR, "ffplay-auto unknown key '%s'\n", colon + 1);
+    } else {
+        memset(&ev, 0, sizeof(ev));
+        ev.type = SDL_KEYDOWN;
+        ev.key.keysym.sym = keys[i].sym;
+        SDL_PushEvent(&ev);
+        av_log(NULL, AV_LOG_INFO, "ffplay-auto t=%.2f key=%s clock=%.2f\n",
+               (av_gettime_relative() - phx_t0) / 1000000.0, keys[i].name, get_master_clock(is));
+    }
+    if (end)
+        memmove(p, end + 1, strlen(end + 1) + 1);
+    else
+        *p = '\0';
+}
+
