+#if CONFIG_HEVC_RPIVID_DECODER
+/* Leave the rpivid block for the rest of the stream. The pictures it decoded are in
+ * system memory, so they serve the CPU decoder as references. */
+static void rpivid_fallback(HEVCContext *s, const char *why)
+{
+    av_log(s->avctx, AV_LOG_WARNING, "rpivid: continuing on the CPU decoder (%s)\n", why);
+    ff_hwaccel_uninit(s->avctx);
+    s->rpivid_failed = 1;
+}
+#endif
+
