+#if CONFIG_HEVC_RPIVID_DECODER
+/* At an IRAP after leaving the block: take it again, a bounded number of times per stream
+ * (FFMPEG_RPIVID_RETRIES, default 3; a refusal or failure each time costs the pictures up to
+ * the next IRAP); not under frame threads, whose contexts share the hwaccel state */
+static void rpivid_retry(HEVCContext *s)
+{
+    const char *e = getenv("FFMPEG_RPIVID_RETRIES");
+    int max = (e && *e) ? atoi(e) : 3, a;
+
+    if (!s->rpivid_failed || !s->rpivid_retry || s->avctx->hwaccel || !IS_IRAP(s) || !s->sh.first_slice_in_pic_flag)
+        return;
+    s->rpivid_retry = 0;
+    if (s->avctx->active_thread_type & FF_THREAD_FRAME) {
+        av_log(s->avctx, AV_LOG_INFO, "rpivid: the block stays off for this stream (frame threads)\n");
+        return;
+    }
+    if (s->rpivid_retries >= max) {
+        av_log(s->avctx, AV_LOG_INFO, "rpivid: the block stays off for this stream (%d retries used)\n", s->rpivid_retries);
+        return;
+    }
+    s->rpivid_retries++;
+    a = ff_rpivid_hevc_attach(s->avctx, s->rpivid_level, s->rpivid_out);
+    if (a < 0) {
+        av_log(s->avctx, AV_LOG_INFO, "rpivid: the block stays off for this stream (it did not take the stream again)\n");
+        return;
+    }
+    s->rpivid_failed = 0;
+    s->max_ra = INT_MAX;   /* a CRA's RASL pictures reference pictures the CPU decoded: dropped */
+    if (a == 1) {
+        s->avctx->sw_pix_fmt = s->avctx->pix_fmt;
+        s->avctx->pix_fmt = AV_PIX_FMT_DRM_PRIME;
+    }
+    av_log(s->avctx, AV_LOG_INFO, "rpivid: back on the block from POC %d (retry %d of %d)\n", s->poc, s->rpivid_retries, max);
+}
+
+/* Leave the rpivid block for the rest of the stream, on the CPU decoder. Its pictures lack
+ * what the CPU decoder keeps of a picture it decoded (the motion field TMVP reads), so a
+ * picture predicted from them would be wrong: unless the current picture is an IRAP (drop:
+ * 0), it is dropped, and so is every picture up to the next IRAP (and the RASL pictures of a
+ * CRA); the caller shows the last picture it got until then. The pictures the decoder holds
+ * stay valid for output (drm_prime output: they are copied into system memory first). */
+static int rpivid_fallback(HEVCContext *s, const char *why, int drop)
+{
+    int zc = ff_rpivid_hevc_zero_copy(s->avctx), ret = 0;
+
+    av_log(s->avctx, AV_LOG_WARNING, "rpivid: continuing on the CPU decoder (%s)%s\n", why,
+           drop ? ": pictures dropped until the next random access point" : "");
+    ff_hwaccel_uninit(s->avctx);
+    s->rpivid_failed = 1;
+    if (drop) {
+        if (s->ref) {
+            /* without reordering the picture went to the output at its start */
+            if (s->output_frame->buf[0] && s->ref->frame->buf[0] &&
+                s->output_frame->buf[0]->buffer == s->ref->frame->buf[0]->buffer)
+                av_frame_unref(s->output_frame);
+            ff_hevc_unref_frame(s->ref, ~0);
+        }
+        s->ref = s->collocated_ref = NULL;
+        s->is_decoded = 0;
+        s->rpivid_skip = 1;
+        s->rpivid_retry = 1;
+        s->max_ra = INT_MAX;   /* the RASL pictures of the next CRA reference what was dropped */
+    } else {
+        s->rpivid_retry = 1;   /* the block again at the IRAP after this one */
+        if (s->nal_unit_type == HEVC_NAL_CRA_NUT)
+            s->max_ra = s->poc;    /* this CRA's RASL pictures reference the block's pictures */
+    }
+    if (zc && (ret = ff_rpivid_hevc_drm_to_cpu(s->avctx)) < 0)
+        av_log(s->avctx, AV_LOG_ERROR, "rpivid: the pictures held could not be moved to system memory\n");
+    return ret;
+}
