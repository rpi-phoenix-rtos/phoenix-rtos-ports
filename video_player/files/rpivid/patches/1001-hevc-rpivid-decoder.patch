+        if (s->sh.first_slice_in_pic_flag && ff_rpivid_hevc_active(s->avctx) &&
+            ff_rpivid_hevc_picture_ok(s->avctx) < 0)
+            rpivid_fallback(s, "a picture the block cannot decode");
+#endif
