+            else if (s->ref)
+                s->is_decoded = 1; /* a system memory picture: the SEI checksum applies */
+        }
+#endif
+    }
+    if (!avctx->hwaccel || (CONFIG_HEVC_RPIVID_DECODER && s->is_decoded)) {
         /* verify the SEI checksum */
         if (avctx->err_recognition & AV_EF_CRCCHECK && s->ref && s->is_decoded &&
             s->sei.picture_hash.is_md5) {
@@ -3555,6 +3595,8 @@ static int hevc_update_thread_context(AVCodecContext *dst,
         if ((ret = set_sps(s, s0->ps.sps, src->pix_fmt)) < 0)
