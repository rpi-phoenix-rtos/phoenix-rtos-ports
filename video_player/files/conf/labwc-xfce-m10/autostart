# labwc autostart of the M10 desktop cycles (docs/gpu-new-lane/M10-video-player.md, m10b):
# the XFCE demo session's own autostart (/etc/xdg/labwc-xfce-demo/autostart) plus one
# one video player once the panel and Thunar are up. Stage the directory as
# /usr/share/m10/labwc-xfce-m10/ with rc.xml, menu.xml and environment copied from
# /etc/xdg/labwc-xfce-demo/, and run the session with CONF_DIR pointing at it. labwc runs this
# with `sh` (busybox); video-play's output goes to labwc's stdout, the console.
#   M10_CLIP    the file (default /usr/share/m10/m10-h264-720p30-aac.mp4)
#   M10_DELAY   seconds before it starts (default 45: the panel and Thunar first)
#   M10_PLAYER  ffplay (default: /bin/video-play -> ffplay-wl) | gtk (/usr/bin/gtk-video --autoexit)
# FFPLAY_AUTOKEYS, GTK_VIDEO_AUTOKEYS, THREADS, LOOP, FS ... pass through from the session's
# environment.
/usr/lib/xfce-demo/bin/xfdesktop > /tmp/xfce-logs/xfdesktop.log 2>&1 &
/usr/lib/xfce-demo/bin/xfce4-panel > /tmp/xfce-logs/xfce4-panel.log 2>&1 &
( sleep "${M10_DELAY:-45}"; clip="${M10_CLIP:-/usr/share/m10/m10-h264-720p30-aac.mp4}"
  if [ "${M10_PLAYER:-ffplay}" = gtk ]; then exec /usr/bin/gtk-video --autoexit "${clip}"; fi
  exec /bin/bash /bin/video-play "${clip}" ) &
