Phoenix-RTOS: wire the phoenix audio driver into the build (new GPU lane).

Adapted from ports/sdl2 patches/0006-cmake-phoenix-audio-driver.patch: the
same PHOENIX-branch hunk, config define and bootstrap entry, rebased onto a
tree WITHOUT the old lane's phoenix video driver (its 0005), which this build
does not carry -- video is SDL's stock KMSDRM driver here (patch 0006).

The driver itself (src/audio/phoenix/, copied verbatim from the ports/sdl2
overlay by the build's overlay step) is a pull-model backend over the
rpi4-audio node /dev/audio0: SDL's audio thread fills the mixing buffer via
the app callback, PlayDevice write()s it; the device's fixed native format is
44100 Hz / stereo / S16LE and its blocking write() provides backpressure.
Pure zlib, no link dependency.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1474,6 +1474,17 @@
   endif()
   CheckPTHREAD()
 
+  # Phoenix-RTOS audio driver: a pull-model backend over the rpi4-audio device
+  # node /dev/audio0 (src/audio/phoenix/, copied in by the build's overlay step).
+  # The device is PIO with a fixed native format (44100 Hz, stereo, S16LE); its
+  # blocking write() provides the backpressure. Pure zlib, no link dependency.
+  if(SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_PHOENIX 1)
+    file(GLOB AUDIO_PHOENIX_SOURCES ${SDL2_SOURCE_DIR}/src/audio/phoenix/*.c)
+    list(APPEND SOURCE_FILES ${AUDIO_PHOENIX_SOURCES})
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
   if(SDL_AUDIO)
     if(SYSV5 OR SOLARIS OR HPUX)
--- a/include/SDL_config.h.cmake
+++ b/include/SDL_config.h.cmake
@@ -301,6 +301,7 @@
 #cmakedefine SDL_AUDIO_DRIVER_DISK @SDL_AUDIO_DRIVER_DISK@
 #cmakedefine SDL_AUDIO_DRIVER_DSOUND @SDL_AUDIO_DRIVER_DSOUND@
 #cmakedefine SDL_AUDIO_DRIVER_DUMMY @SDL_AUDIO_DRIVER_DUMMY@
+#cmakedefine SDL_AUDIO_DRIVER_PHOENIX @SDL_AUDIO_DRIVER_PHOENIX@
 #cmakedefine SDL_AUDIO_DRIVER_EMSCRIPTEN @SDL_AUDIO_DRIVER_EMSCRIPTEN@
 #cmakedefine SDL_AUDIO_DRIVER_ESD @SDL_AUDIO_DRIVER_ESD@
 #cmakedefine SDL_AUDIO_DRIVER_ESD_DYNAMIC @SDL_AUDIO_DRIVER_ESD_DYNAMIC@
--- a/src/audio/SDL_audio.c
