+#elif defined SDL_INPUT_PHOENIX
+#include "../../core/phoenix/SDL_phoenixhid.h"
 #endif
 
 /* KMS/DRM declarations */
@@ -1318,6 +1320,8 @@
     SDL_EVDEV_SetVTSwitchCallbacks(KMSDRM_ReleaseVT, _this, KMSDRM_AcquireVT, _this);
 #elif defined(SDL_INPUT_WSCONS)
     SDL_WSCONS_Init();
+#elif defined(SDL_INPUT_PHOENIX)
