<?xml version="1.0"?>
<!--
  labwc under the games desktop session on Phoenix-RTOS (XFCE + windowed GPU games,
  /bin/xfce-session with CONF_DIR=/etc/xdg/labwc-xfce-games): /etc/xdg/labwc-xfce-games/rc.xml.
  labwc-xfce-demo/rc.xml plus window rules that lay the desktop out (Thunar top left, foot
  below it, the game window on the right: 1280x720 content next to a 620 px wide left column
  on the 1920x1080 output, under the 30 px panel) and Super+G = Quake in a window.
    Super (tap)             application finder
    Super+Return            terminal (foot)
    Super+E                 file manager (Thunar)
    Super+D, Alt+F2         application finder (full / collapsed)
    Super+Space             fuzzel launcher
  labwc's defaults (<default />) stay: Alt+Tab, Alt+F4, window-menu keys and mouse bindings.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow" name="DejaVu Sans" size="11" weight="bold" />
    <font place="InactiveWindow" name="DejaVu Sans" size="11" />
    <font place="MenuItem" name="DejaVu Sans" size="11" />
    <font place="OnScreenDisplay" name="DejaVu Sans" size="11" />
  </theme>

  <keyboard>
    <default />
    <!-- a tap of Super alone: labwc runs onRelease bindings only if no other key came in between -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="/bin/xfce4-appfinder" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="/bin/foot" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="/bin/thunar-wl" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="/bin/xfce4-appfinder" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="/bin/xfce4-appfinder --collapsed" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/bin/fuzzel" />
    </keybind>
    <keybind key="W-g">
      <action name="Execute" command="/bin/bash /bin/game-window.sh quakespasm" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <!-- identifier = the Wayland app_id (a case-insensitive glob): the first Thunar window and
       the first foot, and the SDL_VIDEO_WAYLAND_WMCLASS /bin/game-window.sh gives each game -->
  <windowRules>
    <windowRule identifier="*thunar*" matchOnce="true">
      <action name="ResizeTo" width="620" height="560" />
      <action name="MoveTo" x="8" y="40" />
    </windowRule>
    <windowRule identifier="foot" matchOnce="true">
      <action name="ResizeTo" width="620" height="420" />
      <action name="MoveTo" x="8" y="640" />
    </windowRule>
    <windowRule identifier="quakespasm">
      <action name="MoveTo" x="636" y="40" />
    </windowRule>
    <windowRule identifier="quake2">
      <action name="MoveTo" x="636" y="40" />
    </windowRule>
    <windowRule identifier="quake3">
      <action name="MoveTo" x="636" y="40" />
    </windowRule>
    <windowRule identifier="stk">
      <action name="MoveTo" x="636" y="40" />
    </windowRule>
  </windowRules>

</labwc_config>
