# shellcheck shell=bash
#
# Shared link-and-verify body of the yquake2_drm and quake3_drm ports (sourced from
# ${PORT_DEP_sdl2_kmsdrm}/share/gamedrm/): link an SDL2 GL game's engine objects (compiled by
# its engine port, a `depends` of the caller) on the GPU stack -- SDL 2.30.12 with its KMSDRM
# AND Wayland video drivers (sdl2_kmsdrm), Mesa 26.2 GBM + EGL on the drm and wayland
# platforms + GLES/GL (mesa_drm, its opengl build: libSDL2.a was configured against it), the
# Wayland client stack and libdrm-phoenix: sdl2_kmsdrm's link-inputs.txt -- then build the
# game's launcher. ONE program: full screen on KMS from psh (no compositor socket: SDL falls
# through to KMSDRM), a window on the desktop with SDL_VIDEODRIVER=wayland (/bin/game-window.sh).
#
# The ports framework version of the coordination repo's
# tools/gpu-lane/sdl2-drm/gamedrm/relink-sdl-gl-game.sh. Until GPU migration P3 the engine ports
# linked a program of their own on the first GPU stack and this body took that link line from
# their build.log (with a byte-identical control relink); now they only compile, and publish
# their link inputs in port-sources/<G_PORTDIR>/engine-link.sh.
#
# The caller sets:
#   G_APP            program name, e.g. quake2-drm (tag of every log line, banner, flipstat)
#   G_ENGINE         the engine's name; the program is <G_ENGINE>-drm (/usr/bin/<G_ENGINE>-drm)
#   G_PORTDIR        port-sources/<dir> of the engine port (<name>-<version>); its engine-link.sh
#                    gives ENGINE_OBJS (link order), ENGINE_LINK_FLAGS (the engine port's
#                    ${CFLAGS} ${LDFLAGS}) and ENGINE_LINK_TAIL (-lstdc++ -lm, the stack size)
#   G_GL             gles (libGLESv2 + shared glapi, the stk-drm shape) or
#                    gl (libglapi_bridge's desktop gl* entry points, the quakespasm-drm shape)
#   G_API_TEXT       banner text for the API ("GLES" / "desktop GL")
#   G_LAUNCHER_SRC   the launcher's source (the calling port's glue/); it execs /usr/bin/<G_ENGINE>,
#                    rewritten here to /usr/bin/<G_ENGINE>-drm
#   G_LAUNCHER       the launcher's name, the command users type; installed as /usr/bin/<G_LAUNCHER>
#   G_ENGINE_SYMS    engine symbols that must be present in the program (sanity)
#
# HOW:
#   1. compile gamedrm_hooks.c (banner, the `<app> flipstat`
#      frame counter behind -Wl,--wrap=SDL_GL_SwapWindow);
#   2. link: <gcc> ENGINE_LINK_FLAGS ENGINE_OBJS hooks.o, libgallium whole-archive + one group
#      of libSDL2.a, the Mesa EGL/GBM/dri_gbm/<GLES|bridge>/glapi/v3d/broadcom/winsys/util
#      archives ("mesa-es" or "mesa-gl" of link-inputs.txt), the Wayland client libraries,
#      libdrm.a, the compat shim and zlib ("tail"), ENGINE_LINK_TAIL, -static, the group's flags
#      (--wrap=mmap/ioctl for libdrm-phoenix, --wrap=close/write for the Wayland compat layer)
#      and -Wl,--wrap=SDL_GL_SwapWindow. The command is installed as
#      share/<G_APP>/link-cmd.txt (the object paths in it are the engine port's build tree);
#   3. the launcher: G_LAUNCHER_SRC with only its exec target rewritten.
#
# Also: game_desktop_entry, the XFCE menu entry (Games) of a game in a window.
#
# PROOFS (b_die on failure): nm -u empty, no PT_INTERP, GPU-stack symbols/strings present,
# the first stack's (SDL /dev/fb0 video driver, in-process winsys) absent -- a stale libSDL2.a
# or header in the shared prefix is how they could come back --, only __wrap_ioctl /
# __wrap_mmap call the real ones, the swap wrap sits in the engine's path, the KMSDRM swap is
# submit-first (sdl2_kmsdrm patch 0009), no global symbol defined by both the engine's objects
# and the stack, guarded inputs unchanged.
#
# Copyright 2026 Phoenix Systems
# SPDX-License-Identifier: BSD-3-Clause

g_main() {
	local pfx="${PREFIX_BUILD%/}" sysroot="${NL_SYSROOT}" tcbin
	tcbin="$(dirname "${NL_CC}")"
	local cc="${NL_CC}" nm="${NL_NM}" strip="${NL_STRIP}" readelf="${NL_READELF}" objdump="${NL_OBJDUMP}" size="${NL_SIZE}"

	local out="${PREFIX_PORT_BUILD}/link"
	local gd="${PORT_DEP_sdl2_kmsdrm:?}/share/gamedrm"
	local hooks_src="${gd}/gamedrm_hooks.c"
	local SP="${PORT_DEP_sdl2_kmsdrm}"
	local LI="${SP}/link-inputs.txt"
	local LDA="${PORT_DEP_libdrm_phoenix:?}/lib/libdrm.a"
	local engine_drm="${G_ENGINE}-drm"
	local elf="${out}/${engine_drm}"
	local launcher_drm="${G_LAUNCHER}-drm"

	log()  { printf '[%s] %s\n' "${G_APP}" "$*"; }
	die()  { b_die "[${G_APP}] $*"; }
	sha()  { if [ -e "$1" ]; then sha256sum "$1" | cut -d' ' -f1; else echo "absent"; fi; }

	# --- preconditions (fail loud; never fall back) -------------------------------------
	local TFLAGS=("${NL_TFLAGS[@]}")
	[ -f "${LI}" ] || die "missing ${LI}"
	case "${G_GL}" in gl|gles) ;; *) die "G_GL must be gles or gl" ;; esac
	local kind item GALLIUM_A="" SDL_A="" MESA=() TAILL=() WRAPS=()
	while read -r kind item; do
		case "${kind}" in
			gallium) GALLIUM_A="${item}" ;;
			sdl) SDL_A="${item}" ;;
			mesa-gl) if [ "${G_GL}" = gl ]; then MESA+=("${item}"); fi ;;
			mesa-es) if [ "${G_GL}" = gles ]; then MESA+=("${item}"); fi ;;
			tail) TAILL+=("${item}") ;;
			flag) WRAPS+=("${item}") ;;
			*) die "unknown line in ${LI}: ${kind}" ;;
		esac
	done < "${LI}"
	[ -n "${GALLIUM_A}" ] && [ -n "${SDL_A}" ] && [ "${#MESA[@]}" -gt 10 ] && [ "${#TAILL[@]}" -gt 5 ] \
		|| die "${LI} is incomplete"
	local f a
	for f in "$cc" "$nm" "$strip" "$readelf" "$objdump" "$size" \
			"$sysroot/lib/libphoenix.a" "$G_LAUNCHER_SRC" "$hooks_src" "$SDL_A" "$GALLIUM_A" \
			"$SP/include/SDL2/SDL_config.h" "$LDA" "${MESA[@]}" "${TAILL[@]}"; do
		[ -e "$f" ] || die "missing: $f"
	done
	local GL_BRIDGE="" GLESV2=""
	for a in "${MESA[@]}"; do
		case "$a" in *libglapi_bridge.a) GL_BRIDGE="$a" ;; *libGLESv2.a) GLESV2="$a" ;; esac
	done
	if [ "${G_GL}" = gl ]; then
		[ -n "${GL_BRIDGE}" ] && [ -z "${GLESV2}" ] || die "a gl link group must hold libglapi_bridge.a and not libGLESv2.a"
	else
		[ -n "${GLESV2}" ] && [ -z "${GL_BRIDGE}" ] || die "a gles link group must hold libGLESv2.a and not libglapi_bridge.a"
	fi
	local cfg="${SP}/include/SDL2/SDL_config.h" d
	for d in SDL_VIDEO_DRIVER_KMSDRM SDL_VIDEO_DRIVER_WAYLAND SDL_VIDEO_OPENGL_EGL SDL_VIDEO_OPENGL SDL_VIDEO_OPENGL_ES2 \
			SDL_INPUT_PHOENIX SDL_AUDIO_DRIVER_PHOENIX; do
		grep -qE "^#define ${d} +1" "${cfg}" || die "sdl2_kmsdrm's SDL_config.h lacks ${d} 1"
	done
	for d in SDL_VIDEO_DRIVER_KMSDRM_DYNAMIC SDL_VIDEO_DRIVER_WAYLAND_DYNAMIC SDL_VIDEO_DRIVER_PHOENIX SDL_LOADSO_DLOPEN; do
		if grep -qE "^#define ${d}( |$)" "${cfg}"; then die "sdl2_kmsdrm's SDL_config.h defines ${d}"; fi
	done
	nl_has_sym "${LDA}" __wrap_ioctl || die "${LDA} has no __wrap_ioctl"

	# --- the engine port's link inputs --------------------------------------------------
	local manifest="${pfx}/port-sources/${G_PORTDIR:?}/engine-link.sh"
	[ -f "${manifest}" ] || die "missing ${manifest} (the engine port's p_build writes it)"
	local ENGINE_NAME="" ENGINE_OBJS=() ENGINE_LINK_FLAGS=() ENGINE_LINK_TAIL=()
	# shellcheck disable=SC1090
	. "${manifest}"
	[ "${ENGINE_NAME}" = "${G_ENGINE}" ] || die "${manifest} is ${ENGINE_NAME:-unnamed}'s, not ${G_ENGINE}'s"
	[ "${#ENGINE_OBJS[@]}" -gt 0 ] || die "${manifest}: ENGINE_OBJS is empty"
	for f in "${ENGINE_OBJS[@]}"; do [ -f "$f" ] || die "missing engine object $f"; done
	log "link: ${#ENGINE_OBJS[@]} engine objects (${manifest})"

	local guarded=("$SDL_A" "$GALLIUM_A" "${MESA[@]}" "${TAILL[@]}" "$manifest")
	declare -A before
	for f in "${guarded[@]}"; do before["$f"]="$(sha "$f")"; done
	check_guarded() {
		local g bad=0
		for g in "${guarded[@]}"; do
			if [ "${before[$g]}" != "$(sha "$g")" ]; then
				printf '[%s] ERROR: shared file CHANGED during this build: %s\n' "${G_APP}" "$g" >&2
				bad=1
			fi
		done
		[ "$bad" = 0 ] || die "guarded inputs changed"
		log "guarded shared files unchanged (${#guarded[@]} checked)"
	}

	rm -rf "$out"
	mkdir -p "$out/src" "$out/obj"

	# --- 1. hooks object -----------------------------------------------------------------------
	local hooks_o="$out/obj/gamedrm_hooks.o"
	"$cc" -O2 -g -std=gnu17 -Wall -Wextra -Werror "${TFLAGS[@]}" -I"${SP}/include" \
		-DGAMEDRM_NAME="\"${G_APP}\"" -DGAMEDRM_API="\"${G_API_TEXT}\"" -c "$hooks_src" -o "$hooks_o" \
		|| die "gamedrm_hooks.c compile failed"

	# --- 2. the link -----------------------------------------------------------------------------
	local newgroup=(-Wl,--whole-archive "${GALLIUM_A}" -Wl,--no-whole-archive -Wl,--start-group "${SDL_A}"
		"${MESA[@]}" "${TAILL[@]}" -Wl,--end-group)
	local dargs=("${cc}" "${ENGINE_LINK_FLAGS[@]}" "${ENGINE_OBJS[@]}" "$hooks_o" "${newgroup[@]}" "${ENGINE_LINK_TAIL[@]}"
		-o "$elf" -static "${WRAPS[@]}" -Wl,--wrap=SDL_GL_SwapWindow -Wl,-Map,"${elf}.map")
	local cmdtext="${dargs[*]}"
	printf '%s\n' "$cmdtext" > "$out/link-cmd.txt"
	log "${engine_drm} link (SDL KMSDRM + Wayland, Mesa GBM/EGL (drm + wayland)/${G_API_TEXT}, Wayland client stack, libdrm-phoenix)"
	rm -f "$elf"
	( export PATH="${tcbin}:${PATH}" && "${dargs[@]}" ) > "$out/link.log" 2>&1 \
		|| { head -60 "$out/link.log" >&2; die "${engine_drm} link failed"; }
	[ -f "$elf" ] || die "link reported success but produced no ELF"
	[ -s "$out/link.log" ] && sed "s/^/[${G_APP}]   link: /" "$out/link.log" | head -20
	"$strip" -o "$elf.stripped" "$elf"

	# --- proofs on the program ----------------------------------------------------------------
	local bad=0 und syms s n
	if "$readelf" -l "$elf" | grep -q INTERP; then log "  PT_INTERP present"; bad=1; fi
	und="$("$nm" -u "$elf" || true)"
	log "  undefined symbols (nm -u): $(grep -c . <<< "${und}" || true)"
	[ -n "${und}" ] && { sed "s/^/[${G_APP}]     /" <<< "${und}" | head -20; bad=1; }
	syms="$("$nm" "$elf")"
	for s in KMSDRM_CreateDevice KMSDRM_GLES_SwapWindow SDL_EGL_LoadLibrary SDL_PHOENIX_HID_Poll SDL_GL_SwapWindow \
			__wrap_SDL_GL_SwapWindow __wrap_mmap __wrap_ioctl drmPhoenixMmap drm_phoenix_ioctl gbmint_get_backend \
			kmsro_drm_screen_create v3d_drm_screen_create_renderonly eglGetPlatformDisplayEXT eglGetProcAddress \
			_mesa_glapi_get_proc_address Wayland_CreateDevice Wayland_GLES_SwapWindow Wayland_PumpEvents __wrap_close \
			__wrap_write wl_display_connect wl_egl_window_create wl_cursor_theme_load xkb_keymap_new_from_string \
			dri2_initialize_wayland dri2_initialize_drm memfd_create os_create_anonymous_file \
			wlcursor_os_create_anonymous_file ${G_ENGINE_SYMS}; do
		if grep -qE " [TtWw] ${s}\$" <<< "${syms}"; then log "  symbol ${s}: yes"; else log "  symbol ${s}: NO"; bad=1; fi
	done
	local forbidden
	forbidden="$(grep -E ' [TtWwDdBbRr] (PHOENIX_bootstrap|PHOENIX_PumpEvents|PHOENIX_GL_[A-Za-z_]*|phxgl_[A-Za-z_]*|phoenix_v3d_ioctl|winsys_init|boPool_take|mboxProp|v3da_connect|v3d_phoenix_flip)$' <<< "${syms}" || true)"
	if [ -n "${forbidden}" ]; then log "  forbidden (first-stack) symbols PRESENT:"; sed "s/^/[${G_APP}]     /" <<< "${forbidden}"; bad=1
	else log "  first-stack symbols (SDL phoenix video, phxgl/PHOENIX_GL glue, in-process winsys): none"; fi

	local calls
	calls="$("$objdump" -d --no-show-raw-insn "$elf" | awk '
		/^[0-9a-f]+ <.*>:$/ { fn = $2; gsub(/[<>:]/, "", fn); next }
		/\tbl?\t/ && / <(ioctl|mmap|__wrap_SDL_GL_SwapWindow|SDL_GL_SwapWindow)>$/ {
			t = $NF; gsub(/[<>]/, "", t); print t, fn }' | sort | uniq -c)"
	printf '%s\n' "$calls" > "$out/call-sites.txt"
	awk '$2 == "ioctl" && $3 != "__wrap_ioctl" { bad = 1 } END { exit bad }' <<< "$calls" \
		|| { log "  real ioctl() called from outside __wrap_ioctl:"; awk '$2 == "ioctl"' <<< "$calls" | sed "s/^/[${G_APP}]     /"; bad=1; }
	awk '$2 == "mmap" && $3 != "__wrap_mmap" { bad = 1 } END { exit bad }' <<< "$calls" \
		|| { log "  real mmap() called from outside __wrap_mmap:"; awk '$2 == "mmap"' <<< "$calls" | sed "s/^/[${G_APP}]     /"; bad=1; }
	local engine_callers
	engine_callers="$(awk '$2 == "__wrap_SDL_GL_SwapWindow" { print $3 }' <<< "$calls" | tr '\n' ' ')"
	if [ -n "$engine_callers" ] \
			&& ! awk '$2 == "SDL_GL_SwapWindow" && $3 != "__wrap_SDL_GL_SwapWindow" { f = 1 } END { exit !f }' <<< "$calls" \
			&& grep -qE ' SDL_GL_SwapWindow __wrap_SDL_GL_SwapWindow$' <<< "$calls"; then
		log "  PROOF: ${engine_callers}-> __wrap_SDL_GL_SwapWindow -> SDL_GL_SwapWindow (frame counter in the path)"
	else
		log "  the SDL_GL_SwapWindow wrap is NOT in the engine's swap path:"; sed "s/^/[${G_APP}]     /" <<< "$calls"; bad=1
	fi
	log "  ioctl/mmap: only __wrap_ioctl / __wrap_mmap call the real ones ($out/call-sites.txt)"
	local order
	if order="$(GAMEDRM_OBJDUMP="$objdump" bash "${gd}/check-swap-order.sh" "$elf")"; then log "  ${order}"
	else log "  ${order} -- sdl2_kmsdrm's libSDL2.a lacks patches/0009"; bad=1; fi

	for s in 'KMS/DRM Video Driver' '/dev/dri/' 'libdrm-phoenix:' 'DRMPHX_TRACE' 'DRMPHX sync' '/dev/kbd0' '/dev/audio0' \
			'EGL_KHR_platform_gbm' 'EGL_KHR_platform_wayland' 'SDL Wayland video driver' 'KMS/DRM Video Driver' 'xdg_wm_base' \
			'zxdg_decoration_manager_v1' 'zwp_linux_dmabuf_v1' 'kmsro' "${G_APP}: Phoenix-RTOS GPU stack" "${G_APP} flipstat" \
			"${G_APP} swapstat"; do
		n="$(grep -acF -- "$s" "$elf.stripped" || true)"
		log "  string '$s': $n"
		[ "$n" != 0 ] || bad=1
	done
	for s in 'v3d-winsys:' 'v3da-winsys:' 'phxgl' 'PHOENIX: GL_CreateContext' '/dev/fb0' 'RPI4FB_GETMODE' 'phoenix_v3d_ioctl' \
			'peek_next_scanout' 'v3d-srv' 'v3d-pool:'; do
		n="$(grep -acF -- "$s" "$elf.stripped" || true)"
		log "  first-stack string '$s': $n"
		[ "$n" = 0 ] || bad=1
	done
	# silent duplicates: global symbols defined by the engine's objects AND the GPU stack
	local dups
	dups="$( { for f in "${ENGINE_OBJS[@]}"; do "$nm" -g --defined-only "$f" 2>/dev/null; done \
			| awk 'NF >= 3 && $2 ~ /[TDBRVW]/ { print $3 }' | LC_ALL=C sort -u > "$out/obj/eng-defs.txt"; \
		for f in "$GALLIUM_A" "${MESA[@]}" "${TAILL[@]}" "$SDL_A" "$hooks_o"; do
			"$nm" -g --defined-only "$f" 2>/dev/null; done \
			| awk 'NF >= 3 && $2 ~ /[TDBRVW]/ { print $3 }' | LC_ALL=C sort -u > "$out/obj/drm-defs.txt"; \
		LC_ALL=C comm -12 "$out/obj/eng-defs.txt" "$out/obj/drm-defs.txt" || true; } )"
	if [ -n "$dups" ]; then
		log "  symbols defined by BOTH the engine's objects and the GPU stack ($(grep -c . <<< "$dups")):"
		sed "s/^/[${G_APP}]     /" <<< "$dups" | head -30
		bad=1
	else
		log "  no global symbol defined by both the engine's objects and the GPU stack"
	fi
	rm -f "$out/obj/eng-defs.txt" "$out/obj/drm-defs.txt"

	# --- 3. launcher -------------------------------------------------------------------------------
	local lsrc="$out/src/${launcher_drm}.c" diff_lines
	sed -e "s|\"/usr/bin/${G_ENGINE}\"|\"/usr/bin/${engine_drm}\"|" "$G_LAUNCHER_SRC" > "$lsrc"
	[ "$(grep -c "\"/usr/bin/${engine_drm}\"" "$lsrc")" = 1 ] || die "launcher exec target rewrite did not match exactly once"
	[ "$(grep -c "\"/usr/bin/${G_ENGINE}\"" "$lsrc")" = 0 ] || die "launcher still names /usr/bin/${G_ENGINE}"
	diff_lines="$(diff "$G_LAUNCHER_SRC" "$lsrc" | grep -c '^>' || true)"
	[ "$diff_lines" = 1 ] || die "launcher differs from $(basename "$G_LAUNCHER_SRC") in $diff_lines lines (expected exactly 1)"
	"$cc" -O2 -static -Wall -Wextra --sysroot="${sysroot}/" -B"${sysroot}/lib/" -iprefix "${sysroot}/" \
		-o "$out/${launcher_drm}" "$lsrc" || die "launcher compile failed"
	if "$readelf" -l "$out/${launcher_drm}" 2>/dev/null | grep -q INTERP; then die "${launcher_drm} has a PT_INTERP segment"; fi
	grep -aqF "/usr/bin/${engine_drm}" "$out/${launcher_drm}" || die "launcher ELF lacks its exec target"
	[ -z "$("$nm" -u "$out/${launcher_drm}" || true)" ] || die "launcher has undefined symbols"

	# --- provenance --------------------------------------------------------------------------------
	"$size" "$elf" | sed "s/^/[${G_APP}]   /"
	{
		echo "built:               $(date -u +%Y-%m-%dT%H:%M:%SZ)"
		echo "gamedrm_hooks.c:     $(sha "$hooks_src")"
		echo "libSDL2.a:           $(sha "$SDL_A") (KMSDRM + Wayland)"
		echo "link inputs:         $(sha "$LI") (${LI}); libgallium $(sha "$GALLIUM_A" | cut -c1-16); API ${G_GL}"
		echo "libdrm-phoenix:      $(sha "$LDA")"
		echo "engine-link.sh:      $(sha "$manifest") (${manifest})"
		echo "drm unstripped:      $(sha "$elf") ($(stat -c%s "$elf") B)"
		echo "drm stripped:        $(sha "$elf.stripped") ($(stat -c%s "$elf.stripped") B)"
		echo "${launcher_drm}:$(printf '%*s' $((19 - ${#launcher_drm})) '') $(sha "$out/${launcher_drm}") ($(stat -c%s "$out/${launcher_drm}") B)"
		echo "libphoenix.a:        $(sha "$sysroot/lib/libphoenix.a")"
	} > "$out/BUILD-INFO.txt"
	sed "s/^/[${G_APP}]   /" "$out/BUILD-INFO.txt"

	check_guarded
	[ "$bad" = 0 ] || die "verification failed (see above)"

	# --- install ---------------------------------------------------------------------------------
	local p="${PREFIX_PORT_INSTALL}"
	mkdir -p "${p}/bin" "${p}/prog" "${p}/share/${G_APP}"
	install -m 755 "$elf" "${p}/prog/${engine_drm}"
	install -m 644 "${elf}.map" "$out/link-cmd.txt" "$out/call-sites.txt" "$out/BUILD-INFO.txt" "${p}/share/${G_APP}/"
	install -m 755 "$elf.stripped" "${p}/bin/${engine_drm}"
	install -m 755 "$out/${launcher_drm}" "${p}/bin/${G_LAUNCHER}"
	if b_use rootfs; then
		b_install "${p}/bin/${engine_drm}" "${p}/bin/${G_LAUNCHER}" /usr/bin
	fi
	log "done: ${p}/bin/${engine_drm} (+ /usr/bin/${G_LAUNCHER} launcher)"
}

# game_desktop_entry <game> <Name> <Comment>
#   With USE rootfs: /usr/share/applications/<game>.desktop, the XFCE menu entry (Games) of a
#   game in a window: /bin/game-window.sh <game> (sdl2_kmsdrm USE rootfs) runs the same
#   program as the plain command with SDL_VIDEODRIVER=wayland and the engine's windowed
#   arguments, sets the Wayland app_id the labwc window rules match and refuses a second game
#   while one runs.
game_desktop_entry() {
	local game="${1:?}" nm="${2:?}" comment="${3:?}"
	b_use rootfs || return 0
	local d="${PREFIX_FS}/root/usr/share/applications"
	mkdir -p "${d}"
	printf '%s\n' '[Desktop Entry]' 'Type=Application' "Name=${nm}" "Comment=${comment}" \
		"Exec=/bin/bash /bin/game-window.sh ${game}" 'Icon=applications-games' 'Terminal=false' \
		'StartupNotify=false' 'Categories=Game;' > "${d}/${game}.desktop"
	chmod 644 "${d}/${game}.desktop"
}
