<?xml version="1.0"?>
<!--
  labwc in the XFCE session on Phoenix-RTOS (/bin/xfce-session, /bin/xfce-desktop.sh):
  /etc/xdg/labwc-xfce/rc.xml. Built-in theme, DejaVu Sans, server-side decorations; xfwm4 is
  X11-only, so labwc is the window manager of XFCE's Wayland session. The keys:
    Super (tap)             application finder
    Super+Return            terminal (foot)
    Super+E                 file manager (Thunar)
    Super+D, Alt+F2         application finder (full / collapsed)
    Super+Space             fuzzel launcher
  labwc's defaults (<default />) stay: Alt+Tab, Alt+F4, window-menu keys and mouse bindings.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow" name="DejaVu Sans" size="11" weight="bold" />
    <font place="InactiveWindow" name="DejaVu Sans" size="11" />
    <font place="MenuItem" name="DejaVu Sans" size="11" />
    <font place="OnScreenDisplay" name="DejaVu Sans" size="11" />
  </theme>

  <keyboard>
    <default />
    <!-- a tap of Super alone: labwc runs onRelease bindings only if no other key came in between -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="/bin/xfce4-appfinder" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="/bin/foot" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="/bin/thunar" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="/bin/xfce4-appfinder" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="/bin/xfce4-appfinder --collapsed" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/bin/fuzzel" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

</labwc_config>
