# labwc environment for the XFCE session on Phoenix-RTOS (M7): stage as
# /etc/xdg/labwc-xfce/environment. Exported to labwc and every client it starts
# (the session script exports the same set before it starts labwc).
XKB_DEFAULT_LAYOUT=us
FONTCONFIG_FILE=/etc/fonts/fonts.conf
TERM=xterm-256color
GDK_BACKEND=wayland
GSETTINGS_BACKEND=memory
GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas
NO_AT_BRIDGE=1
XDG_CURRENT_DESKTOP=XFCE
XDG_SESSION_TYPE=wayland
XDG_CONFIG_DIRS=/etc/xdg
XDG_DATA_DIRS=/usr/share
XDG_CONFIG_HOME=/tmp/xfce-home/config
XDG_CACHE_HOME=/tmp/xfce-home/cache
XDG_DATA_HOME=/tmp/xfce-home/data
DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/dbus-session
