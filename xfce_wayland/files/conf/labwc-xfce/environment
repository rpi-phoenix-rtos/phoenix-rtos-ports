# labwc environment of the XFCE session on Phoenix-RTOS: /etc/xdg/labwc-xfce/environment.
# Set for labwc and every client it starts, over what the session script exported, so only
# the fixed settings are here: PATH, TZ, XDG_CONFIG_DIRS, XDG_DATA_DIRS, XDG_*_HOME and
# DBUS_SESSION_BUS_ADDRESS come from the script (its knobs; /bin/xfce-session puts its own
# /etc/xdg/xfce-session and /usr/share/xfce-session first in the XDG_*_DIRS).
XKB_DEFAULT_LAYOUT=us
FONTCONFIG_FILE=/etc/fonts/fonts.conf
TERM=xterm-256color
GDK_BACKEND=wayland
GSETTINGS_BACKEND=memory
GSETTINGS_SCHEMA_DIR=/usr/share/glib-2.0/schemas
NO_AT_BRIDGE=1
XDG_CURRENT_DESKTOP=XFCE
XDG_SESSION_TYPE=wayland
