#!/bin/bash
#
# xfce-session -- the XFCE desktop in ONE psh command. Run ON THE Pi at the psh prompt:
#
#     /bin/bash /bin/xfce-session
#
# The XFCE 4.20 session on labwc, composited on the V3D (/bin/xfce-desktop.sh xfce): the
# session bus, xfconfd, labwc, xfdesktop's wallpaper, the panel, a Thunar window. It runs
# until the panel's Log Out (the button at the right end of the panel; labwc's root menu has
# Log Out too), then stops everything cleanly and returns to psh. The GPU servers
# (rpi4-v3d-async, rpi4-kms, shmsrv) start at boot. On the desktop:
#   Super                 application finder         Super+Return   terminal (foot)
#   Super+E               file manager (Thunar)      Super+D, Alt+F2 application finder
#   Super+Space           fuzzel launcher            right click on the wallpaper: desktop menu
#   the panel: applications menu, launchers (terminal, files, app finder), window buttons,
#   the clock (local time), Log Out
#
# Environment knobs (psh `export NAME=value` before the command):
#   HOLD       0 (default) = until Log Out; N = log out by itself after N seconds (unattended
#              recordings and test cycles: the same logout path as the button)
#   XFCE_AUTOSTART  programs to open once the panel is up, e.g.
#              atril,quake3:120,video (see /bin/xfce-autostart.sh); XFCE_AUTOSTART_DELAY
#              seconds before the first one (default 5)
#   CONF_DIR   labwc's configuration (default /etc/xdg/labwc-xfce-demo); the games and the video
#              sessions: /etc/xdg/labwc-xfce-games (GAME_LIST), /etc/xdg/labwc-xfce-video
#   RENDERER   labwc's renderer: gles2 (default: GPU composition on the V3D) | pixman
#   TZ         POSIX TZ string (default Europe/Warsaw: CET-1CEST,M3.5.0,M10.5.0/3); GLib's
#              clock and file dates use it, libphoenix's localtime() does not yet
#   VERBOSE    labwc log level: 0 (default: errors) | 1 (-V) | 2 (-d)
#   THUNAR_START 1 (default) = open a Thunar window at start; THUNAR_SECOND=<dir> = then open
#              <dir> with a second `thunar` (forwarded to the running one over the bus)
#   SESSION_SCRIPT (default /bin/xfce-desktop.sh) and every knob it reads
#
# Every line of ours starts with "XFCE-SESSION " (grading); the session's own start with "XFCE ".
#
# Copyright 2026 Phoenix Systems
#
# This file is part of Phoenix-RTOS.
#
# %LICENSE%

# psh wires a program's stdout to the console but not always its stderr (as startx)
exec 2>&1

# the session's own programs: the panel's Log Out runs `loginctl` (the xfce-demo stand-in)
DEMO=/usr/lib/xfce-demo/bin
SESSION_SCRIPT=${SESSION_SCRIPT:-/bin/xfce-desktop.sh}

export HOLD=${HOLD:-0}
export RENDERER=${RENDERER:-gles2}
export TZ=${TZ:-CET-1CEST,M3.5.0,M10.5.0/3}
export VERBOSE=${VERBOSE:-0}
export LABWC=${LABWC:-/bin/labwc}
export CONF_DIR=${CONF_DIR:-/etc/xdg/labwc-xfce-demo}
export XFCE_BIN=${XFCE_BIN:-${DEMO}}
export THUNAR=${THUNAR:-/bin/thunar}
export PANEL=${PANEL:-/bin/xfce4-panel}
export XFDESKTOP=${XFDESKTOP:-/bin/xfdesktop}
# settings saved by the session's programs (the panel layout on quit), apart from other XFCE
# sessions of the same boot
export XFCE_HOME=${XFCE_HOME:-/tmp/xfce-demo-home}
# the session's panel layout and fuzzel.ini, then XFCE's defaults
export XFCE_CONFIG_DIRS=${XFCE_CONFIG_DIRS:-/etc/xdg/xfce-demo:/etc/xdg}
# the session's .desktop files (terminal = foot, files = Thunar) shadow the ones of the same
# name in /usr/share/applications
export XFCE_DATA_DIRS=${XFCE_DATA_DIRS:-/usr/share/xfce-demo:/usr/share}
# when HOLD is over: the Log Out button's own command
export LOGOUT_CMD=${LOGOUT_CMD:-${DEMO}/loginctl terminate-session}

echo "XFCE-SESSION start hold=${HOLD} renderer=${RENDERER} tz=${TZ} labwc=${LABWC} conf=${CONF_DIR} session=${SESSION_SCRIPT}"

# --- the GPU servers (started at boot) ---------------------------------------------------------
# /dev/v3d-async and /dev/kms are devfs nodes; /shm answers shmsrv's own stats request.
v3da_up() { [ -e /dev/v3d-async ]; }
kms_up() { [ -e /dev/kms ]; }
shm_up() { /bin/shmsrv -s > /dev/null 2>&1; }
state() { "$1" && echo up || echo missing; }
echo "XFCE-SESSION servers v3d-async=$(state v3da_up) kms=$(state kms_up) shm=$(state shm_up)"
if ! v3da_up || ! kms_up || ! shm_up; then
	echo "XFCE-SESSION done rc=1 (a GPU server is missing: they start at boot, see the boot log)"
	exit 1
fi

/bin/bash "${SESSION_SCRIPT}" xfce input
rc=$?
echo "XFCE-SESSION done rc=${rc}"
exit "${rc}"
