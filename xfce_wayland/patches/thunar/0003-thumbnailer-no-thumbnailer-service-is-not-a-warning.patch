From 249c22d8628c1dd0f73d2b2b84cc6c8338f9bcb5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Witold=20Bo=C5=82t?= <witold.bolt@jit.team>
Date: Wed, 30 Sep 2026 19:41:42 +0200
Subject: [PATCH] thumbnailer: no thumbnailer service is not a warning

Thunar asks org.freedesktop.thumbnails.Thumbnailer1 (tumbler) for the
supported types when it starts. A session without tumbler -- as on
Phoenix-RTOS -- answers org.freedesktop.DBus.Error.ServiceUnknown, and
every Thunar instance printed "ThunarThumbnailer: Failed to retrieve
supported types" as a warning. There is simply no thumbnailer; Thunar
already carries on without one. Log ServiceUnknown at debug level; any
other failure (a thumbnailer that is there but broken) is still a
warning.
---
 thunar/thunar-thumbnailer.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/thunar/thunar-thumbnailer.c b/thunar/thunar-thumbnailer.c
index 1e43285..5832b7c 100644
--- a/thunar/thunar-thumbnailer.c
+++ b/thunar/thunar-thumbnailer.c
@@ -674,7 +674,11 @@ thunar_thumbnailer_received_supported_types (ThunarThumbnailerDBus *proxy,
       g_slist_free_full (thumbnailer->jobs, (GDestroyNotify) thunar_thumbnailer_free_job);
       thumbnailer->jobs = NULL;
 
-      g_warning ("ThunarThumbnailer: Failed to retrieve supported types: %s", error->message);
+      /* no thumbnailer service (tumbler) on the bus: thumbnails are simply not made */
+      if (g_error_matches (error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN))
+        g_debug ("ThunarThumbnailer: Failed to retrieve supported types: %s", error->message);
+      else
+        g_warning ("ThunarThumbnailer: Failed to retrieve supported types: %s", error->message);
       g_clear_error (&error);
 
       thumbnailer->proxy_state = THUNAR_THUMBNAILER_PROXY_FAILED;
