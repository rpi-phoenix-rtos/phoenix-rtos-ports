+plugin_lib = build_target(
   'windowmenu',
   plugin_sources,
-  sources: xfce4_panel_resources_c,
+  target_type: builtin_plugins ? 'static_library' : 'shared_module',
+  # (built in: the panel carries the resources once)
+  sources: builtin_plugins ? [] : xfce4_panel_resources_c,
   gnu_symbol_visibility: 'hidden',
-  c_args: [
+  c_args: (builtin_plugins ? ['-Dxfce_panel_module_init=xfce_panel_builtin_windowmenu_init'] : []) + [
     '-DG_LOG_DOMAIN="@0@"'.format('libwindowmenu'),
   ],
   include_directories: [
@@ -29,9 +31,13 @@ shared_module(
     libpanel_common,
     libxfce4panel,
   ],
-  install: true,
+  install: not builtin_plugins,
   install_dir: get_option('prefix') / get_option('libdir') / plugin_install_subdir,
 )
+if builtin_plugins
+  builtin_plugin_libs += plugin_lib
+  builtin_plugin_names += 'windowmenu'
+endif
 
 configure_file(
   input: 'xfce4-popup-windowmenu.sh',
