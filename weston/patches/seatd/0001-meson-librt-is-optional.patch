From 5f9c28027c98bb1a237e4b9c44dfad42be209b80 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:35:14 +0200
Subject: [PATCH] meson: librt is optional

Systems whose C library provides clock_gettime() and friends have no
librt (Phoenix-RTOS); find_library('rt') must not be fatal there.
---
 meson.build | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index 549ed7e..431a05f 100644
--- a/meson.build
+++ b/meson.build
@@ -158,8 +158,9 @@ if get_option('libseat-logind') != 'disabled'
 	endif
 endif
 
-# needed for cross-compilation
-realtime = meson.get_compiler('c').find_library('rt')
+# needed for cross-compilation (systems whose libc holds the clock functions,
+# e.g. Phoenix-RTOS, have no librt)
+realtime = meson.get_compiler('c').find_library('rt', required: false)
 private_deps += realtime
 
 if with_builtin
-- 
2.53.0

