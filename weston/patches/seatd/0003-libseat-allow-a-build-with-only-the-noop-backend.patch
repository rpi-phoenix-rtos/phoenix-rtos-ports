From dd7fa7ee952243914e0af2027f3b00d57cdba74d Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:36:18 +0200
Subject: [PATCH] libseat: allow a build with only the noop backend

The noop backend is always compiled in. Systems without a seat manager
(Phoenix-RTOS) build libseat with every other backend disabled and select
noop (LIBSEAT_BACKEND=noop); the #error made that impossible.
---
 libseat/libseat.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libseat/libseat.c b/libseat/libseat.c
index 8cc9ab2..f36f475 100644
--- a/libseat/libseat.c
+++ b/libseat/libseat.c
@@ -30,9 +30,9 @@ static const struct named_backend impls[] = {
 	{NULL, NULL},
 };
 
-#if !defined(SEATD_ENABLED) && !defined(LOGIND_ENABLED) && !defined(BUILTIN_ENABLED)
-#error At least one backend must be enabled
-#endif
+/* The noop backend is always built: a build with only it (-Dlibseat-seatd=disabled
+ * -Dlibseat-logind=disabled) serves systems without a seat manager, where the
+ * compositor opens its devices itself (Phoenix-RTOS). */
 
 struct libseat *libseat_open_seat(const struct libseat_seat_listener *listener, void *data) {
 	if (listener == NULL || listener->enable_seat == NULL || listener->disable_seat == NULL) {
-- 
2.53.0

