From 6aae1d866feef5b01163233e027414f9cac98333 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:35:54 +0200
Subject: [PATCH] connection: build where MSG_CMSG_CLOEXEC does not exist

Phoenix-RTOS has no MSG_CMSG_CLOEXEC. Receive without it there; the
descriptors then stay inheritable, which only matters to the seatd backend
(not used on Phoenix, where libseat runs its noop backend).
---
 common/connection.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/common/connection.c b/common/connection.c
index ab79e0e..468156e 100644
--- a/common/connection.c
+++ b/common/connection.c
@@ -8,6 +8,11 @@
 
 #include "connection.h"
 
+#ifndef MSG_CMSG_CLOEXEC
+/* Systems without it (Phoenix-RTOS): received descriptors stay inheritable. */
+#define MSG_CMSG_CLOEXEC 0
+#endif
+
 static inline uint32_t connection_buffer_mask(const uint32_t idx) {
 	return idx & (CONNECTION_BUFFER_SIZE - 1);
 }
