+
+#ifndef WESTON_PHOENIX_TRACE_H
+#define WESTON_PHOENIX_TRACE_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* WLPHX_TRACE=1: one "WLPHX shutdown step=<name>" line on stderr per shutdown
+ * step, so a compositor that does not exit shows where it stopped. stderr and
+ * not weston_log(): the log scopes are torn down during the same shutdown. */
+static inline void
+phoenix_trace_step(const char *step)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		const char *e = getenv("WLPHX_TRACE");
+
+		on = e && e[0] != '\0' && strcmp(e, "0") != 0;
+	}
+	if (on)
+		fprintf(stderr, "WLPHX shutdown step=%s\n", step);
+}
+
+#endif
-- 
