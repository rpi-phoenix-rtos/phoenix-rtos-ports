From 7f2549433c61d91e1aa77b3a495e017f1c425307 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:45:54 +0200
Subject: [PATCH] input: fall back to a builtin XKB keymap

Systems without the XKB data files (xkeyboard-config) cannot compile a
keymap from rule names at run time. A program may supply a keymap compiled
at build time (weak symbol weston_builtin_xkb_keymap, text format v1),
used only when the rule names fail.
---
 libweston/input.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/libweston/input.c b/libweston/input.c
index 0aee74d..f5f5821 100644
--- a/libweston/input.c
+++ b/libweston/input.c
@@ -4043,6 +4043,12 @@ err_keymap:
 	return NULL;
 }
 
+/* Programs for systems without the XKB data files (xkeyboard-config), such as
+ * Phoenix-RTOS, may supply a keymap compiled at build time (text format v1);
+ * it is used when the rule names cannot be compiled. Weak: absent in
+ * ordinary builds. */
+extern const char weston_builtin_xkb_keymap[] __attribute__((weak));
+
 static int
 weston_compositor_build_global_keymap(struct weston_compositor *ec)
 {
@@ -4054,6 +4060,15 @@ weston_compositor_build_global_keymap(struct weston_compositor *ec)
 	keymap = xkb_keymap_new_from_names(ec->xkb_context,
 					   &ec->xkb_names,
 					   0);
+	if (keymap == NULL && weston_builtin_xkb_keymap) {
+		keymap = xkb_keymap_new_from_string(ec->xkb_context,
+						    weston_builtin_xkb_keymap,
+						    XKB_KEYMAP_FORMAT_TEXT_V1,
+						    0);
+		if (keymap)
+			weston_log("using the builtin XKB keymap "
+				   "(rule names not compiled)\n");
+	}
 	if (keymap == NULL) {
 		weston_log("failed to compile global XKB keymap\n");
 		weston_log("  tried rules %s, model %s, layout %s, variant %s, "
-- 
2.53.0

