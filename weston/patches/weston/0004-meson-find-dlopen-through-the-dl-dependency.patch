From ceeee4a9f6f89924ca2411c54f242f25c32ac61c Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:47:55 +0200
Subject: [PATCH] meson: find dlopen() through the dl dependency

cc.find_library('dl') fails on systems whose C library provides dlopen()
and ships no libdl (Phoenix-RTOS). Meson's builtin 'dl' dependency checks
libc first and falls back to libdl.
---
 meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index fd14030..73c85be 100644
--- a/meson.build
+++ b/meson.build
@@ -150,7 +150,7 @@ dep_pixman = dependency('pixman-1', version: '>= 0.25.2')
 dep_libinput = dependency('libinput', version: '>= 1.2.0')
 dep_libevdev = dependency('libevdev')
 dep_libm = cc.find_library('m')
-dep_libdl = cc.find_library('dl')
+dep_libdl = dependency('dl') # libdl, or dlopen() in libc (Phoenix-RTOS, musl, BSDs)
 dep_libdrm = dependency('libdrm', version: '>= 2.4.108')
 dep_libdrm_headers = dep_libdrm.partial_dependency(compile_args: true)
 dep_threads = dependency('threads')
-- 
