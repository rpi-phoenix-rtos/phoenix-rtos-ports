From e084713c043f4ad415867a1e9a4c76cb680687d1 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 10:27:07 +0200
Subject: [PATCH] input: create the XKB context even when no XKB include path
 exists

xkb_context_new() fails when none of its default include paths exists --
on systems without xkeyboard-config (Phoenix-RTOS) -- and Weston then
exits with "failed to create XKB context" before any backend runs,
although keymaps passed as strings need no include path. Retry with
XKB_CONTEXT_NO_DEFAULT_INCLUDES; compiling from rule names then fails
cleanly and the builtin keymap (if the program supplies one) is used.
---
 libweston/input.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/libweston/input.c b/libweston/input.c
index f5f5821..dbd2ae1 100644
--- a/libweston/input.c
+++ b/libweston/input.c
@@ -3938,6 +3938,21 @@ weston_compositor_set_xkb_rule_names(struct weston_compositor *ec,
 {
 	if (ec->xkb_context == NULL) {
 		ec->xkb_context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+		if (ec->xkb_context == NULL) {
+			/* xkb_context_new() fails when none of the default
+			 * include paths ($XDG_CONFIG_HOME/xkb, $HOME/.xkb,
+			 * $XKB_CONFIG_EXTRA_PATH, $XKB_CONFIG_ROOT or the
+			 * built-in root) exists, i.e. on systems without
+			 * xkeyboard-config. Keymaps from strings need no
+			 * include path: go on without them; compiling from
+			 * rule names then fails (and may fall back to a
+			 * builtin keymap, see below). */
+			ec->xkb_context =
+				xkb_context_new(XKB_CONTEXT_NO_DEFAULT_INCLUDES);
+			if (ec->xkb_context)
+				weston_log("XKB: no include path exists, "
+					   "keymaps can only come from strings\n");
+		}
 		if (ec->xkb_context == NULL) {
 			weston_log("failed to create XKB context\n");
 			return -1;
-- 
