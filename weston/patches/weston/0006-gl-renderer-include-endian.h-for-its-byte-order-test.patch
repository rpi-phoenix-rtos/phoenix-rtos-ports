From 55bcfd79e9290a5ce71d7c25cc4b1849eb29773f Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:51:10 +0200
Subject: [PATCH] gl-renderer: include <endian.h> for its byte-order tests

dump_format() and the shm format list test BYTE_ORDER/__BYTE_ORDER, which
glibc happens to pull in through other headers. Where it does not (e.g.
Phoenix-RTOS), an undefined BYTE_ORDER == BIG_ENDIAN reads 0 == 0.
---
 libweston/renderer-gl/gl-renderer.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libweston/renderer-gl/gl-renderer.c b/libweston/renderer-gl/gl-renderer.c
index 8064b41..272b4c3 100644
--- a/libweston/renderer-gl/gl-renderer.c
+++ b/libweston/renderer-gl/gl-renderer.c
@@ -31,6 +31,7 @@
 #include <GLES2/gl2ext.h>
 #include <GLES3/gl3.h>
 
+#include <endian.h>
 #include <fcntl.h>
 #include <stdbool.h>
 #include <stdint.h>
-- 
2.53.0

