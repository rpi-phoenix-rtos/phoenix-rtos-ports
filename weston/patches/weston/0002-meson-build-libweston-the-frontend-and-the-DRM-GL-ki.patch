From a11544d94b7c23aeb11e109c848cac274fa5493c Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:45:25 +0200
Subject: [PATCH] meson: build libweston, the frontend and the DRM/GL/kiosk
 modules with library()

With -Ddefault_library=static they become archives that a statically
linked program combines with a builtin-module table (systems without a
dynamic linker, e.g. Phoenix-RTOS). The default (shared) build is
unchanged.
---
 frontend/meson.build              | 2 +-
 kiosk-shell/meson.build           | 2 +-
 libweston/backend-drm/meson.build | 2 +-
 libweston/meson.build             | 2 +-
 libweston/renderer-gl/meson.build | 2 +-
 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/frontend/meson.build b/frontend/meson.build
index ddaf677..a091128 100644
--- a/frontend/meson.build
+++ b/frontend/meson.build
@@ -25,7 +25,7 @@ if get_option('xwayland')
 	config_h.set_quoted('XSERVER_PATH', get_option('xwayland-path'))
 endif
 
-libexec_weston = shared_library(
+libexec_weston = library(
 	'exec_weston',
 	sources: srcs_weston,
 	include_directories: common_inc,
diff --git a/kiosk-shell/meson.build b/kiosk-shell/meson.build
index 2baaa4e..41651b7 100644
--- a/kiosk-shell/meson.build
+++ b/kiosk-shell/meson.build
@@ -11,7 +11,7 @@ if get_option('shell-kiosk')
 		dep_libshared,
 		dep_libweston_public,
 	]
-	plugin_shell_kiosk = shared_library(
+	plugin_shell_kiosk = library(
 		'kiosk-shell',
 		srcs_shell_kiosk,
 		include_directories: common_inc,
diff --git a/libweston/backend-drm/meson.build b/libweston/backend-drm/meson.build
index 002669e..10ad222 100644
--- a/libweston/backend-drm/meson.build
+++ b/libweston/backend-drm/meson.build
@@ -91,7 +91,7 @@ if get_option('remoting') or get_option('pipewire')
 	config_h.set('BUILD_DRM_VIRTUAL', '1')
 endif
 
-plugin_drm = shared_library(
+plugin_drm = library(
 	'drm-backend',
 	srcs_drm,
 	include_directories: common_inc,
diff --git a/libweston/meson.build b/libweston/meson.build
index d1f126f..2169ac6 100644
--- a/libweston/meson.build
+++ b/libweston/meson.build
@@ -101,7 +101,7 @@ if get_option('backend-vnc')
 	deps_libweston += dep_pam
 endif
 
-lib_weston = shared_library(
+lib_weston = library(
 	'weston-@0@'.format(libweston_major),
 	srcs_libweston,
 	include_directories: common_inc,
diff --git a/libweston/renderer-gl/meson.build b/libweston/renderer-gl/meson.build
index c50e4f3..c7d01eb 100644
--- a/libweston/renderer-gl/meson.build
+++ b/libweston/renderer-gl/meson.build
@@ -46,7 +46,7 @@ foreach name : [ 'egl', 'glesv2' ]
 	deps_renderer_gl += d
 endforeach
 
-plugin_gl = shared_library(
+plugin_gl = library(
 	'gl-renderer',
 	srcs_renderer_gl,
 	include_directories: common_inc,
-- 
2.53.0

