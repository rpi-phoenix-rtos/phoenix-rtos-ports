From 72a89f6038649dbff8c8c7fceaffc7a42988e809 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:36:18 +0200
Subject: [PATCH] meson: do not build the unit tests by default in cross builds

Cross builds cannot run them, and the poller test needs SIGRTMIN, which
Phoenix-RTOS does not have. meson test still builds and runs them.
---
 meson.build | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 431a05f..020c1d6 100644
--- a/meson.build
+++ b/meson.build
@@ -253,7 +253,10 @@ foreach name, value : tests
 	test(name, executable(
 		'@0@_test'.format(name),
 		['tests/@0@.c'.format(name), value],
-		include_directories: [include_directories('.', 'include')]))
+		include_directories: [include_directories('.', 'include')],
+		# built by `meson test`, not by default: cross builds cannot run them, and
+		# the poller test needs SIGRTMIN, which some systems (Phoenix-RTOS) lack
+		build_by_default: not meson.is_cross_build()))
 endforeach
 
 if with_server
-- 
2.53.0

