From 804061a1a041b245be2b9df3f47941b175708f93 Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 16:43:04 +0200
Subject: [PATCH] meson: validate strictly only with wayland-scanner >= 1.25

The interfaces of 1.49 carry the 'frozen' attribute that wayland-scanner 1.25
added to its DTD. An older scanner fails validation, which --strict makes fatal
for every enum header, although the attribute does not change the generated
code. Pass --strict only when the scanner knows the DTD.
---
 include/wayland-protocols/meson.build | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/include/wayland-protocols/meson.build b/include/wayland-protocols/meson.build
index a4e872b..fc0e8c8 100644
--- a/include/wayland-protocols/meson.build
+++ b/include/wayland-protocols/meson.build
@@ -1,4 +1,8 @@
 header_install_dir = get_option('includedir') / 'wayland-protocols'
+# wayland-scanner < 1.25 does not know the interface attribute 'frozen' (DTD of
+# 1.25); its validation failure is fatal only with --strict, and the attribute has
+# no effect on the generated enums.
+scanner_args = dep_scanner.version().version_compare('>=1.25.0') ? ['--strict'] : []
 foreach protocol_file : protocol_files
 	header_name = fs.name(protocol_file).replace('.xml', '-enum.h')
 	headers += custom_target(
@@ -7,7 +11,7 @@ foreach protocol_file : protocol_files
 		input: '../..' / protocol_file,
 		command: [
 			prog_scanner,
-			'--strict',
+			scanner_args,
 			'enum-header',
 			'@INPUT@',
 			'@OUTPUT@',
-- 
2.53.0

