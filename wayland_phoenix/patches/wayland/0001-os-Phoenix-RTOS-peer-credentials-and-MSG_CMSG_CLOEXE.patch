From d7033421008992c309d61e74d5159d646391a2cd Mon Sep 17 00:00:00 2001
From: Phoenix new GPU lane <noreply@phoenix-rtos.invalid>
Date: Sun, 27 Sep 2026 08:32:08 +0200
Subject: [PATCH] os: Phoenix-RTOS peer credentials and MSG_CMSG_CLOEXEC
 fallback

Phoenix-RTOS AF_UNIX sockets carry no peer credentials and the system has
no MSG_CMSG_CLOEXEC. Report the caller's own uid/gid with pid 0 (as FreeBSD
without cr_pid) and take the existing FD_CLOEXEC fallback when the flag is
not defined.
---
 src/wayland-os.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/wayland-os.c b/src/wayland-os.c
index f00ead4..0e31048 100644
--- a/src/wayland-os.c
+++ b/src/wayland-os.c
@@ -125,6 +125,21 @@ wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
 	*pid = ucred.pid;
 	return 0;
 }
+#elif defined(__phoenix__)
+/*
+ * Phoenix-RTOS AF_UNIX sockets carry no peer credentials (no SO_PEERCRED and
+ * no SCM_CREDENTIALS). The system is single-user: report the caller's own
+ * uid/gid and an unknown pid (0), as FreeBSD does without cr_pid.
+ */
+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	(void)sockfd;
+	*uid = getuid();
+	*gid = getgid();
+	*pid = 0;
+	return 0;
+}
 #else
 #error "Don't know how to read ucred on this platform"
 #endif
@@ -178,14 +193,19 @@ recvmsg_cloexec_fallback(int sockfd, struct msghdr *msg, int flags)
 ssize_t
 wl_os_recvmsg_cloexec(int sockfd, struct msghdr *msg, int flags)
 {
-#if HAVE_BROKEN_MSG_CMSG_CLOEXEC
+#if HAVE_BROKEN_MSG_CMSG_CLOEXEC || !defined(MSG_CMSG_CLOEXEC)
 	/*
+	 * Systems without MSG_CMSG_CLOEXEC (Phoenix-RTOS) take the fallback, which
+	 * sets FD_CLOEXEC on each received descriptor.
+	 *
 	 * FreeBSD had a broken implementation of MSG_CMSG_CLOEXEC between 2015
 	 * and 2021, so we have to use the non-MSG_CMSG_CLOEXEC fallback
 	 * directly when compiling against a version that does not include the
 	 * fix (https://cgit.freebsd.org/src/commit/?id=6ceacebdf52211).
 	 */
+#if HAVE_BROKEN_MSG_CMSG_CLOEXEC
 #pragma message("Using fallback directly since MSG_CMSG_CLOEXEC is broken.")
+#endif
 #else
 	ssize_t len;
 
-- 
