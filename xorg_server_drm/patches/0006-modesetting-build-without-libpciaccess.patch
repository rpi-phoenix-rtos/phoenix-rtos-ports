From 6bb480cc6bccfb7b5bbc0ad1957df4fffb1a83f9 Mon Sep 17 00:00:00 2001
From: Phoenix gpu-lane <noreply@anthropic.com>
Date: Sun, 27 Sep 2026 04:47:16 +0200
Subject: [PATCH 6/8] modesetting: build without libpciaccess

driver.c does not compile with -Dpciaccess=false: it includes xf86Pci.h
(which includes <pciaccess.h> unconditionally) and references the PCI match
table and PCI probe, the bus-ID helper and probe_hw_pci(), although the
table and ms_pci_probe() are defined only under XSERVER_LIBPCIACCESS.
Guard all of it, and leave the DriverRec's PCI members NULL without
libpciaccess -- xf86 then probes the driver through Probe(), which opens
the device by path (Option "kmsdev", $KMSDEVICE or /dev/dri/card0): the
case of an SoC display controller on a system with neither PCI nor udev.
---
 hw/xfree86/drivers/modesetting/driver.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/hw/xfree86/drivers/modesetting/driver.c b/hw/xfree86/drivers/modesetting/driver.c
index fe3315a..a6218bb 100644
--- a/hw/xfree86/drivers/modesetting/driver.c
+++ b/hw/xfree86/drivers/modesetting/driver.c
@@ -42,7 +42,9 @@
 #include "xf86Priv.h"
 #include "xf86_OSproc.h"
 #include "compiler.h"
+#ifdef XSERVER_LIBPCIACCESS
 #include "xf86Pci.h"
+#endif
 #include "mipointer.h"
 #include "mipointrst.h"
 #include "micmap.h"
@@ -78,9 +80,11 @@ static Bool ScreenInit(ScreenPtr pScreen, int argc, char **argv);
 static Bool PreInit(ScrnInfoPtr pScrn, int flags);
 
 static Bool Probe(DriverPtr drv, int flags);
+#ifdef XSERVER_LIBPCIACCESS
 static Bool ms_pci_probe(DriverPtr driver,
                          int entity_num, struct pci_device *device,
                          intptr_t match_data);
+#endif
 static Bool ms_driver_func(ScrnInfoPtr scrn, xorgDriverFuncOp op, void *data);
 
 /* window wrapper functions used to get the notification when
@@ -121,8 +125,13 @@ _X_EXPORT DriverRec modesetting = {
     NULL,
     0,
     ms_driver_func,
+#ifdef XSERVER_LIBPCIACCESS
     ms_device_match,
     ms_pci_probe,
+#else
+    NULL,
+    NULL,
+#endif
 #ifdef XSERVER_PLATFORM_BUS
     ms_platform_probe,
 #endif
@@ -291,6 +300,7 @@ probe_hw(const char *dev, struct xf86_platform_device *platform_dev)
     return FALSE;
 }
 
+#ifdef XSERVER_LIBPCIACCESS
 static char *
 ms_DRICreatePCIBusID(const struct pci_device *dev)
 {
@@ -333,6 +343,7 @@ probe_hw_pci(const char *dev, struct pci_device *pdev)
     free(devid);
     return ret;
 }
+#endif
 
 static const OptionInfoRec *
 AvailableOptions(int chipid, int busid)
