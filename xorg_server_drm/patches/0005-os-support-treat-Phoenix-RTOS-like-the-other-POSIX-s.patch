From cfae20258bcf17838a24fe7232eba1a8f9df8193 Mon Sep 17 00:00:00 2001
From: Phoenix gpu-lane <noreply@anthropic.com>
Date: Sun, 27 Sep 2026 04:47:16 +0200
Subject: [PATCH 5/8] os-support: treat Phoenix-RTOS like the other POSIX
 systems

xf86_OSlib.h pulls in the POSIX headers (termios, sys/stat, sys/mman,
signal, errno) and defines POSIX_TTY per operating system; with no block
for Phoenix-RTOS the shared os-support code (posix_tty.c, sigio.c) and the
common xf86 code do not compile.  Phoenix is a POSIX system without
virtual terminals: take the Linux/glibc block, whose VT parts are already
limited to __linux__.
---
 hw/xfree86/os-support/xf86_OSlib.h | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/hw/xfree86/os-support/xf86_OSlib.h b/hw/xfree86/os-support/xf86_OSlib.h
index 159c806..cec4101 100644
--- a/hw/xfree86/os-support/xf86_OSlib.h
+++ b/hw/xfree86/os-support/xf86_OSlib.h
@@ -174,9 +174,10 @@ extern _X_HIDDEN char xf86SolarisFbDev[PATH_MAX];
 #endif                          /* (SYSV || SVR4) */
 
 /**************************************************************************/
-/* Linux or Glibc-based system                                            */
+/* Linux or Glibc-based system, or another POSIX system without VTs       */
 /**************************************************************************/
-#if defined(__linux__) || defined(__GLIBC__) || defined(__CYGWIN__)
+#if defined(__linux__) || defined(__GLIBC__) || defined(__CYGWIN__) || \
+    defined(__phoenix__)
 #include <sys/ioctl.h>
 #include <signal.h>
 #include <stdlib.h>
@@ -205,7 +206,7 @@ extern _X_HIDDEN char xf86SolarisFbDev[PATH_MAX];
 
 #define POSIX_TTY
 
-#endif                          /* __linux__ || __GLIBC__ */
+#endif                          /* __linux__ || __GLIBC__ || __phoenix__ */
 
 /**************************************************************************/
 /* System is BSD-like                                                     */
