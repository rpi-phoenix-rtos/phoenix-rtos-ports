+
+/*
+ * Builtin modules (XORG_BUILTIN_MODULES): on systems without a dynamic linker
+ * the modules are linked into the server.  The program that links them
+ * supplies xf86BuiltinModules[]; LoadModule() consults it before searching
+ * the module path, and LoaderSymbolFromModule() on such a module looks the
+ * name up in the module's own symbol list instead of calling dlsym().
+ */
+
+#ifndef _LOADER_BUILTIN_H
+#define _LOADER_BUILTIN_H
+
+#include "xf86Module.h"
+
+typedef struct {
+    const char *name;
+    void *address;
+} XF86BuiltinSymbol;
+
+typedef struct {
+    const char *name;                   /* canonical name, e.g. "modesetting" */
+    XF86ModuleData *data;               /* the module's <name>ModuleData */
+    const XF86BuiltinSymbol *symbols;   /* names its users resolve, {NULL} ended */
+} XF86BuiltinModule;
+
+/* Supplied by the program, terminated by an entry whose name is NULL. */
+extern const XF86BuiltinModule xf86BuiltinModules[];
+
+const XF86BuiltinModule *LoaderBuiltinFind(const char *name);
+const XF86BuiltinModule *LoaderBuiltinFromHandle(const void *handle);
+
+#endif /* _LOADER_BUILTIN_H */
diff --git a/hw/xfree86/loader/loadmod.c b/hw/xfree86/loader/loadmod.c
index 4286790..ac9d3a4 100644
--- a/hw/xfree86/loader/loadmod.c
+++ b/hw/xfree86/loader/loadmod.c
@@ -53,6 +53,9 @@
 #include "dix.h"
 #include "os.h"
 #include "loaderProcs.h"
+#ifdef XORG_BUILTIN_MODULES
+#include "loader_builtin.h"
+#endif
 #include "xf86Module.h"
 #include "loader.h"
 
@@ -720,6 +723,19 @@ LoadModule(const char *module, void *options, const XF86ModReqInfo *modreq,
         goto LoadModule_fail;
     }
 
+#ifdef XORG_BUILTIN_MODULES
+    {
+        const XF86BuiltinModule *builtin = LoaderBuiltinFind(m);
+
+        if (builtin) {
+            LogMessage(X_INFO, "Module \"%s\": linked into the server\n", m);
+            ret->handle = (void *) builtin;
+            initdata = builtin->data;
+            goto LoadModule_init;
+        }
+    }
+#endif
+
     pathlist = defaultPathList;
     if (!pathlist) {
         /* This could be a malloc failure too */
@@ -777,6 +793,9 @@ LoadModule(const char *module, void *options, const XF86ModReqInfo *modreq,
         goto LoadModule_fail;
     }
     initdata = LoaderSymbolFromModule(ret, p);
+#ifdef XORG_BUILTIN_MODULES
+ LoadModule_init:
+#endif
     if (initdata) {
         ModuleSetupProc setup;
         ModuleTearDownProc teardown;
