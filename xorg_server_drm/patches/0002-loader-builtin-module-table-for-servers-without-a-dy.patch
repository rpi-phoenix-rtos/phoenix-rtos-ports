From 736e5d35ede8eee1423beadbcdc7f911785c0892 Mon Sep 17 00:00:00 2001
From: Phoenix gpu-lane <noreply@anthropic.com>
Date: Sun, 27 Sep 2026 04:39:31 +0200
Subject: [PATCH 2/8] loader: builtin-module table for servers without a
 dynamic linker

With XORG_BUILTIN_MODULES the program that links the server together with
its modules supplies xf86BuiltinModules[]: for each module its canonical
name, its <name>ModuleData and the symbols its users look up with
LoaderSymbolFromModule().

 * LoadModule() consults the table before searching the module path and
   then takes the ordinary version-check/SetupProc path, so a builtin
   module behaves exactly like a loaded one (it appears in the log,
   honours XF86ModReqInfo, gets its options);
 * LoaderSymbolFromModule() on a builtin module resolves the name from the
   module's table (and logs a missing entry: a table out of step with the
   driver fails visibly instead of returning NULL silently);
 * LoaderSymbol() searches every builtin table before dlsym();
 * LoaderUnload() never dlclose()s a builtin handle.

Modules not in the table still go through dlopen() unchanged.
---
 hw/xfree86/loader/loader.c         | 65 ++++++++++++++++++++++++++++++
 hw/xfree86/loader/loader_builtin.h | 54 +++++++++++++++++++++++++
 hw/xfree86/loader/loadmod.c        | 19 +++++++++
 3 files changed, 138 insertions(+)
 create mode 100644 hw/xfree86/loader/loader_builtin.h

diff --git a/hw/xfree86/loader/loader.c b/hw/xfree86/loader/loader.c
index 2580e93..0e32a39 100644
--- a/hw/xfree86/loader/loader.c
+++ b/hw/xfree86/loader/loader.c
@@ -54,6 +54,9 @@
 #include "os.h"
 #include "loader.h"
 #include "loaderProcs.h"
+#ifdef XORG_BUILTIN_MODULES
+#include "loader_builtin.h"
+#endif
 
 #ifdef HAVE_DLFCN_H
 
@@ -113,12 +116,58 @@ LoaderOpen(const char *module, int *errmaj)
     return ret;
 }
 
+#ifdef XORG_BUILTIN_MODULES
+const XF86BuiltinModule *
+LoaderBuiltinFind(const char *name)
+{
+    const XF86BuiltinModule *m;
+
+    for (m = xf86BuiltinModules; m->name; m++)
+        if (!strcmp(m->name, name))
+            return m;
+    return NULL;
+}
+
+const XF86BuiltinModule *
+LoaderBuiltinFromHandle(const void *handle)
+{
+    const XF86BuiltinModule *m;
+
+    for (m = xf86BuiltinModules; m->name; m++)
+        if (handle == (const void *) m)
+            return m;
+    return NULL;
+}
+
+/* The table entry for name, or NULL; an entry may list a symbol as absent
+ * (address NULL), e.g. a feature the build left out. */
+static const XF86BuiltinSymbol *
+LoaderBuiltinSymbol(const XF86BuiltinModule *m, const char *name)
+{
+    const XF86BuiltinSymbol *s;
+
+    for (s = m->symbols; s && s->name; s++)
+        if (!strcmp(s->name, name))
+            return s;
+    return NULL;
+}
+#endif
+
 void *
 LoaderSymbol(const char *name)
 {
     static void *global_scope = NULL;
     void *p;
 
+#ifdef XORG_BUILTIN_MODULES
+    const XF86BuiltinModule *m;
+    const XF86BuiltinSymbol *s;
+
+    for (m = xf86BuiltinModules; m->name; m++)
+        if ((s = LoaderBuiltinSymbol(m, name)) && s->address)
+            return s->address;
+#endif
+
     p = dlsym(RTLD_DEFAULT, name);
     if (p != NULL)
         return p;
@@ -136,6 +185,18 @@ void *
 LoaderSymbolFromModule(void *handle, const char *name)
 {
     ModuleDescPtr mod = handle;
+#ifdef XORG_BUILTIN_MODULES
+    const XF86BuiltinModule *builtin = LoaderBuiltinFromHandle(mod->handle);
+
+    if (builtin) {
+        const XF86BuiltinSymbol *s = LoaderBuiltinSymbol(builtin, name);
+
+        if (!s)
+            LogMessage(X_ERROR, "Builtin module %s: no symbol %s in its table\n",
+                       builtin->name, name);
+        return s ? s->address : NULL;
+    }
+#endif
     return dlsym(mod->handle, name);
 }
 
@@ -143,6 +204,10 @@ void
 LoaderUnload(const char *name, void *handle)
 {
     LogMessageVerbSigSafe(X_INFO, 1, "Unloading %s\n", name);
+#ifdef XORG_BUILTIN_MODULES
+    if (LoaderBuiltinFromHandle(handle))
+        return;
+#endif
     if (handle)
         dlclose(handle);
 }
diff --git a/hw/xfree86/loader/loader_builtin.h b/hw/xfree86/loader/loader_builtin.h
new file mode 100644
index 0000000..9550a4c
--- /dev/null
+++ b/hw/xfree86/loader/loader_builtin.h
@@ -0,0 +1,54 @@
